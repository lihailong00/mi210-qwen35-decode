+    // the scale rounded to FP16. A three-column tile has a zero fourth column.
+    const float amax = warp_reduce_max<QK8_1>(fabsf(x));
+    const float d = amax / 127.0f;
+    reinterpret_cast<int8_t *>(words)[i] = amax == 0.0f ? 0 : roundf(x / d);
+    if (lane == 0) {
