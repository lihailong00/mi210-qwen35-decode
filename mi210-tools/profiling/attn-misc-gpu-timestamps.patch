+// ---- diagnostic: in-graph GPU timestamps (GGML_CUDA_TS=1 [GGML_CUDA_TS_DUMP=n] [GGML_CUDA_TS_OUT=prefix]) ----
+// A 1-thread kernel writing s_memrealtime (25 MHz on MI210) is captured after every dispatched node; after n graph
+// evaluations the timestamps and the node labels are dumped (analysis: ts.py). Real per-node cost = delta - ts kernel cost.
+static __global__ void k_ts(unsigned long long * buf, unsigned int * counter, unsigned int cap) {
+    const unsigned long long t = wall_clock64();
+    const unsigned int i = atomicAdd(counter, 1u);
+    buf[i % cap] = t;
+}
+struct ggml_cuda_ts_state {
+    bool enabled = false; bool dumped = false; int evals = 0; int dump_at = 100;
+    unsigned long long * buf = nullptr; unsigned int * counter = nullptr; unsigned int cap = 1u << 20;
+    std::vector<std::string> labels;
+};
+static ggml_cuda_ts_state & ggml_cuda_ts() {
+    static ggml_cuda_ts_state st = [] {
+        ggml_cuda_ts_state s;
+        s.enabled = getenv("GGML_CUDA_TS") != nullptr;
+        if (const char * e = getenv("GGML_CUDA_TS_DUMP")) { s.dump_at = atoi(e); }
+        return s;
+    }();
+    return st;
+}
+static void ggml_cuda_ts_mark(ggml_backend_cuda_context * ctx, const std::string & label) {
+    ggml_cuda_ts_state & st = ggml_cuda_ts();
+    if (!st.enabled || st.dumped) return;
+    if (!st.buf) {
+        CUDA_CHECK(cudaMalloc(&st.buf, sizeof(unsigned long long) * st.cap));
+        CUDA_CHECK(cudaMalloc(&st.counter, sizeof(unsigned int)));
+        CUDA_CHECK(cudaMemset(st.counter, 0, sizeof(unsigned int)));
+    }
+    k_ts<<<1, 1, 0, ctx->stream()>>>(st.buf, st.counter, st.cap);
+    st.labels.push_back(label);
+}
+static void ggml_cuda_ts_maybe_dump() {
+    ggml_cuda_ts_state & st = ggml_cuda_ts();
+    if (!st.enabled || st.dumped || !st.buf) return;
+    if (++st.evals < st.dump_at) return;
+    CUDA_CHECK(cudaDeviceSynchronize());
+    unsigned int n = 0;
+    CUDA_CHECK(cudaMemcpy(&n, st.counter, sizeof(n), cudaMemcpyDeviceToHost));
+    const unsigned int m = std::min(n, st.cap);
+    std::vector<unsigned long long> h(m);
+    CUDA_CHECK(cudaMemcpy(h.data(), st.buf, sizeof(unsigned long long) * m, cudaMemcpyDeviceToHost));
+    const char * out = getenv("GGML_CUDA_TS_OUT") ? getenv("GGML_CUDA_TS_OUT") : "/tmp/ggml_ts";
+    std::string f1 = std::string(out) + ".ts", f2 = std::string(out) + ".labels";
+    FILE * f = fopen(f1.c_str(), "w");
+    if (f) { for (unsigned int i = 0; i < m; ++i) fprintf(f, "%llu\n", h[i]); fclose(f); }
+    f = fopen(f2.c_str(), "w");
+    if (f) { for (auto & l : st.labels) fprintf(f, "%s\n", l.c_str()); fclose(f); }
+    fprintf(stderr, "ggml_cuda_ts: dumped %u timestamps, %zu labels per graph to %s.*\n", m, st.labels.size(), out);
+    st.dumped = true;
+}
