+// ---------------------------------------------------------------------------------------------
+// Long n_kv (several chunks): the 3 query heads of a kv group read the same K/V. ink_fattn_gqa runs one block per
+// (kv head, chunk of 256 positions) and computes the partials of all 3 heads from one load of K and V. Per head every
+// value is produced by the same operations in the same order as ink_fattn_f16 in multi-chunk mode (same thread roles,
+// same reductions, same chunk boundaries), so the partials and (max, sum) pairs are bit-identical; they are merged by
+// the same combine as before (ink_fattn_combine64, or ink_fattn_combine_big = ink_fattn_combine's arithmetic).
+// Differences to ink_fattn_f16: the per-head mask extent kend is computed for each head; K.Q iterations and V batches
+// run to the largest extent of the 3 heads, and a head only accumulates the V batches inside its own extent (the K.Q
+// values past a head's extent are never read). LDS: S/W of phases 1-3 and A of phase 4 share one buffer.
+// ---------------------------------------------------------------------------------------------
+template <bool BIAS>
+__launch_bounds__(INK_FA_THREADS, 2)
+static __global__ void ink_fattn_gqa(
+        const float * __restrict__ Q, const char * __restrict__ K, const char * __restrict__ V,
+        const half * __restrict__ mask, const float * __restrict__ sinks,
+        float * __restrict__ dst, float * __restrict__ meta,
+        const int n_kv, const int n_head,
+        const int q_stride, const uint32_t nb11, const int nb12, const uint32_t nb21, const int nb22,
+        const int mask_stride, const float scale,
+        const ggml_cuda_ink_attn_bias_args ba) {
+    constexpr int G  = 3;
+    constexpr int D  = INK_FA_D;
+    constexpr int C  = INK_FA_CHUNK;
+    constexpr int AS = D + 4;
+    constexpr int SW = 2*G*C;                      // S + W
+    constexpr int AW = 16*AS;                      // A of one head
+    constexpr int SM = SW > AW ? SW : AW;
+
+    __shared__ float smem[SM];
+    float * S = smem;           // [G][C]
+    float * W = smem + G*C;     // [G][C]
+    float * A = smem;           // [16][AS] (after phase 3, one head at a time)
+    __shared__ int   rend[G][4];
+    __shared__ float rmax[G][4];
+    __shared__ float rws[G][16];
+
+    const int g     = blockIdx.x;
+    const int p     = blockIdx.y;
+    const int tid   = threadIdx.x;
+    const int lane  = tid & 63;
+    const int wave  = tid >> 6;
+    const int lane4 = lane << 2;
+    const int h0    = g*G;
+
+    const int64_t k0  = (int64_t) p*C;
+    const int     len = (int) min((int64_t) C, n_kv - k0);
+
+    const uint32_t pos  = tid >> 3;
+    const uint32_t part = tid & 7;
+    // V role as in ink_fattn_f16 (rows 16*i + sub, columns 8*cg .. 8*cg + 7) but placed on the lanes so that the 16
+    // threads of one sub are adjacent: a V load instruction reads 4 whole rows (ink_fattn_f16: 16 quarter rows)
+    const uint32_t cg   = tid & 15;
+    const uint32_t sub  = tid >> 4;
+
+    const int64_t kv_own = k0 + min(tid, len - 1);
+    int bpos = 0;
+    if (BIAS) {
+        bpos = ba.idx[kv_own];
+    }
+    float4 qf[G][4];
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        const float * Qp = Q + (int64_t) (h0 + j)*q_stride + part*8;
+        ggml_cuda_memcpy_1<sizeof(float4)>(&qf[j][0], Qp);
+        ggml_cuda_memcpy_1<sizeof(float4)>(&qf[j][1], Qp + 4);
+        ggml_cuda_memcpy_1<sizeof(float4)>(&qf[j][2], Qp + 64);
+        ggml_cuda_memcpy_1<sizeof(float4)>(&qf[j][3], Qp + 68);
+    }
+
+    float m[G];
+    float sink[G];
+    float4 br[G][4];
+    float  bs[G];
+    float  bm0 = 0.0f;
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        m[j]    = 0.0f;
+        sink[j] = -INFINITY;
+        bs[j]   = 0.0f;
+    }
+    if (BIAS) {
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+            const float * rp = ba.R + (h0 + j)*INK_FA_NREL;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                ggml_cuda_memcpy_1<sizeof(float4)>(&br[j][i], rp + 4*i);
+            }
+            bs[j] = ba.sinks[h0 + j];
+            if (p == 0) {
+                sink[j] = ba.fill_value;
+            }
+        }
+        bm0 = ggml_cuda_cast<float>(ba.mask0[kv_own]);
+    } else {
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+            m[j] = __half2float(mask[(int64_t) (h0 + j)*mask_stride + kv_own]);
+            if (sinks != nullptr && p == 0) {
+                sink[j] = sinks[h0 + j];
+            }
+        }
+    }
+
+    const char *   Ks    = K + (int64_t) g*nb12 + k0*nb11;
+    const uint32_t klast = (uint32_t) (len - 1)*nb11 + part*16;
+    const uint32_t kstep = 32*nb11;
+    uint32_t       koff  = pos*nb11 + part*16;
+    __align__(16) half2 kr0[8];
+    __align__(16) half2 kr1[8];
+    __align__(16) half2 kr2[8];
+    {
+        const uint32_t o0 = min(koff, klast);
+        const uint32_t o1 = min(koff + kstep, klast);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr0,     Ks + o0);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr0 + 4, Ks + o0 + 128);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr1,     Ks + o1);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr1 + 4, Ks + o1 + 128);
+    }
+    const char *   Vs    = V + (int64_t) g*nb22 + k0*nb21;
+    const uint32_t vlast = (uint32_t) (len - 1)*nb21 + cg*16;
+    const uint32_t vstep = 16*nb21;
+    uint32_t       voff  = sub*nb21 + cg*16;
+    __align__(16) half2 vr[4][4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(vr[i], Vs + min(voff + i*vstep, vlast));
+    }
+
+    if (BIAS) {
+        const bool    padded = bpos >= ba.n_ext;
+        const float * wp     = ba.W + (int64_t) (padded ? 0 : bpos)*INK_FA_NREL;
+        float4 bw[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            ggml_cuda_memcpy_1<sizeof(float4)>(&bw[i], wp + 4*i);
+        }
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+            float acc = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                acc = fmaf(bw[i].x, br[j][i].x, acc);
+                acc = fmaf(bw[i].y, br[j][i].y, acc);
+                acc = fmaf(bw[i].z, br[j][i].z, acc);
+                acc = fmaf(bw[i].w, br[j][i].w, acc);
+            }
+            if (padded) {
+                acc = 0.0f;
+            }
+            const float b = acc - bs[j];
+            const float v = b + bm0;
+            m[j] = __half2float(ggml_cuda_cast<half>(v));
+        }
+    }
+
+    // ---- per head: number of leading positions that contain all unmasked ones
+    bool valid[G];
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        valid[j] = tid < len && !(m[j] == -INFINITY);
+        const uint64_t bal = ggml_cuda_ballot(valid[j]);
+        if (lane == 0) {
+            rend[j][wave] = bal != 0 ? (tid & ~63) + 64 - __builtin_clzll(bal) : 0;
+        }
+    }
+    __syncthreads();
+    int kend[G];
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        kend[j] = max(max(rend[j][0], rend[j][1]), max(rend[j][2], rend[j][3]));
+    }
+    const int kendA = max(max(kend[0], kend[1]), kend[2]);
+
+    // ---- 1. K.Q for the 3 heads from each loaded K row
+    half2 qh[G][8];
+    {
+        const half2 scale_h2 = make_half2(scale, scale);
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                qh[j][2*i + 0] = make_half2(qf[j][i].x, qf[j][i].y);
+                qh[j][2*i + 1] = make_half2(qf[j][i].z, qf[j][i].w);
+            }
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                qh[j][i] *= scale_h2;
+            }
+        }
+    }
+    // three K buffers: iteration it + 3 is loaded into the buffer of iteration it right after its use
+    if (kendA > 64) {
+        const uint32_t o = min(koff + 2*kstep, klast);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr2,     Ks + o);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr2 + 4, Ks + o + 128);
+    }
+#define INK_FA_KSTEP(KB, IT)                                                                   \
+    {                                                                                          \
+        _Pragma("unroll")                                                                      \
+        for (int j = 0; j < G; ++j) {                                                          \
+            const float a = ink_fa_score(KB, qh[j], lane4);                                    \
+            if (part == 0) {                                                                   \
+                S[j*C + (IT)*32 + pos] = a;                                                    \
+            }                                                                                  \
+        }                                                                                      \
+        if (((IT) + 3)*32 < kendA) {                                                           \
+            const uint32_t o = min(koff + ((IT) + 3)*kstep, klast);                            \
+            ggml_cuda_memcpy_1<4*sizeof(half2)>(KB,     Ks + o);                               \
+            ggml_cuda_memcpy_1<4*sizeof(half2)>(KB + 4, Ks + o + 128);                         \
+        }                                                                                      \
+    }
+    for (int it = 0; it*32 < kendA; it += 3) {
+        INK_FA_KSTEP(kr0, it);
+        if ((it + 1)*32 < kendA) {
+            INK_FA_KSTEP(kr1, it + 1);
+        }
+        if ((it + 2)*32 < kendA) {
+            INK_FA_KSTEP(kr2, it + 2);
+        }
+    }
+#undef INK_FA_KSTEP
+    // V rows of batch 1 (in flight during phase 2)
+    __align__(16) half2 vn[4][4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(vn[i], Vs + min(voff + 4*vstep + i*vstep, vlast));
+    }
+    __syncthreads();
+
+    // ---- 2. scores, max, weights per head
+    float s[G];
+    float mx[G];
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        s[j] = -INFINITY;
+        if (valid[j]) {
+            s[j] = S[j*C + tid] + m[j];
+        }
+        float x = s[j];
+#pragma unroll
+        for (int b = 0; b < 6; ++b) {
+            x = ink_fa_max(x, ink_fa_perm(x, lane4 ^ (4 << b)));
+        }
+        mx[j] = x;
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+            rmax[j][wave] = mx[j];
+        }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        float x = ink_fa_max(ink_fa_max(rmax[j][0], rmax[j][1]), ink_fa_max(rmax[j][2], rmax[j][3]));
+        x = ink_fa_max(ink_fa_max(x, -FLT_MAX/2.0f), sink[j]);
+        mx[j] = x;
+        W[j*C + tid] = expf(s[j] - x);
+    }
+    __syncthreads();
+
+    // ---- 3. weighted V sums of the 3 heads from each loaded V row
+    float va[G][8];
+    float wsum[G];
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            va[j][i] = 0.0f;
+        }
+        wsum[j] = 0.0f;
+    }
+    const float * Wc = W + sub;
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        ink_fa_vacc(va[j], wsum[j], vr, Wc + j*C);
+    }
+    // two V buffers: batch b + 1 is loaded while batch b is accumulated (vr: even batches, vn: odd batches)
+    for (int b = 1; b*64 < kendA; b += 2) {
+        if ((b + 1)*64 < kendA) {
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                ggml_cuda_memcpy_1<4*sizeof(half2)>(vr[i], Vs + min(voff + 4*(b + 1)*vstep + i*vstep, vlast));
+            }
+        }
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+            if (b*64 < kend[j]) {
+                ink_fa_vacc(va[j], wsum[j], vn, Wc + j*C + b*64);
+            }
+        }
+        if ((b + 1)*64 < kendA) {
+            if ((b + 2)*64 < kendA) {
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    ggml_cuda_memcpy_1<4*sizeof(half2)>(vn[i], Vs + min(voff + 4*(b + 2)*vstep + i*vstep, vlast));
+                }
+            }
+#pragma unroll
+            for (int j = 0; j < G; ++j) {
+                if ((b + 1)*64 < kend[j]) {
+                    ink_fa_vacc(va[j], wsum[j], vr, Wc + j*C + (b + 1)*64);
+                }
+            }
+        }
+    }
+
+    // ---- 4. totals, partial sums through LDS (A overlays S/W, one head at a time), unnormalized partials + (max, sum)
+    //      The weight sums of the 16 subs are added in the order of the lane butterfly of ink_fattn_f16 (its thread 0
+    //      writes the sum): ((w0 + w1) + (w2 + w3)) + ((w4 + w5) + (w6 + w7)) and so on, pairwise.
+    if (cg == 0) {
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+            rws[j][sub] = wsum[j];
+        }
+    }
+#pragma unroll
+    for (int j = 0; j < G; ++j) {
+        __syncthreads();
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            A[sub*AS + cg*8 + i] = va[j][i];
+        }
+        __syncthreads();
+        if (tid < D) {
+            float v = 0.0f;
+#pragma unroll
+            for (int sb = 0; sb < 16; ++sb) {
+                v += A[sb*AS + tid];
+            }
+            dst[((int64_t) p*n_head + h0 + j)*D + tid] = v;
+        }
+    }
+    if (tid == 0) {
+#pragma unroll
+        for (int j = 0; j < G; ++j) {
+            float t[16];
+#pragma unroll
+            for (int k = 0; k < 16; ++k) {
+                t[k] = rws[j][k];
+            }
+#pragma unroll
+            for (int st = 1; st < 16; st *= 2) {
+#pragma unroll
+                for (int k = 0; k < 16; k += 2*st) {
+                    t[k] = t[k] + t[k + st];
+                }
+            }
+            const float sum = t[0] + expf(sink[j] - mx[j]);
+            meta[((int64_t) p*n_head + h0 + j)*2 + 0] = mx[j];
+            meta[((int64_t) p*n_head + h0 + j)*2 + 1] = sum;
+        }
+    }
+}
+
+// Same arithmetic as ink_fattn_combine (global max, then the chunks accumulated in order, chunks with a zero factor
+// skipped), for hundreds of chunks: block = (head, 32 output columns). All threads load tiles of 256 chunks into LDS
+// (the next tile is loaded into registers while the current one is accumulated); the max and the scale factors are
+// computed in parallel over the chunks; lanes 0..31 of wave 0 run the in-order accumulation of num from LDS, wave 1 the
+// one of den. (The cost is the instruction count of that serial chain: keep it at one fma per chunk.)
+#define INK_FA_CB_T    256 // chunks per tile
+#define INK_FA_CB_COLS 32
+static __global__ void __launch_bounds__(256, 1) ink_fattn_combine_big(
+        const float * __restrict__ tmp, const float * __restrict__ meta, float * __restrict__ dst, const int n_chunks, const int n_head) {
+    constexpr int D  = INK_FA_D;
+    constexpr int T  = INK_FA_CB_T;
+    constexpr int NC = INK_FA_CB_COLS;
+    const int h   = blockIdx.x;
+    const int c0  = blockIdx.y*NC;
+    const int tid = threadIdx.x;
+
+    constexpr int VS = T + 4; // row stride of the transposed partials (column-major: one row per output column)
+    __shared__ __align__(16) float Vt[NC*VS];
+    __shared__ __align__(16) float Sc[T];
+    __shared__ __align__(16) float Sm[T];
+    __shared__ float Rm[256/64];
+
+    // thread tid loads chunk rows (tid >> 3) + 32*i, columns c0 + 4*(tid & 7) .. + 3; the first tile is in flight
+    // during the max pass
+    const int64_t rstride = (int64_t) n_head*D;
+    const float * tp      = tmp + (int64_t) h*D + c0 + 4*(tid & 7);
+    const int     rr      = tid >> 3;
+    float4 vt[T/32];
+    float  mt = 0.0f, st = 0.0f;
+    auto load_tile = [&](const int p0) {
+#pragma unroll
+        for (int i = 0; i < T/32; ++i) {
+            const int pp = min(p0 + rr + 32*i, n_chunks - 1);
+            ggml_cuda_memcpy_1<sizeof(float4)>(&vt[i], tp + pp*rstride);
+        }
+        const int pm = min(p0 + tid, n_chunks - 1);
+        mt = meta[((int64_t) pm*n_head + h)*2 + 0];
+        st = meta[((int64_t) pm*n_head + h)*2 + 1];
+    };
+    load_tile(0);
+
+    // global max (max is exact in any order: the chunk maxima are never NaN)
+    float mx = -INFINITY;
+    for (int p = tid; p < n_chunks; p += 256) {
+        mx = fmaxf(mx, meta[((int64_t) p*n_head + h)*2]);
+    }
+#pragma unroll
+    for (int b = 0; b < 6; ++b) {
+        mx = fmaxf(mx, ink_fa_perm(mx, (tid & 63)*4 ^ (4 << b)));
+    }
+    if ((tid & 63) == 0) {
+        Rm[tid >> 6] = mx;
+    }
+    __syncthreads();
+    mx = fmaxf(fmaxf(Rm[0], Rm[1]), fmaxf(Rm[2], Rm[3]));
+
+    // Per tile: Sc = factor of each chunk, Sm and the partials of chunks with a zero factor (and of the padding past the
+    // last chunk, factor 0) replaced by -1: fma(+0, -1, x) = x + (-0) = x exactly for every x (also -0), which is the
+    // skip of ink_fattn_combine. Then the dependent chain is one fma per chunk: wave 0 accumulates num (one column per
+    // lane, 4 chunks per LDS read), wave 1 den. num += sc*v and den += sc*sm are fused multiply-adds in
+    // ink_fattn_combine (v_pk_fma_f32): spelled out here.
+    float num = 0.0f;
+    float den = 0.0f;
