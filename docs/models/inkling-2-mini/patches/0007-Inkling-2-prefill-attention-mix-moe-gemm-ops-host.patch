+    const ggml_tensor * tau  = nullptr;
+    int i_end = idx[6];
+    if (tau_on) {
+        const int kt = pfo_next(cgraph, idx[6]);
+        const ggml_tensor * nd = kt >= 0 ? cgraph->nodes[kt] : nullptr;
+        if (nd && nd->op == GGML_OP_MUL && nd->src[0] == out && pfo_f32_contig(nd) && ggml_are_same_shape(nd, out) &&
+            pfo_f32_contig(nd->src[1]) && nd->src[1]->ne[0] == 1 && nd->src[1]->ne[1] == 1 && nd->src[1]->ne[2] == out->ne[2] &&
+            nd->src[1]->ne[3] == 1 && out->ne[3] == 1 && ggml_node_get_use_count(cgraph, idx[6]) == 1 &&
+            !(out->flags & GGML_TENSOR_FLAG_OUTPUT) && pfo_disjoint_or_alias(nd, x) && (!s || pfo_disjoint_or_alias(nd, s)) &&
+            !pfo_overlap(nd, nd->src[1])) {
+            tmul  = nd;
+            tau   = nd->src[1];
+            i_end = kt;
+        }
+    }
+    if (!pfo_disjoint_or_alias(out, x) || (s && !pfo_disjoint_or_alias(out, s))) {
+        PFO_REJECT("clip");
+    }
