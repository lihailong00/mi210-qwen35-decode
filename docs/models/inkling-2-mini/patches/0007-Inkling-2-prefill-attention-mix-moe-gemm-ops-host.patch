+#pragma once
+
+#include "common.cuh"
+
+// Inkling-2 prefill (T > 1 tokens per graph) glue fusions (MI210 work, p6-glue).
+// Batched replacements for chains of small elementwise / row ops of src/models/inkling2.cpp:
+//   conv : convolve() without dynamic taps: CONCAT(past, x^T) ; CPY(last 3 -> conv state) ; SSM_CONV ; ADD(x, conv) ;
+//          SCALE [; ADD(residual, .)]                                  (GGML_CUDA_INK_PFOPS_CONV=0 disables)
+//   ctrl : control() epilogue: TANH(F h) SCALE MUL(., cur) ; TANH(G h) MUL(., msg) ; ADD ; RMS_NORM ; MUL(norm weight)
+//                                                                       (GGML_CUDA_INK_PFOPS_CTRL=0)
+//   cnorm: control() input: CONCAT(cur, msg) along dim 1 -> RMS_NORM    (GGML_CUDA_INK_PFOPS_CNORM=0)
+//   clip : clip() for rows of 33..256 values (reduce_rows block 32 tree) (GGML_CUDA_INK_PFOPS_CLIP=0)
+// All arithmetic reproduces the original kernels (same operation order, same reduction trees).
+// GGML_CUDA_INK_PFOPS=0 (or GGML_CUDA_INK_FUSE=0) disables all of them.
+// Same contract as ggml_cuda_try_fuse_inkling: > 0 = number of following nodes consumed, -1 = node handled (later nodes
+// deferred-skipped), 0 = not handled.
+int ggml_cuda_ink_pfops_try(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
+
+// called at the start of each graph evaluation (clears pending launches)
+void ggml_cuda_ink_pfops_begin();
