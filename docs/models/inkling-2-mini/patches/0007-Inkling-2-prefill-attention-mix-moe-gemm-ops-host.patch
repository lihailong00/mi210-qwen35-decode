+#pragma once
+
+#include "common.cuh"
+
+// Prefill (multi-query) attention for GGML_OP_FLASH_ATTN_EXT_BANDED on 64-lane CDNA devices: f32 Q, f16 K/V,
+// head dim 128, GQA 3, f32 relative-bias table, optional per-query sinks. Returns false (and does nothing)
+// when the node does not qualify; the caller then runs the stock banded kernels.
+// GGML_CUDA_INK_PFATTN=0 disables it.
+bool ggml_cuda_ink_pfattn(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+// once per graph (from ggml_cuda_inkling_begin): picks the banded nodes whose relative-bias table is computed inside
+// the kernel and defers a skip of the table MUL_MAT (only when the table has no other consumer).
+// GGML_CUDA_INK_PFATTN_BIAS=0 keeps the table.
+void ggml_cuda_ink_pfattn_begin(const ggml_cgraph * cgraph);
+
+// p7-small GATE: at a banded node followed by RESHAPE, the gate MUL_MAT, SIGMOID and MUL(reshape, sigmoid), the attention
+// launch is deferred to the SIGMOID node and writes sigmoid(gate) * attention into the MUL output (returns -1 at the
+// attention node, 1 at the SIGMOID). GGML_CUDA_INK_PFATTN_GATE=0 disables it. _begin once per graph.
+int  ggml_cuda_ink_pfattn_gate_try(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
+void ggml_cuda_ink_pfattn_gate_begin();
diff --git a/ggml/src/ggml-cuda/inkling-pfgemm-kern.cuh b/ggml/src/ggml-cuda/inkling-pfgemm-kern.cuh
new file mode 100644
index 0000000..6412377
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-pfgemm-kern.cuh
@@ -0,0 +1,779 @@
+// inkling prefill dense BF16 GEMM kernels (shared by the ggml backend file and the standalone bench)
+// D[t*ldd + n] = sum_k bf16_rne(X[t*ldx + k]) * W[n*ldw + k]   (X f32, W bf16, D f32, fp32 accumulate)
+#pragma once
+#include <stdint.h>
+
+typedef short ink_pg_v4s  __attribute__((ext_vector_type(4)));
+typedef float ink_pg_v16f __attribute__((ext_vector_type(16)));
+
+static __device__ __forceinline__ uint32_t ink_pg_bf16_rne(float x) {
+    uint32_t u = __float_as_uint(x);
+    u += 0x7fffu + ((u >> 16) & 1u);
+    return u >> 16;
+}
+
+static __device__ __forceinline__ ink_pg_v4s ink_pg_u2_to_v4s(uint32_t lo, uint32_t hi) {
+    ink_pg_v4s r;
+    r[0] = (short) (lo & 0xffffu);
+    r[1] = (short) (lo >> 16);
+    r[2] = (short) (hi & 0xffffu);
+    r[3] = (short) (hi >> 16);
+    return r;
+}
+
+static __device__ __forceinline__ ink_pg_v4s ink_pg_pack4(const float4 v) {
+    const uint32_t lo = ink_pg_bf16_rne(v.x) | (ink_pg_bf16_rne(v.y) << 16);
+    const uint32_t hi = ink_pg_bf16_rne(v.z) | (ink_pg_bf16_rne(v.w) << 16);
+    return ink_pg_u2_to_v4s(lo, hi);
+}
+
+// row index (within the 32x32 MFMA tile) of accumulator register rr of a lane in half h
+// f32 value rounded (RNE) to bf16 precision, kept as f32: reproduces the bf16 dst of the rocBLAS path
+static __device__ __forceinline__ float ink_pg_round_bf16(float x) {
+    return __uint_as_float(ink_pg_bf16_rne(x) << 16);
+}
+
+static __device__ __forceinline__ int ink_pg_acc_row(int rr, int h) {
+    return (rr >> 2) * 8 + h * 4 + (rr & 3);
+}
+
+// Skinny / small GEMM without LDS staging: block = 4 waves, each wave 32 tokens x (32*NB) rows.
+// KSPLIT waves split K (reduced through LDS), the other 4/KSPLIT wave groups take different tokens.
+// Requirements: K % (16*KSPLIT) == 0, X/W rows 16-byte aligned (ldx % 4 == 0, ldw % 8 == 0), T >= 1, N >= 1.
+template <int KSPLIT, int NB>
+__global__ void __launch_bounds__(256) ink_pg_skinny(const float * __restrict__ X, const uint16_t * __restrict__ W,
+        float * __restrict__ D, const int T, const int N, const int K, const long ldx, const long ldw, const long ldd) {
+    static_assert(KSPLIT == 1 || KSPLIT == 4, "KSPLIT");
+    constexpr int TSUB = 4 / KSPLIT;
+    constexpr int BT   = 32 * TSUB;
+    constexpr int BN   = 32 * NB;
+    const int lane = threadIdx.x & 63;
+    const int w    = threadIdx.x >> 6;
+    const int ks   = w % KSPLIT;
+    const int ts   = w / KSPLIT;
+    const int n0   = blockIdx.x * BN;
+    const int t0   = blockIdx.y * BT + ts * 32;
+    const int r    = lane & 31;
+    const int h    = lane >> 5;
+    const int Kc   = K / KSPLIT;
+
+    int t = t0 + r;
+    t = t < T ? t : T - 1;
+    const float * xp = X + (long) t * ldx + (long) ks * Kc + h * 8;
+    const uint16_t * wp[NB];
+#pragma unroll
+    for (int b = 0; b < NB; ++b) {
+        int n = n0 + b * 32 + r;
+        n = n < N ? n : N - 1;
+        wp[b] = W + (long) n * ldw + (long) ks * Kc + h * 8;
+    }
+
+    ink_pg_v16f acc[NB];
+#pragma unroll
+    for (int b = 0; b < NB; ++b) {
+#pragma unroll
+        for (int i = 0; i < 16; ++i) {
+            acc[b][i] = 0.0f;
+        }
+    }
+
+#pragma unroll 4
+    for (int k = 0; k < Kc; k += 16) {
+        const float4 a0 = *(const float4 *) (xp + k);
+        const float4 a1 = *(const float4 *) (xp + k + 4);
+        uint4 bw[NB];
+#pragma unroll
+        for (int b = 0; b < NB; ++b) {
+            bw[b] = *(const uint4 *) (wp[b] + k);
+        }
+        const ink_pg_v4s A0 = ink_pg_pack4(a0);
+        const ink_pg_v4s A1 = ink_pg_pack4(a1);
+#pragma unroll
+        for (int b = 0; b < NB; ++b) {
+            acc[b] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(A0, ink_pg_u2_to_v4s(bw[b].x, bw[b].y), acc[b], 0, 0, 0);
+            acc[b] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(A1, ink_pg_u2_to_v4s(bw[b].z, bw[b].w), acc[b], 0, 0, 0);
+        }
+    }
+
+    if constexpr (KSPLIT == 1) {
+#pragma unroll
+        for (int b = 0; b < NB; ++b) {
+            const int n = n0 + b * 32 + r;
+#pragma unroll
+            for (int rr = 0; rr < 16; ++rr) {
+                const int tt = t0 + ink_pg_acc_row(rr, h);
+                if (tt < T && n < N) {
+                    D[(long) tt * ldd + n] = acc[b][rr];
+                }
+            }
+        }
+    } else {
+        __shared__ float red[KSPLIT][NB * 16][64];
+#pragma unroll
+        for (int b = 0; b < NB; ++b) {
+#pragma unroll
+            for (int rr = 0; rr < 16; ++rr) {
+                red[ks][b * 16 + rr][lane] = acc[b][rr];
+            }
+        }
+        __syncthreads();
+        constexpr int E = NB * 16 * 64;
+        for (int e = threadIdx.x; e < E; e += 256) {
+            const int l   = e & 63;
+            const int idx = e >> 6;
+            float s = 0.0f;
+#pragma unroll
+            for (int q = 0; q < KSPLIT; ++q) {
+                s += red[q][idx][l];
+            }
+            const int b  = idx >> 4;
+            const int rr = idx & 15;
+            const int tt = blockIdx.y * BT + ink_pg_acc_row(rr, l >> 5);
+            const int n  = n0 + b * 32 + (l & 31);
+            if (tt < T && n < N) {
+                D[(long) tt * ldd + n] = s;
+            }
+        }
+    }
+}
+
+// v2: S waves per block all split K (tree reduction through LDS), block tile 32 tokens x 32*NB rows,
+// U k16-steps per software-pipeline stage (next stage loaded before the current one is consumed).
+// Requirements: K % (16*U*S) == 0, ldx % 4 == 0, ldw % 8 == 0, 16-byte aligned pointers.
+template <int S, int NB, int U>
+__global__ void __launch_bounds__(64 * S) ink_pg_sk2(const float * __restrict__ X, const uint16_t * __restrict__ W,
+        float * __restrict__ D, const int T, const int N, const int K, const long ldx, const long ldw, const long ldd) {
+    const int lane = threadIdx.x & 63;
+    const int w    = threadIdx.x >> 6;
+    const int n0   = blockIdx.x * (32 * NB);
+    const int t0   = blockIdx.y * 32;
+    const int r    = lane & 31;
+    const int h    = lane >> 5;
+    const int KC   = K / S;
+
+    int t = t0 + r;
+    t = t < T ? t : T - 1;
+    const float * xp = X + (long) t * ldx + (long) w * KC + h * 8;
+    const uint16_t * wp[NB];
+#pragma unroll
+    for (int b = 0; b < NB; ++b) {
+        int n = n0 + b * 32 + r;
+        n = n < N ? n : N - 1;
+        wp[b] = W + (long) n * ldw + (long) w * KC + h * 8;
+    }
+
+    ink_pg_v16f acc[NB];
+#pragma unroll
+    for (int b = 0; b < NB; ++b) {
+#pragma unroll
+        for (int i = 0; i < 16; ++i) {
+            acc[b][i] = 0.0f;
+        }
+    }
+
+    float4 a[U][2];
+    uint4  bv[U][NB];
+#pragma unroll
+    for (int u = 0; u < U; ++u) {
+        a[u][0] = *(const float4 *) (xp + u * 16);
+        a[u][1] = *(const float4 *) (xp + u * 16 + 4);
+#pragma unroll
+        for (int b = 0; b < NB; ++b) {
+            bv[u][b] = *(const uint4 *) (wp[b] + u * 16);
+        }
+    }
+    for (int k = 0; k < KC; k += 16 * U) {
+        int kn = k + 16 * U;
+        kn = kn < KC ? kn : KC - 16 * U;
+        float4 an[U][2];
+        uint4  bn[U][NB];
+#pragma unroll
+        for (int u = 0; u < U; ++u) {
+            an[u][0] = *(const float4 *) (xp + kn + u * 16);
+            an[u][1] = *(const float4 *) (xp + kn + u * 16 + 4);
+#pragma unroll
+            for (int b = 0; b < NB; ++b) {
+                bn[u][b] = *(const uint4 *) (wp[b] + kn + u * 16);
+            }
+        }
+        __builtin_amdgcn_sched_barrier(0);
+#pragma unroll
+        for (int u = 0; u < U; ++u) {
+            const ink_pg_v4s A0 = ink_pg_pack4(a[u][0]);
+            const ink_pg_v4s A1 = ink_pg_pack4(a[u][1]);
+#pragma unroll
+            for (int b = 0; b < NB; ++b) {
+                acc[b] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(A0, ink_pg_u2_to_v4s(bv[u][b].x, bv[u][b].y), acc[b], 0, 0, 0);
+                acc[b] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(A1, ink_pg_u2_to_v4s(bv[u][b].z, bv[u][b].w), acc[b], 0, 0, 0);
+            }
+        }
+#pragma unroll
+        for (int u = 0; u < U; ++u) {
+            a[u][0] = an[u][0];
+            a[u][1] = an[u][1];
+#pragma unroll
+            for (int b = 0; b < NB; ++b) {
+                bv[u][b] = bn[u][b];
+            }
+        }
+    }
+
+    if constexpr (S > 1) {
+        __shared__ float red[S / 2][NB * 16][64];
+#pragma unroll
+        for (int half = S / 2; half >= 1; half >>= 1) {
+            if (w >= half && w < 2 * half) {
+#pragma unroll
+                for (int b = 0; b < NB; ++b) {
+#pragma unroll
+                    for (int rr = 0; rr < 16; ++rr) {
+                        red[w - half][b * 16 + rr][lane] = acc[b][rr];
+                    }
+                }
+            }
+            __syncthreads();
+            if (w < half) {
+#pragma unroll
+                for (int b = 0; b < NB; ++b) {
+#pragma unroll
+                    for (int rr = 0; rr < 16; ++rr) {
+                        acc[b][rr] += red[w][b * 16 + rr][lane];
+                    }
+                }
+            }
+            __syncthreads();
+        }
+    }
+    if (w == 0) {
+#pragma unroll
+        for (int b = 0; b < NB; ++b) {
+            const int n = n0 + b * 32 + r;
+#pragma unroll
+            for (int rr = 0; rr < 16; ++rr) {
+                const int tt = t0 + ink_pg_acc_row(rr, h);
+                if (tt < T && n < N) {
+                    D[(long) tt * ldd + n] = acc[b][rr];
+                }
+            }
+        }
+    }
+}
+
+template <int S, int NB, int U>
+static void ink_pg_sk2_run(const float * X, const uint16_t * W, float * D, int T, int N, int K, hipStream_t st) {
+    dim3 grid((N + 32 * NB - 1) / (32 * NB), (T + 31) / 32);
+    ink_pg_sk2<S, NB, U><<<grid, 64 * S, 0, st>>>(X, W, D, T, N, K, K, K, N);
+}
+
+// LDS-tiled GEMM: 256 threads (2x2 waves), wave tile (32*WT tokens) x (32*WN rows), block tile BT x BN, BK = 32,
+// double-buffered LDS, global loads of the next k-slab issued before the MFMAs of the current one.
+// X is f32 (converted to bf16 with RNE while staging) or bf16 (XBF16). Requirements: N % BN == 0, K % 32 == 0,
+// 16-byte aligned rows. Tokens beyond T are clamped on load and masked on store.
+#ifndef INK_PG_TILED_WPE
+#define INK_PG_TILED_WPE 4
+#endif
+#define INK_PG_LDS_STRIDE 32  // bf16 elements per LDS row (no pad): 16-byte chunks XOR-swizzled by (row>>1)&3
+#define INK_PG_SWZ(row_, c_) (((c_) ^ (((row_) >> 1) & 3)) * 8)
+template <int WT, int WN, bool XBF16>
+__global__ void __launch_bounds__(256, INK_PG_TILED_WPE) ink_pg_tiled(const void * __restrict__ Xv, const uint16_t * __restrict__ W,
+        float * __restrict__ D, const int T, const int N, const int K, const long ldx, const long ldw, const long ldd,
+        const int Kp, const long dsplit, const int rbf16 = 0) {
+    constexpr int BT = 64 * WT;
+    constexpr int BN = 64 * WN;
+    constexpr int XL = BT * 32 / (XBF16 ? 8 : 4) / 256;  // global vector loads per thread for the X slab
+    constexpr int WL = BN * 32 / 8 / 256;                 // uint4 loads per thread for the W slab
+    static_assert(XL >= 1 && WL >= 1, "tile too small");
+    __shared__ __attribute__((aligned(16))) uint16_t xs[1][BT * INK_PG_LDS_STRIDE];
+    __shared__ __attribute__((aligned(16))) uint16_t ws[1][BN * INK_PG_LDS_STRIDE];
+
+    const int tid  = threadIdx.x;
+    const int lane = tid & 63;
+    const int wv   = tid >> 6;
+    const int wt   = wv >> 1;
+    const int wn   = wv & 1;
+    const int r    = lane & 31;
+    const int h    = lane >> 5;
+
+    // tile swizzle: groups of 8 token tiles, n fastest inside a group column
+    const int ntn = (N + BN - 1) / BN;
+    const int ntt = (T + BT - 1) / BT;
+    int bid = blockIdx.x;
+    const int GROUP = 8;
+    const int per_group = GROUP * ntn;
+    const int g = bid / per_group;
+    const int first_t = g * GROUP;
+    const int gsz = min(ntt - first_t, GROUP);
+    const int in_g = bid - g * per_group;
+    const int tile_t = first_t + in_g % gsz;
+    const int tile_n = in_g / gsz;
+    const int t0 = tile_t * BT;
+    const int n0 = tile_n * BN;
+
+    // global load mapping
+    // X f32: 8 threads per row (float4 each), rows tid/8 + 32*i ; X bf16: 4 threads per row (uint4 each), rows tid/4 + 64*i
+    constexpr int XTPR = XBF16 ? 4 : 8;
+    constexpr int XRPP = 256 / XTPR;
+    const int xc = tid % XTPR;
+    const int xr = tid / XTPR;
+    int tx = t0 + xr;
+    // split-K: blockIdx.y selects K range [p*Kp, (p+1)*Kp); partial results go to D + p*dsplit
+    const int kbase = blockIdx.y * Kp;
+    D += (long) blockIdx.y * dsplit;
+    const char * xbase = (const char *) Xv + (long) kbase * (XBF16 ? 2 : 4);
+    const long xrow_step = (long) XRPP * ldx * (XBF16 ? 2 : 4);
+    // rows past T are clamped per load below
+    const int wc = tid & 3;
+    const int wr = tid >> 2;
+    const int wn0 = n0 + wr < N ? n0 + wr : N - 1;
+    const int wn1 = n0 + wr + 64 < N ? n0 + wr + 64 : N - 1;
+    const uint16_t * wbase = W + (long) wn0 * ldw + wc * 8 + kbase;
+    const long wrow_step = (long) (wn1 - wn0) * ldw;
+
+    static_assert(XL <= 4 && WL <= 2, "staging supports XL <= 4, WL <= 2");
+    float4 xf0, xf1, xf2, xf3;
+    uint4  xb0, xb1, xb2, xb3;
+    uint4  wg0, wg1;
+#define INK_PG_XROW(i_) ((tx + XRPP * (i_)) < T ? (tx + XRPP * (i_)) : T - 1)
+#define INK_PG_XLD(i_, dstf_, dstb_, k_) do { if constexpr (XL > (i_)) { \
+            if constexpr (XBF16) { dstb_ = *(const uint4 *) ((const uint16_t *) xbase + (long) INK_PG_XROW(i_) * ldx + xc * 8 + (k_)); } \
+            else { dstf_ = *(const float4 *) ((const float *) xbase + (long) INK_PG_XROW(i_) * ldx + xc * 4 + (k_)); } } } while (0)
+#define INK_PG_GLOAD(k_) do { \
+        INK_PG_XLD(0, xf0, xb0, k_); INK_PG_XLD(1, xf1, xb1, k_); INK_PG_XLD(2, xf2, xb2, k_); INK_PG_XLD(3, xf3, xb3, k_); \
+        wg0 = *(const uint4 *) (wbase + (k_)); \
+        if constexpr (WL > 1) { wg1 = *(const uint4 *) (wbase + wrow_step + (k_)); } \
+    } while (0)
+#define INK_PG_XST(i_, srcf_, srcb_) do { if constexpr (XL > (i_)) { \
+            if constexpr (XBF16) { *(uint4 *) &xs[0][(xr + XRPP * (i_)) * INK_PG_LDS_STRIDE + INK_PG_SWZ(xr + XRPP * (i_), xc)] = srcb_; } \
+            else { \
+                const uint32_t lo_ = ink_pg_bf16_rne(srcf_.x) | (ink_pg_bf16_rne(srcf_.y) << 16); \
+                const uint32_t hi_ = ink_pg_bf16_rne(srcf_.z) | (ink_pg_bf16_rne(srcf_.w) << 16); \
+                *(uint2 *) &xs[0][(xr + XRPP * (i_)) * INK_PG_LDS_STRIDE + INK_PG_SWZ(xr + XRPP * (i_), xc >> 1) + (xc & 1) * 4] = make_uint2(lo_, hi_); } } } while (0)
+#define INK_PG_SSTORE() do { \
+        INK_PG_XST(0, xf0, xb0); INK_PG_XST(1, xf1, xb1); INK_PG_XST(2, xf2, xb2); INK_PG_XST(3, xf3, xb3); \
+        *(uint4 *) &ws[0][wr * INK_PG_LDS_STRIDE + INK_PG_SWZ(wr, wc)] = wg0; \
+        if constexpr (WL > 1) { *(uint4 *) &ws[0][(wr + 64) * INK_PG_LDS_STRIDE + INK_PG_SWZ(wr + 64, wc)] = wg1; } \
+    } while (0)
+    (void) xrow_step;
+
+    ink_pg_v16f acc[WT][WN];
+#pragma unroll
+    for (int i = 0; i < WT; ++i) {
+#pragma unroll
+        for (int j = 0; j < WN; ++j) {
+#pragma unroll
+            for (int q = 0; q < 16; ++q) {
+                acc[i][j][q] = 0.0f;
+            }
+        }
+    }
+
+    const int nk = Kp / 32;
+    // single LDS buffer (more blocks per CU), next slab prefetched into registers during the MFMAs
+    INK_PG_GLOAD(0);
+    for (int kt = 0; kt < nk; ++kt) {
+        const int cur = 0;
+        INK_PG_SSTORE();
+        __syncthreads();
+        INK_PG_GLOAD((kt + 1 < nk ? kt + 1 : kt) * 32);
+        __builtin_amdgcn_sched_barrier(0);
+#pragma unroll
+        for (int kk = 0; kk < 2; ++kk) {
+            uint4 af[WT], bf[WN];
+#pragma unroll
+            for (int i = 0; i < WT; ++i) {
+                af[i] = *(const uint4 *) &xs[cur][(wt * 32 * WT + i * 32 + r) * INK_PG_LDS_STRIDE + INK_PG_SWZ(r, kk * 2 + h)];
+            }
+#pragma unroll
+            for (int j = 0; j < WN; ++j) {
+                bf[j] = *(const uint4 *) &ws[cur][(wn * 32 * WN + j * 32 + r) * INK_PG_LDS_STRIDE + INK_PG_SWZ(r, kk * 2 + h)];
+            }
+#pragma unroll
+            for (int i = 0; i < WT; ++i) {
+#pragma unroll
+                for (int j = 0; j < WN; ++j) {
+                    acc[i][j] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af[i].x, af[i].y),
+                        ink_pg_u2_to_v4s(bf[j].x, bf[j].y), acc[i][j], 0, 0, 0);
+                    acc[i][j] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af[i].z, af[i].w),
+                        ink_pg_u2_to_v4s(bf[j].z, bf[j].w), acc[i][j], 0, 0, 0);
+                }
+            }
+        }
+        __syncthreads();
+    }
+
+#pragma unroll
+    for (int i = 0; i < WT; ++i) {
+#pragma unroll
+        for (int j = 0; j < WN; ++j) {
+            const int n = n0 + wn * 32 * WN + j * 32 + r;
+#pragma unroll
+            for (int q = 0; q < 16; ++q) {
+                const int tt = t0 + wt * 32 * WT + i * 32 + ink_pg_acc_row(q, h);
+                if (tt < T && n < N) {
+                    D[(long) tt * ldd + n] = rbf16 ? ink_pg_round_bf16(acc[i][j][q]) : acc[i][j][q];
+                }
+            }
+        }
+    }
+}
+
+template <int WT, int WN, bool XBF16>
+static void ink_pg_tiled_run(const void * X, const uint16_t * W, float * D, int T, int N, int K, int P, hipStream_t st) {
+    const int ntn = (N + 64 * WN - 1) / (64 * WN);
+    const int ntt = (T + 64 * WT - 1) / (64 * WT);
+    ink_pg_tiled<WT, WN, XBF16><<<dim3(ntn * ntt, P), 256, 0, st>>>(X, W, D, T, N, K, K, K, N, K / P, (long) T * N);
+}
+
+// dst[i] = sum_{p < P} part[p*n + i] (fixed order, deterministic)
+__global__ void ink_pg_reduce(const float * __restrict__ part, float * __restrict__ dst, const int P, const long n4, const int rbf16 = 0) {
+    const long i = (long) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n4) {
+        return;
+    }
+    float4 s = ((const float4 *) part)[i];
+    for (int p = 1; p < P; ++p) {
+        const float4 v = ((const float4 *) part)[(long) p * n4 + i];
+        s.x += v.x; s.y += v.y; s.z += v.z; s.w += v.w;
+    }
+    if (rbf16) {
+        s.x = ink_pg_round_bf16(s.x); s.y = ink_pg_round_bf16(s.y); s.z = ink_pg_round_bf16(s.z); s.w = ink_pg_round_bf16(s.w);
+    }
+    ((float4 *) dst)[i] = s;
+}
+
+// BK = 64 variant for bf16 activations (large GEMMs): 256 threads (2x2 waves), wave tile (32*WT) x (32*WN),
+// single LDS buffer of 64-element rows with 16-byte chunks XOR-swizzled by row & 7, next slab prefetched in registers.
+// Requirements: K % 64 == 0, 16-byte aligned rows; tokens beyond T and rows beyond N are clamped / masked.
+#ifndef INK_PG_T64_WPE
+#define INK_PG_T64_WPE 2
+#endif
+#ifndef INK_PG_T64_GROUP
+#define INK_PG_T64_GROUP 8
+#endif
+#define INK_PG_SWZ64(row_, c_) (((c_) ^ ((row_) & 7)) * 8)
+template <int WT, int WN>
+__global__ void __launch_bounds__(256, INK_PG_T64_WPE) ink_pg_t64(const uint16_t * __restrict__ X, const uint16_t * __restrict__ W,
+        float * __restrict__ D, const int T, const int N, const int K, const long ldx, const long ldw, const long ldd,
+        const int rbf16 = 0) {
+    constexpr int BT = 64 * WT;
+    constexpr int BN = 64 * WN;
+    constexpr int XL = BT * 64 / 8 / 256;
+    constexpr int WL = BN * 64 / 8 / 256;
+    static_assert(XL >= 1 && WL >= 1 && XL <= 4 && WL <= 4, "tile");
+    __shared__ __attribute__((aligned(16))) uint16_t xs[BT * 64];
+    __shared__ __attribute__((aligned(16))) uint16_t ws[BN * 64];
+
+    const int tid  = threadIdx.x;
+    const int lane = tid & 63;
+    const int wv   = tid >> 6;
+    const int wt   = wv >> 1;
+    const int wn   = wv & 1;
+    const int r    = lane & 31;
+    const int h    = lane >> 5;
+
+    const int ntn = (N + BN - 1) / BN;
+    const int ntt = (T + BT - 1) / BT;
+    const int bid = blockIdx.x;
+    const int GROUP = INK_PG_T64_GROUP;
+    const int per_group = GROUP * ntn;
+    const int g = bid / per_group;
+    const int first_t = g * GROUP;
+    const int gsz = min(ntt - first_t, GROUP);
+    const int in_g = bid - g * per_group;
+    const int t0 = (first_t + in_g % gsz) * BT;
+    const int n0 = (in_g / gsz) * BN;
+
+    const int c  = tid & 7;   // 16-byte chunk within a 128-byte row
+    const int rr = tid >> 3;  // row within a 32-row pass
+    const uint16_t * xp[4];
+    const uint16_t * wp[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        int t = t0 + rr + 32 * i; t = t < T ? t : T - 1;
+        int n = n0 + rr + 32 * i; n = n < N ? n : N - 1;
+        xp[i] = X + (long) t * ldx + c * 8;
+        wp[i] = W + (long) n * ldw + c * 8;
+    }
+    uint4 xa0, xa1, xa2, xa3, wa0, wa1, wa2, wa3;
+#define INK_PG64_LOAD(k_) do { \
+        xa0 = *(const uint4 *) (xp[0] + (k_)); \
+        if constexpr (XL > 1) { xa1 = *(const uint4 *) (xp[1] + (k_)); } \
+        if constexpr (XL > 2) { xa2 = *(const uint4 *) (xp[2] + (k_)); xa3 = *(const uint4 *) (xp[3] + (k_)); } \
+        wa0 = *(const uint4 *) (wp[0] + (k_)); \
+        if constexpr (WL > 1) { wa1 = *(const uint4 *) (wp[1] + (k_)); } \
+        if constexpr (WL > 2) { wa2 = *(const uint4 *) (wp[2] + (k_)); wa3 = *(const uint4 *) (wp[3] + (k_)); } \
+    } while (0)
+#define INK_PG64_STORE() do { \
+        *(uint4 *) &xs[(rr +  0) * 64 + INK_PG_SWZ64(rr +  0, c)] = xa0; \
+        if constexpr (XL > 1) { *(uint4 *) &xs[(rr + 32) * 64 + INK_PG_SWZ64(rr + 32, c)] = xa1; } \
+        if constexpr (XL > 2) { *(uint4 *) &xs[(rr + 64) * 64 + INK_PG_SWZ64(rr + 64, c)] = xa2; \
+                                *(uint4 *) &xs[(rr + 96) * 64 + INK_PG_SWZ64(rr + 96, c)] = xa3; } \
+        *(uint4 *) &ws[(rr +  0) * 64 + INK_PG_SWZ64(rr +  0, c)] = wa0; \
+        if constexpr (WL > 1) { *(uint4 *) &ws[(rr + 32) * 64 + INK_PG_SWZ64(rr + 32, c)] = wa1; } \
+        if constexpr (WL > 2) { *(uint4 *) &ws[(rr + 64) * 64 + INK_PG_SWZ64(rr + 64, c)] = wa2; \
+                                *(uint4 *) &ws[(rr + 96) * 64 + INK_PG_SWZ64(rr + 96, c)] = wa3; } \
+    } while (0)
+
+    ink_pg_v16f acc[WT][WN];
+#pragma unroll
+    for (int i = 0; i < WT; ++i) {
+#pragma unroll
+        for (int j = 0; j < WN; ++j) {
+#pragma unroll
+            for (int q = 0; q < 16; ++q) {
+                acc[i][j][q] = 0.0f;
+            }
+        }
+    }
+
+    const int nk = K / 64;
+    INK_PG64_LOAD(0);
+    for (int kt = 0; kt < nk; ++kt) {
+        INK_PG64_STORE();
+        __syncthreads();
+        INK_PG64_LOAD((kt + 1 < nk ? kt + 1 : kt) * 64);
+        __builtin_amdgcn_sched_barrier(0);
+#pragma unroll
+        for (int kk = 0; kk < 4; ++kk) {
+            uint4 af[WT], bf[WN];
+#pragma unroll
+            for (int i = 0; i < WT; ++i) {
+                af[i] = *(const uint4 *) &xs[(wt * 32 * WT + i * 32 + r) * 64 + INK_PG_SWZ64(r, kk * 2 + h)];
+            }
+#pragma unroll
+            for (int j = 0; j < WN; ++j) {
+                bf[j] = *(const uint4 *) &ws[(wn * 32 * WN + j * 32 + r) * 64 + INK_PG_SWZ64(r, kk * 2 + h)];
+            }
+#pragma unroll
+            for (int i = 0; i < WT; ++i) {
+#pragma unroll
+                for (int j = 0; j < WN; ++j) {
+                    acc[i][j] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af[i].x, af[i].y),
+                        ink_pg_u2_to_v4s(bf[j].x, bf[j].y), acc[i][j], 0, 0, 0);
+                    acc[i][j] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af[i].z, af[i].w),
+                        ink_pg_u2_to_v4s(bf[j].z, bf[j].w), acc[i][j], 0, 0, 0);
+                }
+            }
+        }
+        __syncthreads();
+    }
+#undef INK_PG64_LOAD
+#undef INK_PG64_STORE
+
+#pragma unroll
+    for (int i = 0; i < WT; ++i) {
+#pragma unroll
+        for (int j = 0; j < WN; ++j) {
+            const int n = n0 + wn * 32 * WN + j * 32 + r;
+#pragma unroll
+            for (int q = 0; q < 16; ++q) {
+                const int tt = t0 + wt * 32 * WT + i * 32 + ink_pg_acc_row(q, h);
+                if (tt < T && n < N) {
+                    const float v = acc[i][j][q];
+                    D[(long) tt * ldd + n] = rbf16 ? ink_pg_round_bf16(v) : v;
+                }
+            }
+        }
+    }
+}
+
+template <int WT, int WN>
+static void ink_pg_t64_run(const uint16_t * X, const uint16_t * W, float * D, int T, int N, int K, hipStream_t st) {
+    const int ntn = (N + 64 * WN - 1) / (64 * WN);
+    const int ntt = (T + 64 * WT - 1) / (64 * WT);
+    ink_pg_t64<WT, WN><<<ntn * ntt, 256, 0, st>>>(X, W, D, T, N, K, K, K, N);
+}
+
+// skinny / split-K variant with BK = 64 and f32 activations: block tile 64 tokens x 64 rows (2x2 waves of 32x32),
+// X staged with RNE to bf16, blockIdx.y = K split (partials to D + p*dsplit). Requirements: Kp % 64 == 0.
+__global__ void __launch_bounds__(256, 4) ink_pg_d64(const float * __restrict__ X, const uint16_t * __restrict__ W,
+        float * __restrict__ D, const int T, const int N, const long ldx, const long ldw, const long ldd,
+        const int Kp, const long dsplit) {
+    __shared__ __attribute__((aligned(16))) uint16_t xs[64 * 64];
+    __shared__ __attribute__((aligned(16))) uint16_t ws[64 * 64];
+    const int tid  = threadIdx.x;
+    const int lane = tid & 63;
+    const int wv   = tid >> 6;
+    const int wt   = wv >> 1;
+    const int wn   = wv & 1;
+    const int r    = lane & 31;
+    const int h    = lane >> 5;
+    const int ntn  = (N + 63) / 64;
+    const int t0   = (blockIdx.x / ntn) * 64;
+    const int n0   = (blockIdx.x % ntn) * 64;
+    const int kb   = blockIdx.y * Kp;
+    D += (long) blockIdx.y * dsplit;
+
+    const int xc = tid & 15;  // float4 column (16 per 64-float row)
+    const int xr = tid >> 4;  // 16 rows per pass
+    const float * xp[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        int t = t0 + xr + 16 * i; t = t < T ? t : T - 1;
+        xp[i] = X + (long) t * ldx + kb + xc * 4;
+    }
+    const int wc = tid & 7;
+    const int wr = tid >> 3;
+    const uint16_t * wq[2];
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        int n = n0 + wr + 32 * i; n = n < N ? n : N - 1;
+        wq[i] = W + (long) n * ldw + kb + wc * 8;
+    }
+    float4 x0, x1, x2, x3;
+    uint4 w0, w1;
+    ink_pg_v16f acc;
+#pragma unroll
+    for (int q = 0; q < 16; ++q) {
+        acc[q] = 0.0f;
+    }
+#define INK_PGD_LOAD(k_) do { x0 = *(const float4 *) (xp[0] + (k_)); x1 = *(const float4 *) (xp[1] + (k_)); \
+        x2 = *(const float4 *) (xp[2] + (k_)); x3 = *(const float4 *) (xp[3] + (k_)); \
+        w0 = *(const uint4 *) (wq[0] + (k_)); w1 = *(const uint4 *) (wq[1] + (k_)); } while (0)
+#define INK_PGD_XST(i_, v_) do { const int row_ = xr + 16 * (i_); \
+        const uint32_t lo_ = ink_pg_bf16_rne(v_.x) | (ink_pg_bf16_rne(v_.y) << 16); \
+        const uint32_t hi_ = ink_pg_bf16_rne(v_.z) | (ink_pg_bf16_rne(v_.w) << 16); \
+        *(uint2 *) &xs[row_ * 64 + INK_PG_SWZ64(row_, xc >> 1) + (xc & 1) * 4] = make_uint2(lo_, hi_); } while (0)
+    const int nk = Kp / 64;
+    INK_PGD_LOAD(0);
+    for (int kt = 0; kt < nk; ++kt) {
+        INK_PGD_XST(0, x0); INK_PGD_XST(1, x1); INK_PGD_XST(2, x2); INK_PGD_XST(3, x3);
+        *(uint4 *) &ws[wr * 64 + INK_PG_SWZ64(wr, wc)] = w0;
+        *(uint4 *) &ws[(wr + 32) * 64 + INK_PG_SWZ64(wr + 32, wc)] = w1;
+        __syncthreads();
+        INK_PGD_LOAD((kt + 1 < nk ? kt + 1 : kt) * 64);
+        __builtin_amdgcn_sched_barrier(0);
+#pragma unroll
+        for (int kk = 0; kk < 4; ++kk) {
+            const uint4 af = *(const uint4 *) &xs[(wt * 32 + r) * 64 + INK_PG_SWZ64(r, kk * 2 + h)];
+            const uint4 bf = *(const uint4 *) &ws[(wn * 32 + r) * 64 + INK_PG_SWZ64(r, kk * 2 + h)];
+            acc = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af.x, af.y), ink_pg_u2_to_v4s(bf.x, bf.y), acc, 0, 0, 0);
+            acc = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af.z, af.w), ink_pg_u2_to_v4s(bf.z, bf.w), acc, 0, 0, 0);
+        }
+        __syncthreads();
+    }
+#undef INK_PGD_LOAD
+#undef INK_PGD_XST
+    const int n = n0 + wn * 32 + r;
+#pragma unroll
+    for (int q = 0; q < 16; ++q) {
+        const int tt = t0 + wt * 32 + ink_pg_acc_row(q, h);
+        if (tt < T && n < N) {
+            D[(long) tt * ldd + n] = acc[q];
+        }
+    }
+}
+
+// ink_pg_t64 with 8 waves (512 threads): block tile 128 x 128, waves 2 (tokens) x 4 (rows), wave tile 64 x 32.
+// Same per-element arithmetic as ink_pg_t64<2,2> (bit-identical results), twice the waves per block for latency hiding.
+// EPI = 2 (p7-dense, loop gain + forget): grid of 2*nb1 blocks, the second half computes W2 -> D2.
+// EPI = 1 (p7-dense, gate projection fused with SIGMOID and MUL(attn, .)): instead of D the kernel writes
+// Db[t*lddb + n] = bf16_rne(op_sigmoid(v) * A[t*lda + n]) with v the (rbf16-rounded) result, i.e. exactly the f32->bf16
+// conversion of what unary_gated_op_kernel<op_sigmoid, float> would have stored (the activation of the o projection).
+static __device__ __forceinline__ float ink_pg_op_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x));  // = op_sigmoid in unary.cu
+}
+template <int EPI = 0>
+__global__ void __launch_bounds__(512, 2) ink_pg_t64w8(const uint16_t * __restrict__ X, const uint16_t * __restrict__ W,
+        float * __restrict__ D, const int T, const int N, const int K, const long ldx, const long ldw, const long ldd,
+        const int rbf16, const float * __restrict__ A = nullptr, const long lda = 0, uint16_t * __restrict__ Db = nullptr,
+        const uint16_t * __restrict__ W2 = nullptr, float * __restrict__ D2 = nullptr, const int nb1 = 0) {
+    __shared__ __attribute__((aligned(16))) uint16_t xs[128 * 64];
+    __shared__ __attribute__((aligned(16))) uint16_t ws[128 * 64];
+    const int tid  = threadIdx.x;
+    const int lane = tid & 63;
+    const int wv   = tid >> 6;
+    const int wt   = wv >> 2;   // 0..1: 64-token half
+    const int wn   = wv & 3;    // 0..3: 32-row quarter
+    const int r    = lane & 31;
+    const int h    = lane >> 5;
+
+    const int ntn = (N + 127) / 128;
+    const int ntt = (T + 127) / 128;
+    int bid = blockIdx.x;
+    if constexpr (EPI == 2) {
+        // two GEMMs on the same activation (same N, K): blocks [nb1, 2*nb1) compute W2 -> D2
+        if (bid >= nb1) {
+            bid -= nb1;
+            W = W2;
+            D = D2;
+        }
+    }
+    const int GROUP = INK_PG_T64_GROUP;
+    const int per_group = GROUP * ntn;
+    const int g = bid / per_group;
+    const int first_t = g * GROUP;
+    const int gsz = min(ntt - first_t, GROUP);
+    const int in_g = bid - g * per_group;
+    const int t0 = (first_t + in_g % gsz) * 128;
+    const int n0 = (in_g / gsz) * 128;
+
+    const int c  = tid & 7;
+    const int rr = tid >> 3;   // 0..63
+    int ta = t0 + rr;      ta = ta < T ? ta : T - 1;
+    int tb = t0 + rr + 64; tb = tb < T ? tb : T - 1;
+    int na = n0 + rr;      na = na < N ? na : N - 1;
+    int nb = n0 + rr + 64; nb = nb < N ? nb : N - 1;
+    const uint16_t * xpa = X + (long) ta * ldx + c * 8;
+    const uint16_t * xpb = X + (long) tb * ldx + c * 8;
+    const uint16_t * wpa = W + (long) na * ldw + c * 8;
+    const uint16_t * wpb = W + (long) nb * ldw + c * 8;
+    uint4 xa0, xa1, wa0, wa1;
+
+    ink_pg_v16f acc[2];
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+#pragma unroll
+        for (int q = 0; q < 16; ++q) {
+            acc[i][q] = 0.0f;
+        }
+    }
+    const int nk = K / 64;
+    xa0 = *(const uint4 *) xpa; xa1 = *(const uint4 *) xpb; wa0 = *(const uint4 *) wpa; wa1 = *(const uint4 *) wpb;
+    for (int kt = 0; kt < nk; ++kt) {
+        *(uint4 *) &xs[(rr +  0) * 64 + INK_PG_SWZ64(rr +  0, c)] = xa0;
+        *(uint4 *) &xs[(rr + 64) * 64 + INK_PG_SWZ64(rr + 64, c)] = xa1;
+        *(uint4 *) &ws[(rr +  0) * 64 + INK_PG_SWZ64(rr +  0, c)] = wa0;
+        *(uint4 *) &ws[(rr + 64) * 64 + INK_PG_SWZ64(rr + 64, c)] = wa1;
+        __syncthreads();
+        const int kn = (kt + 1 < nk ? kt + 1 : kt) * 64;
+        xa0 = *(const uint4 *) (xpa + kn); xa1 = *(const uint4 *) (xpb + kn);
+        wa0 = *(const uint4 *) (wpa + kn); wa1 = *(const uint4 *) (wpb + kn);
+        __builtin_amdgcn_sched_barrier(0);
+#pragma unroll
+        for (int kk = 0; kk < 4; ++kk) {
+            uint4 af[2];
+#pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                af[i] = *(const uint4 *) &xs[(wt * 64 + i * 32 + r) * 64 + INK_PG_SWZ64(r, kk * 2 + h)];
+            }
+            const uint4 bf = *(const uint4 *) &ws[(wn * 32 + r) * 64 + INK_PG_SWZ64(r, kk * 2 + h)];
+#pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                acc[i] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af[i].x, af[i].y),
+                    ink_pg_u2_to_v4s(bf.x, bf.y), acc[i], 0, 0, 0);
+                acc[i] = __builtin_amdgcn_mfma_f32_32x32x8bf16_1k(ink_pg_u2_to_v4s(af[i].z, af[i].w),
+                    ink_pg_u2_to_v4s(bf.z, bf.w), acc[i], 0, 0, 0);
+            }
+        }
+        __syncthreads();
+    }
+    const int n = n0 + wn * 32 + r;
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+#pragma unroll
+        for (int q = 0; q < 16; ++q) {
+            const int tt = t0 + wt * 64 + i * 32 + ink_pg_acc_row(q, h);
+            if (tt < T && n < N) {
+                const float v = acc[i][q];
+                if constexpr (EPI == 1) {
+                    const float g = rbf16 ? ink_pg_round_bf16(v) : v;
+                    const float o = ink_pg_op_sigmoid(g) * A[(long) tt * lda + n];
+                    Db[(long) tt * ldd + n] = (uint16_t) ink_pg_bf16_rne(o);
+                } else {
+                    D[(long) tt * ldd + n] = rbf16 ? ink_pg_round_bf16(v) : v;
+                }
+            }
+        }
+    }
+}
diff --git a/ggml/src/ggml-cuda/inkling-pfgemm.cu b/ggml/src/ggml-cuda/inkling-pfgemm.cu
new file mode 100644
index 0000000..d943a32
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-pfgemm.cu
@@ -0,0 +1,574 @@
+// Inkling-2 prefill dense BF16 GEMMs (MI210 work, p6-dense). See inkling-pfgemm.cuh.
+#include "inkling-pfgemm.cuh"
+#include "convert.cuh"
+#include "inkling-pfgemm-kern.cuh"
+#include "inkling-fuse.cuh" // p7-dense: ggml_cuda_inkling_defer_skip / skip_pending
+#include "graph.cuh"     // p7-dense: ggml_cuda_stream_context
+#include "ggml-impl.h"
+
+#include <cstdlib>
+#include <cstdint>
+
+static int ink_pg_env(const char * name, int def) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : def;
+}
+
+static int ink_pg_enabled() {
+    static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM", 1);
+    return v;
+}
+
+// bitmask of features (default all on):
+//   GGML_CUDA_INK_PFGEMM_CACHE=0   no shared activation conversion
+//   GGML_CUDA_INK_PFGEMM_F32OUT=0  keep the bf16 dst + conversion for the large GEMMs
+//   GGML_CUDA_INK_PFGEMM_SK=0      no custom skinny kernel (1 = BK=64 split-K kernel, 2 = first BK=32 version)
+static int ink_pg_cache_on()  { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_CACHE", 1);  return v; }
+static int ink_pg_f32out_on() { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_F32OUT", 1); return v; }
+static int ink_pg_sk_on()     { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_SK", 1);     return v; }
+//   GGML_CUDA_INK_PFGEMM_T64=0     q/gate on rocBLAS instead of the BK=64 tiled kernel
+static int ink_pg_t64_on()    { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_T64", 1);    return v; }
+//   GGML_CUDA_INK_PFGEMM_RBF16     1 (default, fidelity mode): the custom kernels round their f32 results to bf16
+//                                  precision (what the original bf16-dst rocBLAS path stores) and the large GEMMs keep
+//                                  the bf16 dst (t64 takes q/gate/o/gain/forget); kld8 ub2048 same-top-p 98.338%.
+//                                  0 (precision mode): unrounded f32 results + f32-dst rocBLAS: more precise, ~0.3%
+//                                  faster, but further from the original numerics (same-top-p 98.13-98.39% < 98.3 bar).
+static int ink_pg_rbf16()     { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_RBF16", 1);  return v; }
+// minimum number of weight rows for the f32-output rocBLAS GEMM (measured: BSS loses to BBS+convert below ~1024)
+static int ink_pg_f32out_min_n() { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_F32OUT_MIN_N", 1024); return v; }
+
+//   GGML_CUDA_INK_PFGEMM_GATEO=0   p7-dense: no gate-projection epilogue fusion (gate MUL_MAT + SIGMOID + MUL(attn, .) +
+//                                  f32->bf16 conversion of the o-projection activation in one kernel; bit-identical)
+static int ink_pg_gateo_on()  { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_GATEO", 0);  return v; }
+//   GGML_CUDA_INK_PFGEMM_PAIR=0    p7-dense: no merged launch of two GEMMs on the same activation (loop forget + gain;
+//                                  the later one is computed early when its dst is untouched in between; bit-identical)
+static int ink_pg_pair_on()   { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_PAIR", 1);   return v; }
+static int ink_pg_stats_on()  { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_STATS", 0);  return v; }
+
+static uint64_t ink_pg_gen = 1;
+
+// p7-dense: the graph being evaluated (node-level fusions look ahead from the MUL_MAT being computed)
+static const ggml_cgraph * ink_pg_graph  = nullptr;
+static int                 ink_pg_cursor = 0;
+static long long           ink_pg_hits_gateo = 0, ink_pg_miss_gateo = 0, ink_pg_hits_pair = 0, ink_pg_miss_pair = 0;
+
+static void ink_pg_print_stats() {
+    fprintf(stderr, "ink pfgemm: gateo=%lld (declined %lld) pair=%lld (declined %lld)\n", ink_pg_hits_gateo, ink_pg_miss_gateo,
+            ink_pg_hits_pair, ink_pg_miss_pair);
+}
+
+void ggml_cuda_ink_pfgemm_begin(const ggml_cgraph * cgraph) {
+    ++ink_pg_gen;
+    ink_pg_graph  = cgraph;
+    ink_pg_cursor = 0;
+    static bool reg = false;
+    if (!reg && ink_pg_stats_on()) {
+        reg = true;
+        atexit(ink_pg_print_stats);
+    }
+}
+
+// index of node t in the current graph (nodes run in order: search forward from the last hit), or -1
+static int ink_pg_find(const ggml_tensor * t) {
+    const ggml_cgraph * g = ink_pg_graph;
+    if (g == nullptr) {
+        return -1;
+    }
+    const int n = g->n_nodes;
+    for (int k = ink_pg_cursor; k < n; ++k) {
+        if (g->nodes[k] == t) {
+            ink_pg_cursor = k;
+            return k;
+        }
+    }
+    for (int k = 0; k < ink_pg_cursor && k < n; ++k) {
+        if (g->nodes[k] == t) {
+            ink_pg_cursor = k;
+            return k;
+        }
+    }
+    return -1;
+}
+
+static int ink_pg_next(const ggml_cgraph * g, int k) {
+    for (++k; k < g->n_nodes; ++k) {
+        const ggml_tensor * t = g->nodes[k];
+        if (t->op == GGML_OP_NONE || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE ||
+            t->op == GGML_OP_TRANSPOSE || ggml_is_empty(t)) {
+            continue;
+        }
+        return k;
+    }
+    return -1;
+}
+
+struct ink_pg_cache {
+    void *              buf  = nullptr;
+    size_t              cap  = 0;
+    const ggml_tensor * t    = nullptr;
+    const void *        data = nullptr;
+    int64_t             ne0  = 0;
+    int64_t             ne1  = 0;
+    uint64_t            gen  = 0;
+    cudaStream_t        stream = nullptr;  // owner: the buffer is only ever used on this stream
+    bool                captured = false;  // p7-host: buf is referenced by a captured graph, never free it
+    // p7-dense: second buffer holding a bf16 activation produced by a fused epilogue (pending until its MUL_MAT runs)
+    void *              buf2   = nullptr;
+    size_t              cap2   = 0;
+    const ggml_tensor * p_t    = nullptr;
+    const void *        p_data = nullptr;
+    uint64_t            p_gen  = 0;
+};
+
+// p7-host: GGML_CUDA_INK_PFGEMM_CAPCACHE=0 restores the uncached conversion while a graph is captured
+static int ink_pg_capcache_on() { static const int v = ink_pg_env("GGML_CUDA_INK_PFGEMM_CAPCACHE", 1); return v; }
+
+// one cache per (device, stream): several contexts (e.g. a draft / MTP context) may run on other streams
+#define INK_PG_CACHE_SLOTS 4
+static ink_pg_cache ink_pg_caches[GGML_CUDA_MAX_DEVICES][INK_PG_CACHE_SLOTS];
+
+// bf16 copy of the f32 activation src1 (contiguous, ne10 x ne11). Uses the cache when allowed, else the pool.
+// the cache slot of (device, stream), or nullptr (cache off, stream capture, no free slot)
+static ink_pg_cache * ink_pg_slot(ggml_backend_cuda_context & ctx, bool allow_capture = false, bool * capturing = nullptr) {
+    cudaStream_t stream = ctx.stream();
+    bool use_cache = ink_pg_cache_on() != 0 && ctx.device >= 0 && ctx.device < GGML_CUDA_MAX_DEVICES;
+    if (capturing) {
+        *capturing = false;
+    }
+    if (use_cache) {
+#if defined(GGML_USE_HIP)
+        hipStreamCaptureStatus st = hipStreamCaptureStatusNone;
+        if (hipStreamIsCapturing(stream, &st) != hipSuccess || st != hipStreamCaptureStatusNone) {
+#else
+        cudaStreamCaptureStatus st = cudaStreamCaptureStatusNone;
+        if (cudaStreamIsCapturing(stream, &st) != cudaSuccess || st != cudaStreamCaptureStatusNone) {
+#endif
+            (void) cudaGetLastError();
+            // p7-host: during a capture only the activation cache may be used (existing buffer, no allocation)
+            if (capturing) {
+                *capturing = true;
+            }
+            use_cache = allow_capture && ink_pg_capcache_on() != 0;
+        }
+    }
+    ink_pg_cache * cp = nullptr;
+    if (use_cache) {
+        for (int s = 0; s < INK_PG_CACHE_SLOTS && cp == nullptr; ++s) {
+            if (ink_pg_caches[ctx.device][s].stream == stream) {
+                cp = &ink_pg_caches[ctx.device][s];
+            }
+        }
+        for (int s = 0; s < INK_PG_CACHE_SLOTS && cp == nullptr; ++s) {
+            if (ink_pg_caches[ctx.device][s].stream == nullptr && ink_pg_caches[ctx.device][s].buf == nullptr) {
+                cp = &ink_pg_caches[ctx.device][s];
+                cp->stream = stream;
+            }
+        }
+    }
+    return cp;
+}
+
+static const nv_bfloat16 * ink_pg_src1_bf16(ggml_backend_cuda_context & ctx, const ggml_tensor * src1,
+        ggml_cuda_pool_alloc<nv_bfloat16> & tmp) {
+    const int64_t n = ggml_nelements(src1);
+    cudaStream_t stream = ctx.stream();
+    const to_bf16_cuda_t to_bf16 = ggml_get_to_bf16_cuda(GGML_TYPE_F32);
+
+    bool capturing = false; // p7-host
+    ink_pg_cache * cp = ink_pg_slot(ctx, true, &capturing);
+    // p7-dense: activation already produced in bf16 by a fused epilogue
+    if (cp != nullptr && cp->p_t == src1 && cp->p_data == src1->data && cp->p_gen == ink_pg_gen && cp->buf2 != nullptr) {
+        cp->p_t = nullptr;
+        return (const nv_bfloat16 *) cp->buf2;
+    }
+    const bool use_cache = cp != nullptr;
+    if (!use_cache) {
+        tmp.alloc(n);
+        to_bf16(src1->data, tmp.get(), n, stream);
+        return tmp.get();
+    }
+
+    ink_pg_cache & c = *cp;
+    if (c.gen == ink_pg_gen && c.t == src1 && c.data == src1->data && c.ne0 == src1->ne[0] && c.ne1 == src1->ne[1] &&
+            c.buf != nullptr) {
+        c.captured = c.captured || capturing; // p7-host
+        return (const nv_bfloat16 *) c.buf;
+    }
+    const size_t need = (size_t) n * sizeof(nv_bfloat16);
+    if (need > c.cap && capturing) { // p7-host: no allocation inside a capture
+        tmp.alloc(n);
+        to_bf16(src1->data, tmp.get(), n, stream);
+        return tmp.get();
+    }
+    if (need > c.cap) {
+        if (c.buf) {
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+            if (!c.captured) { // p7-host: a buffer that a captured graph uses stays allocated
+                CUDA_CHECK(cudaFree(c.buf));
+            }
+            c.buf = nullptr;
+            c.cap = 0;
+            c.captured = false;
+        }
+        const size_t cap = need + need / 4;
+        if (cudaMalloc(&c.buf, cap) != cudaSuccess) {
+            (void) cudaGetLastError();
+            c.buf = nullptr;
+            c.gen = 0;
+            tmp.alloc(n);
+            to_bf16(src1->data, tmp.get(), n, stream);
+            return tmp.get();
+        }
+        c.cap = cap;
+    }
+    c.captured = c.captured || capturing; // p7-host
+    to_bf16(src1->data, (nv_bfloat16 *) c.buf, n, stream);
+    c.t    = src1;
+    c.data = src1->data;
+    c.ne0  = src1->ne[0];
+    c.ne1  = src1->ne[1];
+    c.gen  = ink_pg_gen;
+    return (const nv_bfloat16 *) c.buf;
+}
+
+static bool ink_pg_aligned16(const void * p) {
+    return ((uintptr_t) p & 15) == 0;
+}
+
+// custom skinny GEMM (few weight rows, long K: the loop_*_down projections N=64, K=4608): LDS-tiled MFMA kernel
+// reading the f32 activation directly (bf16 RNE rounding while staging, like the conversion it replaces), split-K
+// over P blocks into a pool workspace, then a fixed-order reduction. Returns false when the shape is not covered.
+// pgbench T=2048 N=64 K=4608: 69 us vs 106 us (54 conversion + 49 rocBLAS + 3 bf16->f32).
+static bool ink_pg_skinny_launch(ggml_backend_cuda_context & ctx, const void * w, const void * x, void * d,
+        int T, int N, int K, cudaStream_t stream) {
+    if (N > 64 || N % 4 != 0 || K < 2048 || K % 128 != 0) {
+        return false;
+    }
+    const int ntt = (T + 63) / 64;
+    int P = 4;
+    if (ink_pg_sk_on() == 2) {
+        // BK=32 kernel (first version)
+        if (ntt * P < 128 && K % 256 == 0) {
+            P = 8;
+        }
+        ggml_cuda_pool_alloc<float> ws(ctx.pool(), (size_t) P * T * N);
+        ink_pg_tiled<1, 1, false><<<dim3(ntt, P), 256, 0, stream>>>(x, (const uint16_t *) w, ws.get(), T, N, K,
+            (long) K, (long) K, (long) N, K / P, (long) T * N);
+        const long n4 = (long) T * N / 4;
+        ink_pg_reduce<<<(unsigned) ((n4 + 255) / 256), 256, 0, stream>>>(ws.get(), (float *) d, P, n4);
+        return true;
+    }
+    // BK=64 kernel ink_pg_d64 (64x64 tiles), split-K into ~192 blocks, P a divisor of K/64 in [2, 12].
+    // pgbench (us) down K=4608: T=2048 45.5 (P=6) vs 72 (BK=32), T=1024 28.5 (P=12) vs 41, T=512 21.0 vs 28;
+    // sink K=2304: T=2048 25.8 vs 35 (rocBLAS 38 + bf16->f32 2.5), T=512 11.5 vs 14.5.
+    {
+        const int ntn = (N + 63) / 64;
+        const int nks = K / 64;
+        int target = (192 + ntt * ntn / 2) / (ntt * ntn);
+        target = target < 2 ? 2 : (target > 12 ? 12 : target);
+        P = 1;
+        for (int p = target; p >= 1; --p) {
+            if (nks % p == 0) {
+                P = p;
+                break;
+            }
+        }
+    }
+    ggml_cuda_pool_alloc<float> ws(ctx.pool(), (size_t) P * T * N);
+    ink_pg_d64<<<dim3(ntt * ((N + 63) / 64), P), 256, 0, stream>>>((const float *) x, (const uint16_t *) w, ws.get(), T, N,
+        (long) K, (long) K, (long) N, K / P, (long) T * N);
+    const long n4 = (long) T * N / 4;
+    ink_pg_reduce<<<(unsigned) ((n4 + 255) / 256), 256, 0, stream>>>(ws.get(), (float *) d, P, n4, ink_pg_rbf16());
+    return true;
+}
+
+// shapes / types the hook claims (ggml_cuda_ink_pfgemm returns true exactly for these)
+static bool ink_pg_accepts(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (!ink_pg_enabled()) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_BF16 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    // only claim what the original path computes in BF16 (ggml_cuda_mul_mat_cublas): an F32 accumulation request
+    // (e.g. the LM head, ggml_prec_set_acc(cur, GGML_PREC_F32)) or a forced cuBLAS compute type keeps the old path
+    {
+        const ggml_prec acc = ggml_prec_get_acc(dst);
+        if (acc != GGML_PREC_UNDEFINED && acc <= GGML_PREC_F32) {
+            return false;
+        }
+        static const bool forced_ct = getenv("GGML_CUDA_CUBLAS_COMPUTE_TYPE") != nullptr;
+        if (forced_ct || !fast_bf16_hardware_available(ggml_cuda_info().devices[ctx.device].cc)) {
+            return false;
+        }
+    }
+    const int64_t K = src0->ne[0];
+    const int64_t N = src0->ne[1];
+    const int64_t T = src1->ne[1];
+    if (T < 64 || src1->ne[0] != K || dst->ne[0] != N || dst->ne[1] != T) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || dst->ne[2] != 1 || dst->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    if (K % 16 != 0 || N < 1 || !ink_pg_aligned16(src0->data) || !ink_pg_aligned16(src1->data) || !ink_pg_aligned16(dst->data)) {
+        return false;
+    }
+    if (T > INT32_MAX || N > INT32_MAX || K > INT32_MAX) {
+        return false;
+    }
+    return true;
+}
+
+static bool ink_pg_contig_f32_2d(const ggml_tensor * t, int64_t ne0, int64_t ne1) {
+    return t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && t->ne[0] == ne0 && t->ne[1] == ne1 && t->ne[2] == 1 &&
+           t->ne[3] == 1 && ((uintptr_t) t->data & 15) == 0;
+}
+
+// p7-dense GATEO: dst = gate MUL_MAT followed by SIGMOID(dst) and MUL(attn, SIGMOID) whose only consumer is the o-projection
+// MUL_MAT (also claimed by this hook). Returns the MUL node and the attention output, or nullptr.
+static const ggml_tensor * ink_pg_gateo_match(ggml_backend_cuda_context & ctx, const ggml_tensor * dst, const ggml_tensor ** attn) {
+    if (!ink_pg_gateo_on() || !ctx.stream_context().concurrent_events.empty()) {
+        if (ink_pg_stats_on() > 1) fprintf(stderr, "gateo: %s concurrent\n", dst->name);
+        return nullptr;
+    }
+    const ggml_cgraph * g = ink_pg_graph;
+    const int i = ink_pg_find(dst);
+    if (i < 0) {
+        if (ink_pg_stats_on() > 1) fprintf(stderr, "gateo: %s not found\n", dst->name);
+        return nullptr;
+    }
+    const int j1 = ink_pg_next(g, i);
+    const int j2 = j1 < 0 ? -1 : ink_pg_next(g, j1);
+    const int j3 = j2 < 0 ? -1 : ink_pg_next(g, j2);
+    if (j3 < 0) {
+        if (ink_pg_stats_on() > 1) fprintf(stderr, "gateo: %s j3\n", dst->name);
+        return nullptr;
+    }
+    const ggml_tensor * sig = g->nodes[j1];
+    const ggml_tensor * mul = g->nodes[j2];
+    const ggml_tensor * o   = g->nodes[j3];
+    if (sig->op != GGML_OP_UNARY || ggml_get_unary_op(sig) != GGML_UNARY_OP_SIGMOID || sig->src[0] != dst ||
+        mul->op != GGML_OP_MUL || (mul->src[0] != sig && mul->src[1] != sig) || mul->src[0] == mul->src[1] ||
+        o->op != GGML_OP_MUL_MAT || o->src[1] != mul) {
+        if (ink_pg_stats_on() > 1 && dst->ne[0] == 3072) fprintf(stderr, "gateo: %s pattern %s %s %s\n", dst->name, sig->name, mul->name, o->name);
+        return nullptr;
+    }
+    const ggml_tensor * a = mul->src[0] == sig ? mul->src[1] : mul->src[0];
+    const int64_t N = dst->ne[0];
+    const int64_t T = dst->ne[1];
+    if (!ink_pg_contig_f32_2d(sig, N, T) || !ink_pg_contig_f32_2d(mul, N, T) || !ink_pg_contig_f32_2d(a, N, T)) {
+        return nullptr;
+    }
+    // the f32 results of the gate MUL_MAT, the SIGMOID and the MUL are never materialized: single use, not outputs
+    const int mask = GGML_TENSOR_FLAG_OUTPUT;
+    if ((dst->flags & mask) || (sig->flags & mask) || (mul->flags & mask) ||
+        ggml_node_get_use_count(g, i) != 1 || ggml_node_get_use_count(g, j1) != 1 || ggml_node_get_use_count(g, j2) != 1) {
+        if (ink_pg_stats_on() > 1) fprintf(stderr, "gateo: %s uses %d %d %d flags %d %d %d\n", dst->name, ggml_node_get_use_count(g, i),
+            ggml_node_get_use_count(g, j1), ggml_node_get_use_count(g, j2), dst->flags, sig->flags, mul->flags);
+        return nullptr;
+    }
+    if (!(sig->flags & GGML_TENSOR_FLAG_COMPUTE) || !(mul->flags & GGML_TENSOR_FLAG_COMPUTE) || !(o->flags & GGML_TENSOR_FLAG_COMPUTE) ||
+        ggml_cuda_inkling_skip_pending(sig) || ggml_cuda_inkling_skip_pending(mul) || ggml_cuda_inkling_skip_pending(o)) {
+        if (ink_pg_stats_on() > 1) fprintf(stderr, "gateo: %s compute/skip\n", dst->name);
+        return nullptr;
+    }
+    // o must run through this hook on the shared bf16 activation (not the skinny f32 kernel)
+    if (!ink_pg_accepts(ctx, o->src[0], mul, o) || o->src[0]->ne[1] <= 64) {
+        if (ink_pg_stats_on() > 1) fprintf(stderr, "gateo: %s o not accepted\n", dst->name);
+        return nullptr;
+    }
+    *attn = a;
+    return mul;
+}
+
+static bool ink_pg_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (a == nullptr || b == nullptr || a->data == nullptr || b->data == nullptr) {
+        return false;
+    }
+    const char * a0 = (const char *) a->data;
+    const char * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+// p7-dense PAIR: a later MUL_MAT (within a few nodes) on the same activation with the same weight shape (loop forget at
+// node i, gain at i+4), computed now in the same launch. Its dst must be neither read nor written by the nodes in between.
+static ggml_tensor * ink_pg_pair_match(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    if (!ink_pg_pair_on() || !ctx.stream_context().concurrent_events.empty()) {
+        return nullptr;
+    }
+    const ggml_cgraph * g = ink_pg_graph;
+    const int i = ink_pg_find(dst);
+    if (i < 0) {
+        return nullptr;
+    }
+    int j = i;
+    ggml_tensor * m = nullptr;
+    for (int q = 0; q < 6; ++q) {
+        j = ink_pg_next(g, j);
+        if (j < 0) {
+            return nullptr;
+        }
+        ggml_tensor * c = g->nodes[j];
+        if (c->op == GGML_OP_MUL_MAT && c->src[1] == src1) {
+            m = c;
+            break;
+        }
+    }
+    if (m == nullptr) {
+        return nullptr;
+    }
+    const ggml_tensor * w = m->src[0];
+    if (w->type != src0->type || !ggml_are_same_shape(w, src0) || !ggml_are_same_shape(m, dst) || m->type != dst->type ||
+        !ggml_is_contiguous(m) || !(m->flags & GGML_TENSOR_FLAG_COMPUTE) || ggml_cuda_inkling_skip_pending(m) ||
+        !ink_pg_accepts(ctx, w, src1, m) || ink_pg_overlap(m, src1) || ink_pg_overlap(m, dst)) {
+        return nullptr;
+    }
+    // nodes in (i, j): must not touch m's dst (it is written now instead of at j)
+    for (int k = i + 1; k < j; ++k) {
+        const ggml_tensor * nd = g->nodes[k];
+        if (ink_pg_overlap(nd, m)) {
+            if (ink_pg_stats_on() > 1) fprintf(stderr, "pair: %s dst overlaps node %s\n", m->name, nd->name);
+            return nullptr;
+        }
+        for (int q = 0; q < GGML_MAX_SRC; ++q) {
+            if (nd->src[q] && ink_pg_overlap(nd->src[q], m)) {
+                if (ink_pg_stats_on() > 1) fprintf(stderr, "pair: %s dst overlaps src of %s\n", m->name, nd->name);
+                return nullptr;
+            }
+        }
+    }
+    return m;
+}
+
+// bf16 activation buffer for a fused epilogue (slot buf2), or nullptr
+static uint16_t * ink_pg_buf2(ggml_backend_cuda_context & ctx, ink_pg_cache * cp, size_t n) {
+    const size_t need = n * sizeof(uint16_t);
+    if (need > cp->cap2) {
+        if (cp->buf2) {
+            CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+            CUDA_CHECK(cudaFree(cp->buf2));
+            cp->buf2 = nullptr;
+            cp->cap2 = 0;
+        }
+        const size_t cap = need + need / 4;
+        if (cudaMalloc(&cp->buf2, cap) != cudaSuccess) {
+            const cudaError_t e = cudaGetLastError();
+            if (ink_pg_stats_on() > 1) {
+                fprintf(stderr, "gateo: buf2 alloc of %zu failed: %s\n", cap, cudaGetErrorString(e));
+            }
+            cp->buf2 = nullptr;
+            return nullptr;
+        }
+        cp->cap2 = cap;
+    }
+    return (uint16_t *) cp->buf2;
+}
+
+bool ggml_cuda_ink_pfgemm(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    if (!ink_pg_accepts(ctx, src0, src1, dst)) {
+        return false;
+    }
+    const int64_t K = src0->ne[0];
+    const int64_t N = src0->ne[1];
+    const int64_t T = src1->ne[1];
+
+    cudaStream_t stream = ctx.stream();
+
+    // ---- custom skinny kernel (reads the f32 activation directly) ----
+    if (ink_pg_sk_on() && ink_pg_skinny_launch(ctx, src0->data, src1->data, dst->data, (int) T, (int) N, (int) K, stream)) {
+        return true;
+    }
+
+    // ---- rocBLAS with a shared bf16 activation ----
+    ggml_cuda_pool_alloc<nv_bfloat16> src1_tmp(ctx.pool());
+    const nv_bfloat16 * src1_bf16 = ink_pg_src1_bf16(ctx, src1, src1_tmp);
+
+    // q / gate projections (N=3072, K=2304) at T=2048: BK=64 LDS-tiled MFMA kernel on the shared bf16 activation,
+    // f32 dst. pgbench T=2048: 283 us vs 302 rocBLAS f32-out; T=1024: 146 vs 155+21 bf16-out+conversion; T=512: 96 vs
+    // 77+12 (not used). o / kv shapes stay on rocBLAS (T=2048: 290 vs 270, 117 vs 103).
+    // RBF16 (fidelity) mode: results rounded to bf16 like the original bf16-dst path, and no f32-dst rocBLAS; then
+    // t64 also takes o (N=2304: 290 vs 263+30 bf16-out+conversion) and gain/forget (K=64: 27 vs 18+30).
+    const bool rb = ink_pg_rbf16() != 0;
+    // 8-wave variant ink_pg_t64w8 (bit-identical to ink_pg_t64<2,2>), pgbench us: q T=2048 274 (t64 286), T=1024 138;
+    // o T=2048 272 vs 263+30, T=1024 170 vs 142+17 (so o only at T >= 1536); gain/forget 24 vs 19+31.
+    const bool t64_shape = N >= 3072 || (rb && ((N >= 2304 && T >= 1536) || K <= 256));
+    if (ink_pg_t64_on() && t64_shape && T >= 1024 && N % 128 == 0 && K % 64 == 0) {
+        const int ntn = (int) (N / 128);
+        const int ntt = (int) ((T + 127) / 128);
+        const ggml_tensor * attn = nullptr;
+        const ggml_tensor * mul  = ink_pg_gateo_match(ctx, dst, &attn);
+        if (mul != nullptr) {
+            ink_pg_cache * cp = ink_pg_slot(ctx);
+            uint16_t * ob = cp ? ink_pg_buf2(ctx, cp, (size_t) N * T) : nullptr;
+            if (ob != nullptr) {
+                ink_pg_t64w8<1><<<ntn * ntt, 512, 0, stream>>>((const uint16_t *) src1_bf16, (const uint16_t *) src0->data,
+                    nullptr, (int) T, (int) N, (int) K, (long) K, (long) K, (long) N, ink_pg_rbf16(),
+                    (const float *) attn->data, (long) N, ob);
+                cp->p_t    = mul;
+                cp->p_data = mul->data;
+                cp->p_gen  = ink_pg_gen;
+                ggml_cuda_inkling_defer_skip(ink_pg_graph->nodes[ink_pg_next(ink_pg_graph, ink_pg_find(dst))]); // SIGMOID
+                ggml_cuda_inkling_defer_skip(mul);
+                ++ink_pg_hits_gateo;
+                return true;
+            }
+        }
+        if (K <= 256 && N <= 4096) {
+            ggml_tensor * m = ink_pg_pair_match(ctx, src0, src1, dst);
+            if (m != nullptr) {
+                ink_pg_t64w8<2><<<2 * ntn * ntt, 512, 0, stream>>>((const uint16_t *) src1_bf16, (const uint16_t *) src0->data,
+                    (float *) dst->data, (int) T, (int) N, (int) K, (long) K, (long) K, (long) N, ink_pg_rbf16(),
+                    nullptr, 0, nullptr, (const uint16_t *) m->src[0]->data, (float *) m->data, ntn * ntt);
+                ggml_cuda_inkling_defer_skip(m);
+                ++ink_pg_hits_pair;
+                return true;
+            }
+            if (ink_pg_stats_on()) {
+                ++ink_pg_miss_pair;
+            }
+        }
+        if (ink_pg_stats_on() > 1 && N == 3072 && mul) fprintf(stderr, "gateo: %s nobuf %p\n", dst->name, (void *) ink_pg_slot(ctx));
+        if (ink_pg_stats_on() && N == 3072) {
+            ++ink_pg_miss_gateo;
+        }
+        ink_pg_t64w8<<<ntn * ntt, 512, 0, stream>>>((const uint16_t *) src1_bf16, (const uint16_t *) src0->data,
+            (float *) dst->data, (int) T, (int) N, (int) K, (long) K, (long) K, (long) N, ink_pg_rbf16());
+        return true;
+    }
+
+    cublasHandle_t h = ctx.cublas_handle();
+    CUBLAS_CHECK(cublasSetStream(h, stream));
+    const float alpha = 1.0f;
+    const float beta  = 0.0f;
+
+    // f32 dst (pgbench): T=2048: wins for N >= 1024 (q 302 vs 328, o 270 vs 293, kv 103 vs 110 us) and K=64
+    // (gain 25 vs 48); T=1024: neutral for N >= 1024; T=512: loses for N >= 1024 (o 130 vs 83, kv 56 vs 40),
+    // still wins for K=64 (8 vs 16).
+    const bool f32out = (K <= 256) || (T >= 1536 && N >= ink_pg_f32out_min_n());
+    if (ink_pg_f32out_on() && f32out && !rb) {
+        CUBLAS_CHECK(cublasGemmEx(h, CUBLAS_OP_T, CUBLAS_OP_N,
+                (int) N, (int) T, (int) K,
+                &alpha, src0->data, CUDA_R_16BF, (int) K,
+                        src1_bf16,  CUDA_R_16BF, (int) K,
+                &beta,  dst->data,  CUDA_R_32F,  (int) N,
+                CUBLAS_COMPUTE_32F, CUBLAS_GEMM_DEFAULT_TENSOR_OP));
+        return true;
+    }
+
+    // same call as ggml_cuda_mul_mat_cublas_impl<GGML_TYPE_BF16> on CDNA: bf16 dst, then bf16 -> f32
+    ggml_cuda_pool_alloc<nv_bfloat16> dst_tmp(ctx.pool(), (size_t) N * T);
+    CUBLAS_CHECK(cublasGemmEx(h, CUBLAS_OP_T, CUBLAS_OP_N,
+            (int) N, (int) T, (int) K,
+            &alpha, src0->data,    CUDA_R_16BF, (int) K,
+                    src1_bf16,     CUDA_R_16BF, (int) K,
+            &beta,  dst_tmp.get(), CUDA_R_16BF, (int) N,
+            CUBLAS_COMPUTE_32F, CUBLAS_GEMM_DEFAULT_TENSOR_OP));
+    const to_fp32_cuda_t to_fp32 = ggml_get_to_fp32_cuda(GGML_TYPE_BF16);
+    to_fp32(dst_tmp.get(), (float *) dst->data, N * T, stream);
+    return true;
+}
diff --git a/ggml/src/ggml-cuda/inkling-pfgemm.cuh b/ggml/src/ggml-cuda/inkling-pfgemm.cuh
new file mode 100644
index 0000000..d1fe70d
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-pfgemm.cuh
@@ -0,0 +1,18 @@
+#pragma once
+
+#include "common.cuh"
+
+// Inkling-2 prefill (multi-token) dense BF16 MUL_MAT (MI210 work, p6-dense).
+// Handles MUL_MAT with a contiguous 2D BF16 weight, a contiguous 2D F32 activation with >= 64 columns (tokens)
+// and a contiguous F32 dst:
+//   - the f32->bf16 conversion of the activation is cached and shared by consecutive GEMMs that read the same
+//     activation tensor within one graph evaluation (q/k/v/gate/rel/sink, loop gain/forget),
+//   - large GEMMs write f32 directly from rocBLAS (no bf16 dst + bf16->f32 conversion),
+//   - skinny GEMMs run a custom MFMA kernel that reads the f32 activation directly.
+// GGML_CUDA_INK_PFGEMM=0 restores the previous path exactly.
+// Returns true when handled.
+bool ggml_cuda_ink_pfgemm(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+
+// called at the start of every graph evaluation (invalidates the conversion cache)
+// p7-dense: also records the graph being evaluated (node-level epilogue fusions)
+void ggml_cuda_ink_pfgemm_begin(const ggml_cgraph * cgraph = nullptr);
diff --git a/ggml/src/ggml-cuda/inkling-pfmix.cu b/ggml/src/ggml-cuda/inkling-pfmix.cu
new file mode 100644
index 0000000..578480b
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-pfmix.cu
@@ -0,0 +1,863 @@
+// Inkling-2 prefill on MI210 (gfx90a): the depth-attention mix() of src/models/inkling2.cpp for T > 1 tokens in one
+// kernel. See inkling-pfmix.cuh. Conventions as in inkling-fuse.cu / inkling-ops.cu: bit-exact reproduction of the
+// original kernels' arithmetic, strict shape / use-count / buffer guards, an opt-out env var.
+
+#include "inkling-pfmix.cuh"
+#include "inkling-fuse.cuh"
+#include "ggml-impl.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+// ---------------------------------------------------------------------------------------------
+// switches and counters
+// ---------------------------------------------------------------------------------------------
+
+static bool pf_env_on(const char * name, bool def = true) {
+    const char * v = getenv(name);
+    return v == nullptr ? def : atoi(v) != 0;
+}
+
+static int pf_env_int(const char * name, int def) {
+    const char * v = getenv(name);
+    return v == nullptr ? def : atoi(v);
+}
+
+static bool pf_debug() {
+    static const bool on = getenv("GGML_CUDA_INK_DEBUG") != nullptr;
+    return on;
+}
+
+#define PF_MAX_S 5
+#define PF_MAX_Q 3
+#define PF_MAX_D 4
+
+static std::atomic<long long> pf_hits[PF_MAX_S + 1][PF_MAX_Q + 1];
+static std::atomic<long long> pf_staged;
+static std::atomic<long long> pf_conts;
+static std::atomic<long long> pf_mm2_skipped;
+
+static void pf_print_stats() {
+    fprintf(stderr, "inkling pfmix hits:");
+    for (int s = 1; s <= PF_MAX_S; ++s) {
+        for (int q = 1; q <= PF_MAX_Q; ++q) {
+            const long long h = pf_hits[s][q].load();
+            if (h) {
+                fprintf(stderr, " S%dq%d=%lld", s, q, h);
+            }
+        }
+    }
+    fprintf(stderr, " staged=%lld conts_elided=%lld out_elided=%lld\n", pf_staged.load(), pf_conts.load(), pf_mm2_skipped.load());
+}
+
+static void pf_stats_register() {
+    static bool done = false;
+    if (done) {
+        return;
+    }
+    done = true;
+    if (pf_env_on("GGML_CUDA_FUSION_STATS", false)) {
+        atexit(pf_print_stats);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// graph helpers (local copies of the small static helpers of inkling-fuse.cu)
+// ---------------------------------------------------------------------------------------------
+
+static bool pf_is_noop(const ggml_tensor * t) {
+    return t->op == GGML_OP_NONE || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE ||
+           t->op == GGML_OP_TRANSPOSE || ggml_is_empty(t);
+}
+
+static int pf_next(const ggml_cgraph * cgraph, int j) {
+    for (++j; j < cgraph->n_nodes; ++j) {
+        if (!pf_is_noop(cgraph->nodes[j])) {
+            return j;
+        }
+    }
+    return -1;
+}
+
+static bool pf_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (ggml_is_empty(a) || ggml_is_empty(b) || !a->data || !b->data) {
+        return false;
+    }
+    const char * a0 = (const char *) a->data;
+    const char * a1 = a0 + ggml_nbytes(a);
+    const char * b0 = (const char *) b->data;
+    const char * b1 = b0 + ggml_nbytes(b);
+    return a0 < b1 && b0 < a1;
+}
+
+// every node in [i0, i1] except those in outs must be used only by nodes inside [i0, i1] and must not be an output
+static bool pf_internal_only(const ggml_cgraph * cgraph, int i0, int i1, ggml_tensor * const * outs, int n_outs) {
+    for (int k = i0; k <= i1; ++k) {
+        const ggml_tensor * nd = cgraph->nodes[k];
+        bool is_out = false;
+        for (int o = 0; o < n_outs; ++o) {
+            is_out = is_out || outs[o] == nd;
+        }
+        if (is_out) {
+            continue;
+        }
+        if (nd->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+        int uses = 0;
+        for (int m = k + 1; m <= i1; ++m) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (cgraph->nodes[m]->src[s] == nd) {
+                    uses++;
+                }
+            }
+        }
+        if (uses != ggml_node_get_use_count(cgraph, k)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------------------------------------
+// kernel
+// ---------------------------------------------------------------------------------------------
+// n = 2304 (fixed: the original kernels' block sizes and reduction trees depend on it):
+// - rms_norm_f32<float, 1024, 1, true>: thread c < 576 holds float4 c, tmp = ((x*x + y*y) + z*z) + w*w (rounded
+//   products), warp_reduce_sum<32> over float4 32g .. 32g+31 (18 chunk sums), then warp_reduce_sum<32> over the 32 chunk
+//   slots (14 zeros); scale = rsqrtf(sum / n + eps), nrm = scale * x
+// - scores: mul_mat_vec_f<float, float, nq, 128>: thread lt accumulates float2 lt + 128k (k = 0..8) in order
+//   (ncols_dst 1, 2: rounded products added; 3: fma for query 0 and 1), warp_reduce_sum<64> per wave, then
+//   (wave0 + 0) + (wave1 + 0)
+// - soft_max_f32<true, 0, 0> over S per query
+// - output: S even: mul_mat_vec_f<float, float, nq, 64> over the S-long rows of the transposed states (lane p
+//   accumulates the pair 2p, 2p+1 from zero, then the 64-lane sum); S odd: rocBLAS (fma chain, see pf_wsum)
+// Here one 128-thread block handles one token and holds float2 lt + 128k of every state row, i.e. exactly the data of
+// mul_mat_vec_f's thread lt; the rms_norm partial of float4 c is formed on the even lane (DPP from the odd neighbour),
+// chunk / row trees are evaluated from LDS by one thread each in the original tree order.
+
+#define PF_N  2304
+#define PF_IT 9     // float2 per thread per row: PF_N / 2 / 128
+#define PF_NCH 18   // 32-float4 chunks per row
+#define PF_CHS 36   // LDS stride of a chunk (32 + 4 padding, keeps 16-byte alignment)
+
+struct pf_args {
+    const float * rows[PF_MAX_S];
+    long long     row_stride[PF_MAX_S];             // floats between tokens
+    const float * q;                                // queries [n, nq] contiguous
+    float       * dst[PF_MAX_Q][PF_MAX_D];
+    long long     dst_stride[PF_MAX_Q][PF_MAX_D];   // floats between tokens
+    int           nd[PF_MAX_Q];
+    int           n;
+    float         eps;
+    float         sm_scale;
+    int           odd_mode;
+};
+
+static __device__ __forceinline__ float pf_dpp_xor1(const float v) {
+    return __uint_as_float(__builtin_amdgcn_update_dpp(0u, __float_as_uint(v), 0xB1, 0xF, 0xF, false)); // quad_perm [1,0,3,2]
+}
+
+template <int CTRL>
+static __device__ __forceinline__ float pf_dpp(const float v) {
+    return __uint_as_float(__builtin_amdgcn_update_dpp(0u, __float_as_uint(v), CTRL, 0xF, 0xF, false));
+}
+
+// x += shfl_xor(x, off) for off = 32 .. 1 (warp_reduce_sum<64>), for N values at once
+template <int N>
+static __device__ __forceinline__ void pf_reduce_xor64(float * t) {
+    float o[N];
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        o[i] = __shfl_xor(t[i], 32, 64);
+    }
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        t[i] += o[i];
+    }
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        o[i] = __shfl_xor(t[i], 16, 64);
+    }
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        t[i] += o[i];
+    }
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        t[i] += pf_dpp<0x128>(t[i]);                 // xor 8: row rotate by 8
+    }
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        t[i] += pf_dpp<0x1B>(pf_dpp<0x141>(t[i]));   // xor 4: half-row mirror, then reversed quads
+    }
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        t[i] += pf_dpp<0x4E>(t[i]);                  // xor 2: quad_perm [2,3,0,1]
+    }
+#pragma unroll
+    for (int i = 0; i < N; ++i) {
+        t[i] += pf_dpp<0xB1>(t[i]);                  // xor 1: quad_perm [1,0,3,2]
+    }
+}
+
+// warp_reduce_sum<32> result (lane 0) of 32 values v[0..31]
+static __device__ __forceinline__ float pf_tree32(const float * v) {
+    float a[16];
+#pragma unroll
+    for (int l = 0; l < 16; ++l) {
+        a[l] = v[l] + v[l + 16];
+    }
+#pragma unroll
+    for (int l = 0; l < 8; ++l) {
+        a[l] = a[l] + a[l + 8];
+    }
+#pragma unroll
+    for (int l = 0; l < 4; ++l) {
+        a[l] = a[l] + a[l + 4];
+    }
+    a[0] = a[0] + a[2];
+    a[1] = a[1] + a[3];
+    return a[0] + a[1];
+}
+
+// warp_reduce_sum<32> over lanes holding v[0..S-1] (S <= 5) and zeros: lane 0's result; values are not negative zeros
+template <int S>
+static __device__ __forceinline__ float pf_tree32_few(const float * v) {
+    if constexpr (S == 1) {
+        return v[0];
+    } else if constexpr (S == 2) {
+        return v[0] + v[1];
+    } else if constexpr (S == 3) {
+        return (v[0] + v[2]) + v[1];
+    } else if constexpr (S == 4) {
+        return (v[0] + v[2]) + (v[1] + v[3]);
+    } else {
+        static_assert(S == 5, "pf_tree32_few: S");
+        return ((v[0] + v[4]) + v[2]) + (v[1] + v[3]);
+    }
+}
+
+// acc += x0*y0; acc += x1*y1 as mul_mat_vec_f<float, float, ncols_dst, *> compiles on gfx90a: ncols_dst 1 and 2 add
+// rounded products, ncols_dst 3 uses fused multiply-adds for destination columns 0 and 1 (see inkling-ops.cu)
+static __device__ __forceinline__ float pf_mad2(const float acc, const float x0, const float y0, const float x1, const float y1,
+                                                const bool fma) {
+    if (fma) {
+        return fmaf(x1, y1, fmaf(x0, y0, acc));
+    }
+    float r;
+    {
+#pragma clang fp contract(off)
+        const float p0 = x0 * y0;
+        const float p1 = x1 * y1;
+        r = acc + p0;
+        r = r + p1;
+    }
+    return r;
+}
+
+// out = sum_s v[s] * w[s] in the order of the original final MUL_MAT
+template <int S>
+static __device__ __forceinline__ float pf_wsum(const float * v, const float * w, const int odd_mode, const bool fma) {
+    if constexpr (S % 2 == 0) {
+        float t[S/2];
+#pragma unroll
+        for (int p = 0; p < S/2; ++p) {
+            const float acc = pf_mad2(0.0f, v[2*p + 0], w[2*p + 0], v[2*p + 1], w[2*p + 1], fma);
+            t[p] = acc + 0.0f; // warp_reduce_sum<64>: the lanes without a column pair contribute +0.0f
+        }
+        if constexpr (S == 2) {
+            return t[0];
+        } else {
+            static_assert(S == 4, "pf_wsum: even S > 4");
+            return t[0] + t[1];
+        }
+    } else {
+        if (odd_mode == 1) {
+            float acc;
+            {
+#pragma clang fp contract(off)
+                acc = v[0] * w[0];
+#pragma unroll
+                for (int s = 1; s < S; ++s) {
+                    const float p = v[s] * w[s];
+                    acc = acc + p;
+                }
+            }
+            return acc;
+        }
+        if (odd_mode == 2) {
+            double acc = 0.0;
+#pragma unroll
+            for (int s = 0; s < S; ++s) {
+                acc += (double) v[s] * (double) w[s];
+            }
+            return (float) acc;
+        }
+        float acc = 0.0f;
+#pragma unroll
+        for (int s = 0; s < S; ++s) {
+            acc = fmaf(v[s], w[s], acc);
+        }
+        return acc;
+    }
+}
+
+// p7-small QL (GGML_CUDA_INK_PFMIX_QL, default 1): the query vectors (same for every token, L2 resident) are read at
+// the score step instead of being held in registers from the start (fewer VGPRs, same values / arithmetic)
+template <int S, int NQ, bool QL>
+static __global__ void __launch_bounds__(128) pf_mix_kernel(const pf_args a) {
+    const int t    = blockIdx.x;
+    const int lt   = threadIdx.x;
+    const int w    = lt >> 6;
+    const int lane = lt & 63;
+
+    __shared__ float4 part4[S*PF_NCH*PF_CHS/4];
+    __shared__ float  csum[S*PF_NCH];
+    __shared__ float  rscale[S];
+    __shared__ float  wsum[NQ][S][2];
+    float * part = (float *) part4;
+
+    // all global loads: float2 lt + 128k of every state row and of every query
+    float2 x[S][PF_IT];
+#pragma unroll
+    for (int s = 0; s < S; ++s) {
+        const float2 * r2 = (const float2 *) (a.rows[s] + (long long) t*a.row_stride[s]) + lt;
+#pragma unroll
+        for (int k = 0; k < PF_IT; ++k) {
+            x[s][k] = r2[128*k];
+        }
+    }
+    float2 qv[NQ][PF_IT];
+    if constexpr (!QL) {
+#pragma unroll
+        for (int j = 0; j < NQ; ++j) {
+            const float2 * q2 = (const float2 *) (a.q + j*PF_N) + lt;
+#pragma unroll
+            for (int k = 0; k < PF_IT; ++k) {
+                qv[j][k] = q2[128*k];
+            }
+        }
+    }
+
+    // 1. rms_norm level 1: float4 c = (float2 2c, float2 2c + 1) lives on lanes (even, odd) of the same wave;
+    //    c = 64k + 32w + (lane >> 1): chunk 2k + w, position lane >> 1
+#pragma unroll
+    for (int s = 0; s < S; ++s) {
+#pragma unroll
+        for (int k = 0; k < PF_IT; ++k) {
+            float tmp;
+            {
+#pragma clang fp contract(off)
+                const float q0 = x[s][k].x * x[s][k].x;
+                const float q1 = x[s][k].y * x[s][k].y;
+                const float qz = pf_dpp_xor1(q0);
+                const float qw = pf_dpp_xor1(q1);
+                tmp = q0 + q1;
+                tmp = tmp + qz;
+                tmp = tmp + qw;
+            }
+            if ((lane & 1) == 0) {
+                part[(s*PF_NCH + 2*k + w)*PF_CHS + (lane >> 1)] = tmp;
+            }
+        }
+    }
+    __syncthreads();
+
+    // 2. chunk sums (first warp_reduce_sum<32>), one thread per chunk
+    if (lt < S*PF_NCH) {
+        float v[32];
+        const float4 * p4 = part4 + lt*(PF_CHS/4);
+#pragma unroll
+        for (int m = 0; m < 8; ++m) {
+            const float4 f = p4[m];
+            v[4*m + 0] = f.x;
+            v[4*m + 1] = f.y;
+            v[4*m + 2] = f.z;
+            v[4*m + 3] = f.w;
+        }
+        csum[lt] = pf_tree32(v);
+    }
+    __syncthreads();
+
+    // 3. row sums (second warp_reduce_sum<32> over 18 chunk sums and 14 zeros) and scales
+    if (lt < S) {
+        float v[32];
+#pragma unroll
+        for (int g = 0; g < 32; ++g) {
+            v[g] = g < PF_NCH ? csum[lt*PF_NCH + g] : 0.0f;
+        }
+        const float sum = pf_tree32(v);
+        rscale[lt] = rsqrtf(sum / a.n + a.eps);
+    }
+    __syncthreads();
+
+    float sc[S];
+#pragma unroll
+    for (int s = 0; s < S; ++s) {
+        sc[s] = rscale[s];
+    }
+
+    // 4. scores: mul_mat_vec_f<float, float, NQ, 128> per state row
+    {
+        float sumf[S*NQ];
+#pragma unroll
+        for (int s = 0; s < S; ++s) {
+#pragma unroll
+            for (int j = 0; j < NQ; ++j) {
+                float acc = 0.0f;
+#pragma unroll
+                for (int k = 0; k < PF_IT; ++k) {
+                    const float tx = sc[s] * x[s][k].x;
+                    const float ty = sc[s] * x[s][k].y;
+                    const float2 qq = QL ? ((const float2 *) (a.q + j*PF_N) + lt)[128*k] : qv[j][k];
+                    acc = pf_mad2(acc, tx, qq.x, ty, qq.y, NQ == 3 && j < 2);
+                }
+                sumf[s*NQ + j] = acc;
+            }
+        }
+        pf_reduce_xor64<S*NQ>(sumf);
+        if (lane == 0) {
+#pragma unroll
+            for (int s = 0; s < S; ++s) {
+#pragma unroll
+                for (int j = 0; j < NQ; ++j) {
+                    wsum[j][s][w] = sumf[s*NQ + j];
+                }
+            }
+        }
+    }
+    __syncthreads();
+
+    // 5. softmax over S per query (every thread, same values) and the mixed rows
+#pragma unroll
+    for (int j = 0; j < NQ; ++j) {
+        float val[S];
+        float max_val = -INFINITY;
+#pragma unroll
+        for (int s = 0; s < S; ++s) {
+            const float score = (wsum[j][s][0] + 0.0f) + (wsum[j][s][1] + 0.0f);
+            val[s]  = score*a.sm_scale + 0.0f;
+            max_val = max(max_val, val[s]);
+        }
+        float e[S];
+#pragma unroll
+        for (int s = 0; s < S; ++s) {
+            e[s] = expf(val[s] - max_val);
+        }
+        const float inv_sum = 1.0f / pf_tree32_few<S>(e);
+        float wj[S];
+#pragma unroll
+        for (int s = 0; s < S; ++s) {
+            wj[s] = e[s] * inv_sum;
+        }
+
+        const bool fma = NQ == 3 && j < 2;
+        float2 o[PF_IT];
+#pragma unroll
+        for (int k = 0; k < PF_IT; ++k) {
+            float vx[S], vy[S];
+#pragma unroll
+            for (int s = 0; s < S; ++s) {
+                vx[s] = sc[s] * x[s][k].x;
+                vy[s] = sc[s] * x[s][k].y;
+            }
+            o[k] = make_float2(pf_wsum<S>(vx, wj, a.odd_mode, fma), pf_wsum<S>(vy, wj, a.odd_mode, fma));
+        }
+        for (int d = 0; d < a.nd[j]; ++d) {
+            float2 * o2 = (float2 *) (a.dst[j][d] + (long long) t*a.dst_stride[j][d]) + lt;
+#pragma unroll
+            for (int k = 0; k < PF_IT; ++k) {
+                o2[128*k] = o[k];
+            }
+        }
+    }
+}
+
+template <int S>
+static void pf_launch_s(const pf_args & a, int nq, int T, cudaStream_t stream) {
+    static const bool ql = pf_env_on("GGML_CUDA_INK_PFMIX_QL");
+    switch (nq) {
+        case 1: if (ql) { pf_mix_kernel<S, 1, true><<<T, 128, 0, stream>>>(a); } else { pf_mix_kernel<S, 1, false><<<T, 128, 0, stream>>>(a); } break;
+        case 2: if (ql) { pf_mix_kernel<S, 2, true><<<T, 128, 0, stream>>>(a); } else { pf_mix_kernel<S, 2, false><<<T, 128, 0, stream>>>(a); } break;
+        case 3: if (ql) { pf_mix_kernel<S, 3, true><<<T, 128, 0, stream>>>(a); } else { pf_mix_kernel<S, 3, false><<<T, 128, 0, stream>>>(a); } break;
+        default: GGML_ABORT("ink pfmix: nq");
+    }
+}
+
+static void pf_launch(const pf_args & a, int S, int nq, int T, cudaStream_t stream) {
+    switch (S) {
+        case 2: pf_launch_s<2>(a, nq, T, stream); break;
+        case 3: pf_launch_s<3>(a, nq, T, stream); break;
+        case 4: pf_launch_s<4>(a, nq, T, stream); break;
+        case 5: pf_launch_s<5>(a, nq, T, stream); break;
+        default: GGML_ABORT("ink pfmix: S");
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// ---------------------------------------------------------------------------------------------
+// verify mode (GGML_CUDA_INK_PFMIX_VERIFY=1 with GGML_CUDA_DISABLE_GRAPHS=1): the kernel writes to scratch, the original
+// nodes run, the results are compared bit by bit once the final MUL_MAT has run
+// ---------------------------------------------------------------------------------------------
+
+struct pf_verify_entry {
+    float             * mine;
+    const ggml_tensor * ref;
+    int                 ref_idx;
+    int                 S;
+    int                 nq;
+};
+
+static std::vector<pf_verify_entry> pf_pending;
+static long long pf_vcmp[PF_MAX_S + 1][PF_MAX_Q + 1];
+static long long pf_vbad[PF_MAX_S + 1][PF_MAX_Q + 1];
+static double    pf_vmax[PF_MAX_S + 1][PF_MAX_Q + 1];
+
+static void pf_verify_print() {
+    fprintf(stderr, "inkling pfmix verify:");
+    for (int s = 1; s <= PF_MAX_S; ++s) {
+        for (int q = 1; q <= PF_MAX_Q; ++q) {
+            if (pf_vcmp[s][q]) {
+                fprintf(stderr, " S%dq%d %lld/%lld bad (max rel %.3g)", s, q, pf_vbad[s][q], pf_vcmp[s][q], pf_vmax[s][q]);
+            }
+        }
+    }
+    fprintf(stderr, "\n");
+}
+
+static void pf_verify_flush(ggml_backend_cuda_context & ctx, int i) {
+    for (size_t e = 0; e < pf_pending.size();) {
+        const pf_verify_entry v = pf_pending[e];
+        if (v.ref_idx >= i) {
+            ++e;
+            continue;
+        }
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        const size_t nel = ggml_nelements(v.ref);
+        std::vector<float> a(nel), b(nel);
+        CUDA_CHECK(cudaMemcpy(a.data(), v.mine, nel*sizeof(float), cudaMemcpyDeviceToHost));
+        CUDA_CHECK(cudaMemcpy(b.data(), v.ref->data, nel*sizeof(float), cudaMemcpyDeviceToHost));
+        long long bad = 0;
+        for (size_t k = 0; k < nel; ++k) {
+            if (memcmp(&a[k], &b[k], sizeof(float)) != 0) {
+                bad++;
+                const double rel = fabs((double) a[k] - (double) b[k]) / (fabs((double) b[k]) + 1e-30);
+                if (rel > pf_vmax[v.S][v.nq]) {
+                    pf_vmax[v.S][v.nq] = rel;
+                }
+            }
+        }
+        pf_vcmp[v.S][v.nq] += nel;
+        pf_vbad[v.S][v.nq] += bad;
+        CUDA_CHECK(cudaFree(v.mine));
+        pf_pending.erase(pf_pending.begin() + e);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// matcher
+// ---------------------------------------------------------------------------------------------
+
+#define PF_REJECT() do { if (pf_debug()) { fprintf(stderr, "ink pfmix reject line %d at node %d %s\n", __LINE__, i, node->name); } return 0; } while (0)
+
+static int pf_try_mix(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    ggml_tensor * node = cgraph->nodes[i];
+    // innermost concat: src1 is the current state, src0 the first block (dim 1)
+    if (node->op != GGML_OP_CONCAT || ggml_get_op_params_i32(node, 0) != 1 || node->src[1]->op == GGML_OP_CONCAT ||
+        node->type != GGML_TYPE_F32 || node->ne[2] <= 1) {
+        return 0;
+    }
+    const int64_t T = node->ne[2];
+    const ggml_tensor * rows_rev[PF_MAX_S];
+    int nrows = 0;
+    rows_rev[nrows++] = node->src[1];
+    rows_rev[nrows++] = node->src[0];
+    ggml_tensor * prev = node;
+    int k = i;
+    while (true) {
+        const int kn = pf_next(cgraph, k);
+        if (kn < 0) {
+            return 0;
+        }
+        ggml_tensor * nx = cgraph->nodes[kn];
+        if (nx->op != GGML_OP_CONCAT) {
+            break;
+        }
+        if (nx->src[1] != prev || ggml_get_op_params_i32(nx, 0) != 1 || nrows >= PF_MAX_S) {
+            PF_REJECT();
+        }
+        rows_rev[nrows++] = nx->src[0];
+        prev = nx;
+        k    = kn;
+    }
+    ggml_tensor * states = prev;
+    const int S = nrows;
+
+    // RMS_NORM of the states
+    const int kn = pf_next(cgraph, k);
+    if (kn < 0) {
+        return 0;
+    }
+    ggml_tensor * nrm = cgraph->nodes[kn];
+    const int64_t n = nrm->ne[0];
+    if (nrm->op != GGML_OP_RMS_NORM || nrm->src[0] != states) {
+        PF_REJECT();
+    }
+    if (n != PF_N || nrm->type != GGML_TYPE_F32 || nrm->ne[1] != S || nrm->ne[2] != T || nrm->ne[3] != 1 ||
+        !ggml_is_contiguous(nrm) || ((uintptr_t) nrm->data % 16) || states->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(states) || states->ne[0] != n || states->ne[1] != S || states->ne[2] != T ||
+        ((uintptr_t) states->data % 16)) {
+        PF_REJECT();
+    }
+    pf_args a = {};
+    for (int r = 0; r < S; ++r) {
+        const ggml_tensor * t = rows_rev[S - 1 - r]; // final order: last concat's src0 first, the current state last
+        if (t->type != GGML_TYPE_F32 || t->ne[0] != n || t->ne[1] != 1 || t->ne[2] != T || t->ne[3] != 1 ||
+            t->nb[0] != sizeof(float) || ((uintptr_t) t->data % 8) || (t->nb[2] % 8) || !t->data) {
+            PF_REJECT();
+        }
+        a.rows[r]       = (const float *) t->data;
+        a.row_stride[r] = (long long) (t->nb[2] / sizeof(float));
+    }
+
+    // TRANSPOSE (view) + CONT, REPEAT(query), MUL_MAT(nrm, repeat), SOFT_MAX, MUL_MAT(cont, softmax)
+    const int kc = pf_next(cgraph, kn);
+    if (kc < 0) {
+        return 0;
+    }
+    ggml_tensor * cont = cgraph->nodes[kc];
+    if (cont->op != GGML_OP_CONT || cont->src[0]->op != GGML_OP_TRANSPOSE || cont->src[0]->src[0] != nrm ||
+        cont->type != GGML_TYPE_F32 || !ggml_is_contiguous(cont) || cont->ne[0] != S || cont->ne[1] != n || cont->ne[2] != T) {
+        PF_REJECT();
+    }
+    const int kr = pf_next(cgraph, kc);
+    if (kr < 0) {
+        return 0;
+    }
+    ggml_tensor * rep = cgraph->nodes[kr];
+    if (rep->op != GGML_OP_REPEAT) {
+        PF_REJECT();
+    }
+    const ggml_tensor * qt = rep->src[0];
+    const int64_t nq = rep->ne[1];
+    if (rep->type != GGML_TYPE_F32 || rep->ne[0] != n || nq < 1 || nq > PF_MAX_Q || rep->ne[2] != T || rep->ne[3] != 1 ||
+        qt->type != GGML_TYPE_F32 || !ggml_is_contiguous(qt) || qt->ne[0] != n || qt->ne[1] != nq || qt->ne[2] != 1 ||
+        qt->ne[3] != 1 || ((uintptr_t) qt->data % 8)) {
+        PF_REJECT();
+    }
+    const int km1 = pf_next(cgraph, kr);
+    if (km1 < 0) {
+        return 0;
+    }
+    ggml_tensor * mm1 = cgraph->nodes[km1];
+    if (mm1->op != GGML_OP_MUL_MAT || mm1->src[0] != nrm || mm1->src[1] != rep || mm1->type != GGML_TYPE_F32 ||
+        mm1->ne[0] != S || mm1->ne[1] != nq || mm1->ne[2] != T || mm1->ne[3] != 1) {
+        PF_REJECT();
+    }
+    const int ks = pf_next(cgraph, km1);
+    if (ks < 0) {
+        return 0;
+    }
+    ggml_tensor * sm = cgraph->nodes[ks];
+    float sm_scale, sm_max_bias;
+    memcpy(&sm_scale, (const float *) sm->op_params + 0, sizeof(float));
+    memcpy(&sm_max_bias, (const float *) sm->op_params + 1, sizeof(float));
+    if (sm->op != GGML_OP_SOFT_MAX || sm->src[0] != mm1 || sm->src[1] || sm->src[2] || sm_max_bias != 0.0f ||
+        sm->type != GGML_TYPE_F32 || !ggml_is_contiguous(sm) || !ggml_are_same_shape(sm, mm1)) {
+        PF_REJECT();
+    }
+    const int km2 = pf_next(cgraph, ks);
+    if (km2 < 0) {
+        return 0;
+    }
+    ggml_tensor * mm2 = cgraph->nodes[km2];
+    if (mm2->op != GGML_OP_MUL_MAT || mm2->src[0] != cont || mm2->src[1] != sm || mm2->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(mm2) || mm2->ne[0] != n || mm2->ne[1] != nq || mm2->ne[2] != T || mm2->ne[3] != 1 ||
+        ((uintptr_t) mm2->data % 8)) {
+        PF_REJECT();
+    }
+
+    ggml_tensor * outs[1] = { mm2 };
+    if (!pf_internal_only(cgraph, i, km2, outs, 1)) {
+        PF_REJECT();
+    }
+    // the output must not alias the inputs (the kernel reads and writes in one launch), except a state row that the
+    // output reuses exactly (same base, one query, same token stride): block t then reads token t's row into registers
+    // before it writes token t's output, and no other block touches it. Any other overlap: the kernel writes a pool
+    // buffer that is copied to the output afterwards.
+    bool staged = pf_overlap(mm2, qt);
+    for (int r = 0; r < S; ++r) {
+        const ggml_tensor * t = rows_rev[r];
+        if (pf_overlap(mm2, t)) {
+            const bool exact = t->data == mm2->data && nq == 1 && t->nb[2] == mm2->nb[2] && ggml_nbytes(t) == ggml_nbytes(mm2);
+            if (!exact) {
+                staged = true;
+                if (pf_debug()) {
+                    fprintf(stderr, "ink pfmix overlap: S=%d nq=%d row %d %s %p nb2 %zu bytes %zu vs out %s %p nb2 %zu bytes %zu\n", S,
+                            (int) nq, r, t->name, t->data, t->nb[2], ggml_nbytes(t), mm2->name, mm2->data, mm2->nb[2], ggml_nbytes(mm2));
+                }
+            }
+        }
+    }
+
+    memcpy(&a.eps, nrm->op_params, sizeof(float));
+    a.q        = (const float *) qt->data;
+    a.n        = (int) n;
+    a.sm_scale = sm_scale;
+    {
+        static const int odd1 = pf_env_int("GGML_CUDA_INK_PFMIX_ODD1", 0);
+        static const int odd3 = pf_env_int("GGML_CUDA_INK_PFMIX_ODD3", 0);
+        a.odd_mode = nq == 3 ? odd3 : odd1;
+    }
+    static const bool verify = pf_env_on("GGML_CUDA_INK_PFMIX_VERIFY", false);
+
+    // CONT copies of a query row (VIEW [n, T] of row j -> CONT, later in the graph) are written by the kernel directly
+    // (early: their buffers must be untouched until the CONT node, which is then skipped); the MUL_MAT output itself
+    // only if something else still reads it
+    static const bool cont_on = pf_env_on("GGML_CUDA_INK_PFMIX_CONT");
+    ggml_tensor * conts[PF_MAX_Q*PF_MAX_D];
+    int ncont = 0;
+    bool write_mm2 = true;
+    for (int j = 0; j < nq; ++j) {
+        a.nd[j] = 0;
+    }
+    if (cont_on && !verify && !staged) {
+        const int uses = ggml_node_get_use_count(cgraph, km2);
+        int found = 0;
+        const int lim = std::min(cgraph->n_nodes - 1, km2 + 600);
+        for (int kv = km2 + 1; kv <= lim && found < uses; ++kv) {
+            ggml_tensor * v = cgraph->nodes[kv];
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                found += v->src[s] == mm2;
+            }
+            if (v->op != GGML_OP_VIEW || v->src[0] != mm2 || v->type != GGML_TYPE_F32 || v->ne[0] != n || v->ne[1] != T ||
+                v->ne[2] != 1 || v->ne[3] != 1 || v->nb[0] != sizeof(float) || v->nb[1] != mm2->nb[2] ||
+                v->view_offs % (n*sizeof(float)) != 0 || (int64_t) (v->view_offs / (n*sizeof(float))) >= nq ||
+                ggml_node_get_use_count(cgraph, kv) != 1 || (v->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                continue;
+            }
+            const int j = (int) (v->view_offs / (n*sizeof(float)));
+            int kc = -1;
+            for (int k2 = kv + 1; k2 <= lim; ++k2) {
+                const ggml_tensor * nd = cgraph->nodes[k2];
+                bool uses_v = false;
+                for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                    uses_v = uses_v || nd->src[s] == v;
+                }
+                if (uses_v) {
+                    kc = k2;
+                    break;
+                }
+            }
+            if (kc < 0) {
+                continue;
+            }
+            ggml_tensor * c = cgraph->nodes[kc];
+            if (c->op != GGML_OP_CONT || c->src[0] != v || c->type != GGML_TYPE_F32 || !ggml_is_contiguous(c) ||
+                c->ne[0] != n || c->ne[1] != T || c->ne[2] != 1 || c->ne[3] != 1 || !c->data || ((uintptr_t) c->data % 8) ||
+                a.nd[j] >= PF_MAX_D - 1 || ncont >= PF_MAX_Q*PF_MAX_D) {
+                continue;
+            }
+            // no alias with the kernel's inputs, the MUL_MAT output or the other early-written copies
+            bool ok = !pf_overlap(c, mm2) && !pf_overlap(c, qt);
+            for (int r = 0; r < S; ++r) {
+                ok = ok && !pf_overlap(c, rows_rev[r]);
+            }
+            for (int e = 0; e < ncont; ++e) {
+                ok = ok && !pf_overlap(c, conts[e]);
+            }
+            // nodes between the mix and the CONT neither write nor read its buffer
+            for (int k3 = km2 + 1; ok && k3 < kc; ++k3) {
+                const ggml_tensor * nd = cgraph->nodes[k3];
+                if (pf_is_noop(nd)) {
+                    continue;
+                }
+                if (pf_overlap(nd, c)) {
+                    ok = false;
+                    break;
+                }
+                for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                    if (nd->src[s] && pf_overlap(nd->src[s], c)) {
+                        ok = false;
+                        break;
+                    }
+                }
+            }
+            if (!ok) {
+                if (pf_debug()) {
+                    fprintf(stderr, "ink pfmix: CONT %d (%s) of mix at %d not elided (buffer)\n", kc, c->name, i);
+                }
+                continue;
+            }
+            conts[ncont++]               = c;
+            a.dst[j][a.nd[j]]            = (float *) c->data;
+            a.dst_stride[j][a.nd[j]]     = (long long) (c->nb[1] / sizeof(float));
+            a.nd[j]++;
+        }
+        write_mm2 = found != uses || ncont != uses || (mm2->flags & GGML_TENSOR_FLAG_OUTPUT);
+    }
+    if (write_mm2) {
+        for (int j = 0; j < nq; ++j) {
+            a.dst[j][a.nd[j]]        = (float *) mm2->data + j*n;
+            a.dst_stride[j][a.nd[j]] = (long long) (mm2->nb[2] / sizeof(float));
+            a.nd[j]++;
+        }
+    }
+
+    if (verify) {
+        float * mine = nullptr;
+        CUDA_CHECK(cudaMalloc(&mine, ggml_nbytes(mm2)));
+        for (int j = 0; j < nq; ++j) {
+            a.dst[j][0] = mine + j*n;
+        }
+        pf_launch(a, S, (int) nq, (int) T, ctx.stream());
+        pf_pending.push_back({ mine, mm2, km2, S, (int) nq });
+        return 0;
+    }
+
+    if (staged) {
+        ggml_cuda_pool_alloc<float> tmp(ctx.pool(), ggml_nelements(mm2));
+        for (int j = 0; j < nq; ++j) {
+            a.dst[j][0]        = tmp.ptr + j*n;
+            a.dst_stride[j][0] = nq*n;
+        }
+        pf_launch(a, S, (int) nq, (int) T, ctx.stream());
+        CUDA_CHECK(cudaMemcpyAsync(mm2->data, tmp.ptr, ggml_nbytes(mm2), cudaMemcpyDeviceToDevice, ctx.stream()));
+        pf_staged++;
+    } else {
+        pf_launch(a, S, (int) nq, (int) T, ctx.stream());
+    }
+    for (int e = 0; e < ncont; ++e) {
+        ggml_cuda_inkling_defer_skip(conts[e]);
+    }
+    pf_conts += ncont;
+    pf_mm2_skipped += !write_mm2;
+    pf_hits[S][nq]++;
+    return km2 - i;
+}
+
+int ggml_cuda_ink_pfmix_try(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = pf_env_on("GGML_CUDA_INK_FUSE") && pf_env_on("GGML_CUDA_INK_PFMIX");
+    if (!on) {
+        return 0;
+    }
+    pf_stats_register();
+    static const bool verify = pf_env_on("GGML_CUDA_INK_PFMIX_VERIFY", false);
+    if (verify) {
+        static bool reg = false;
+        if (!reg) {
+            reg = true;
+            atexit(pf_verify_print);
+        }
+        pf_verify_flush(ctx, i);
+    }
+    if (cgraph->nodes[i]->op != GGML_OP_CONCAT) {
+        return 0;
+    }
+    return pf_try_mix(ctx, cgraph, i);
+}
diff --git a/ggml/src/ggml-cuda/inkling-pfmix.cuh b/ggml/src/ggml-cuda/inkling-pfmix.cuh
