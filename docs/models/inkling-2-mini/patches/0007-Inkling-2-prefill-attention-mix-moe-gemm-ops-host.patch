+    const float fval = ggml_get_op_params_f32(fill, 0);
+    const float s_sc = ggml_get_op_params_f32(scl, 0);
+    const float s_b  = ggml_get_op_params_f32(scl, 1);
+    const float lo   = ggml_get_op_params_f32(clamp, 0);
+    const float hi   = ggml_get_op_params_f32(clamp, 1);
+    const int nblocks = (int) ((nrows + 7)/8);
+    cudaStream_t stream = ctx.stream();
+    const ggml_tensor * fo = tmul ? tmul : out;
+    float * dst = (float *) fo->data;
+    pfo_srows sm;
+    const bool srows = out->ne[3] == 1 && pfo_match_srows(cgraph, i, i_end, fo, sm);
+    const float * taup = tau ? (const float *) tau->data : nullptr;
+    const int64_t tau_div = out->ne[1];
+    if (s) {
+        pfo_clip_f32<true><<<nblocks, 256, 0, stream>>>((const float *) x->data, (const float *) s->data, dst,
+                                                        (int) ncols, nrows, ggml_nrows(s), s_sc, s_b, fval, lo, hi, taup, tau_div,
+                                                        srows ? (const int64_t *) sm.idx->data : nullptr, srows ? sm.dst : nullptr, sm.nb1);
+    } else {
+        pfo_clip_f32<false><<<nblocks, 256, 0, stream>>>((const float *) x->data, nullptr, dst, (int) ncols, nrows,
+                                                         1, s_sc, s_b, fval, lo, hi, taup, tau_div,
+                                                         srows ? (const int64_t *) sm.idx->data : nullptr, srows ? sm.dst : nullptr, sm.nb1);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    pfo_hits[tmul ? PFO_CLIPTAU : PFO_CLIP]++;
+    if (srows) {
+        ggml_cuda_inkling_defer_skip(sm.sr);
+        pfo_hits[PFO_CLIP_SROWS]++;
+    }
+    return i_end - i;
+}
+
+// ---------------------------------------------------------------------------------------------
+
+void ggml_cuda_ink_pfops_begin() {
+    if (!pfo_conv_pending.empty() || !pfo_ctrl_pending.empty()) {
+        // a deferred launch was never reached (its launch node was consumed by another fusion): results are wrong
+        fprintf(stderr, "ink pfops: WARNING %zu conv / %zu ctrl deferred launches not executed\n", pfo_conv_pending.size(),
+                pfo_ctrl_pending.size());
+    }
+    pfo_conv_pending.clear();
+    pfo_ctrl_pending.clear();
+}
+
+int ggml_cuda_ink_pfops_try(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    // multi-stream graph optimization (GGML_CUDA_GRAPH_OPT=1) skips the inkling hooks inside concurrent regions, which
+    // could drop a deferred launch: the pfops fusions are off then
+    static const bool on = pfo_env_on("GGML_CUDA_INK_FUSE") && pfo_env_on("GGML_CUDA_INK_PFOPS") &&
+                           !pfo_env_on("GGML_CUDA_GRAPH_OPT", false);
+    if (!on) {
+        return 0;
+    }
+    pfo_stats_register();
+    if (pfo_verify()) {
+        pfo_verify_flush(ctx, cgraph, i);
+    }
+    const ggml_tensor * node = cgraph->nodes[i];
+    switch (node->op) {
+        case GGML_OP_CONCAT: {
+            int n = pfo_try_conv(ctx, cgraph, i);
+            if (n == 0) {
+                n = pfo_try_cnorm(ctx, cgraph, i);
+            }
+            return n;
+        }
+        case GGML_OP_SSM_CONV:
+        case GGML_OP_SCALE:
+            return pfo_conv_pending.empty() ? 0 : pfo_launch_conv(ctx, cgraph, i);
+        case GGML_OP_UNARY: {
+            if (!pfo_ctrl_pending.empty()) {
+                const int n = pfo_launch_ctrl(ctx, cgraph, i);
+                if (n != 0) {
+                    return n;
+                }
+            }
+            return pfo_try_ctrl(ctx, cgraph, i);
+        }
+        case GGML_OP_MUL:
+        case GGML_OP_SQR:
+            return pfo_try_clip(ctx, cgraph, i);
+        case GGML_OP_RMS_NORM:
+            return pfo_try_rms_srows(ctx, cgraph, i);
+        default:
+            return 0;
+    }
+}
