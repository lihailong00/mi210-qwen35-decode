+// ---------------------------------------------------------------------------------------------
+// v3 of the NVFP4 GEMV. Same integer dot products as ink_mmid_nvfp4; with L = 8 also the same float summation
+// order (bit-identical output). Fewer instructions per 64-value block (kernel time on gfx90a follows the number of
+// instructions executed per wave):
+//  - the signed e2m1 value of 4 codes is the xor of two v_perm_b32: selectors 8..15 of v_perm_b32 return
+//    sign(byte 1/3/5/7) * 0xFF, 0x00, 0xFF, 0xFF, 0xFF, and the two 8-entry tables are chosen so that
+//    T1[n] ^ special2(n) = +mag(n) for codes 0..7 and special1(n) ^ T2[n - 8] = -mag(n - 8) for codes 8..15
+//  - the UE4M3 sub-block scale is a 256-entry LDS table (built with ink_ue4m3_half, same bits)
+//  - a 36-byte block is read with 3 loads (dword + 2x dwordx4)
+// L lanes share a row (any L <= 64, 64/L rows per wave), lane sub handles blocks sub, sub + L, ... (at most MAXIT).
+// PRE: issue all weight loads of a lane before the arithmetic.
+// MODE 1: only streams the weights (xor of the loaded dwords), for the bandwidth ceiling of this access pattern.
+// MODE 2: all arithmetic, but every lane reads the same weight block (ALU + setup cost). MODE 3: setup only.
+// MODE 4: like 0, with the float summation order of v1 for any L >= 8 (bit-identical output).
+// ---------------------------------------------------------------------------------------------
+
+static __device__ __forceinline__ int ink_nv3_dot(const uint32_t a, const int yv, const int sumi) {
+    // a: 4 e2m1 codes, one per byte (0..15)
+    const uint32_t p = ggml_hip_perm(0xF3F7F904u, 0x030201FFu, a);
+    const uint32_t n = ggml_hip_perm(0x0B0705FCu, 0x0201FF00u, a ^ 0x08080808u);
+    return ggml_cuda_dp4a((int) (p ^ n), yv, sumi);
+}
+
+template <int L, int MAXIT, bool PRE, int MODE>
+static __global__ void __launch_bounds__(256) ink_mmid_nvfp4_v3(
+        const char * __restrict__ w, const int64_t w_nb1, const int64_t w_nb2, const int nb,
+        const block_q8_1 * __restrict__ y, const int64_t y_stride_blocks, const bool y_per_slot,
+        const int32_t * __restrict__ ids, const float * __restrict__ escale,
+        float * __restrict__ dst, const int64_t dst_nb1, const int nrows) {
+    constexpr int RW = 64 / L; // rows per wave
+    const int slot   = blockIdx.y;
+    const int expert = ids[slot];
+    const int tid    = threadIdx.x;
+    const int wl     = tid & 63;
+    const int rw     = wl / L;
+    const int sub    = wl - rw*L;
+    const int row    = blockIdx.x*(4*RW) + (tid >> 6)*RW + rw;
+    const bool lane_on = (64 % L == 0) || rw < RW; // lanes 64 - 64 % L .. 63 of a wave have no row
+    const bool live  = lane_on && row < nrows;
+    const char * wrow = w + expert*w_nb2 + (int64_t) (live ? row : 0)*w_nb1;
+
+    auto load_block = [&](const int bi, uint32_t * q) {
+        const char * bp = MODE == 2 ? w : wrow + (int64_t) bi*sizeof(block_nvfp4);
+        q[0] = *(const uint32_t *) bp;
+        const ink_int4_a4 a0 = *(const ink_int4_a4 *) (bp + 4);
+        const ink_int4_a4 a1 = *(const ink_int4_a4 *) (bp + 20);
+        q[1] = a0.x; q[2] = a0.y; q[3] = a0.z; q[4] = a0.w;
+        q[5] = a1.x; q[6] = a1.y; q[7] = a1.z; q[8] = a1.w;
+    };
+
+    uint32_t q[PRE ? MAXIT : 1][9];
+    if (PRE) {
+#pragma unroll
+        for (int it = 0; it < MAXIT; ++it) {
+            const int bi = sub + L*it;
+            if (bi < nb && lane_on) {
+                load_block(bi, q[PRE ? it : 0]);
+            }
+        }
+    }
+
+    // LDS: [2*nb] q8_1 blocks at 0 (ds_read2 offsets of a block stay below 256 elements), then at the compile-time
+    // offset 18*L*MAXIT ints the [256] table ue4m3 -> value/2
+    extern __shared__ int ink_y_lds3[];
+    constexpr int LUT_OFF = 18*L*MAXIT;
+    const float * lut = (const float *) (ink_y_lds3 + LUT_OFF);
+    const block_q8_1 * ys = (const block_q8_1 *) ink_y_lds3;
+    if (MODE != 1) {
+        const block_q8_1 * yrow = y + (y_per_slot ? slot*y_stride_blocks : 0);
+        const int n_int = nb*2*(int) (sizeof(block_q8_1)/sizeof(int));
+        ((float *) ink_y_lds3)[LUT_OFF + tid] = ink_ue4m3_half((uint32_t) tid);
+        if (n_int % 4 == 0) {
+            for (int k = tid; k < n_int/4; k += 256) {
+                const ink_int4_a4 v = ((const ink_int4_a4 *) yrow)[k];
+                *(ink_int4_a4 *) (ink_y_lds3 + 4*k) = v;
+            }
+        } else {
+            for (int k = tid; k < n_int; k += 256) {
+                ink_y_lds3[k] = ((const int *) yrow)[k];
+            }
+        }
+        __syncthreads();
+    }
+
+    constexpr bool CH = MODE == 4 && L >= 8; // v1 summation order for any L >= 8 (needs nb >= 8)
+    float sum = 0.0f;
+    float P[MAXIT][4];
+#pragma unroll
+    for (int it = 0; it < MAXIT; ++it) {
+        const int bi = sub + L*it;
+#pragma unroll
+        for (int s = 0; s < 4; ++s) {
+            P[it][s] = 0.0f;
+        }
+        if (bi < nb && lane_on && MODE != 3) {
+            uint32_t * qb = q[PRE ? it : 0];
+            if (!PRE) {
+                load_block(bi, qb);
+            }
+            if (MODE == 1) {
+                sum += (float) (int) (qb[0] ^ qb[1] ^ qb[2] ^ qb[3] ^ qb[4] ^ qb[5] ^ qb[6] ^ qb[7] ^ qb[8]);
+            } else {
+#pragma clang fp contract(off)
+                const uint32_t sc4 = qb[0];
+#pragma unroll
+                for (int s = 0; s < 4; ++s) {
+                    const uint32_t A = qb[1 + 2*s + 0];
+                    const uint32_t B = qb[1 + 2*s + 1];
+                    const block_q8_1 * b8 = ys + 2*bi + (s >> 1);
+                    const int i8 = (s & 1) << 2;
+                    const int * q8 = (const int *) b8->qs;
+                    int sumi = ink_nv3_dot(A & 0x0F0F0F0Fu,        q8[i8 + 0], 0);
+                    sumi     = ink_nv3_dot((A >> 4) & 0x0F0F0F0Fu, q8[i8 + 2], sumi);
+                    sumi     = ink_nv3_dot(B & 0x0F0F0F0Fu,        q8[i8 + 1], sumi);
+                    sumi     = ink_nv3_dot((B >> 4) & 0x0F0F0F0Fu, q8[i8 + 3], sumi);
+                    const float d = lut[(sc4 >> (8*s)) & 0xFF] * __low2float(b8->ds);
+                    if (CH) {
+                        P[it][s] = d * float(sumi);
+                    } else {
+                        sum += d * float(sumi);
+                    }
+                }
+            }
+        }
+    }
+    const int rb = wl - sub; // first lane of the row
+    if (CH) {
+#pragma clang fp contract(off)
+        // v1 keeps 8 partial sums per row: chain c adds the 4 sub-block products of the blocks c, c + 8, c + 16, ... in
+        // order, then a xor 4, 2, 1 tree. Here block b lives in lane b % L, so a chain hops between lanes: in stage k
+        // the lanes that own a block of [8k, 8k + 7] continue the partial sum of the lane that owns block - 8.
+        constexpr int NST = (L*MAXIT + 7)/8;
+        const int src4 = (sub >= 8 ? wl - 8 : wl + L - 8) << 2;
+#pragma unroll
+        for (int k = 0; k < NST; ++k) {
+            float in = 0.0f;
+            if (k > 0) {
+                in = __int_as_float(__builtin_amdgcn_ds_bpermute(src4, __float_as_int(sum)));
+            }
+            bool  part = false;
+            float p0 = 0.0f, p1 = 0.0f, p2 = 0.0f, p3 = 0.0f;
+#pragma unroll
+            for (int it = 0; it < MAXIT; ++it) {
+                if (L*it <= 8*k + 7 && L*it + L - 1 >= 8*k) { // compile time: iteration it has blocks in this stage
+                    const int bi = sub + L*it;
+                    const bool here = (bi >> 3) == k && bi < nb && lane_on;
+                    p0 = here ? P[it][0] : p0;
+                    p1 = here ? P[it][1] : p1;
+                    p2 = here ? P[it][2] : p2;
+                    p3 = here ? P[it][3] : p3;
+                    part = part || here;
+                }
+            }
+            const float t = (((in + p0) + p1) + p2) + p3;
+            sum = part ? t : sum;
+        }
+        // lanes 0..7 of the row fetch the ends of the chains 0..7, then the v1 tree
+        const int be = sub + (((nb - 1 - sub) >> 3) << 3);
+        int le = be;
+#pragma unroll
+        for (int it = 1; it < MAXIT; ++it) {
+            le = le >= L ? le - L : le;
+        }
+        sum = __int_as_float(__builtin_amdgcn_ds_bpermute((rb + le) << 2, __float_as_int(sum)));
+#pragma unroll
+        for (int off = 4; off > 0; off >>= 1) {
+            sum += __int_as_float(__builtin_amdgcn_ds_bpermute((rb + (sub ^ off)) << 2, __float_as_int(sum)));
+        }
+    } else {
+        // lane 0 of a row collects the L partial sums; for L = 8 this is the xor 4, 2, 1 tree of v1
+        constexpr int PW = L <= 1 ? 1 : L <= 2 ? 2 : L <= 4 ? 4 : L <= 8 ? 8 : L <= 16 ? 16 : L <= 32 ? 32 : 64;
+        int len = L;
+#pragma unroll
+        for (int off = PW/2; off > 0; off >>= 1) {
+            const float t = __int_as_float(__builtin_amdgcn_ds_bpermute((wl + off) << 2, __float_as_int(sum)));
+            if (sub < off && sub + off < len) {
+                sum += t;
+            }
+            len = len < off ? len : off;
+        }
+    }
+    if (live && sub == 0) {
+        const float v = escale ? sum * escale[expert] : sum;
+        dst[slot*dst_nb1 + row] = v;
+    }
+}
+
+// bandwidth probes: stream the weight rows with aligned 16-byte loads. P=0: one uint4 per lane and iteration (BF16 GEMV
+// pattern), P=1: 4 consecutive uint4 (a 64-byte line) per lane and iteration
+template <int L, int P>
+static __global__ void __launch_bounds__(256) ink_nv_stream(
+        const char * __restrict__ w, const int64_t w_nb1, const int64_t w_nb2, const int nb,
+        const int32_t * __restrict__ ids, float * __restrict__ dst, const int64_t dst_nb1, const int nrows) {
+    constexpr int rows_per_block = L >= 256 ? 1 : 256 / L;
+    constexpr int LL = L >= 64 ? 64 : L;
+    const int slot   = blockIdx.y;
+    const int expert = ids[slot];
+    const int tid    = threadIdx.x;
+    const int row    = blockIdx.x*rows_per_block + (L >= 256 ? 0 : tid / L);
+    const int sub    = L >= 256 ? tid : tid % L;
+    if (row >= nrows) {
+        return;
+    }
+    const uint4 * wr = (const uint4 *) (w + expert*w_nb2 + (int64_t) row*w_nb1);
+    const int n = P == 0 ? nb*9/4 : nb*9/16;
+    uint32_t x = 0;
+    for (int c = sub; c < n; c += L) {
+        if (P == 0) {
+            const uint4 v = wr[c];
+            x ^= v.x ^ v.y ^ v.z ^ v.w;
+        } else {
+            const uint4 v0 = wr[4*c + 0];
+            const uint4 v1 = wr[4*c + 1];
+            const uint4 v2 = wr[4*c + 2];
+            const uint4 v3 = wr[4*c + 3];
+            x ^= v0.x ^ v0.y ^ v0.z ^ v0.w ^ v1.x ^ v1.y ^ v1.z ^ v1.w ^ v2.x ^ v2.y ^ v2.z ^ v2.w ^ v3.x ^ v3.y ^ v3.z ^ v3.w;
+        }
+    }
+    float sum = (float) (int) x;
+#pragma unroll
+    for (int off = LL/2; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off, 64);
+    }
+    if (tid % LL == 0 && (L < 256 || tid == 0)) {
+        dst[slot*dst_nb1 + row] = sum;
+    }
+}
+
+// launch + wave start cost only (same grid as the GEMV)
+static __global__ void __launch_bounds__(256) ink_mmid_nvfp4_empty(const int32_t * __restrict__ ids, float * __restrict__ dst,
+                                                                   const int64_t dst_nb1, const int nrows, const int rpb) {
+    const int row = blockIdx.x*rpb;
+    if (threadIdx.x == 0 && row < nrows && ids[blockIdx.y] < 0) {
+        dst[blockIdx.y*dst_nb1 + row] = 0.0f;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// v4 of the NVFP4 GEMV: the mapping of weight blocks to lanes is decoupled from the float summation order.
+// Phase 1: a 256-thread block covers RB = NIT * (256 / NB) whole rows; thread t handles block t % NB of the rows
+//          t / NB + R1 * it (it < NIT), i.e. NIT weight blocks, with the v3 decode, and writes the 4 sub-block products
+//          d * float(sumi) of each block to LDS. All lanes of a wave are busy (v3 with 18 lanes: 54 of 64) and a wave
+//          is short (the kernel time follows memory + the serial instruction count of one wave).
+//          Lanes without a row skip the loads (keeping the loads conditional also keeps them in a better order:
+//          measured 22.4 vs 22.75 us) and write products nobody reads.
+// Phase 2: thread 8 * r + c adds the products of chain c of row r in the v1 order (blocks c, c + 8, ...), then the
+//          xor 4, 2, 1 tree over the 8 chains: bit-identical to ink_mmid_nvfp4<8, 5>.
+// Byte offsets are 32-bit (the launcher checks the tensor sizes). The ue4m3 table is computed per launch: reading it
+// from a global table costs one more queued memory round trip per wave (+0.8 us per launch).
+// MODE 1: stream probe (the products are replaced by the xor of the loaded dwords).
+// ---------------------------------------------------------------------------------------------
+
+template <int CTRL>
+static __device__ __forceinline__ float ink_gemv_dpp(const float v) {
+    return __uint_as_float(__builtin_amdgcn_update_dpp(0u, __float_as_uint(v), CTRL, 0xF, 0xF, false));
+}
+
+template <int NB, int NIT, int MODE>
+static __global__ void __launch_bounds__(256) ink_mmid_nvfp4_v4(
+        const char * __restrict__ w, const uint32_t w_nb1, const uint32_t w_nb2,
+        const char * __restrict__ y, const uint32_t y_slot_bytes,
+        const int32_t * __restrict__ ids, const float * __restrict__ escale,
+        float * __restrict__ dst, const uint32_t dst_nb1, const int nrows) {
+    constexpr int R1 = 256 / NB;   // rows per iteration
+    constexpr int RB = R1*NIT;     // rows per block
+    constexpr int Y_INTS   = 18*NB;
+    constexpr int LUT_OFF  = Y_INTS;
+    constexpr int PROD_OFF = LUT_OFF + 256;
+    constexpr bool DEAD = 256 % NB != 0; // threads R1*NB .. 255 have no row
+    static_assert(Y_INTS % 4 == 0 && Y_INTS/4 <= 256 && RB <= 32 && NB >= 8, "ink nvfp4 v4: unsupported shape");
+
+    const uint32_t slot   = blockIdx.y;
+    const uint32_t expert = (uint32_t) ids[slot];
+    const uint32_t tid    = threadIdx.x;
+    const uint32_t rl     = tid / NB;
+    const uint32_t blk    = tid - rl*NB;
+    const uint32_t row0   = blockIdx.x*RB + rl;
+    const bool t_on       = !DEAD || tid < R1*NB;
+    const char * wexp     = w + (size_t) (expert*w_nb2);
+
+    uint32_t q[NIT][9];
+#pragma unroll
+    for (int it = 0; it < NIT; ++it) {
+        const uint32_t row  = row0 + R1*it;
+        const uint32_t rowc = t_on && row < (uint32_t) nrows ? row : 0;
