new file mode 100644
index 0000000..4ee0a70
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-attn.cu
@@ -0,0 +1,543 @@
+#include "inkling-attn.cuh"
+#include "inkling-fuse.cuh"
+#include "convert.cuh"
+#include "ggml-impl.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+#include <unordered_set>
+
+// ---------------------------------------------------------------------------------------------
+// Dense attention bias of src/models/inkling2.cpp (n_tokens == 1):
+//
+//   PAD(rel_bias W [16, n_ext] -> [16, n_ext + 1])                       constant weight, zero column appended
+//   ... Rcur [16, n_head] (clip; for the full attention passes followed by a MUL with tau, which stays a node) ...
+//   MUL_MAT(pad, Rcur) -> table [n_ext + 1, n_head]                      rocBLAS sgemm, MFMA 16x16x4 Tensile kernel
+//   MUL_MAT(sink_proj, x) -> sinks [n_head]                              (BF16 GEMV, not part of this fusion)
+//   SUB(table, sinks [1, n_head])
+//   PERMUTE + CONT -> [n_head, n_ext + 1]
+//   GET_ROWS(., rel_pos [n_kv]) -> [n_head, n_kv]
+//   RESHAPE + PERMUTE + CONT -> kq_b [n_kv, 1, n_head]
+//   CPY(kq_mask f16 [n_kv] -> f32)
+//   ADD(kq_b, mask)
+//   CPY(-> f16) kq_mask_rel_pos [n_kv, 1, n_head]
+//   FILL(sinks [n_head])
+//   FLASH_ATTN_EXT(q, k, v, kq_mask_rel_pos, sinks)
+//
+// One kernel computes, only for the gathered positions,
+//   out[kv, head] = f16((dot(W[:, rel_pos[kv]], R[:, head]) - sink[head]) + f32(mask[kv]))
+// and the FILL. The decision is taken at the PAD (which is skipped), the kernel is launched at the SUB (the first
+// point where all inputs exist); the nodes in between that do not belong to the chain run unchanged.
+//
+// The table GEMM is rocBLAS sgemm(T, N) running the Tensile kernels Cijk_Alik_Bljk_SB_MT64x16x32_MI16x16x4x1 (+ MT16x16x32
+// for the last row). Measured with GGML_CUDA_INK_VERIFY=1 (12M table entries): its result equals a sequential
+// fused multiply-add over k = 0..15 starting from 0, bit for bit; rounded products, 4-term groups, descending order
+// and double accumulation all differ. The padded column is an exact +0.
+// ---------------------------------------------------------------------------------------------
+
+#define INK_ATTN_NREL 16
+
+static bool inka_env_on(const char * name) {
+    const char * v = getenv(name);
+    return v == nullptr || atoi(v) != 0;
+}
+
+static bool inka_debug() {
+    static const bool on = getenv("GGML_CUDA_INK_DEBUG") != nullptr;
+    return on;
+}
+
+static bool inka_verify() {
+    static const bool on = getenv("GGML_CUDA_INK_VERIFY") != nullptr;
+    return on;
+}
+
+static std::atomic<long long> inka_hits;
+static std::atomic<long long> inka_hits_snapshot;
+
+static void inka_print_stats() {
+    fprintf(stderr, "inkling attn bias fusions (captured nodes): attn_bias=%lld (with snapshot %lld)\n", inka_hits.load(),
+            inka_hits_snapshot.load());
+}
+
+static bool inka_is_noop(const ggml_tensor * t) {
+    return t->op == GGML_OP_NONE || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE ||
+           t->op == GGML_OP_TRANSPOSE || ggml_is_empty(t);
+}
+
+static int inka_next(const ggml_cgraph * cgraph, int j) {
+    for (++j; j < cgraph->n_nodes; ++j) {
+        if (!inka_is_noop(cgraph->nodes[j])) {
+            return j;
+        }
+    }
+    return -1;
+}
+
+static bool inka_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (ggml_is_empty(a) || ggml_is_empty(b) || !a->data || !b->data) {
+        return false;
+    }
+    const char * a0 = (const char *) a->data;
+    const char * a1 = a0 + ggml_nbytes(a);
+    const char * b0 = (const char *) b->data;
+    const char * b1 = b0 + ggml_nbytes(b);
+    return a0 < b1 && b0 < a1;
+}
+
+// ---------------------------------------------------------------------------------------------
+// kernels
+// ---------------------------------------------------------------------------------------------
+
+// dot of 16 terms exactly as the rocBLAS/Tensile MFMA kernel accumulates it
+static __device__ __forceinline__ float inka_dot16(const float * w, const float * r) {
+    float acc = 0.0f;
+    for (int k = 0; k < INK_ATTN_NREL; ++k) {
+        acc = fmaf(w[k], r[k], acc);
+    }
+    return acc;
+}
+
+// debug: compare the dot product with the whole table computed by the original MUL_MAT node
+static __global__ void inka_verify_kernel(const float * __restrict__ W, const float * __restrict__ R, const float * __restrict__ table,
+                                          const int n_ext, const int n_head, unsigned long long * cnt, float * first) {
+    const int p = blockIdx.x*blockDim.x + threadIdx.x;
+    const int h = blockIdx.y;
+    if (p > n_ext) {
+        return;
+    }
+    float w[INK_ATTN_NREL];
+    float r[INK_ATTN_NREL];
+    for (int k = 0; k < INK_ATTN_NREL; ++k) {
+        w[k] = p < n_ext ? W[(int64_t) p*INK_ATTN_NREL + k] : 0.0f;
+        r[k] = R[h*INK_ATTN_NREL + k];
+    }
+    const float ref = table[(int64_t) h*(n_ext + 1) + p];
+    const float v   = inka_dot16(w, r);
+    if (p == 0 && h == 0) {
+        atomicAdd(&cnt[0], (unsigned long long) (n_ext + 1)*n_head);
+    }
+    if (__float_as_uint(v) != __float_as_uint(ref)) {
+        const unsigned long long prev = atomicAdd(&cnt[1], 1ULL);
+        if (prev == 0) {
+            first[0] = v;
+            first[1] = ref;
+        }
+    }
+}
+
+static unsigned long long * inka_vcnt   = nullptr;
+static float *              inka_vfirst = nullptr;
+
+static void inka_verify_print() {
+    cudaDeviceSynchronize();
+    fprintf(stderr, "ink attn verify: table dot compared %llu mismatched %llu (first: fused %.9g ref %.9g)\n", inka_vcnt[0],
+            inka_vcnt[1], inka_vfirst[0], inka_vfirst[1]);
+}
+
+// one thread per (kv position, head); a block covers consecutive kv of one head, so the f16 output is written in runs
+template <bool has_fill>
+static __global__ void inka_bias_mask_kernel(const float * __restrict__ W, const float * __restrict__ R,
+                                             const float * __restrict__ sinks, const int32_t * __restrict__ idx,
+                                             const half * __restrict__ mask, half * __restrict__ dst, float * __restrict__ fill,
+                                             const int n_kv, const int n_ext, const float fill_value) {
+    const int kv = blockIdx.x*blockDim.x + threadIdx.x;
+    const int h  = blockIdx.y;
+    if (kv >= n_kv) {
+        return;
+    }
+    const int   p      = idx[kv];
+    const bool  padded = p >= n_ext; // the zero column appended by the PAD
+    const float * wp   = W + (int64_t) (padded ? 0 : p)*INK_ATTN_NREL;
+    const float * rp   = R + h*INK_ATTN_NREL;
+
+    // issue all loads before the arithmetic
+    float w[INK_ATTN_NREL];
+    float r[INK_ATTN_NREL];
+    for (int k = 0; k < INK_ATTN_NREL; ++k) {
+        w[k] = wp[k];
+    }
+    for (int k = 0; k < INK_ATTN_NREL; ++k) {
+        r[k] = rp[k];
+    }
+    const float s = sinks[h];
+    const float m = ggml_cuda_cast<float>(mask[kv]); // CPY f16 -> f32
+
+    float acc = inka_dot16(w, r); // MUL_MAT
+    if (padded) {
+        acc = 0.0f;
+    }
+    const float b = acc - s; // SUB
+    const float v = b + m;   // ADD
+    dst[(int64_t) h*n_kv + kv] = ggml_cuda_cast<half>(v); // CPY f32 -> f16
+    if (has_fill && kv == 0) {
+        fill[h] = fill_value;
+    }
+}
+
+// For the case that ggml-alloc placed the output (or the FILL) on top of R / sinks (their buffers are free once the
+// original MUL_MAT / SUB have run; happens in about a third of the layer passes): a tiny kernel first copies R and the
+// sinks to a scratch slot, the main kernel then reads the copy.
+#define INK_ATTN_SNAP_MAX_HEAD 60 // (16 + 1)*n_head threads in one block
+#define INK_ATTN_SNAP_SLOT     (INK_ATTN_SNAP_MAX_HEAD*(INK_ATTN_NREL + 1))
+#define INK_ATTN_SNAP_NSLOTS   (1 << 12)
+
+static __global__ void inka_snapshot_kernel(const float * __restrict__ R, const float * __restrict__ sinks, float * __restrict__ snap,
+                                            const int n_head) {
+    const int j  = threadIdx.x;
+    const int nr = n_head*INK_ATTN_NREL;
+    if (j < nr) {
+        snap[j] = R[j];
+    } else if (j < nr + n_head) {
+        snap[j] = sinks[j - nr];
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// matching
+// ---------------------------------------------------------------------------------------------
+
+struct inka_launch {
+    const float *   W;
+    const float *   R;
+    const float *   sinks;
+    const int32_t * idx;
+    const half *    mask;
+    half *          dst;
+    float *         fill;
+    int             n_kv;
+    int             n_ext;
+    int             n_head;
+    float           fill_value;
+    bool            snapshot;
+    // verify mode
+    const float * table;
+};
+
+// keyed by the SUB node
+static std::unordered_map<const ggml_tensor *, inka_launch> inka_pending;
+
+void ggml_cuda_ink_attn_begin() {
+    inka_pending.clear();
+}
+
+#define INKA_REJECT() do { if (inka_debug()) { fprintf(stderr, "ink attn reject line %d at node %d\n", __LINE__, i); } return 0; } while (0)
+
+static bool inka_f32_contig(const ggml_tensor * t) {
+    return t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && t->data != nullptr;
+}
+
+static int inka_decide(ggml_cgraph * cgraph, int i) {
+    static const bool enabled = inka_env_on("GGML_CUDA_INK_FUSE") && inka_env_on("GGML_CUDA_INK_ATTN_BIAS");
+    if (!enabled) {
+        return 0;
+    }
+    ggml_tensor * pad = cgraph->nodes[i];
+    const ggml_tensor * W = pad->src[0];
+    if (pad->type != GGML_TYPE_F32 || !W || W->op != GGML_OP_NONE || W->view_src || !inka_f32_contig(W) ||
+        W->ne[0] != INK_ATTN_NREL || W->ne[2] != 1 || W->ne[3] != 1 || pad->ne[0] != W->ne[0] || pad->ne[1] != W->ne[1] + 1 ||
+        pad->ne[2] != 1 || pad->ne[3] != 1 || W->ne[1] < 1 || W->ne[1] >= (1 << 24)) {
+        return 0; // not ours: stay quiet
+    }
+    for (int q = 0; q < 9; ++q) {
+        if (ggml_get_op_params_i32(pad, q) != (q == 3 ? 1 : 0)) {
+            return 0;
+        }
+    }
+    const int n_ext = (int) W->ne[1];
+
+    // table = MUL_MAT(pad, R): a few nodes later (the chain that computes R sits in between)
+    int k_tm = -1;
+    for (int k = i + 1; k < cgraph->n_nodes && k <= i + 32; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (n->op == GGML_OP_MUL_MAT && n->src[0] == pad) {
+            k_tm = k;
+            break;
+        }
+    }
+    if (k_tm < 0) {
+        INKA_REJECT();
+    }
+    ggml_tensor *       tm   = cgraph->nodes[k_tm];
+    const ggml_tensor * Rcur = tm->src[1];
+    if (!inka_f32_contig(Rcur) || Rcur->ne[0] != INK_ATTN_NREL || Rcur->ne[2] != 1 || Rcur->ne[3] != 1 || Rcur->ne[1] < 1 ||
+        Rcur->ne[1] > 4096 || tm->type != GGML_TYPE_F32 || tm->ne[0] != n_ext + 1 || tm->ne[1] != Rcur->ne[1] || tm->ne[2] != 1 ||
+        tm->ne[3] != 1) {
+        INKA_REJECT();
+    }
+    const int n_head = (int) Rcur->ne[1];
+
+    // SUB(table, sinks): the next computed node, or the one after the sink GEMV
+    int k_sub = k_tm;
+    for (int q = 0; q < 2; ++q) {
+        k_sub = inka_next(cgraph, k_sub);
+        if (k_sub < 0) {
+            INKA_REJECT();
+        }
+        if (cgraph->nodes[k_sub]->op == GGML_OP_SUB && cgraph->nodes[k_sub]->src[0] == tm) {
+            break;
+        }
+        if (q == 1) {
+            INKA_REJECT();
+        }
+    }
+    ggml_tensor *       sub    = cgraph->nodes[k_sub];
+    const ggml_tensor * sinks1 = sub->src[1]; // [1, n_head] view of the sink GEMV result
+    if (!sinks1 || !inka_f32_contig(sinks1) || sinks1->ne[0] != 1 || sinks1->ne[1] != n_head || sinks1->ne[2] != 1 ||
+        sinks1->ne[3] != 1 || !ggml_are_same_shape(sub, tm) || sub->type != GGML_TYPE_F32) {
+        INKA_REJECT();
+    }
+
+    // the rest of the chain: consecutive computed nodes
+    const ggml_op seq[] = { GGML_OP_CONT, GGML_OP_GET_ROWS, GGML_OP_CONT, GGML_OP_CPY, GGML_OP_ADD, GGML_OP_CPY };
+    int idx[6];
+    int k = k_sub;
+    for (int q = 0; q < 6; ++q) {
+        k = inka_next(cgraph, k);
+        if (k < 0 || cgraph->nodes[k]->op != seq[q]) {
+            INKA_REJECT();
+        }
+        idx[q] = k;
+    }
+    ggml_tensor * cont1 = cgraph->nodes[idx[0]];
+    ggml_tensor * gr    = cgraph->nodes[idx[1]];
+    ggml_tensor * cont2 = cgraph->nodes[idx[2]];
+    ggml_tensor * mcpy  = cgraph->nodes[idx[3]];
+    ggml_tensor * add   = cgraph->nodes[idx[4]];
+    ggml_tensor * out   = cgraph->nodes[idx[5]];
+
+    // CONT(PERMUTE(sub)) -> [n_head, n_ext + 1]
+    const ggml_tensor * perm1 = cont1->src[0];
+    if (!perm1 || perm1->op != GGML_OP_PERMUTE || perm1->src[0] != sub || perm1->view_offs != 0 || perm1->ne[0] != n_head ||
+        perm1->ne[1] != n_ext + 1 || perm1->ne[2] != 1 || perm1->ne[3] != 1 || perm1->nb[0] != sub->nb[1] ||
+        perm1->nb[1] != sub->nb[0] || !ggml_are_same_shape(cont1, perm1) || cont1->type != GGML_TYPE_F32) {
+        INKA_REJECT();
+    }
+    // GET_ROWS(cont1, rel_pos [n_kv]) -> [n_head, n_kv]
+    const ggml_tensor * pos = gr->src[1];
+    if (gr->src[0] != cont1 || !pos || pos->type != GGML_TYPE_I32 || !ggml_is_contiguous(pos) || !pos->data || pos->ne[1] != 1 ||
+        pos->ne[2] != 1 || pos->ne[3] != 1 || pos->ne[0] < 1 || pos->ne[0] >= (1 << 24) || gr->type != GGML_TYPE_F32 ||
+        gr->ne[0] != n_head || gr->ne[1] != pos->ne[0] || gr->ne[2] != 1 || gr->ne[3] != 1) {
+        INKA_REJECT();
+    }
+    const int n_kv = (int) pos->ne[0];
+    // CONT(PERMUTE(RESHAPE(gr))) -> [n_kv, 1, n_head]: element (kv, 0, h) = gr[h, kv]
+    const ggml_tensor * perm2 = cont2->src[0];
+    if (!perm2 || perm2->op != GGML_OP_PERMUTE || perm2->view_offs != 0 || !perm2->src[0]) {
+        INKA_REJECT();
+    }
+    const ggml_tensor * rs = perm2->src[0];
+    if ((rs != gr && (rs->op != GGML_OP_RESHAPE || rs->src[0] != gr || rs->view_offs != 0)) || rs->ne[0] != n_head ||
+        rs->ne[1] != n_kv || rs->ne[2] != 1 || rs->ne[3] != 1 || !ggml_is_contiguous(rs) || perm2->ne[0] != n_kv ||
+        perm2->ne[1] != 1 || perm2->ne[2] != n_head || perm2->ne[3] != 1 || perm2->nb[0] != rs->nb[1] ||
+        perm2->nb[2] != rs->nb[0] || !ggml_are_same_shape(cont2, perm2) || cont2->type != GGML_TYPE_F32) {
+        INKA_REJECT();
+    }
+    // CPY(mask f16 [n_kv] -> f32), ADD(kq_b, mask), CPY(-> f16)
+    const ggml_tensor * mask = mcpy->src[0];
+    if (!mask || mask->type != GGML_TYPE_F16 || !ggml_is_contiguous(mask) || !mask->data || mask->ne[0] != n_kv ||
+        ggml_nelements(mask) != n_kv || mcpy->type != GGML_TYPE_F32 || !ggml_are_same_shape(mcpy, mask) ||
+        (mcpy->src[1] && mcpy->src[1] != mcpy)) {
+        INKA_REJECT();
+    }
+    if (add->src[0] != cont2 || add->src[1] != mcpy || add->type != GGML_TYPE_F32 || !ggml_are_same_shape(add, cont2)) {
+        INKA_REJECT();
+    }
+    if (out->src[0] != add || (out->src[1] && out->src[1] != out) || out->type != GGML_TYPE_F16 || !ggml_are_same_shape(out, add) ||
+        !ggml_is_contiguous(out) || !out->data) {
+        INKA_REJECT();
+    }
+
+    // optional: FILL(sinks) directly before the FLASH_ATTN_EXT that consumes the mask
+    ggml_tensor * fill   = nullptr;
+    int           k_fill = inka_next(cgraph, idx[5]);
+    int           k_end  = idx[5];
+    if (k_fill > 0 && cgraph->nodes[k_fill]->op == GGML_OP_FILL) {
+        ggml_tensor * f    = cgraph->nodes[k_fill];
+        const int     k_fa = inka_next(cgraph, k_fill);
+        if (k_fa > 0 && cgraph->nodes[k_fa]->op == GGML_OP_FLASH_ATTN_EXT && cgraph->nodes[k_fa]->src[3] == out &&
+            cgraph->nodes[k_fa]->src[4] == f && inka_f32_contig(f) && ggml_nelements(f) == n_head && f->ne[0] == n_head &&
+            !(f->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            fill  = f;
+            k_end = k_fill;
+        }
+    }
+
+    // the nodes that are not computed any more
+    std::unordered_set<const ggml_tensor *> fused;
+    fused.insert(pad);
+    fused.insert(tm);
+    for (int q = k_sub; q <= k_end; ++q) {
+        fused.insert(cgraph->nodes[q]); // includes the views in between
+    }
+
+    // every elided tensor must be used only inside the fusion
+    for (int q = i; q <= k_end; ++q) {
+        const ggml_tensor * n = cgraph->nodes[q];
+        if (!fused.count(n) || n == out || n == fill) {
+            continue;
+        }
+        if (n->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            INKA_REJECT();
+        }
+        int uses = 0;
+        for (int m = q; m <= k_end; ++m) {
+            if (!fused.count(cgraph->nodes[m])) {
+                continue;
+            }
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (cgraph->nodes[m]->src[s] == n) {
+                    uses++;
+                }
+            }
+        }
+        if (uses != ggml_node_get_use_count(cgraph, q)) {
+            INKA_REJECT();
+        }
+    }
+
+    // R is read at the SUB instead of at the MUL_MAT: no node in between may overwrite it.
+    // (W is a weight; rel_pos and the mask are read earlier than originally, but everything after the SUB is fused.)
+    for (int q = k_tm + 1; q < k_sub; ++q) {
+        const ggml_tensor * n = cgraph->nodes[q];
+        if (!fused.count(n) && !inka_is_noop(n) && inka_overlap(n, Rcur)) {
+            INKA_REJECT();
+        }
+    }
+
+    // The outputs are written while other threads still read the inputs. W, rel_pos and the mask must not overlap them at
+    // all; R / sinks may (ggml-alloc reuses their buffers for the mask in about a third of the layer passes): then they
+    // are copied to a scratch slot first. GGML_CUDA_INK_ATTN_SNAPSHOT=1 forces the copy (debug).
+    static const bool force_snapshot = getenv("GGML_CUDA_INK_ATTN_SNAPSHOT") != nullptr && atoi(getenv("GGML_CUDA_INK_ATTN_SNAPSHOT")) != 0;
+    bool snapshot = force_snapshot;
+    {
+        const ggml_tensor * hard[3] = { W, pos, mask };
+        for (int s = 0; s < 3; ++s) {
+            if (inka_overlap(out, hard[s]) || (fill && inka_overlap(fill, hard[s]))) {
+                INKA_REJECT();
+            }
+        }
+        const ggml_tensor * soft[2] = { Rcur, sinks1 };
+        for (int s = 0; s < 2; ++s) {
+            if (inka_overlap(out, soft[s]) || (fill && inka_overlap(fill, soft[s]))) {
+                snapshot = true;
+            }
+        }
+        if (fill && inka_overlap(out, fill)) {
+            INKA_REJECT();
+        }
+    }
+    if (snapshot && n_head > INK_ATTN_SNAP_MAX_HEAD) {
+        INKA_REJECT();
+    }
+    if (((uintptr_t) out->data % 2) || ((uintptr_t) mask->data % 2)) {
+        INKA_REJECT();
+    }
+
+    inka_launch L;
+    L.W          = (const float *) W->data;
+    L.R          = (const float *) Rcur->data;
+    L.sinks      = (const float *) sinks1->data;
+    L.idx        = (const int32_t *) pos->data;
+    L.mask       = (const half *) mask->data;
+    L.dst        = (half *) out->data;
+    L.fill       = fill ? (float *) fill->data : nullptr;
+    L.n_kv       = n_kv;
+    L.n_ext      = n_ext;
+    L.n_head     = n_head;
+    L.fill_value = fill ? ggml_get_op_params_f32(fill, 0) : 0.0f;
+    L.snapshot   = snapshot;
+    L.table      = (const float *) tm->data;
+    inka_pending[sub] = L;
+
+    if (inka_verify()) {
+        return 0; // all original nodes run; the SUB hook compares the dot products
+    }
+
+    for (const ggml_tensor * n : fused) {
+        if (n != pad && n != sub && !inka_is_noop(n)) {
+            ggml_cuda_inkling_defer_skip(n);
+        }
+    }
+    return -1; // the PAD is not computed
+}
+
+static int inka_launch_at_sub(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    GGML_UNUSED(cgraph);
+    auto it = inka_pending.find(cgraph->nodes[i]);
+    if (it == inka_pending.end()) {
+        return 0;
+    }
+    const inka_launch L = it->second;
+    inka_pending.erase(it);
+
+    cudaStream_t stream = ctx.stream();
+
+    if (inka_verify()) {
+        if (!inka_vcnt) {
+            CUDA_CHECK(cudaMallocManaged(&inka_vcnt, 2*sizeof(unsigned long long)));
+            CUDA_CHECK(cudaMallocManaged(&inka_vfirst, 2*sizeof(float)));
+            memset(inka_vcnt, 0, 2*sizeof(unsigned long long));
+            memset(inka_vfirst, 0, 2*sizeof(float));
+            atexit(inka_verify_print);
+        }
+        const dim3 grid((L.n_ext + 1 + 255)/256, L.n_head, 1);
+        inka_verify_kernel<<<grid, 256, 0, stream>>>(L.W, L.R, L.table, L.n_ext, L.n_head, inka_vcnt, inka_vfirst);
+        CUDA_CHECK(cudaGetLastError());
+        return 0;
+    }
+
+    const float * R     = L.R;
+    const float * sinks = L.sinks;
+    if (L.snapshot) {
+        // one scratch slot per captured call site, so that concurrent streams do not share one
+        static float * snap_pool = nullptr;
+        static int     next_slot = 0;
+        if (!snap_pool) {
+            CUDA_CHECK(cudaMalloc(&snap_pool, (size_t) INK_ATTN_SNAP_NSLOTS*INK_ATTN_SNAP_SLOT*sizeof(float)));
+        }
+        float * snap = snap_pool + (size_t) next_slot*INK_ATTN_SNAP_SLOT;
+        next_slot    = (next_slot + 1) % INK_ATTN_SNAP_NSLOTS;
+        inka_snapshot_kernel<<<1, L.n_head*(INK_ATTN_NREL + 1), 0, stream>>>(R, sinks, snap, L.n_head);
+        CUDA_CHECK(cudaGetLastError());
+        R     = snap;
+        sinks = snap + L.n_head*INK_ATTN_NREL;
+        inka_hits_snapshot++;
+    }
+    {
+        const int  block = 256;
+        const dim3 grid((L.n_kv + block - 1)/block, L.n_head, 1);
+        if (L.fill) {
+            inka_bias_mask_kernel<true><<<grid, block, 0, stream>>>(L.W, R, sinks, L.idx, L.mask, L.dst, L.fill, L.n_kv, L.n_ext,
+                                                                    L.fill_value);
+        } else {
+            inka_bias_mask_kernel<false><<<grid, block, 0, stream>>>(L.W, R, sinks, L.idx, L.mask, L.dst, L.fill, L.n_kv, L.n_ext,
+                                                                     L.fill_value);
+        }
+    }
+    CUDA_CHECK(cudaGetLastError());
+    inka_hits++;
+    return -1;
+}
+
+int ggml_cuda_ink_try_attn_bias(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static bool stats_registered = false;
+    if (!stats_registered) {
+        stats_registered = true;
+        const char * v   = getenv("GGML_CUDA_FUSION_STATS");
+        if (v && atoi(v) != 0) {
+            atexit(inka_print_stats);
+        }
+    }
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (node->op == GGML_OP_PAD) {
+        return inka_decide(cgraph, i);
+    }
+    if (node->op == GGML_OP_SUB) {
+        return inka_launch_at_sub(ctx, cgraph, i);
+    }
+    return 0;
+}
