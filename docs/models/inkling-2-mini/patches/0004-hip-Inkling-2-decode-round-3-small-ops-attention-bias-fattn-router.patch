+        if (o.ctrl_nrm) {
+            ops_ctrl_rows[o.ctrl_nrm] |= 1 << o.ref_row;
+        } else {
+            ggml_cuda_inkling_defer_skip(o.skip0);
+            ggml_cuda_inkling_defer_skip(o.skip1);
+            ops_hits[OPS_MIXNORM]++;
+        }
+    }
+    for (const ggml_tensor * c : skip_conts) {
+        ggml_cuda_inkling_defer_skip(c);
+        ops_hits[OPS_MIXOUT_CONT]++;
+    }
+    return ko - i;
+}
+
+// ---------------------------------------------------------------------------------------------
+// convolve() (inkling2.cpp), single token, with its consumers:
+//   CONCAT(past [3, C] view of the conv history, x^T [1, C]) ; VIEW(concat, last 3) -> CPY into the conv state ;
+//   SSM_CONV(concat, w) -> [dynamic taps: 4 x (CONT(window), MUL(window, tap), ADD)] -> ADD(x, conv) -> SCALE
+//   tails: residual  ADD(resid, SCALE)
+//          K         clip (SQR .. MUL) -> VIEW -> SET_ROWS into the f16 KV cache
+//          V         RMS_NORM -> VIEW -> SET_ROWS into the f16 KV cache
+// One kernel per convolution. Arithmetic as compiled for gfx90a in the original kernels (checked in the disassembly):
+//   ssm_conv_f32   rounded products added in order to 0, then + bias (0)
+//   k_bin_bcast    MUL / ADD nodes: one rounded operation each
+//   scale_f32      fma(scale, x, bias)
+//   reduce_rows_f32 + block_reduce (clip) and rms_norm_f32<float, 32, 1, true> (V): 32-lane group sums, see the kernels
+// ---------------------------------------------------------------------------------------------
+
+struct ink_conv_args {
+    const float   * x;        // [C] current input
+    const float   * past;     // [3, C] history, row stride past_nb1 floats
+    int64_t         past_nb1;
+    const float   * w;        // [4, C] taps, row stride w_nb1 floats
+    int64_t         w_nb1;
+    float         * state;    // [3*C] new conv state
+    const float   * taps;     // dynamic taps [4, n_heads] contiguous, or nullptr
+    int             C;
+    int             hd;       // channels per head
+    float           s_scale;
+    float           s_bias;
+    // plain / residual
+    float         * dst;      // SCALE output or nullptr
+    const float   * resid;
+    float         * dst2;     // ADD(resid, SCALE) output or nullptr
+    // K / V tail
+    const int64_t * idx;      // cache row index
+    half          * cache;    // f16 cache base or nullptr (verify)
+    int64_t         cache_s1; // elements per cache row
+    float           c_scale, c_bias, c_fill, c_lo, c_hi; // clip
+    float           eps;                                 // rms norm
+    float         * dbg_scl;  // verify only
+    float         * dbg_out;  // verify only
+};
+
+template <bool DYN>
+static __device__ __forceinline__ float ink_conv_eval(const ink_conv_args & a, const int c) {
+    const float * pr = a.past + (int64_t) c*a.past_nb1;
+    const float * wr = a.w + (int64_t) c*a.w_nb1;
+    const float p0 = pr[0];
+    const float p1 = pr[1];
+    const float p2 = pr[2];
+    const float xc = a.x[c];
+    const float w0 = wr[0];
+    const float w1 = wr[1];
+    const float w2 = wr[2];
+    const float w3 = wr[3];
+    float t0 = 0.0f, t1 = 0.0f, t2 = 0.0f, t3 = 0.0f;
+    if constexpr (DYN) {
+        const float * tr = a.taps + (c / a.hd)*4;
+        t0 = tr[0];
+        t1 = tr[1];
+        t2 = tr[2];
+        t3 = tr[3];
+    }
+    a.state[c*3 + 0] = p1;
+    a.state[c*3 + 1] = p2;
+    a.state[c*3 + 2] = xc;
+    float y;
+    {
+#pragma clang fp contract(off)
+        float sumf = 0.0f + p0*w0;
+        sumf = sumf + p1*w1;
+        sumf = sumf + p2*w2;
+        sumf = sumf + xc*w3;
+        sumf = sumf + 0.0f; // bias
+        if constexpr (DYN) {
+            // lag 0..3: window = concat[c][3 - lag], out = out + window*tap[lag]
+            sumf = sumf + xc*t0;
+            sumf = sumf + p2*t1;
+            sumf = sumf + p1*t2;
+            sumf = sumf + p0*t3;
+        }
+        y = xc + sumf;
+    }
+    return fmaf(a.s_scale, y, a.s_bias);
+}
+
+template <bool DYN>
+static __global__ void ink_conv_plain(const ink_conv_args a) {
+    const int c = blockIdx.x*blockDim.x + threadIdx.x;
+    if (c >= a.C) {
+        return;
+    }
+    float r = 0.0f;
+    if (a.resid) {
+        r = a.resid[c];
+    }
+    const float v = ink_conv_eval<DYN>(a, c);
+    if (a.dst) {
+        a.dst[c] = v;
+    }
+    if (a.dst2) {
+        a.dst2[c] = r + v;
+    }
+}
+
+// K: one 128-thread block per head. clip: reduce_rows_f32 with a 512-thread block has thread col hold xs[col]^2 (zeros past
+// ncols = 128); block_reduce sums 32-lane groups and then the group sums v0..v15 (zeros from v4): (v0 + v2) + (v1 + v3).
+template <bool DYN>
+static __global__ void __launch_bounds__(128) ink_conv_k(const ink_conv_args a) {
+    const int h   = blockIdx.x;
+    const int col = threadIdx.x;
+    const int c   = h*128 + col;
+    const float xs = ink_conv_eval<DYN>(a, c);
+    float v;
+    {
+#pragma clang fp contract(off)
+        v = xs * xs;
+    }
+    {
+        float t[1] = { v };
+        ink_reduce_xor<1, 32>(t);
+        v = t[0];
+    }
+    __shared__ float gs[4];
+    if (col % 32 == 0) {
+        gs[col / 32] = v;
+    }
+    __syncthreads();
+    const float sum    = (gs[0] + gs[2]) + (gs[1] + gs[3]);
+    const float norm   = sqrtf(sum);
+    const float normb  = fmaf(a.c_scale, norm, a.c_bias);
+    const float factor = a.c_fill / normb;
+    const float cl     = fminf(fmaxf(factor, a.c_lo), a.c_hi);
+    float val;
+    {
+#pragma clang fp contract(off)
+        val = xs * cl;
+    }
+    if (a.cache) {
+        const int64_t row = a.idx[0];
+        a.cache[row*a.cache_s1 + c] = ggml_cuda_cast<half>(val);
+    }
+    if (a.dbg_scl) {
+        a.dbg_scl[c] = xs;
+        a.dbg_out[c] = val;
+    }
+}
+
+// V: rms_norm_f32<float, 32, 1, true>: one 32-thread block per head, thread tid holds float4 tid of the row
+template <bool DYN>
+static __global__ void __launch_bounds__(32) ink_conv_v(const ink_conv_args a) {
+    const int h   = blockIdx.x;
+    const int tid = threadIdx.x;
+    const int c   = h*128 + 4*tid;
+    const float x0 = ink_conv_eval<DYN>(a, c + 0);
+    const float x1 = ink_conv_eval<DYN>(a, c + 1);
+    const float x2 = ink_conv_eval<DYN>(a, c + 2);
+    const float x3 = ink_conv_eval<DYN>(a, c + 3);
+    float tmp;
+    {
+#pragma clang fp contract(off)
+        const float q0 = x0 * x0;
+        const float q1 = x1 * x1;
+        const float q2 = x2 * x2;
+        const float q3 = x3 * x3;
+        tmp = q0 + q1;
+        tmp = tmp + q2;
+        tmp = tmp + q3;
+    }
+    {
+        float t[1] = { tmp };
+        ink_reduce_xor<1, 32>(t);
+        tmp = t[0];
+    }
+    const float scale = rsqrtf(tmp / a.hd + a.eps);
+    float r0, r1, r2, r3;
+    {
+#pragma clang fp contract(off)
+        r0 = scale * x0;
+        r1 = scale * x1;
+        r2 = scale * x2;
+        r3 = scale * x3;
+    }
+    if (a.cache) {
+        const int64_t row = a.idx[0];
+        half * d = a.cache + row*a.cache_s1 + c;
+        d[0] = ggml_cuda_cast<half>(r0);
+        d[1] = ggml_cuda_cast<half>(r1);
+        d[2] = ggml_cuda_cast<half>(r2);
+        d[3] = ggml_cuda_cast<half>(r3);
+    }
+    if (a.dbg_scl) {
+        a.dbg_scl[c + 0] = x0;
+        a.dbg_scl[c + 1] = x1;
+        a.dbg_scl[c + 2] = x2;
+        a.dbg_scl[c + 3] = x3;
+        a.dbg_out[c + 0] = r0;
+        a.dbg_out[c + 1] = r1;
+        a.dbg_out[c + 2] = r2;
+        a.dbg_out[c + 3] = r3;
+    }
+}
+
+enum ops_conv_tail { OPS_TAIL_NONE, OPS_TAIL_RESID, OPS_TAIL_K, OPS_TAIL_V };
+
+struct ops_conv_launch {
+    ink_conv_args a;
+    int           tail;
+    bool          dyn;
+    int           n_heads;
+    bool          verify;
+};
+
+static std::unordered_map<const ggml_tensor *, ops_conv_launch> ops_conv_pending;
+
+static void ops_conv_do_launch(ggml_backend_cuda_context & ctx, const ops_conv_launch & L) {
+    cudaStream_t stream = ctx.stream();
+    const ink_conv_args & a = L.a;
+    if (L.tail == OPS_TAIL_K) {
+        if (L.dyn) {
+            ink_conv_k<true><<<L.n_heads, 128, 0, stream>>>(a);
+        } else {
+            ink_conv_k<false><<<L.n_heads, 128, 0, stream>>>(a);
+        }
+    } else if (L.tail == OPS_TAIL_V) {
+        if (L.dyn) {
+            ink_conv_v<true><<<L.n_heads, 32, 0, stream>>>(a);
+        } else {
+            ink_conv_v<false><<<L.n_heads, 32, 0, stream>>>(a);
+        }
+    } else {
+        const int threads = 256;
+        if (L.dyn) {
+            ink_conv_plain<true><<<(a.C + threads - 1)/threads, threads, 0, stream>>>(a);
+        } else {
+            ink_conv_plain<false><<<(a.C + threads - 1)/threads, threads, 0, stream>>>(a);
+        }
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+#define OPS_CONV_REJECT() do { if (ops_debug()) { fprintf(stderr, "ink ops conv reject line %d at node %d %s\n", __LINE__, i, cat->name); } return 0; } while (0)
+
+static const ggml_tensor * ops_strip_reshape(const ggml_tensor * t) {
+    while (t && t->op == GGML_OP_RESHAPE) {
+        t = t->src[0];
+    }
+    return t;
+}
+
+static int ops_try_conv(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on        = ops_env_on("GGML_CUDA_INK_CONV") && ops_env_on("GGML_CUDA_INK_SCONV");
+    static const bool resadd_on = ops_env_on("GGML_CUDA_INK_RESADD");
+    static const bool kv_on     = ops_env_on("GGML_CUDA_INK_KVTAIL");
+    static const bool dconv_on  = ops_env_on("GGML_CUDA_INK_DCONV");
+    static const bool early_on  = ops_env_on("GGML_CUDA_INK_CONV_EARLY");
+    if (!on) {
+        return 0;
+    }
+    ggml_tensor * cat = cgraph->nodes[i];
+    if (cat->op != GGML_OP_CONCAT || ggml_get_op_params_i32(cat, 0) != 0 || cat->type != GGML_TYPE_F32 || cat->ne[0] != 4 ||
+        cat->ne[2] != 1 || cat->ne[3] != 1 || !ggml_is_contiguous(cat)) {
+        return 0;
+    }
+    const ggml_tensor * past = cat->src[0];
+    const ggml_tensor * xt   = cat->src[1];
+    const int64_t C = cat->ne[1];
+    if (past->type != GGML_TYPE_F32 || past->ne[0] != 3 || past->ne[1] != C || past->nb[0] != sizeof(float) ||
+        past->nb[1] % sizeof(float) != 0 || !past->data ||
+        xt->op != GGML_OP_TRANSPOSE || xt->ne[0] != 1 || xt->ne[1] != C || xt->nb[1] != sizeof(float) || xt->type != GGML_TYPE_F32) {
+        OPS_CONV_REJECT();
+    }
+    const ggml_tensor * x = ops_strip_reshape(xt->src[0]);
+    if (ggml_nelements(x) != C || !ggml_is_contiguous(x) || x->type != GGML_TYPE_F32 || x->data != xt->data) {
+        OPS_CONV_REJECT();
+    }
+
+    // state store and SSM_CONV
+    ggml_tensor * sview = nullptr;
+    ggml_tensor * scpy  = nullptr;
+    ggml_tensor * conv  = nullptr;
+    int i_cpy = -1, i_conv = -1;
+    const int i_lim = std::min(cgraph->n_nodes, i + 400);
+    for (int k = i + 1; k < i_lim; ++k) {
+        ggml_tensor * nd = cgraph->nodes[k];
+        if (!sview && nd->op == GGML_OP_VIEW && nd->view_src == cat && nd->ne[0] == 3) {
+            sview = nd;
+        } else if (sview && !scpy && nd->op == GGML_OP_CPY && nd->src[0] == sview) {
+            scpy  = nd;
+            i_cpy = k;
+        } else if (!conv && nd->op == GGML_OP_SSM_CONV && nd->src[0] == cat) {
+            conv   = nd;
+            i_conv = k;
+        }
+        if (scpy && conv) {
+            break;
+        }
+    }
+    if (!sview || !scpy || !conv || i_cpy > i_conv) {
+        OPS_CONV_REJECT();
+    }
+    const ggml_tensor * sdst = scpy->src[1];
+    if (sview->ne[1] != C || sview->view_offs != sizeof(float) || sview->nb[1] != cat->nb[1] ||
+        sdst->type != GGML_TYPE_F32 || ggml_nelements(sdst) != 3*C || !ggml_is_contiguous(sdst) || scpy->data != sdst->data) {
+        OPS_CONV_REJECT();
+    }
+    const ggml_tensor * w = conv->src[1];
+    if (w->type != GGML_TYPE_F32 || w->ne[0] != 4 || w->ne[1] != C || w->nb[0] != sizeof(float) || w->nb[1] % sizeof(float) != 0 ||
+        conv->ne[0] != C || conv->ne[1] != 1 || conv->type != GGML_TYPE_F32 || conv->src[2]) {
+        OPS_CONV_REJECT();
+    }
+
+    std::vector<int> body = { i, i_cpy, i_conv }; // computed nodes of the fusion
+    // dynamic taps: 4 x (CONT(TRANSPOSE(VIEW(cat, lag))), MUL(window, tap), ADD(out, term))
+    const ggml_tensor * out    = conv;
+    const ggml_tensor * taps   = nullptr;
+    int                 i_taps = -1;
+    int                 n_heads = 0;
+    int                 i_first_mul = -1;
+    bool                dyn = false;
+    int k = ops_next(cgraph, i_conv);
+    if (k < 0) {
+        OPS_CONV_REJECT();
+    }
+    if (cgraph->nodes[k]->op == GGML_OP_CONT) {
+        if (!dconv_on) {
+            return 0;
+        }
+        dyn = true;
+        for (int lag = 0; lag < 4; ++lag) {
+            const ggml_tensor * ct = cgraph->nodes[k];
+            const ggml_tensor * tr = ct->src[0];
+            const ggml_tensor * vw = tr && tr->op == GGML_OP_TRANSPOSE ? tr->src[0] : nullptr;
+            if (ct->op != GGML_OP_CONT || !vw || vw->op != GGML_OP_VIEW || vw->view_src != cat || vw->ne[0] != 1 || vw->ne[1] != C ||
+                vw->nb[1] != cat->nb[1] || vw->view_offs != (size_t) (3 - lag)*sizeof(float) || ggml_nelements(ct) != C ||
+                ct->type != GGML_TYPE_F32) {
+                OPS_CONV_REJECT();
+            }
+            body.push_back(k);
+            k = ops_next(cgraph, k);
+            // the MUL_MAT that produces the taps may sit here (it is not part of the fusion)
+            if (lag == 0 && k >= 0 && cgraph->nodes[k]->op == GGML_OP_MUL_MAT) {
+                i_taps = k;
+                k = ops_next(cgraph, k);
+            }
+            if (k < 0) {
+                OPS_CONV_REJECT();
+            }
+            const ggml_tensor * mul = cgraph->nodes[k];
+            const ggml_tensor * tv  = mul->src[1];
+            if (mul->op != GGML_OP_MUL || ops_strip_reshape(mul->src[0]) != ct || !tv || tv->op != GGML_OP_VIEW || !tv->view_src ||
+                tv->type != GGML_TYPE_F32 || tv->ne[0] != 1 || tv->ne[2] != 1 || tv->ne[3] != 1 || tv->nb[1] != 4*sizeof(float) ||
+                mul->type != GGML_TYPE_F32 || mul->ne[1] != tv->ne[1] || mul->ne[0]*mul->ne[1] != C || ggml_nelements(mul) != C ||
+                mul->src[0]->ne[0] != mul->ne[0] || mul->src[0]->ne[1] != mul->ne[1]) {
+                OPS_CONV_REJECT();
+            }
+            const ggml_tensor * tb = tv->view_src;
+            if (lag == 0) {
+                taps        = tb;
+                n_heads     = (int) tv->ne[1];
+                i_first_mul = k;
+            }
+            if (tb != taps || tv->ne[1] != n_heads || tv->view_offs != (size_t) lag*sizeof(float)) {
+                OPS_CONV_REJECT();
+            }
+            body.push_back(k);
+            k = ops_next(cgraph, k);
+            if (k < 0) {
+                OPS_CONV_REJECT();
+            }
+            const ggml_tensor * add = cgraph->nodes[k];
+            if (add->op != GGML_OP_ADD || ops_strip_reshape(add->src[0]) != out || ops_strip_reshape(add->src[1]) != mul ||
+                ggml_nelements(add) != C || add->type != GGML_TYPE_F32) {
+                OPS_CONV_REJECT();
+            }
+            body.push_back(k);
+            out = add;
+            k = ops_next(cgraph, k);
+            if (k < 0) {
+                OPS_CONV_REJECT();
+            }
+        }
+        if (!taps || taps->type != GGML_TYPE_F32 || ggml_nelements(taps) != 4*n_heads || !ggml_is_contiguous(taps) || !taps->data ||
+            n_heads <= 0 || C % n_heads != 0) {
+            OPS_CONV_REJECT();
+        }
+        // the taps must have been computed before the launch position (the first MUL)
+        const ggml_tensor * tprod = ops_strip_reshape(taps);
+        bool found = false;
+        for (int m = 0; m < i_first_mul && !found; ++m) {
+            found = cgraph->nodes[m] == tprod;
+        }
+        if (!found && tprod->op != GGML_OP_NONE) {
+            OPS_CONV_REJECT();
+        }
+        GGML_UNUSED(i_taps);
+    }
+    ggml_tensor * add = cgraph->nodes[k];
+    if (add->op != GGML_OP_ADD || ops_strip_reshape(add->src[1]) != out || add->src[0] != x || ggml_nelements(add) != C ||
+        add->type != GGML_TYPE_F32) {
+        OPS_CONV_REJECT();
+    }
+    body.push_back(k);
+    k = ops_next(cgraph, k);
+    if (k < 0) {
+        OPS_CONV_REJECT();
+    }
+    ggml_tensor * scl = cgraph->nodes[k];
+    if (scl->op != GGML_OP_SCALE || scl->src[0] != add || !ggml_is_contiguous(scl) || ggml_nelements(scl) != C ||
+        scl->type != GGML_TYPE_F32) {
+        OPS_CONV_REJECT();
+    }
+    const int i_scl = k;
+    body.push_back(k);
+
+    // tails
+    int                 tail   = OPS_TAIL_NONE;
+    int                 i_last = i_scl;
+    ggml_tensor *       outn   = scl;     // the node whose buffer receives the result
+    const ggml_tensor * resid  = nullptr;
+    const ggml_tensor * setr   = nullptr;
+    const ggml_tensor * clipn[8] = {};
+    const ggml_tensor * vnorm  = nullptr;
+    int                 i_tailref = -1;   // verify: index of the f32 tail result node
+    const int kt = ops_next(cgraph, i_scl);
+    const int64_t hd = dyn ? C / n_heads : 128;
+    if (kt >= 0) {
+        ggml_tensor * tn = cgraph->nodes[kt];
+        const ggml_tensor * rs = tn->src[0];
+        const bool rs_ok = rs && rs->op == GGML_OP_RESHAPE && rs->src[0] == scl && rs->ne[0] == 128 && rs->ne[0]*rs->ne[1] == C &&
+                           ggml_nelements(rs) == C && (!dyn || rs->ne[0] == hd);
+        if (resadd_on && tn->op == GGML_OP_ADD && tn->src[1] == scl && tn->src[0] != scl && tn->src[0]->type == GGML_TYPE_F32 &&
+            ggml_nelements(tn->src[0]) == C && ggml_is_contiguous(tn->src[0]) && tn->type == GGML_TYPE_F32 &&
+            ggml_nelements(tn) == C && ggml_is_contiguous(tn) && ggml_node_get_use_count(cgraph, i_scl) == 1 &&
+            !(scl->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            tail   = OPS_TAIL_RESID;
+            resid  = tn->src[0];
+            outn   = tn;
+            i_last = kt;
+            body.push_back(kt);
+        } else if (kv_on && rs_ok && tn->op == GGML_OP_SQR) {
+            // clip: SQR SUM_ROWS SQRT SCALE FILL DIV CLAMP MUL
+            const ggml_op seq[8] = { GGML_OP_SQR, GGML_OP_SUM_ROWS, GGML_OP_SQRT, GGML_OP_SCALE, GGML_OP_FILL, GGML_OP_DIV, GGML_OP_CLAMP, GGML_OP_MUL };
+            int idx[8];
+            int q = kt;
+            bool ok = true;
+            for (int s = 0; s < 8 && ok; ++s) {
+                if (s > 0) {
+                    q = ops_next(cgraph, q);
+                }
+                ok = q >= 0 && cgraph->nodes[q]->op == seq[s];
+                if (ok) {
+                    idx[s]   = q;
+                    clipn[s] = cgraph->nodes[q];
+                }
+            }
+            ok = ok && clipn[1]->src[0] == clipn[0] && clipn[2]->src[0] == clipn[1] && clipn[3]->src[0] == clipn[2] &&
+                 clipn[4]->src[0] == clipn[3] && clipn[5]->src[0] == clipn[4] && clipn[5]->src[1] == clipn[3] &&
+                 clipn[6]->src[0] == clipn[5] && clipn[7]->src[0] == rs && clipn[7]->src[1] == clipn[6] &&
+                 clipn[1]->ne[0] == 1 && ggml_nelements(clipn[1]) == rs->ne[1] && ggml_are_same_shape(clipn[7], rs) &&
+                 clipn[7]->type == GGML_TYPE_F32;
+            if (ok) {
+                // reduce_rows_f32 launch configuration (sum_rows_f32_cuda): the 512-thread block form is reproduced
+                const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+                ok = (rs->ne[1] / nsm) < 2;
+            }
+            if (ok) {
+                for (int m = idx[7] + 1; m < std::min(cgraph->n_nodes, idx[7] + 200) && !setr; ++m) {
+                    const ggml_tensor * nd = cgraph->nodes[m];
+                    if (nd->op == GGML_OP_SET_ROWS && nd->src[0]->op == GGML_OP_VIEW && nd->src[0]->src[0] == clipn[7]) {
+                        setr   = nd;
+                        i_last = m;
+                    }
+                }
+            }
+            if (ok && setr) {
+                tail = OPS_TAIL_K;
+                for (int s = 0; s < 8; ++s) {
+                    body.push_back(idx[s]);
+                }
+                body.push_back(i_last);
+                i_tailref = idx[7];
+            } else {
+                setr = nullptr;
+                i_last = i_scl;
+            }
+        } else if (kv_on && rs_ok && tn->op == GGML_OP_RMS_NORM && tn->type == GGML_TYPE_F32 && ggml_are_same_shape(tn, rs) &&
+                   ggml_is_contiguous(tn) && ((uintptr_t) tn->data % 16) == 0 && ((uintptr_t) scl->data % 16) == 0) {
+            // rms_norm_f32_dispatch: vec path with a 32-thread block for ncols = 128 and aligned buffers
+            for (int m = kt + 1; m < std::min(cgraph->n_nodes, kt + 200) && !setr; ++m) {
+                const ggml_tensor * nd = cgraph->nodes[m];
+                if (nd->op == GGML_OP_SET_ROWS && nd->src[0]->op == GGML_OP_VIEW && nd->src[0]->src[0] == tn) {
+                    setr   = nd;
+                    i_last = m;
+                }
+            }
+            if (setr) {
+                tail  = OPS_TAIL_V;
+                vnorm = tn;
+                body.push_back(kt);
+                body.push_back(i_last);
+                i_tailref = kt;
+            }
+        }
+    }
+    if (tail == OPS_TAIL_K || tail == OPS_TAIL_V) {
+        const ggml_tensor * sv   = setr->src[0];
+        const ggml_tensor * sidx = setr->src[1];
+        if (sv->view_offs != 0 || sv->ne[0] != C || ggml_nelements(sv) != C || sidx->type != GGML_TYPE_I64 ||
+            ggml_nelements(sidx) != 1 || !sidx->data || setr->type != GGML_TYPE_F16 || setr->ne[0] != C || setr->ne[2] != 1 ||
+            setr->ne[3] != 1 || setr->nb[0] != sizeof(half) || setr->nb[1] % sizeof(half) != 0 || !setr->data) {
+            OPS_CONV_REJECT();
+        }
+        outn = const_cast<ggml_tensor *>(setr);
+    }
+
+    // every fused node except the result must be used only inside the fusion (through views as well)
+    ops_set fused;
+    for (int m : body) {
+        fused.insert(cgraph->nodes[m]);
+    }
+    {
+        ops_set inside = fused;
+        inside.erase(outn);
+        inside.erase(scpy);
+        for (int m = i + 1; m <= i_last; ++m) {
+            const ggml_tensor * nd = cgraph->nodes[m];
+            if ((nd->op == GGML_OP_RESHAPE || nd->op == GGML_OP_VIEW || nd->op == GGML_OP_PERMUTE || nd->op == GGML_OP_TRANSPOSE) &&
+                nd->src[0] && inside.count(nd->src[0])) {
+                inside.insert(nd);
+            }
+        }
+        for (int m = i; m <= i_last; ++m) {
+            const ggml_tensor * nd = cgraph->nodes[m];
+            if (!inside.count(nd)) {
+                continue;
+            }
+            if (nd->flags & GGML_TENSOR_FLAG_OUTPUT) {
+                OPS_CONV_REJECT();
+            }
+            int uses = 0;
+            for (int m2 = m + 1; m2 <= i_last; ++m2) {
+                const ggml_tensor * u = cgraph->nodes[m2];
+                if (!inside.count(u) && u != outn && u != scpy) {
+                    continue;
+                }
+                for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                    if (u->src[s] == nd) {
+                        uses++;
+                    }
+                }
+            }
+            if (uses != ggml_node_get_use_count(cgraph, m)) {
+                OPS_CONV_REJECT();
+            }
+        }
+    }
+
+    // launch position: dynamic at the first MUL (taps computed); plain at the SSM_CONV when the inputs survive until
+    // there and the state can be stored late, otherwise right here at the CONCAT
+    const bool verify = ops_verify();
+    int Lp = dyn ? i_first_mul : i_conv;
+    auto inputs_ok = [&](int lp) {
+        return ops_unmodified_between(cgraph, i, lp, x, fused) && ops_unmodified_between(cgraph, i, lp, past, fused) &&
+               ops_write_window_free(cgraph, i, lp, sdst, fused);
+    };
+    if (!inputs_ok(Lp)) {
+        if (dyn || !early_on) {
+            OPS_CONV_REJECT();
+        }
+        Lp = i;
+    }
+    auto outputs_ok = [&](int lp) {
+        // the result buffer is written at lp instead of at i_last
+        if (!ops_write_window_free(cgraph, lp, i_last, outn, fused)) {
+            return false;
+        }
+        if (resid) {
+            for (int m = lp; m <= i_last; ++m) {
+                const ggml_tensor * nd = cgraph->nodes[m];
+                if (nd == resid || nd == ops_strip_reshape(resid) || (!fused.count(nd) && !ops_is_noop(nd) && ops_overlap(nd, resid))) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    };
+    if (!outputs_ok(Lp)) {
+        if (Lp == i || dyn || !early_on || !outputs_ok(i)) {
+            OPS_CONV_REJECT();
+        }
+        Lp = i;
+    }
+    // launched at the CONCAT: the state is stored here instead of at the CPY, nothing in between may touch it
+    if (Lp == i && !ops_write_window_free(cgraph, i, i_cpy, sdst, fused)) {
+        OPS_CONV_REJECT();
+    }
+    // aliasing: a thread reads x[c] / resid[c] before it writes its own element, so exact aliasing of the f32 result is fine
+    auto alias_ok = [&](const ggml_tensor * o, const ggml_tensor * in) {
+        return !ops_overlap(o, in) || (o->data == in->data && ggml_nbytes(o) == ggml_nbytes(in) && o->type == GGML_TYPE_F32);
+    };
+    if (!alias_ok(outn, x) || (resid && !alias_ok(outn, resid)) || ops_overlap(outn, past) || ops_overlap(outn, w) ||
+        ops_overlap(outn, sdst) || ops_overlap(sdst, x) || ops_overlap(sdst, past) || ops_overlap(sdst, w) ||
+        (resid && ops_overlap(sdst, resid)) || (taps && (ops_overlap(outn, taps) || ops_overlap(sdst, taps)))) {
+        OPS_CONV_REJECT();
+    }
+    if (tail == OPS_TAIL_K || tail == OPS_TAIL_V) {
+        if (hd != 128 || C % 128 != 0 || ops_overlap(setr, setr->src[1])) {
+            OPS_CONV_REJECT();
+        }
+    }
+
+    ops_conv_launch L = {};
+    ink_conv_args & a = L.a;
+    a.x        = (const float *) x->data;
+    a.past     = (const float *) past->data;
+    a.past_nb1 = past->nb[1]/sizeof(float);
+    a.w        = (const float *) w->data;
+    a.w_nb1    = w->nb[1]/sizeof(float);
+    a.state    = (float *) sdst->data;
+    a.taps     = taps ? (const float *) taps->data : nullptr;
+    a.C        = (int) C;
+    a.hd       = (int) hd;
+    a.s_scale  = ops_param_f32(scl, 0);
+    a.s_bias   = ops_param_f32(scl, 1);
+    if (tail == OPS_TAIL_NONE) {
+        a.dst = (float *) scl->data;
+    } else if (tail == OPS_TAIL_RESID) {
+        a.resid = (const float *) resid->data;
+        a.dst2  = (float *) outn->data;
+    } else {
+        a.idx      = (const int64_t *) setr->src[1]->data;
+        a.cache    = (half *) setr->data;
+        a.cache_s1 = setr->nb[1]/sizeof(half);
+        if (tail == OPS_TAIL_K) {
+            a.c_scale = ops_param_f32(clipn[3], 0);
+            a.c_bias  = ops_param_f32(clipn[3], 1);
+            a.c_fill  = ops_param_f32(clipn[4], 0);
+            a.c_lo    = ops_param_f32(clipn[6], 0);
+            a.c_hi    = ops_param_f32(clipn[6], 1);
+        } else {
+            a.eps = ops_param_f32(vnorm, 0);
+        }
+    }
+    L.tail    = tail;
+    L.dyn     = dyn;
+    L.n_heads = (int) (C / 128);
+    L.verify  = verify;
+    if (verify) {
+        float * dbg = nullptr;
+        CUDA_CHECK(cudaMalloc(&dbg, 5*C*sizeof(float)));
+        a.state = dbg;
+        char name[40];
+        const int base = 76 + (dyn ? 4 : 0) + tail; // 76..83
+        static const char * tnames[4] = { "plain", "resid", "k", "v" };
+        snprintf(name, sizeof(name), "conv%s.%s.state", dyn ? "dyn" : "", tnames[tail]);
+        ops_verify_add(dbg, sdst->data, 3*C, std::max(Lp, i_conv), base, name);
+        snprintf(name, sizeof(name), "conv%s.%s.out", dyn ? "dyn" : "", tnames[tail]);
+        if (tail == OPS_TAIL_NONE) {
+            a.dst = dbg + 3*C;
+            ops_verify_add(a.dst, scl->data, C, i_scl, base + 8, name);
+        } else if (tail == OPS_TAIL_RESID) {
+            a.dst2 = dbg + 3*C;
+            ops_verify_add(a.dst2, outn->data, C, i_last, base + 8, name);
+        } else {
+            a.cache   = nullptr;
+            a.dbg_scl = dbg + 3*C;
+            a.dbg_out = dbg + 4*C;
+            ops_verify_add(a.dbg_out, cgraph->nodes[i_tailref]->data, C, i_tailref, base + 8, name);
+        }
+    }
+
+    if (Lp == i) {
+        ops_conv_do_launch(ctx, L);
+        if (verify) {
+            return 0;
+        }
+    } else {
+        ops_conv_pending[cgraph->nodes[Lp]] = L;
+        ops_deferred.push_back({ Lp, x });
+        ops_deferred.push_back({ Lp, past });
+        if (verify) {
+            return 0;
+        }
+    }
+    for (int m : body) {
+        if (m != i && m != Lp) {
+            ggml_cuda_inkling_defer_skip(cgraph->nodes[m]);
+        }
+    }
+    ops_hits[tail == OPS_TAIL_RESID ? OPS_RESADD : tail == OPS_TAIL_K ? OPS_KTAIL : tail == OPS_TAIL_V ? OPS_VTAIL : OPS_CONV]++;
+    if (dyn) {
+        ops_hits[OPS_DCONV]++;
+    }
+    return -1; // the CONCAT is never materialized
+}
+
+static int ops_launch_conv(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    auto it = ops_conv_pending.find(cgraph->nodes[i]);
+    if (it == ops_conv_pending.end()) {
+        return 0;
+    }
+    const ops_conv_launch L = it->second;
+    ops_conv_pending.erase(it);
+    ops_conv_do_launch(ctx, L);
+    return L.verify ? 0 : -1;
+}
+
+static int ops_try_mixout(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    return ops_mixout_impl(&ctx, cgraph, i, nullptr);
+}
+
+// `t` holds a mixed row (the final MUL_MAT of a mix with one query, or a CONT copy of one of its rows): can that mix
+// write the RMS_NORM output `cn` (node kn) of control() early, i.e. is cn's buffer free from the mix to the RMS_NORM?
+static bool ops_ctrl_row_from_mix(const ggml_cgraph * cgraph, const ggml_tensor * t, const ggml_tensor * cat, const ggml_tensor * cn, int kn) {
+    ops_elided_prepare(cgraph);
+    const ggml_tensor * mo = t;
+    if (t->op == GGML_OP_CONT && t->src[0] && t->src[0]->op == GGML_OP_VIEW) {
+        mo = t->src[0]->src[0];
+    }
+    auto it = ops_mix_spans.find(mo);
+    if (it == ops_mix_spans.end() || (mo == t && mo->ne[1] != 1)) {
+        return false;
+    }
+    ops_set f;
+    for (int m = it->second.first; m <= it->second.second; ++m) {
+        if (!ops_is_noop(cgraph->nodes[m])) {
+            f.insert(cgraph->nodes[m]);
+        }
+    }
+    f.insert(cat);
+    f.insert(cn);
+    return !ops_overlap(cn, mo) && ops_untouched_between(cgraph, it->second.first, kn, cn, f);
+}
+
+static int ops_ctrl_norm_match(const ggml_cgraph * cgraph, int i);
+
+static void ops_elided_prepare(const ggml_cgraph * cgraph) {
+    if (ops_elided_graph == cgraph) {
+        return;
+    }
+    ops_elided_graph = cgraph;
+    ops_elided.clear();
+    ops_mix_spans.clear();
+    static const bool on = ops_env_on("GGML_CUDA_INK_ELIDED");
+    if (!on || ops_verify()) {
+        return; // in verify mode every original node runs
+    }
+    std::vector<const ggml_tensor *> nodes;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * nd = cgraph->nodes[i];
+        if (nd->op != GGML_OP_CONCAT && nd->op != GGML_OP_RMS_NORM) {
+            continue;
+        }
+        nodes.clear();
+        if (nd->op == GGML_OP_CONCAT && ops_ctrl_norm_match(cgraph, i) >= 0) {
+            ops_elided.insert(nd); // the CONCAT of control() is never materialized
+            continue;
+        }
+        const int consumed = ops_mixout_impl(nullptr, const_cast<ggml_cgraph *>(cgraph), i, &nodes);
+        if (consumed > 0) {
+            ops_elided.insert(nodes.begin(), nodes.end());
+            ops_mix_spans[cgraph->nodes[i + consumed]] = { i, i + consumed };
+            i += consumed - 1;
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// control(): CONCAT(cur, message) -> RMS_NORM over the two rows (same fusion as ink_try_ctrl_norm of inkling-fuse.cu,
+// taken over here so that the match below is the single place that decides whether the CONCAT is materialized).
+// rms_norm_f32<float, 1024, 1, true> per row; one 576-thread block per row, DPP shuffles as in ink_mixl_kernel.
+// ---------------------------------------------------------------------------------------------
+
+static __global__ void __launch_bounds__(576) ink_ctrl_norm2(const float * a, const float * b, float * dst, const float eps) {
+    constexpr int n = 2304;
+    const int row  = blockIdx.x;
+    const int tid  = threadIdx.x;
+    const int lane = tid & 63;
+    const float * x = row == 0 ? a : b;
+    __shared__ float chunk[32];
+
+    const float4 xs = ((const float4 *) x)[tid];
+    float t[1];
+    {
+#pragma clang fp contract(off)
+        const float qx = xs.x * xs.x;
+        const float qy = xs.y * xs.y;
+        const float qz = xs.z * xs.z;
+        const float qw = xs.w * xs.w;
+        float tmp = qx + qy;
+        tmp = tmp + qz;
+        tmp = tmp + qw;
+        t[0] = tmp;
+    }
+    ink_reduce_xor<1, 32>(t);
+    if ((lane & 31) == 0) {
+        chunk[tid >> 5] = t[0];
+    }
+    __syncthreads();
+    const int gl = lane & 31;
+    float v[1] = { chunk[gl < 18 ? gl : 17] };
+    v[0] = gl < 18 ? v[0] : 0.0f;
+    ink_reduce_xor<1, 32>(v);
+    const float scale = rsqrtf(v[0] / n + eps);
+    ((float4 *) (dst + (int64_t) row*n))[tid] = make_float4(scale*xs.x, scale*xs.y, scale*xs.z, scale*xs.w);
+}
+
+static int ops_mixout_impl(ggml_backend_cuda_context * pctx, ggml_cgraph * cgraph, int i, std::vector<const ggml_tensor *> * dry);
+static int ops_ctrl_norm_match_raw(const ggml_cgraph * cgraph, int i);
+
+// structural match; returns the RMS_NORM index or -1. A mix over two states starts with the same two nodes: the mix wins.
+static int ops_ctrl_norm_match(const ggml_cgraph * cgraph, int i) {
+    const int j = ops_ctrl_norm_match_raw(cgraph, i);
+    if (j < 0) {
+        return -1;
+    }
+    std::vector<const ggml_tensor *> nodes;
+    if (ops_mixout_impl(nullptr, const_cast<ggml_cgraph *>(cgraph), i, &nodes) > 0) {
+        return -1;
+    }
+    return j;
+}
+
+static int ops_ctrl_norm_match_raw(const ggml_cgraph * cgraph, int i) {
+    static const bool on = ops_env_on("GGML_CUDA_INK_CTRL_NORM") && ops_env_on("GGML_CUDA_INK_CTRL_NORM2");
+    const ggml_tensor * cat = cgraph->nodes[i];
+    if (!on || cat->op != GGML_OP_CONCAT || ggml_get_op_params_i32(cat, 0) != 1 || !cat->src[0] || !cat->src[1]) {
+        return -1;
+    }
+    const int j = ops_next(cgraph, i);
+    if (j < 0) {
+        return -1;
+    }
+    const ggml_tensor * nrm = cgraph->nodes[j];
+    const ggml_tensor * a   = cat->src[0];
+    const ggml_tensor * b   = cat->src[1];
+    const int64_t       n   = 2304;
+    if (nrm->op != GGML_OP_RMS_NORM || nrm->src[0] != cat || a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 ||
+        nrm->type != GGML_TYPE_F32 || cat->type != GGML_TYPE_F32 || ggml_nelements(a) != n || ggml_nelements(b) != n ||
+        a->ne[0] != n || b->ne[0] != n || !ggml_is_contiguous(a) || !ggml_is_contiguous(b) || !ggml_is_contiguous(nrm) ||
+        cat->ne[0] != n || cat->ne[1] != 2 || ggml_nelements(cat) != 2*n || ggml_nelements(nrm) != 2*n || nrm->ne[0] != n ||
+        ((uintptr_t) a->data % 16) || ((uintptr_t) b->data % 16) || ((uintptr_t) nrm->data % 16) || !a->data || !b->data) {
+        return -1;
+    }
+    // the CONCAT (and anything between it and the RMS_NORM) is used only here
+    for (int m = i; m < j; ++m) {
+        const ggml_tensor * nd = cgraph->nodes[m];
+        int uses = 0;
+        for (int m2 = m + 1; m2 <= j; ++m2) {
+            for (int q = 0; q < GGML_MAX_SRC; ++q) {
+                if (cgraph->nodes[m2]->src[q] == nd) {
+                    uses++;
+                }
+            }
+        }
+        if ((nd->flags & GGML_TENSOR_FLAG_OUTPUT) || uses != ggml_node_get_use_count(cgraph, m)) {
+            return -1;
+        }
+    }
+    if (ops_overlap(nrm, a) || ops_overlap(nrm, b)) {
+        return -1;
+    }
+    return j;
+}
+
+static int ops_try_ctrl_norm(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (ops_verify()) {
+        return 0; // the fusion of inkling-fuse.cu runs (and the original nodes when it is verified)
+    }
+    const int j = ops_ctrl_norm_match(cgraph, i);
+    if (j < 0) {
+        return 0;
+    }
+    const ggml_tensor * cat = cgraph->nodes[i];
+    ggml_tensor *       nrm = cgraph->nodes[j];
+    auto it = ops_ctrl_rows.find(nrm);
+    if (it != ops_ctrl_rows.end() && it->second == 3) {
+        ops_hits[OPS_CTRLNORM]++; // both rows were written by the mix kernels that produced them
+        return j - i;
+    }
+    ink_ctrl_norm2<<<2, 576, 0, ctx.stream()>>>((const float *) cat->src[0]->data, (const float *) cat->src[1]->data,
+                                                (float *) nrm->data, ops_param_f32(nrm, 0));
+    CUDA_CHECK(cudaGetLastError());
+    ops_hits[OPS_CTRLNORM2]++;
+    return j - i;
+}
+
+// ---------------------------------------------------------------------------------------------
+// q8_1 activations for the NVFP4 MoE GEMV (inkling-gemv.cu) written by the kernel that produces the activation
+// instead of a separate quantize_q8_1 launch. Same values as quantize_q8_1: d = max|x| / 127 over each block of 32,
+// q = roundf(x / d), ds = (d, d * sum(q)) (the max and the integer sum do not depend on the reduction order).
+// The buffers are persistent (one per call site of a graph; captured graphs keep the pointers).
+// ---------------------------------------------------------------------------------------------
+
+static std::vector<std::pair<void *, size_t>>         ops_q8_slots;
+static size_t                                         ops_q8_next = 0;
+static std::unordered_map<const ggml_tensor *, void *> ops_q8_ready; // activation tensor -> its q8_1 blocks (this evaluation)
+
+static void * ops_q8_buffer(size_t size) {
+    if (ops_q8_next == ops_q8_slots.size()) {
+        ops_q8_slots.push_back({ nullptr, 0 });
+    }
+    std::pair<void *, size_t> & slot = ops_q8_slots[ops_q8_next++];
+    if (slot.second < size) {
+        // a smaller buffer may still be referenced by a captured graph: it is not freed
+        CUDA_CHECK(cudaMalloc(&slot.first, size));
+        CUDA_CHECK(cudaMemset(slot.first, 0, size));
+        slot.second = size;
+    }
+    return slot.first;
+}
+
+const void * ggml_cuda_ink_ops_q8_lookup(const ggml_tensor * src1) {
+    if (ops_q8_ready.empty()) {
+        return nullptr;
+    }
+    const ggml_tensor * t = src1;
+    while (t) {
+        auto it = ops_q8_ready.find(t);
+        if (it != ops_q8_ready.end()) {
+            return it->second;
+        }
+        if (t->op != GGML_OP_RESHAPE || !t->src[0] || t->src[0]->data != t->data) {
+            break;
+        }
+        t = t->src[0];
+    }
+    return nullptr;
+}
+
+// is `t` (through reshapes) the activation of a single-token NVFP4 MUL_MAT_ID that ink_mmid_nvfp4 will take?
+// returns the number of activation rows (1 or n_used), 0 if not
+static int ops_q8_consumer_rows(const ggml_cgraph * cgraph, int i_t, const ggml_tensor * t, int lim) {
+    static const bool on = ops_env_on("GGML_CUDA_INK_NVFP4") && ops_env_on("GGML_CUDA_INK_Q8");
+    if (!on) {
+        return 0;
+    }
+    for (int m = i_t + 1; m < std::min(cgraph->n_nodes, i_t + lim); ++m) {
+        const ggml_tensor * mm = cgraph->nodes[m];
+        if (mm->op != GGML_OP_MUL_MAT_ID || !mm->src[1] || ops_strip_reshape(mm->src[1]) != t) {
+            continue;
+        }
+        const ggml_tensor * src0 = mm->src[0];
+        const ggml_tensor * src1 = mm->src[1];
+        const ggml_tensor * ids  = mm->src[2];
+        if (src0->type != GGML_TYPE_NVFP4 || src1->type != GGML_TYPE_F32 || src1->data != t->data || !ids ||
+            src1->ne[2] != 1 || src1->ne[3] != 1 || src1->ne[0] != src0->ne[0] || src1->ne[0] % 64 != 0 ||
+            src1->nb[0] != sizeof(float) || !ggml_is_contiguous(src1) || (src1->ne[1] != 1 && src1->ne[1] != ids->ne[0])) {
+            return 0;
+        }
+        return (int) src1->ne[1];
+    }
+    return 0;
+}
+
+template <int CTRL>
+static __device__ __forceinline__ int ink_dpp_i(const int v) {
+    return (int) __builtin_amdgcn_update_dpp(0u, (unsigned int) v, CTRL, 0xF, 0xF, false);
+}
+
+// max / integer sum over the 32-lane group of each lane (any order gives the same result)
+static __device__ __forceinline__ float ink_max32(float v) {
+    v = fmaxf(v, ggml_cuda_shfl_xor(v, 16, 32));
+    v = fmaxf(v, ink_dpp<0x128>(v));
+    v = fmaxf(v, ink_dpp<0x1B>(ink_dpp<0x141>(v)));
+    v = fmaxf(v, ink_dpp<0x4E>(v));
+    v = fmaxf(v, ink_dpp<0xB1>(v));
+    return v;
+}
+
+static __device__ __forceinline__ int ink_isum32(int v) {
+    v += ggml_cuda_shfl_xor(v, 16, 32);
+    v += ink_dpp_i<0x128>(v);
+    v += ink_dpp_i<0x1B>(ink_dpp_i<0x141>(v));
+    v += ink_dpp_i<0x4E>(v);
+    v += ink_dpp_i<0xB1>(v);
+    return v;
+}
+
+// SITU activation (ink_situ_f32 of inkling-fuse.cu) + q8_1 of the result, one thread per element
+static __global__ void __launch_bounds__(256) ink_situ_q8(
+        const float * __restrict__ gu, float * __restrict__ dst, block_q8_1 * __restrict__ y, const int ystride,
+        const int n_ff, const int n_used, const int64_t gu_nb1, const int64_t g_offs, const int64_t u_offs,
+        const float s1, const float b1, const float s2, const float b2,
+        const float s3, const float b3, const float s4, const float b4) {
+    const int  r     = blockIdx.x*blockDim.x + threadIdx.x;
+    const int  e     = blockIdx.y;
+    const bool valid = r < n_ff;
+    const int  rc    = valid ? r : n_ff - 1;
+    const float * row = gu + e*gu_nb1;
+
+    const float g = row[g_offs + rc];
+    const float u = row[u_offs + rc];
+
+    const float tg  = fmaf(s1, g, b1);
+    const float tg2 = tanhf(tg);
+    const float ag  = fmaf(s2, tg2, b2);
+    const float sg  = 1.0f / (1.0f + expf(-g));
+    const float gg  = ag * sg;
+
+    const float tu  = fmaf(s3, u, b3);
+    const float tu2 = tanhf(tu);
+    const float au  = fmaf(s4, tu2, b4);
+
+    const float xi = valid ? gg * au : 0.0f;
+    if (valid) {
+        dst[(int64_t) e*n_ff + r] = xi;
+    }
+
+    const float  amax = ink_max32(fabsf(xi));
+    const float  d    = amax / 127.0f;
+    const int8_t q    = amax == 0.0f ? 0 : roundf(xi / d);
+    const int    sum  = ink_isum32((int) q);
+    if (valid) {
+        block_q8_1 * yb = y + (int64_t) e*ystride + r / QK8_1;
+        yb->qs[r % QK8_1] = q;
+        if (r % QK8_1 == 0) {
+            yb->ds = make_half2(d, d * sum);
+        }
+    }
+}
+
+static int ops_try_situ_q8(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = ops_env_on("GGML_CUDA_INK_SITU") && ops_env_on("GGML_CUDA_INK_SITU_Q8");
+    if (!on || ops_verify()) {
+        return 0; // verify: ink_situ_f32 of inkling-fuse.cu runs; the q8 blocks are checked through the logits md5
+    }
+    const ggml_op seq[] = { GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_MUL,
+                            GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE, GGML_OP_MUL };
+    int idx[9];
+    int k = i;
+    for (int q = 0; q < 9; ++q) {
+        if (q > 0) {
+            k = ops_next(cgraph, k);
+        }
+        if (k < 0 || cgraph->nodes[k]->op != seq[q]) {
+            return 0;
+        }
+        idx[q] = k;
+    }
+    ggml_tensor * n[9];
+    for (int q = 0; q < 9; ++q) {
+        n[q] = cgraph->nodes[idx[q]];
+    }
+    const ggml_tensor * gview = n[0]->src[0];
+    const ggml_tensor * uview = n[5]->src[0];
+    if (gview->op != GGML_OP_VIEW || uview->op != GGML_OP_VIEW || !gview->view_src || gview->view_src != uview->view_src ||
+        gview->src[0] != gview->view_src || uview->src[0] != uview->view_src || n[3]->src[0] != gview ||
+        ggml_get_unary_op(n[1]) != GGML_UNARY_OP_TANH || ggml_get_unary_op(n[3]) != GGML_UNARY_OP_SIGMOID ||
+        ggml_get_unary_op(n[6]) != GGML_UNARY_OP_TANH ||
+        n[1]->src[0] != n[0] || n[2]->src[0] != n[1] || n[4]->src[0] != n[2] || n[4]->src[1] != n[3] ||
+        n[6]->src[0] != n[5] || n[7]->src[0] != n[6] || n[8]->src[0] != n[4] || n[8]->src[1] != n[7]) {
+        return 0;
+    }
+    const ggml_tensor * gu  = gview->view_src;
+    ggml_tensor *       out = n[8];
+
+    const int64_t n_ff   = gview->ne[0];
+    const int64_t n_used = gu->ne[1];
+    if (gu->type != GGML_TYPE_F32 || !ggml_is_contiguous(gu) || gu->ne[2] != 1 || gu->ne[3] != 1 ||
+        gview->ne[1] != n_used || gview->ne[2] != 1 || gview->ne[3] != 1 || uview->ne[0] != n_ff || uview->ne[1] != n_used ||
+        uview->ne[2] != 1 || gview->nb[0] != sizeof(float) || uview->nb[0] != sizeof(float) ||
+        gview->nb[1] != gu->nb[1] || uview->nb[1] != gu->nb[1] ||
+        gview->view_offs % sizeof(float) || uview->view_offs % sizeof(float) ||
+        gview->view_offs + n_ff*sizeof(float) > (size_t) gu->nb[1] || uview->view_offs + n_ff*sizeof(float) > (size_t) gu->nb[1] ||
+        !ggml_is_contiguous(out) || out->ne[0] != n_ff || out->ne[1] != n_used || out->ne[2] != 1 || n_ff % QK8_1 != 0) {
+        return 0;
+    }
+    for (int q = 0; q < 9; ++q) {
+        if (n[q]->type != GGML_TYPE_F32) {
+            return 0;
+        }
+    }
+    // all intermediates are used only inside
+    for (int q = 0; q < 8; ++q) {
+        int uses = 0;
+        for (int q2 = q + 1; q2 < 9; ++q2) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (n[q2]->src[s] == n[q]) {
+                    uses++;
+                }
+            }
+        }
+        if (uses != ggml_node_get_use_count(cgraph, idx[q]) || (n[q]->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return 0;
+        }
+    }
+    if (ops_overlap(out, gu)) {
+        return 0;
+    }
+    // only for the NVFP4 down GEMV with one activation row per expert slot
+    if (ops_q8_consumer_rows(cgraph, idx[8], out, 16) != n_used || n_used < 2) {
+        return 0;
+    }
+    const int64_t K_pad   = GGML_PAD(n_ff, MATRIX_ROW_PADDING);
+    const int     ystride = (int) (K_pad / QK8_1);
+    void * y = ops_q8_buffer((size_t) n_used*ystride*sizeof(block_q8_1));
+
+    const int threads = 256;
+    const dim3 grid((n_ff + threads - 1)/threads, n_used, 1);
+    ink_situ_q8<<<grid, threads, 0, ctx.stream()>>>(
+        (const float *) gu->data, (float *) out->data, (block_q8_1 *) y, ystride, (int) n_ff, (int) n_used,
+        gu->nb[1]/sizeof(float), gview->view_offs/sizeof(float), uview->view_offs/sizeof(float),
+        ops_param_f32(n[0], 0), ops_param_f32(n[0], 1), ops_param_f32(n[2], 0), ops_param_f32(n[2], 1),
+        ops_param_f32(n[5], 0), ops_param_f32(n[5], 1), ops_param_f32(n[7], 0), ops_param_f32(n[7], 1));
+    CUDA_CHECK(cudaGetLastError());
+    ops_q8_ready[out] = y;
+    ops_hits[OPS_SITUQ8]++;
+    return idx[8] - i;
+}
+
+// ---------------------------------------------------------------------------------------------
+// build_norm(): RMS_NORM(x [2304]) -> MUL(norm, weight). The stock kernel (rms_norm_f32<float, 1024, 1, true, true>) is a
+// generic 1024-thread block; this is the same arithmetic in one 576-thread block with DPP shuffles (see ink_mixl_kernel).
+// ---------------------------------------------------------------------------------------------
+
+// Q8: also writes the q8_1 blocks of the result (thread tid holds 4 of the 32 values of block tid / 8)
+template <bool Q8>
+static __global__ void __launch_bounds__(576) ink_norm_mul(const float * x, const float * w, float * dst, const float eps, block_q8_1 * y) {
+    constexpr int n = 2304;
+    const int tid  = threadIdx.x;
+    const int lane = tid & 63;
+    __shared__ float chunk[32];
+
+    const float4 xs = ((const float4 *) x)[tid];
+    const float4 ws = ((const float4 *) w)[tid];
+    float t[1];
+    {
+#pragma clang fp contract(off)
+        const float qx = xs.x * xs.x;
+        const float qy = xs.y * xs.y;
+        const float qz = xs.z * xs.z;
+        const float qw = xs.w * xs.w;
+        float tmp = qx + qy;
+        tmp = tmp + qz;
+        tmp = tmp + qw;
+        t[0] = tmp;
+    }
+    ink_reduce_xor<1, 32>(t);
+    if ((lane & 31) == 0) {
+        chunk[tid >> 5] = t[0];
+    }
+    __syncthreads();
+    const int gl = lane & 31;
+    float v[1] = { chunk[gl < 18 ? gl : 17] };
+    v[0] = gl < 18 ? v[0] : 0.0f;
+    ink_reduce_xor<1, 32>(v);
+    const float scale = rsqrtf(v[0] / n + eps);
+    float4 r = make_float4(scale*xs.x, scale*xs.y, scale*xs.z, scale*xs.w);
+    r.x *= ws.x;
+    r.y *= ws.y;
+    r.z *= ws.z;
+    r.w *= ws.w;
+    ((float4 *) dst)[tid] = r;
+    if constexpr (Q8) {
+        float amax = fmaxf(fmaxf(fabsf(r.x), fabsf(r.y)), fmaxf(fabsf(r.z), fabsf(r.w)));
+        amax = fmaxf(amax, ink_dpp<0x1B>(ink_dpp<0x141>(amax)));
+        amax = fmaxf(amax, ink_dpp<0x4E>(amax));
+        amax = fmaxf(amax, ink_dpp<0xB1>(amax));
+        const float  d  = amax / 127.0f;
+        const int8_t q0 = amax == 0.0f ? 0 : roundf(r.x / d);
+        const int8_t q1 = amax == 0.0f ? 0 : roundf(r.y / d);
+        const int8_t q2 = amax == 0.0f ? 0 : roundf(r.z / d);
+        const int8_t q3 = amax == 0.0f ? 0 : roundf(r.w / d);
+        int sum = (int) q0 + (int) q1 + (int) q2 + (int) q3;
+        sum += ink_dpp_i<0x1B>(ink_dpp_i<0x141>(sum));
+        sum += ink_dpp_i<0x4E>(sum);
+        sum += ink_dpp_i<0xB1>(sum);
+        block_q8_1 * yb = y + (tid >> 3);
+        const uint32_t packed = (uint32_t) (uint8_t) q0 | ((uint32_t) (uint8_t) q1 << 8) | ((uint32_t) (uint8_t) q2 << 16) |
+                                ((uint32_t) (uint8_t) q3 << 24);
+        *(uint32_t *) (yb->qs + (tid & 7)*4) = packed;
+        if ((tid & 7) == 0) {
+            yb->ds = make_half2(d, d * sum);
+        }
+    }
+}
+
+static int ops_try_norm_mul(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = ops_env_on("GGML_CUDA_INK_NORM_MUL");
+    if (!on) {
+        return 0;
+    }
+    const ggml_tensor * nrm = cgraph->nodes[i];
+    const ggml_tensor * x   = nrm->src[0];
+    const int64_t       n   = 2304;
+    if (nrm->op != GGML_OP_RMS_NORM || !x || x->type != GGML_TYPE_F32 || nrm->type != GGML_TYPE_F32 || ggml_nelements(x) != n ||
+        x->ne[0] != n || nrm->ne[0] != n || !ggml_is_contiguous(x) || !ggml_is_contiguous(nrm) || !x->data ||
+        ((uintptr_t) x->data % 16) || ((uintptr_t) nrm->data % 16) || ggml_node_get_use_count(cgraph, i) != 1 ||
+        (nrm->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    const int k = ops_next(cgraph, i);
+    if (k < 0) {
+        return 0;
+    }
+    ggml_tensor *       mul = cgraph->nodes[k];
+    const ggml_tensor * wt  = mul->src[1];
+    // all buffers 16-byte aligned: the stock kernel takes its float4 path with a 1024-thread block for 512 < n/4 <= 1024
+    if (mul->op != GGML_OP_MUL || mul->src[0] != nrm || !wt || wt->type != GGML_TYPE_F32 || ggml_nelements(wt) != n ||
+        wt->ne[0] != n || !ggml_is_contiguous(wt) || !wt->data || ((uintptr_t) wt->data % 16) || mul->type != GGML_TYPE_F32 ||
+        ggml_nelements(mul) != n || !ggml_is_contiguous(mul) || ((uintptr_t) mul->data % 16)) {
+        return 0;
+    }
+    // nodes between the RMS_NORM and the MUL are views; x and the weight are read before the barrier, dst is written after it
+    float * dst = (float *) mul->data;
+    const bool verify = ops_verify();
+    if (verify) {
+        CUDA_CHECK(cudaMalloc(&dst, n*sizeof(float)));
+        ops_verify_add(dst, mul->data, (int) n, k, 75, "norm_mul");
+    }
+    // the NVFP4 gate/up GEMV quantizes this vector to q8_1: do it here
+    void * y = nullptr;
+    if (!verify && ops_q8_consumer_rows(cgraph, k, mul, 64) == 1) {
+        y = ops_q8_buffer((size_t) (GGML_PAD(n, MATRIX_ROW_PADDING) / QK8_1)*sizeof(block_q8_1));
+    }
+    if (y) {
+        ink_norm_mul<true><<<1, 576, 0, ctx.stream()>>>((const float *) x->data, (const float *) wt->data, dst,
+                                                        ops_param_f32(nrm, 0), (block_q8_1 *) y);
+        ops_q8_ready[mul] = y;
+        ops_hits[OPS_NORMQ8]++;
+    } else {
+        ink_norm_mul<false><<<1, 576, 0, ctx.stream()>>>((const float *) x->data, (const float *) wt->data, dst,
+                                                         ops_param_f32(nrm, 0), nullptr);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    if (verify) {
+        return 0;
+    }
+    ops_hits[OPS_NORMMUL]++;
+    return k - i;
+}
+
+// ---------------------------------------------------------------------------------------------
+// clip() with a per-channel scale (Q and R of the attention): MUL(x, s) SQR SUM_ROWS SQRT SCALE FILL DIV CLAMP MUL
+// [-> MUL(., tau) with a single-element tau in the full-attention passes]. Same arithmetic as ink_clip_f32 of
+// inkling-fuse.cu (reduce_rows_f32 with a 512-thread block: one element per thread, zeros past ncols), with one
+// 128-thread block per row (ncols 128) or 4 rows per 64-thread block (ncols 16: the row sum is a DPP-only reduction).
+// ---------------------------------------------------------------------------------------------
+
+struct ink_clip_args {
+    const float * x;
+    const float * s;
+    float       * dst;
+    const float * tau; // optional single value multiplied onto the result (separate MUL node)
+    float         sc_scale, sc_bias, fill, lo, hi;
+};
+
+static __device__ __forceinline__ float ink_clip_finish(const ink_clip_args & a, const float xs, const float sum) {
+    const float norm   = sqrtf(sum);
+    const float normb  = fmaf(a.sc_scale, norm, a.sc_bias);
+    const float factor = a.fill / normb;
+    const float c      = fminf(fmaxf(factor, a.lo), a.hi);
+    float r;
+    {
+#pragma clang fp contract(off)
+        r = xs * c;
+        if (a.tau) {
+            r = r * a.tau[0];
+        }
+    }
+    return r;
+}
+
+static __global__ void __launch_bounds__(128) ink_clip128(const ink_clip_args a) {
+    const int row = blockIdx.x;
+    const int col = threadIdx.x;
+    const int idx = row*128 + col;
+    float xs;
+    float v[1];
+    {
+#pragma clang fp contract(off)
+        xs   = a.x[idx] * a.s[idx];
+        v[0] = xs * xs;
+    }
+    ink_reduce_xor<1, 32>(v);
+    __shared__ float gs[4];
+    if ((col & 31) == 0) {
+        gs[col >> 5] = v[0];
+    }
+    __syncthreads();
+    const float sum = (gs[0] + gs[2]) + (gs[1] + gs[3]);
+    a.dst[idx] = ink_clip_finish(a, xs, sum);
+}
+
+static __global__ void __launch_bounds__(64) ink_clip16(const ink_clip_args a) {
+    const int idx = blockIdx.x*64 + threadIdx.x; // 4 rows of 16 per wave
+    float xs;
+    float v;
+    {
+#pragma clang fp contract(off)
+        xs = a.x[idx] * a.s[idx];
+        v  = xs * xs;
+    }
+    // warp_reduce_sum<32> with zeros in lanes 16..31: the offsets 8, 4, 2, 1 inside the row of 16 lanes
+    v += ink_dpp<0x128>(v);
+    v += ink_dpp<0x1B>(ink_dpp<0x141>(v));
+    v += ink_dpp<0x4E>(v);
+    v += ink_dpp<0xB1>(v);
+    a.dst[idx] = ink_clip_finish(a, xs, v);
+}
+
+static int ops_try_clip(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on     = ops_env_on("GGML_CUDA_INK_CLIP") && ops_env_on("GGML_CUDA_INK_CLIP2");
+    static const bool tau_on = ops_env_on("GGML_CUDA_INK_CLIP_TAU");
+    if (!on) {
+        return 0;
+    }
+    ggml_tensor * n0 = cgraph->nodes[i];
+    if (n0->op != GGML_OP_MUL) {
+        return 0;
+    }
+    const ggml_tensor * x = n0->src[0];
+    const ggml_tensor * s = n0->src[1];
+    if (!x || !s || !ggml_are_same_shape(x, s) || !ggml_are_same_shape(x, n0)) {
+        return 0;
+    }
+    const ggml_op seq[8] = { GGML_OP_SQR, GGML_OP_SUM_ROWS, GGML_OP_SQRT, GGML_OP_SCALE, GGML_OP_FILL, GGML_OP_DIV, GGML_OP_CLAMP, GGML_OP_MUL };
+    int idx[8];
+    int k = i;
+    for (int q = 0; q < 8; ++q) {
+        k = ops_next(cgraph, k);
+        if (k < 0 || cgraph->nodes[k]->op != seq[q]) {
+            return 0;
+        }
+        idx[q] = k;
+    }
+    ggml_tensor * sqr   = cgraph->nodes[idx[0]];
+    ggml_tensor * sum   = cgraph->nodes[idx[1]];
+    ggml_tensor * sqrtn = cgraph->nodes[idx[2]];
+    ggml_tensor * scl   = cgraph->nodes[idx[3]];
+    ggml_tensor * fill  = cgraph->nodes[idx[4]];
+    ggml_tensor * div   = cgraph->nodes[idx[5]];
+    ggml_tensor * clamp = cgraph->nodes[idx[6]];
+    ggml_tensor * out   = cgraph->nodes[idx[7]];
+    if (sqr->src[0] != n0 || sum->src[0] != sqr || sqrtn->src[0] != sum || scl->src[0] != sqrtn || fill->src[0] != scl ||
+        div->src[0] != fill || div->src[1] != scl || clamp->src[0] != div || out->src[0] != n0 || out->src[1] != clamp) {
+        return 0;
+    }
+    const int64_t ncols = x->ne[0];
+    const int64_t nrows = ggml_nrows(x);
+    if (x->type != GGML_TYPE_F32 || s->type != GGML_TYPE_F32 || out->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) ||
+        !ggml_is_contiguous(s) || !ggml_is_contiguous(out) || !ggml_are_same_shape(out, x) || sum->ne[0] != 1 ||
+        ggml_nrows(sum) != nrows || (ncols != 128 && ncols != 16) || (ncols == 16 && nrows % 4 != 0) || !x->data || !s->data) {
+        return 0;
+    }
+    // reduce_rows_f32 launch configuration (sum_rows_f32_cuda): the 512-thread block form is the one reproduced
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    if ((nrows / nsm) >= 2) {
+        return 0;
+    }
+    // optional scalar multiply that follows (Qcur * tau, Rcur * tau)
+    int                 i_last = idx[7];
+    ggml_tensor *       dstn   = out;
+    const ggml_tensor * tau    = nullptr;
+    if (tau_on && ggml_node_get_use_count(cgraph, idx[7]) == 1 && !(out->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        const int kt = ops_next(cgraph, idx[7]);
+        if (kt >= 0) {
+            ggml_tensor * m2 = cgraph->nodes[kt];
+            if (m2->op == GGML_OP_MUL && m2->src[0] == out && m2->src[1] && m2->src[1]->type == GGML_TYPE_F32 &&
+                ggml_nelements(m2->src[1]) == 1 && m2->src[1]->data && m2->type == GGML_TYPE_F32 && ggml_are_same_shape(m2, out) &&
+                ggml_is_contiguous(m2)) {
+                // the scalar must not be produced after the launch position
+                bool late = false;
+                const ggml_tensor * tb = ops_strip_reshape(m2->src[1]);
+                for (int m = i; m <= kt && !late; ++m) {
+                    late = cgraph->nodes[m] == tb;
+                }
+                if (!late) {
+                    tau    = m2->src[1];
+                    dstn   = m2;
+                    i_last = kt;
+                }
+            }
+        }
+    }
+    // intermediates are used only inside
+    for (int m = i; m < i_last; ++m) {
+        const ggml_tensor * nd = cgraph->nodes[m];
+        if (nd == tau || (tau && nd == ops_strip_reshape(tau))) {
+            continue;
+        }
+        int uses = 0;
+        for (int m2 = m + 1; m2 <= i_last; ++m2) {
+            for (int q = 0; q < GGML_MAX_SRC; ++q) {
+                if (cgraph->nodes[m2]->src[q] == nd) {
+                    uses++;
+                }
+            }
+        }
+        if (ops_is_noop(nd)) {
+            // views between the nodes that belong to later consumers of other tensors are not ours
+            bool ours = false;
+            for (int m0 = i; m0 < m && !ours; ++m0) {
+                ours = nd->src[0] == cgraph->nodes[m0];
+            }
+            if (!ours) {
+                continue;
+            }
+        }
+        if ((nd->flags & GGML_TENSOR_FLAG_OUTPUT) || uses != ggml_node_get_use_count(cgraph, m)) {
+            return 0;
+        }
+    }
+    // each thread reads x[i], s[i] before it writes dst[i]: only exact aliasing with x is safe
+    if ((ops_overlap(dstn, x) && dstn->data != x->data) || ops_overlap(dstn, s) || (tau && ops_overlap(dstn, tau))) {
+        return 0;
+    }
+    // nodes between the clip and the tau MUL (none expected) must not touch the result buffer
+    if (tau) {
+        ops_set fused;
+        for (int m = i; m <= i_last; ++m) {
+            fused.insert(cgraph->nodes[m]);
+        }
+        if (!ops_write_window_free(cgraph, i, i_last, dstn, fused)) {
+            return 0;
+        }
+    }
+
+    ink_clip_args a = {};
+    a.x        = (const float *) x->data;
+    a.s        = (const float *) s->data;
+    a.dst      = (float *) dstn->data;
+    a.tau      = tau ? (const float *) tau->data : nullptr;
+    a.sc_scale = ops_param_f32(scl, 0);
+    a.sc_bias  = ops_param_f32(scl, 1);
+    a.fill     = ops_param_f32(fill, 0);
+    a.lo       = ops_param_f32(clamp, 0);
+    a.hi       = ops_param_f32(clamp, 1);
+    const bool verify = ops_verify();
+    if (verify) {
+        CUDA_CHECK(cudaMalloc(&a.dst, ncols*nrows*sizeof(float)));
+        ops_verify_add(a.dst, dstn->data, (int) (ncols*nrows), i_last, ncols == 128 ? 96 : 97, ncols == 128 ? "clip128" : "clip16");
+    }
+    if (ncols == 128) {
+        ink_clip128<<<nrows, 128, 0, ctx.stream()>>>(a);
+    } else {
+        ink_clip16<<<nrows/4, 64, 0, ctx.stream()>>>(a);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    if (verify) {
+        return 0;
+    }
+    ops_hits[OPS_CLIP2]++;
+    if (tau) {
+        ops_hits[OPS_CLIPTAU]++;
+    }
+    return i_last - i;
+}
+
+void ggml_cuda_ink_ops_begin() {
+    if (!ops_conv_pending.empty()) {
+        // a convolution deferred to a later node was never launched (its launch node was not dispatched): results of
+        // the previous evaluation are wrong
+        GGML_LOG_ERROR("%s: %d deferred Inkling convolution(s) were not launched in the previous graph evaluation\n", __func__,
+                       (int) ops_conv_pending.size());
+    }
+    ops_deferred.clear();
+    ops_conv_pending.clear();
+    ops_ctrl_rows.clear();
+    ops_elided.clear();
+    ops_mix_spans.clear();
+    ops_elided_graph = nullptr;
+    ops_q8_ready.clear();
+    ops_q8_next = 0;
+}
+
+// ---------------------------------------------------------------------------------------------
+
+int ggml_cuda_ink_ops_try(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (!ops_all_on()) {
+        return 0;
+    }
+    ops_stats_register();
+    if (ops_verify()) {
+        ops_verify_flush(ctx, i);
+    }
+    const ggml_tensor * node = cgraph->nodes[i];
+    int n = 0;
+    if (!ops_conv_pending.empty()) {
+        n = ops_launch_conv(ctx, cgraph, i);
+        if (n != 0) {
+            return n;
+        }
+    }
+    switch (node->op) {
+        case GGML_OP_MUL:
+            n = ops_try_clip(ctx, cgraph, i);
+            break;
+        case GGML_OP_SCALE:
+            n = ops_try_situ_q8(ctx, cgraph, i);
+            break;
+        case GGML_OP_CONCAT:
+            n = ops_try_conv(ctx, cgraph, i);
+            if (n == 0) {
+                n = ops_try_mixout(ctx, cgraph, i);
+            }
+            if (n == 0) {
+                n = ops_try_ctrl_norm(ctx, cgraph, i);
+            }
+            break;
+        case GGML_OP_RMS_NORM:
+            n = ops_try_mixout(ctx, cgraph, i);
+            if (n == 0) {
+                n = ops_try_norm_mul(ctx, cgraph, i);
+            }
+            break;
+        default:
+            break;
+    }
+    return n;
+}
