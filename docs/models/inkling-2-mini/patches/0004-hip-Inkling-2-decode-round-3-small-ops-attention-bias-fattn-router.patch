+
+// Inkling-2 single-token decode: fusions of the remaining small kernels (MI210 work, second round).
+// Same contract as ggml_cuda_try_fuse_inkling: > 0 = number of following nodes consumed,
+// -1 = only node i handled, 0 = not handled. Called first from ggml_cuda_try_fuse_inkling.
+// Each fusion has an opt-out env var GGML_CUDA_INK_<NAME>=0:
+//   MIXOUT  mix(): CONCAT.. RMS_NORM, scores, SOFT_MAX and the final weighted sum in one kernel that writes
+//           the mixed rows straight into the CONT copies of each query row
+//   CONV    convolve() in one kernel (supersedes the sconv fusion of inkling-fuse.cu), with
+//   RESADD  the residual ADD that follows it,
+//   KVTAIL  K: clip + SET_ROWS, V: RMS_NORM + SET_ROWS (KV cache store),
+//   DCONV   the dynamic taps of the full-attention passes
+int ggml_cuda_ink_ops_try(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
+
+// called at the start of each graph evaluation (from ggml_cuda_inkling_begin)
+void ggml_cuda_ink_ops_begin();
+
+// true if a fusion launched at a node in (i0, i1] reads memory overlapping `region` that the graph reads earlier
+// (inputs of a deferred kernel); used by the buffer checks of fusions that write a buffer early
+bool ggml_cuda_ink_ops_deferred_read_overlaps(const ggml_tensor * region, int i0, int i1);
