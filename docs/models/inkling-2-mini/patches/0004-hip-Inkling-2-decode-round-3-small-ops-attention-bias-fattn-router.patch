diff --git a/ggml/src/ggml-cuda/inkling-fattn.cu b/ggml/src/ggml-cuda/inkling-fattn.cu
new file mode 100644
index 0000000..18b8dc3
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-fattn.cu
@@ -0,0 +1,560 @@
+#include "inkling-fattn.cuh"
+#include "fattn.cuh"
+#include "ggml-impl.h"
+
+#include <algorithm>
+#include <cfloat>
+#include <climits>
+#include <cstdlib>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+// ---------------------------------------------------------------------------------------------
+// Single-query flash attention (decode): dst[h] = sum_k w[h][k]*V[k] / (sum_k w[h][k] + exp(sink[h] - max)),
+// w[h][k] = exp(scale*Q[h].K[k] + mask[h][k] - max).
+//
+// Measured on gfx90a inside the decode graph: the cost of a small kernel is the number of instructions a
+// wave executes (loads issued together are cheap, barriers are cheap), and loaded values that are moved or
+// selected force an immediate wait. The kernel is therefore a short program per thread over many waves.
+// Grid: (query heads, chunks of 256 positions), 256 threads; all loads of the first 64 positions are issued
+// in the prologue.
+//   0. every thread tests the mask value of one position; a ballot gives the number of leading positions
+//      that contain all unmasked ones (kend). Nothing past kend is loaded or computed.
+//   1. K.Q: 8 threads per row, 32 rows per iteration, the arithmetic of flash_attn_ext_vec (Q scaled in
+//      half precision, v_dot2_f32_f16, 4-2-1 reduction): the scores are bit-identical to the stock kernel
+//   2. one thread per position: score + mask, block max (with the sink), weight = exp(score - max)
+//   3. weighted V sums in f32: thread = (16 position subsets) x (16 column groups of 8), 4 rows per batch;
+//      the weight sum is accumulated alongside
+//   4. the 16 subsets are added through LDS, normalized and written (single chunk), or written
+//      unnormalized with (max, sum) per head and merged by ink_fattn_combine64 (several chunks).
+// ---------------------------------------------------------------------------------------------
+
+#define INK_FA_D       128
+#define INK_FA_THREADS 256
+#define INK_FA_CHUNK   256 // positions per block
+
+static bool ink_fattn_env_on(const char * name) {
+    const char * v = getenv(name);
+    return v == nullptr || atoi(v) != 0;
+}
+
+// The kernels below address lanes directly (ds_bpermute, ballot bit = threadIdx.x & 63) and use GCN inline
+// assembly: they are only built for HIP and only used on 64-lane devices (GCN/CDNA, checked at run time);
+// elsewhere the stock kernel runs. (No device macro such as __GFX9__ here: the host pass does not define it.)
+#if defined(GGML_USE_HIP)
+#define INK_FA_AVAILABLE
+#endif
+
+#ifdef INK_FA_AVAILABLE
+static_assert(sizeof(ggml_cuda_thread_mask_t) == 8, "ink_fattn needs 64-lane waves");
+
+// value of another lane of the same wave; idx4 = 4*lane
+static __device__ __forceinline__ float ink_fa_perm(const float v, const int idx4) {
+    return __int_as_float(__builtin_amdgcn_ds_bpermute(idx4, __float_as_int(v)));
+}
+
+// maxNum in one instruction
+static __device__ __forceinline__ float ink_fa_max(const float a, const float b) {
+    float r;
+    asm volatile("v_max_f32 %0, %1, %2" : "=v"(r) : "v"(a), "v"(b));
+    return r;
+}
+
+// K.Q of one row part: same arithmetic as flash_attn_ext_vec with f16 K (v_dot2_f32_f16 over the 8 half2
+// pairs of the thread, then the 8 threads of the row are reduced 4-2-1)
+static __device__ __forceinline__ float ink_fa_score(const half2 * kr, const half2 * qh, const int lane4) {
+    float acc = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        ggml_cuda_mad(acc, kr[i], qh[i]);
+    }
+    acc += ink_fa_perm(acc, lane4 ^ 16);
+    acc += ink_fa_perm(acc, lane4 ^ 8);
+    acc += ink_fa_perm(acc, lane4 ^ 4);
+    return acc;
+}
+
+// 4 V rows (8 columns each) times their weights
+static __device__ __forceinline__ void ink_fa_vacc(float * va, float & wsum, const half2 (*vr)[4], const float * Wb) {
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const float w = Wb[16*i]; // 0 for masked rows and rows past the chunk
+        wsum += w;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            const float2 vf = __half22float2(vr[i][e]);
+            va[2*e + 0] += w * vf.x;
+            va[2*e + 1] += w * vf.y;
+        }
+    }
+}
+
+template <int G>
+__launch_bounds__(INK_FA_THREADS, 1)
+static __global__ void ink_fattn_f16(
+        const float * __restrict__ Q, const char * __restrict__ K, const char * __restrict__ V,
+        const half * __restrict__ mask, const float * __restrict__ sinks,
+        float * __restrict__ dst, float * __restrict__ meta,
+        const int n_kv, const int n_head,
+        const int q_stride, const uint32_t nb11, const int nb12, const uint32_t nb21, const int nb22,
+        const int mask_stride, const float scale) {
+    constexpr int D  = INK_FA_D;
+    constexpr int C  = INK_FA_CHUNK;
+    constexpr int AS = D + 4; // row stride of A: spreads the LDS banks evenly
+
+    __shared__ float S[C];                  // K.Q of each position
+    __shared__ float W[4*(C + 16)];         // weights: 4 copies staggered by 16 words (even LDS bank use)
+    __shared__ float A[16*AS];              // partial V sums of the 16 position subsets
+    __shared__ int   rend[INK_FA_THREADS];
+    __shared__ float rmax[INK_FA_THREADS];
+
+    const int h     = blockIdx.x;
+    const int p     = blockIdx.y;
+    const int tid   = threadIdx.x;
+    const int lane  = tid & 63; // waves are filled in thread order
+    const int lane4 = lane << 2;
+    const int g     = h / G;
+
+    const int64_t k0  = (int64_t) p*C;
+    const int     len = (int) min((int64_t) C, n_kv - k0);
+
+    const uint32_t pos  = tid >> 3;  // score role: position within an iteration of 32
+    const uint32_t part = tid & 7;   //             half2 elements [4*part, 4*part + 4) and [32 + 4*part, 32 + 4*part + 4)
+    const uint32_t sub  = tid & 15;  // V role: rows 16*i + sub
+    const uint32_t cg   = tid >> 4;  //         columns 8*cg .. 8*cg + 7
+
+    // ---- loads issued up front: Q part, own mask value, sink, K rows of iterations 0 and 1, V rows of batch 0.
+    //      K and V are addressed as uniform base + 32-bit lane offset; offsets are clamped to the last row of
+    //      the chunk (rows past it have zero weight).
+    const float * Qp = Q + (int64_t) h*q_stride + part*8;
+    float4 qf[4];
+    ggml_cuda_memcpy_1<sizeof(float4)>(&qf[0], Qp);
+    ggml_cuda_memcpy_1<sizeof(float4)>(&qf[1], Qp + 4);
+    ggml_cuda_memcpy_1<sizeof(float4)>(&qf[2], Qp + 64);
+    ggml_cuda_memcpy_1<sizeof(float4)>(&qf[3], Qp + 68);
+
+    const float m = __half2float(mask[(int64_t) h*mask_stride + k0 + min(tid, len - 1)]);
+    float sink = -INFINITY;
+    if (sinks != nullptr && p == 0) {
+        sink = sinks[h];
+    }
+
+    const char *   Ks    = K + (int64_t) g*nb12 + k0*nb11;
+    const uint32_t klast = (uint32_t) (len - 1)*nb11 + part*16;
+    const uint32_t kstep = 32*nb11;
+    uint32_t       koff  = pos*nb11 + part*16;
+    __align__(16) half2 kr0[8];
+    __align__(16) half2 kr1[8];
+    {
+        const uint32_t o0 = min(koff, klast);
+        const uint32_t o1 = min(koff + kstep, klast);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr0,     Ks + o0);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr0 + 4, Ks + o0 + 128);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr1,     Ks + o1);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr1 + 4, Ks + o1 + 128);
+    }
+    const char *   Vs    = V + (int64_t) g*nb22 + k0*nb21;
+    const uint32_t vlast = (uint32_t) (len - 1)*nb21 + cg*16;
+    const uint32_t vstep = 16*nb21;
+    uint32_t       voff  = sub*nb21 + cg*16;
+    __align__(16) half2 vr[4][4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(vr[i], Vs + min(voff + i*vstep, vlast));
+    }
+
+    // ---- number of leading positions that contain all unmasked ones (from the mask values)
+    const bool valid = tid < len && !(m == -INFINITY);
+    {
+        const uint64_t bal = ggml_cuda_ballot(valid); // bit i = lane i of this wave
+        rend[tid] = bal != 0 ? (tid & ~63) + 64 - __builtin_clzll(bal) : 0;
+    }
+    __syncthreads();
+    const int kend = max(max(rend[lane], rend[64 + lane]), max(rend[128 + lane], rend[192 + lane]));
+
+    // ---- 1. K.Q (Q converted and scaled in half precision like the stock kernel: bit-identical scores)
+    half2 qh[8];
+    {
+        const half2 scale_h2 = make_half2(scale, scale);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            qh[2*i + 0] = make_half2(qf[i].x, qf[i].y);
+            qh[2*i + 1] = make_half2(qf[i].z, qf[i].w);
+        }
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            qh[i] *= scale_h2;
+        }
+    }
+    {
+        const float a0 = ink_fa_score(kr0, qh, lane4);
+        if (part == 0) {
+            S[pos] = a0;
+        }
+    }
+    if (kend > 32) {
+        const float a1 = ink_fa_score(kr1, qh, lane4);
+        if (part == 0) {
+            S[32 + pos] = a1;
+        }
+    }
+    koff += kstep;
+    for (int it = 2; it*32 < kend; ++it) {
+        koff += kstep;
+        const uint32_t o = min(koff, klast);
+        __align__(16) half2 kr[8];
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr,     Ks + o);
+        ggml_cuda_memcpy_1<4*sizeof(half2)>(kr + 4, Ks + o + 128);
+        const float a = ink_fa_score(kr, qh, lane4);
+        if (part == 0) {
+            S[it*32 + pos] = a;
+        }
+    }
+    __syncthreads();
+
+    // ---- 2. scores, max, weights: one thread per position
+    float s = -INFINITY;
+    if (valid) {
+        s = S[tid] + m;
+    }
+    float mx = s;
+#pragma unroll
+    for (int b = 0; b < 6; ++b) {
+        mx = ink_fa_max(mx, ink_fa_perm(mx, lane4 ^ (4 << b)));
+    }
+    rmax[tid] = mx;
+    __syncthreads();
+    mx = ink_fa_max(ink_fa_max(rmax[lane], rmax[64 + lane]), ink_fa_max(rmax[128 + lane], rmax[192 + lane]));
+    mx = ink_fa_max(ink_fa_max(mx, -FLT_MAX/2.0f), sink);
+
+    const float wt = expf(s - mx); // 0 for masked positions
+#pragma unroll
+    for (int c = 0; c < 4; ++c) {
+        W[c*(C + 16) + tid] = wt;
+    }
+    __syncthreads();
+
+    // ---- 3. weighted V sums: rows 16*i + sub, columns 8*cg .. 8*cg + 7; the weight sum rides along
+    const float * Wc = W + (cg & 3)*(C + 16) + sub;
+    float va[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        va[i] = 0.0f;
+    }
+    float wsum = 0.0f;
+    ink_fa_vacc(va, wsum, vr, Wc);
+    for (int b = 1; b*64 < kend; ++b) {
+        voff += 4*vstep;
+        __align__(16) half2 vn[4][4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            ggml_cuda_memcpy_1<4*sizeof(half2)>(vn[i], Vs + min(voff + i*vstep, vlast));
+        }
+        ink_fa_vacc(va, wsum, vn, Wc + b*64);
+    }
+
+    // ---- 4. total weight (16 lanes share cg), partial sums through LDS, normalize, write
+#pragma unroll
+    for (int b = 0; b < 4; ++b) {
+        wsum += ink_fa_perm(wsum, lane4 ^ (4 << b));
+    }
+    const float sum = wsum + expf(sink - mx);
+
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        A[sub*AS + cg*8 + i] = va[i];
+    }
+    __syncthreads();
+
+    const bool single = gridDim.y == 1;
+    if (tid < D) {
+        float v = 0.0f;
+#pragma unroll
+        for (int sb = 0; sb < 16; ++sb) {
+            v += A[sb*AS + tid];
+        }
+        if (single) {
+            dst[h*D + tid] = v / sum;
+        } else {
+            dst[((int64_t) p*n_head + h)*D + tid] = v;
+        }
+    }
+    if (!single && tid == 0) {
+        meta[((int64_t) p*n_head + h)*2 + 0] = mx;
+        meta[((int64_t) p*n_head + h)*2 + 1] = sum;
+    }
+}
+
+// combine the chunks of one head: block = head, thread = output element
+static __global__ void ink_fattn_combine(const float * __restrict__ tmp, const float * __restrict__ meta, float * __restrict__ dst,
+                                         const int n_chunks, const int n_head) {
+    constexpr int D = INK_FA_D;
+    const int h   = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    float mx = -INFINITY;
+    for (int p = 0; p < n_chunks; ++p) {
+        mx = fmaxf(mx, meta[((int64_t) p*n_head + h)*2]);
+    }
+    float num = 0.0f;
+    float den = 0.0f;
+    for (int p = 0; p < n_chunks; ++p) {
+        const float sc = expf(meta[((int64_t) p*n_head + h)*2] - mx);
+        const float sm = meta[((int64_t) p*n_head + h)*2 + 1];
+        const float v  = tmp[((int64_t) p*n_head + h)*D + tid];
+        if (sc != 0.0f) {
+            num += sc*v;
+            den += sc*sm;
+        }
+    }
+    dst[h*D + tid] = num / den;
+}
+
+// combine up to 64 chunks of one head: block = head, thread = output element. Lane p of each wave owns
+// chunk p: its (max, sum) pair and scale factor; the other lanes fetch the factor with a lane permute.
+static __global__ void ink_fattn_combine64(const float * __restrict__ tmp, const float * __restrict__ meta, float * __restrict__ dst,
+                                           const int n_chunks, const int n_head) {
+    constexpr int D = INK_FA_D;
+    const int h     = blockIdx.x;
+    const int tid   = threadIdx.x;
+    const int lane  = tid & 63;
+    const int lane4 = lane << 2;
+
+    const uint32_t stride = (uint32_t) n_head*D;
+    const float *  tp     = tmp + h*D + tid;
+    const uint32_t last   = (uint32_t) (n_chunks - 1)*stride;
+
+    float v[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        v[i] = tp[min(i*stride, last)];
+    }
+    float2 mt;
+    ggml_cuda_memcpy_1<sizeof(float2)>(&mt, meta + ((int64_t) min(lane, n_chunks - 1)*n_head + h)*2);
+
+    const bool  own = lane < n_chunks;
+    const float m   = own ? mt.x : -INFINITY;
+    float mx = m;
+#pragma unroll
+    for (int b = 0; b < 6; ++b) {
+        mx = ink_fa_max(mx, ink_fa_perm(mx, lane4 ^ (4 << b)));
+    }
+    const float c  = expf(m - mx); // 0 for the lanes without a chunk
+    const float sm = mt.y;
+
+    // chunks are accumulated in order (same sums as ink_fattn_combine)
+    float num = 0.0f;
+    float den = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const float cp = ink_fa_perm(c, 4*i);
+        num += cp * v[i];
+        den += cp * ink_fa_perm(sm, 4*i);
+    }
+    for (int p0 = 8; p0 < n_chunks; p0 += 8) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            v[i] = tp[min((p0 + i)*stride, last)];
+        }
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const float cp = ink_fa_perm(c, 4*(p0 + i));
+            num += cp * v[i];
+            den += cp * ink_fa_perm(sm, 4*(p0 + i));
+        }
+    }
+    dst[h*D + tid] = num / den;
+}
+
+#endif // INK_FA_AVAILABLE
+
+static bool ink_fattn_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a->data || !b->data) {
+        return true;
+    }
+    const char * a0 = (const char *) a->data;
+    const char * a1 = a0 + ggml_nbytes(a);
+    const char * b0 = (const char *) b->data;
+    const char * b1 = b0 + ggml_nbytes(b);
+    return a0 < b1 && b0 < a1;
+}
+
+// debug: GGML_CUDA_INK_FATTN_CHECK=1 together with GGML_CUDA_DISABLE_GRAPHS runs the stock kernel as well,
+// keeps its result and reports how far this kernel is from it (the stock kernel accumulates V in half precision)
+static struct ink_fattn_check_stats {
+    long long n        = 0;
+    long long n_multi  = 0; // nodes with more than one chunk
+    double    worst    = 0.0; // largest rms(diff)/rms(ref) of a node
+    double    worst_el = 0.0; // largest |diff| / max|ref| of a node
+    double    sum_rel  = 0.0;
+    int64_t   max_n_kv = 0;
+} ink_fattn_chk;
+
+static void ink_fattn_check_print() {
+    fprintf(stderr, "ink_fattn check: %lld nodes (%lld multi-chunk, max n_kv %lld): rms diff / rms ref mean %.3e worst %.3e, worst max|diff|/max|ref| %.3e\n",
+            ink_fattn_chk.n, ink_fattn_chk.n_multi, (long long) ink_fattn_chk.max_n_kv,
+            ink_fattn_chk.n ? ink_fattn_chk.sum_rel/ink_fattn_chk.n : 0.0, ink_fattn_chk.worst, ink_fattn_chk.worst_el);
+}
+
+static void ink_fattn_check(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const float * mine, const int64_t n_kv, const int n_chunks) {
+    static bool registered = false;
+    if (!registered) {
+        registered = true;
+        atexit(ink_fattn_check_print);
+    }
+    ggml_cuda_flash_attn_ext(ctx, dst);
+    CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+    const size_t n = ggml_nelements(dst);
+    std::vector<float> a(n);
+    std::vector<float> b(n);
+    CUDA_CHECK(cudaMemcpy(a.data(), mine, n*sizeof(float), cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(b.data(), dst->data, n*sizeof(float), cudaMemcpyDeviceToHost));
+    double sd = 0.0, sr = 0.0, md = 0.0, mr = 0.0;
+    bool   bad = false;
+    for (size_t k = 0; k < n; ++k) {
+        const double d = (double) a[k] - (double) b[k];
+        bad = bad || !std::isfinite(a[k]);
+        sd += d*d;
+        sr += (double) b[k]*b[k];
+        md  = std::max(md, fabs(d));
+        mr  = std::max(mr, fabs((double) b[k]));
+    }
+    const double rel    = sr > 0.0 ? sqrt(sd/sr) : sqrt(sd);
+    const double rel_el = mr > 0.0 ? md/mr : md;
+    ink_fattn_chk.n++;
+    ink_fattn_chk.n_multi += n_chunks > 1;
+    ink_fattn_chk.sum_rel += rel;
+    ink_fattn_chk.worst    = std::max(ink_fattn_chk.worst, rel);
+    ink_fattn_chk.worst_el = std::max(ink_fattn_chk.worst_el, rel_el);
+    ink_fattn_chk.max_n_kv = std::max(ink_fattn_chk.max_n_kv, n_kv);
+    if (bad || rel > 2e-2) {
+        fprintf(stderr, "ink_fattn check: node %s n_kv %lld: rms diff / rms ref %.3e, max|diff| %.3e, max|ref| %.3e%s\n", dst->name,
+                (long long) n_kv, rel, md, mr, bad ? " (non-finite)" : "");
+    }
+}
+
+int ggml_cuda_ink_try_fattn(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = ink_fattn_env_on("GGML_CUDA_INK_FUSE") && ink_fattn_env_on("GGML_CUDA_INK_FATTN");
+    if (!on) {
+        return 0;
+    }
+#ifndef INK_FA_AVAILABLE
+    GGML_UNUSED_VARS(ctx, cgraph, i);
+    return 0;
+#else
+    // wave64 devices only (the lane arithmetic of the kernels is not valid with 32-lane waves)
+    {
+        const int cc = ggml_cuda_info().devices[ctx.device].cc;
+        if (!GGML_CUDA_CC_IS_CDNA(cc) && !GGML_CUDA_CC_IS_GCN(cc)) {
+            return 0;
+        }
+    }
+    ggml_tensor * dst = cgraph->nodes[i];
+    if (dst->op != GGML_OP_FLASH_ATTN_EXT) {
+        return 0;
+    }
+    const ggml_tensor * Q     = dst->src[0];
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    if (!Q || !K || !V || !mask || dst->src[5] != nullptr || dst->src[6] != nullptr) {
+        return 0;
+    }
+
+    constexpr int D = INK_FA_D;
+    constexpr int G = 3;
+
+    const int64_t n_head    = Q->ne[2];
+    const int64_t n_head_kv = K->ne[2];
+    const int64_t n_kv      = K->ne[1];
+
+    // single query, single sequence, f32 Q, f16 K/V with contiguous rows of 128, GQA 3
+    if (Q->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 ||
+        Q->ne[0] != D || Q->ne[1] != 1 || Q->ne[3] != 1 || K->ne[0] != D || V->ne[0] != D || K->ne[3] != 1 || V->ne[3] != 1 ||
+        V->ne[1] != n_kv || V->ne[2] != n_head_kv || n_head != G*n_head_kv || n_kv < 1 || n_kv > 65535*INK_FA_CHUNK || n_head > 65535 ||
+        Q->nb[0] != sizeof(float) || Q->nb[2] % 16 != 0 || K->nb[0] != sizeof(half) || V->nb[0] != sizeof(half) ||
+        K->nb[1] % 16 != 0 || K->nb[2] % 16 != 0 || V->nb[1] % 16 != 0 || V->nb[2] % 16 != 0 ||
+        ((uintptr_t) Q->data) % 16 != 0 || ((uintptr_t) K->data) % 16 != 0 || ((uintptr_t) V->data) % 16 != 0) {
+        return 0;
+    }
+    if (K->nb[1] > (1 << 20) || V->nb[1] > (1 << 20) || K->nb[2] > (1 << 20) || V->nb[2] > (1 << 20) ||
+        Q->nb[2] > (1 << 20)) {
+        return 0;
+    }
+    // dense mask: one f16 row of n_kv values per head
+    if (mask->type != GGML_TYPE_F16 || mask->ne[0] != n_kv || mask->ne[1] != 1 || mask->ne[2] != n_head || mask->ne[3] != 1 ||
+        mask->nb[0] != sizeof(half) || mask->nb[2] % sizeof(half) != 0 || mask->nb[2]/sizeof(half) > (size_t) INT_MAX) {
+        return 0;
+    }
+    if (sinks && (sinks->type != GGML_TYPE_F32 || !ggml_is_contiguous(sinks) || ggml_nelements(sinks) != n_head)) {
+        return 0;
+    }
+    if (dst->ne[0] != D || dst->ne[1] != n_head || dst->ne[2] != 1 || dst->ne[3] != 1 || !ggml_is_contiguous(dst) ||
+        ((uintptr_t) dst->data) % 16 != 0) {
+        return 0;
+    }
+
+    float scale         = 1.0f;
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (max_bias != 0.0f || logit_softcap != 0.0f) {
+        return 0;
+    }
+
+    if (ink_fattn_overlap(dst, Q) || ink_fattn_overlap(dst, K) || ink_fattn_overlap(dst, V) || ink_fattn_overlap(dst, mask) ||
+        (sinks && ink_fattn_overlap(dst, sinks))) {
+        return 0;
+    }
+
+    // one block per (head, chunk of 256 positions); several chunks are merged by ink_fattn_combine
+    const int n_chunks = (int) ((n_kv + INK_FA_CHUNK - 1) / INK_FA_CHUNK);
+
+    cudaStream_t stream = ctx.stream();
+
+    ggml_cuda_pool_alloc<float> tmp(ctx.pool());
+    ggml_cuda_pool_alloc<float> meta(ctx.pool());
+    if (n_chunks > 1) {
+        tmp.alloc((size_t) n_chunks*n_head*D);
+        meta.alloc((size_t) n_chunks*n_head*2);
+    }
+
+    static const bool check = getenv("GGML_CUDA_INK_FATTN_CHECK") != nullptr && atoi(getenv("GGML_CUDA_INK_FATTN_CHECK")) != 0 &&
+                              getenv("GGML_CUDA_DISABLE_GRAPHS") != nullptr;
+    ggml_cuda_pool_alloc<float> chk(ctx.pool());
+    float * out = (float *) dst->data;
+    if (check) {
+        chk.alloc((size_t) n_head*D);
+        out = chk.get();
+    }
+
+    const dim3 grid(n_head, n_chunks, 1);
+    const dim3 block(INK_FA_THREADS, 1, 1);
+    ink_fattn_f16<G><<<grid, block, 0, stream>>>(
+        (const float *) Q->data, (const char *) K->data, (const char *) V->data, (const half *) mask->data,
+        sinks ? (const float *) sinks->data : nullptr,
+        n_chunks > 1 ? tmp.get() : out, n_chunks > 1 ? meta.get() : nullptr,
+        (int) n_kv, (int) n_head,
+        (int) (Q->nb[2]/sizeof(float)), (int) K->nb[1], (int) K->nb[2], (int) V->nb[1], (int) V->nb[2],
+        (int) (mask->nb[2]/sizeof(half)), scale);
+    CUDA_CHECK(cudaGetLastError());
+
+    if (n_chunks > 1) {
+        if (n_chunks <= 64) {
+            ink_fattn_combine64<<<n_head, D, 0, stream>>>(tmp.get(), meta.get(), out, n_chunks, (int) n_head);
+        } else {
+            ink_fattn_combine<<<n_head, D, 0, stream>>>(tmp.get(), meta.get(), out, n_chunks, (int) n_head);
+        }
+        CUDA_CHECK(cudaGetLastError());
+    }
+    if (check) {
+        ink_fattn_check(ctx, dst, out, n_kv, n_chunks);
+    }
+    return -1;
+#endif // INK_FA_AVAILABLE
+}
