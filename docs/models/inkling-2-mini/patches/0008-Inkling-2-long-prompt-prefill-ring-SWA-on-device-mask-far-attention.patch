+// p8-long: op params 8..10 of the banded node (0 = no ring layout)
+void ggml_flash_attn_ext_banded_set_ring(
+        struct ggml_tensor * a,
+        int32_t              n_log,
+        int32_t              rot,
+        int32_t              n_swa) {
+    GGML_ASSERT(a->op == GGML_OP_FLASH_ATTN_EXT_BANDED);
+    GGML_ASSERT(a->src[3] == NULL);
+    GGML_ASSERT(n_log >= a->src[0]->ne[1] && n_log <= a->src[1]->ne[1] && a->src[1]->ne[1] == a->src[2]->ne[1]);
+    GGML_ASSERT(rot >= 0 && rot < a->src[1]->ne[1] && n_swa >= 0 && a->src[0]->ne[3] == 1);
+    ggml_set_op_params_i32(a, 8,  n_log);
+    ggml_set_op_params_i32(a, 9,  rot);
+    ggml_set_op_params_i32(a, 10, n_swa);
+}
+
+int32_t ggml_flash_attn_ext_banded_get_ring(
+        const struct ggml_tensor * a,
+        int32_t                  * rot,
+        int32_t                  * n_swa) {
+    GGML_ASSERT(a->op == GGML_OP_FLASH_ATTN_EXT_BANDED);
+    if (rot) {
+        *rot = ggml_get_op_params_i32(a, 9);
+    }
+    if (n_swa) {
+        *n_swa = ggml_get_op_params_i32(a, 10);
+    }
+    return ggml_get_op_params_i32(a, 8);
+}
