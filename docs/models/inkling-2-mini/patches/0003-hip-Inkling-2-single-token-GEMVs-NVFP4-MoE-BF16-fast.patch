+#!/bin/bash
+# per-kernel timing sweep (inside container): ksweep.sh <regex> "<ENV=.. ENV=..>" ...
+RE=$1; shift
+cd /lab/unsloth-llama
+for cfg in "$@"; do
+  rm -rf /lab/results/ksweep
+  env $cfg LD_LIBRARY_PATH=build/bin:/opt/rocm/lib timeout 300 rocprofv3 --kernel-trace --output-format csv -d /lab/results/ksweep -o run -- build/bin/llama-bench -m /data/model/Inkling-2-Mini-GGUF/Inkling-2-Mini-UD-Q8_K_XL.gguf -ngl 999 -fa 1 -p 0 -n 24 -r 1 > /dev/null 2>&1
+  python3 - "$RE" "$cfg" <<"PY"
+import csv,sys,re,collections,statistics
+rows=list(csv.DictReader(open("/lab/results/ksweep/run_kernel_trace.csv")))
+t=collections.defaultdict(list)
+for r in rows:
+    n=r["Kernel_Name"]
+    if re.search(sys.argv[1],n):
+        k=re.sub(r"\(.*","",n)[:60]+" grid="+r["Grid_Size_X"]+"x"+r["Grid_Size_Y"]
+        t[k].append((int(r["End_Timestamp"])-int(r["Start_Timestamp"]))/1000)
+for k,v in sorted(t.items()):
+    v=sorted(v)[len(v)//10:]  # drop warm-up outliers
+    print("%-28s %8.2f us med %8.2f us min  n=%d  %s"%(sys.argv[2][:28],statistics.median(v),min(v),len(v),k))
+PY
+done
