diff --git a/ggml/src/ggml-cuda/inkling-gemv.cu b/ggml/src/ggml-cuda/inkling-gemv.cu
new file mode 100644
index 0000000..02ea2f5
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-gemv.cu
@@ -0,0 +1,440 @@
+// Inkling-2 decode GEMVs for MI210 (gfx90a): single-token MoE NVFP4 experts.
+// Replaces mul_mat_vec_q for MUL_MAT_ID(NVFP4, f32 activations, one token) and optionally the
+// following per-expert scale (RESHAPE, REPEAT, GET_ROWS, MUL). Same q8_1 activation quantization and
+// int8 dot products as mul_mat_vec_q; only the order in which float partial sums are added differs.
+// GGML_CUDA_INK_NVFP4=0 disables it.
+
+#include "inkling-gemv.cuh"
+#include "inkling-fuse.cuh"
+#include "quantize.cuh"
+#include "vecdotq.cuh"
+#include "ggml-impl.h"
+
+#include <cstdlib>
+
+static bool ink_gemv_env_on(const char * name) {
+    const char * v = getenv(name);
+    return v == nullptr || atoi(v) != 0;
+}
+
+static bool ink_gemv_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (ggml_is_empty(a) || ggml_is_empty(b) || !a->data || !b->data) {
+        return false;
+    }
+    const char * a0 = (const char *) a->data;
+    const char * a1 = a0 + ggml_nbytes(a);
+    const char * b0 = (const char *) b->data;
+    const char * b1 = b0 + ggml_nbytes(b);
+    return a0 < b1 && b0 < a1;
+}
+
+// exact equivalent of ggml_cuda_ue4m3_to_fp32 (fallback path on gfx90a: branches + ldexpf + division) built from bits:
+// value/2 for exp > 0 is 2^(exp-8) * (1 + man/8); subnormals man * 2^-10; 0 and 0x7F give 0
+static __device__ __forceinline__ float ink_ue4m3_half(const uint32_t x) {
+    const uint32_t e = (x >> 3) & 0xF;
+    const uint32_t m = x & 0x7;
+    const float normal = __uint_as_float(((e + 119u) << 23) | (m << 20));
+    const float sub    = (float) m * (1.0f/1024.0f);
+    const float r = e == 0 ? sub : normal;
+    return x == 0x7F ? 0.0f : r;
+}
+
+typedef int ink_int4_a4 __attribute__((ext_vector_type(4), aligned(4)));
+
+
+#include <algorithm>
+#include <unordered_set>
+
+// nodes in (i0, i1] not in `fused` must neither read nor write memory overlapping `t` (t is written early, at i0)
+static bool ink_gemv_untouched_between(const ggml_cgraph * cgraph, int i0, int i1, const ggml_tensor * t,
+                                       const std::unordered_set<const ggml_tensor *> & fused) {
+    for (int k = i0 + 1; k <= i1; ++k) {
+        const ggml_tensor * nd = cgraph->nodes[k];
+        if (fused.count(nd)) {
+            continue;
+        }
+        if (nd->op == GGML_OP_NONE || nd->op == GGML_OP_RESHAPE || nd->op == GGML_OP_VIEW || nd->op == GGML_OP_PERMUTE ||
+            nd->op == GGML_OP_TRANSPOSE || ggml_is_empty(nd)) {
+            continue;
+        }
+        if (ink_gemv_overlap(nd, t)) {
+            return false;
+        }
+        for (int q = 0; q < GGML_MAX_SRC; ++q) {
+            const ggml_tensor * sq = nd->src[q];
+            if (sq && !fused.count(sq) && ink_gemv_overlap(sq, t)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+// one block = 256/L rows of one expert; L lanes share a row, lane sub handles blocks sub, sub+L, ... (at most MAXIT).
+// PRE: issue all weight loads of a lane before the arithmetic. Each 36-byte block is read as 2x dwordx4 + 1 dword
+// (unaligned-by-16 vector loads are fine on gfx90a global memory).
+template <int L, int MAXIT, bool PRE, bool VEC>
+static __global__ void __launch_bounds__(256) ink_mmid_nvfp4(
+        const char * __restrict__ w, const int64_t w_nb1, const int64_t w_nb2, const int nb,
+        const block_q8_1 * __restrict__ y, const int64_t y_stride_blocks, const bool y_per_slot,
+        const int32_t * __restrict__ ids, const float * __restrict__ escale,
+        float * __restrict__ dst, const int64_t dst_nb1, const int nrows) {
+    constexpr int rows_per_block = 256 / L;
+    const int slot   = blockIdx.y;
+    const int expert = ids[slot];
+    const int tid    = threadIdx.x;
+    const int row    = blockIdx.x*rows_per_block + tid / L;
+    const int sub    = tid % L;
+    const char * wrow = w + expert*w_nb2 + (int64_t) (row < nrows ? row : 0)*w_nb1;
+
+    auto load_block = [&](const int bi, int * q) {
+        const char * bp = wrow + (int64_t) bi*sizeof(block_nvfp4);
+        if (VEC) {
+            q[0] = *(const int *) bp;
+            const ink_int4_a4 a0 = *(const ink_int4_a4 *) (bp + 4);
+            const ink_int4_a4 a1 = *(const ink_int4_a4 *) (bp + 20);
+            q[1] = a0.x; q[2] = a0.y; q[3] = a0.z; q[4] = a0.w;
+            q[5] = a1.x; q[6] = a1.y; q[7] = a1.z; q[8] = a1.w;
+        } else {
+#pragma unroll
+            for (int k = 0; k < 9; ++k) {
+                q[k] = ((const int *) bp)[k];
+            }
+        }
+    };
+
+    int q[PRE ? MAXIT : 1][9];
+    if (PRE) {
+#pragma unroll
+        for (int it = 0; it < MAXIT; ++it) {
+            const int bi = sub + L*it;
+            if (bi < nb) {
+                load_block(bi, q[PRE ? it : 0]);
+            }
+        }
+    }
+
+    // stage this slot's q8_1 activations in LDS (2*nb q8 blocks of 36 bytes)
+    extern __shared__ int ink_y_lds[];
+    const block_q8_1 * yrow = y + (y_per_slot ? slot*y_stride_blocks : 0);
+    const int n_int = nb*2*(int) (sizeof(block_q8_1)/sizeof(int));
+    for (int k = tid; k < n_int; k += 256) {
+        ink_y_lds[k] = ((const int *) yrow)[k];
+    }
+    __syncthreads();
+    const block_q8_1 * ys = (const block_q8_1 *) ink_y_lds;
+
+    float sum = 0.0f;
+#pragma unroll
+    for (int it = 0; it < MAXIT; ++it) {
+        const int bi = sub + L*it;
+        if (bi < nb) {
+            int * qb = q[PRE ? it : 0];
+            if (!PRE) {
+                load_block(bi, qb);
+            }
+            const uint32_t sc4 = (uint32_t) qb[0];
+#pragma unroll
+            for (int s = 0; s < 4; ++s) {
+                const int2 v0 = get_int_from_table_16(qb[1 + 2*s + 0], kvalues_mxfp4);
+                const int2 v1 = get_int_from_table_16(qb[1 + 2*s + 1], kvalues_mxfp4);
+                const block_q8_1 * b8 = ys + 2*bi + (s >> 1);
+                const int i8 = (s & 1) << 2;
+                const int * q8 = (const int *) b8->qs;
+                int sumi = ggml_cuda_dp4a(v0.x, q8[i8 + 0], 0);
+                sumi = ggml_cuda_dp4a(v0.y, q8[i8 + 2], sumi);
+                sumi = ggml_cuda_dp4a(v1.x, q8[i8 + 1], sumi);
+                sumi = ggml_cuda_dp4a(v1.y, q8[i8 + 3], sumi);
+                const float d = ink_ue4m3_half((sc4 >> (8*s)) & 0xFF) * __low2float(b8->ds);
+                sum += d * float(sumi);
+            }
+        }
+    }
+#pragma unroll
+    for (int off = L/2; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off, 64);
+    }
+    if (row < nrows && sub == 0) {
+        const float v = escale ? sum * escale[expert] : sum;
+        dst[slot*dst_nb1 + row] = v;
+    }
+}
+
+// matches MUL_MAT_ID -> [RESHAPE(scale w)] -> REPEAT -> GET_ROWS(repeat, ids) -> MUL(mm, get_rows)
+static int ink_match_mmid_scale(const ggml_cgraph * cgraph, int i, const ggml_tensor ** scale_w, ggml_tensor ** out) {
+    const ggml_tensor * mm = cgraph->nodes[i];
+    int k = i + 1;
+    const ggml_tensor * rs = nullptr;
+    if (k < cgraph->n_nodes && cgraph->nodes[k]->op == GGML_OP_RESHAPE) {
+        rs = cgraph->nodes[k];
+        k++;
+    }
+    if (k + 2 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * rep = cgraph->nodes[k];
+    const ggml_tensor * gr  = cgraph->nodes[k + 1];
+    ggml_tensor *       mul = cgraph->nodes[k + 2];
+    if (rep->op != GGML_OP_REPEAT || !ggml_are_same_shape(rep, rep->src[0]) || (rs && rep->src[0] != rs) || rep->ne[0] != 1 ||
+        rep->type != GGML_TYPE_F32 || !ggml_is_contiguous(rep->src[0]) ||
+        gr->op != GGML_OP_GET_ROWS || gr->src[0] != rep || gr->src[1] != mm->src[2] ||
+        mul->op != GGML_OP_MUL || mul->src[0] != mm || mul->src[1] != gr || !ggml_are_same_shape(mul, mm) ||
+        !ggml_is_contiguous(mul)) {
+        return 0;
+    }
+    if (ggml_node_get_use_count(cgraph, i) != 1 || ggml_node_get_use_count(cgraph, k) != 1 || ggml_node_get_use_count(cgraph, k + 1) != 1 ||
+        (mm->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    if (rs && ggml_node_get_use_count(cgraph, i + 1) != 1) {
+        return 0;
+    }
+    *scale_w = rep->src[0];
+    *out     = mul;
+    return k + 2 - i;
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// BF16 x f32 single-token GEMV: L lanes per row (L = 256: one row per block with an LDS reduction),
+// 16-byte weight loads (8 bf16), activations read from global (cached).
+// Several MUL_MATs that share the same activation vector are merged into one launch (segments);
+// the later ones are then computed early, which is checked against buffer reuse like the other early fusions.
+// ---------------------------------------------------------------------------------------------
+
+#define INK_BF16_MAX_SEG 8
+
+struct ink_bf16_segs {
+    const char * w[INK_BF16_MAX_SEG];
+    int64_t      nb1[INK_BF16_MAX_SEG];
+    float      * dst[INK_BF16_MAX_SEG];
+    int          row0[INK_BF16_MAX_SEG + 1];
+    int          nseg;
+};
+
+template <int L>
+static __global__ void __launch_bounds__(256) ink_gemv_bf16(const ink_bf16_segs segs, const float * __restrict__ x, const int K8) {
+    constexpr int rows_per_block = L >= 256 ? 1 : 256 / L;
+    constexpr int LL = L >= 64 ? 64 : L; // lanes per row inside one wave
+    const int tid = threadIdx.x;
+    const int row = blockIdx.x*rows_per_block + (L >= 256 ? 0 : tid / L);
+    const int sub = L >= 256 ? tid : tid % L;
+    if (row >= segs.row0[segs.nseg]) {
+        return;
+    }
+    int sg = 0;
+#pragma unroll
+    for (int k = 1; k < INK_BF16_MAX_SEG; ++k) {
+        if (k < segs.nseg && row >= segs.row0[k]) {
+            sg = k;
+        }
+    }
+    const int r = row - segs.row0[sg];
+    const uint4  * wr = (const uint4 *) (segs.w[sg] + (int64_t) r*segs.nb1[sg]);
+    const float4 * x4 = (const float4 *) x;
+    float sum = 0.0f;
+    for (int c = sub; c < K8; c += L) {
+        const uint4  wv = wr[c];
+        const float4 xa = x4[2*c + 0];
+        const float4 xb = x4[2*c + 1];
+        sum = fmaf(__uint_as_float(wv.x << 16),         xa.x, sum);
+        sum = fmaf(__uint_as_float(wv.x & 0xFFFF0000u), xa.y, sum);
+        sum = fmaf(__uint_as_float(wv.y << 16),         xa.z, sum);
+        sum = fmaf(__uint_as_float(wv.y & 0xFFFF0000u), xa.w, sum);
+        sum = fmaf(__uint_as_float(wv.z << 16),         xb.x, sum);
+        sum = fmaf(__uint_as_float(wv.z & 0xFFFF0000u), xb.y, sum);
+        sum = fmaf(__uint_as_float(wv.w << 16),         xb.z, sum);
+        sum = fmaf(__uint_as_float(wv.w & 0xFFFF0000u), xb.w, sum);
+    }
+#pragma unroll
+    for (int off = LL/2; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off, 64);
+    }
+    if (L >= 256) {
+        __shared__ float part[4];
+        if (tid % 64 == 0) {
+            part[tid / 64] = sum;
+        }
+        __syncthreads();
+        if (tid == 0) {
+            segs.dst[sg][r] = (part[0] + part[1]) + (part[2] + part[3]);
+        }
+    } else if (sub == 0) {
+        segs.dst[sg][r] = sum;
+    }
+}
+
+static bool ink_bf16_gemv_ok(const ggml_tensor * mm, const ggml_tensor * x) {
+    const ggml_tensor * src0 = mm->src[0];
+    const int64_t K = src0->ne[0];
+    const int64_t N = src0->ne[1];
+    return mm->op == GGML_OP_MUL_MAT && mm->src[1] == x && src0->type == GGML_TYPE_BF16 && x->type == GGML_TYPE_F32 &&
+        mm->type == GGML_TYPE_F32 && ggml_nelements(x) == K && ggml_is_contiguous(x) && src0->ne[2] == 1 && src0->ne[3] == 1 &&
+        K % 8 == 0 && src0->nb[0] == 2 && src0->nb[1] % 16 == 0 && ((uintptr_t) src0->data % 16) == 0 &&
+        ((uintptr_t) x->data % 16) == 0 && ggml_nelements(mm) == N && ggml_is_contiguous(mm) && N < (1 << 30) &&
+        !(mm->flags & GGML_TENSOR_FLAG_OUTPUT && false) && !ink_gemv_overlap(mm, x) && !ink_gemv_overlap(mm, src0);
+}
+
+static int ink_try_gemv_bf16(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on    = ink_gemv_env_on("GGML_CUDA_INK_BF16");
+    static const bool merge = ink_gemv_env_on("GGML_CUDA_INK_BF16_MERGE");
+    if (!on) {
+        return 0;
+    }
+    ggml_tensor * mm = cgraph->nodes[i];
+    const ggml_tensor * x = mm->src[1];
+    if (!ink_bf16_gemv_ok(mm, x)) {
+        return 0;
+    }
+    const int64_t K = mm->src[0]->ne[0];
+
+    ggml_tensor * members[INK_BF16_MAX_SEG] = { mm };
+    int           member_idx[INK_BF16_MAX_SEG] = { i };
+    int nm = 1;
+    if (merge) {
+        // later single-token BF16 GEMVs on the same activation vector, computed early here
+        std::unordered_set<const ggml_tensor *> fused = { mm };
+        const int lim = std::min(cgraph->n_nodes, i + 200);
+        for (int k = i + 1; k < lim && nm < INK_BF16_MAX_SEG; ++k) {
+            ggml_tensor * nd = cgraph->nodes[k];
+            if (nd->op != GGML_OP_MUL_MAT || nd->src[1] != x || !ink_bf16_gemv_ok(nd, x) || nd->src[0]->ne[0] != K) {
+                continue;
+            }
+            fused.insert(nd);
+            bool ok = ink_gemv_untouched_between(cgraph, i, k, nd, fused);
+            for (int m = 0; m < nm && ok; ++m) {
+                ok = !ink_gemv_overlap(nd, members[m]);
+            }
+            if (!ok) {
+                fused.erase(nd);
+                continue;
+            }
+            members[nm]    = nd;
+            member_idx[nm] = k;
+            nm++;
+        }
+    }
+
+    ink_bf16_segs segs = {};
+    int rows = 0;
+    for (int m = 0; m < nm; ++m) {
+        segs.w[m]    = (const char *) members[m]->src[0]->data;
+        segs.nb1[m]  = members[m]->src[0]->nb[1];
+        segs.dst[m]  = (float *) members[m]->data;
+        segs.row0[m] = rows;
+        rows += (int) members[m]->src[0]->ne[1];
+    }
+    segs.row0[nm] = rows;
+    segs.nseg     = nm;
+
+    static const int env_l = getenv("GGML_CUDA_INK_BF16_L") ? atoi(getenv("GGML_CUDA_INK_BF16_L")) : 0;
+    const int K8 = (int) (K/8);
+    int lanes = env_l;
+    static const int env_small = getenv("GGML_CUDA_INK_BF16_SMALL_L") ? atoi(getenv("GGML_CUDA_INK_BF16_SMALL_L")) : 256;
+    if (lanes == 0) {
+        lanes = rows >= 2048 ? 32 : (rows >= 256 ? 64 : env_small);
+    }
+#define INK_LAUNCH_BF16(L_) ink_gemv_bf16<L_><<<(rows + ((L_) >= 256 ? 1 : 256/(L_)) - 1)/((L_) >= 256 ? 1 : 256/(L_)), 256, 0, ctx.stream()>>>( \
+        segs, (const float *) x->data, K8)
+    switch (lanes) {
+        case 16:  INK_LAUNCH_BF16(16);  break;
+        case 32:  INK_LAUNCH_BF16(32);  break;
+        case 64:  INK_LAUNCH_BF16(64);  break;
+        case 256: INK_LAUNCH_BF16(256); break;
+        default: GGML_ABORT("ink bf16: unsupported lanes");
+    }
+#undef INK_LAUNCH_BF16
+    CUDA_CHECK(cudaGetLastError());
+    for (int m = 1; m < nm; ++m) {
+        ggml_cuda_inkling_defer_skip(members[m]);
+    }
+    GGML_UNUSED(member_idx);
+    return -1;
+}
+
+int ggml_cuda_ink_try_gemv(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (cgraph->nodes[i]->op == GGML_OP_MUL_MAT) {
+        return ink_try_gemv_bf16(ctx, cgraph, i);
+    }
+    static const bool on = ink_gemv_env_on("GGML_CUDA_INK_NVFP4");
+    if (!on) {
+        return 0;
+    }
+    ggml_tensor * mm = cgraph->nodes[i];
+    if (mm->op != GGML_OP_MUL_MAT_ID) {
+        return 0;
+    }
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    const ggml_tensor * ids  = mm->src[2];
+    // single token: src1 [K, 1 or n_used, 1], ids [n_used, 1], dst [N, n_used, 1]
+    const int64_t K      = src0->ne[0];
+    const int64_t N      = src0->ne[1];
+    const int64_t n_used = ids->ne[0];
+    if (src0->type != GGML_TYPE_NVFP4 || src1->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 || ids->ne[1] != 1 || mm->ne[2] != 1 || mm->ne[1] != n_used || mm->ne[0] != N ||
+        (src1->ne[1] != 1 && src1->ne[1] != n_used) || src1->ne[0] != K || K % 64 != 0 || src0->nb[1] % 4 != 0 ||
+        src0->nb[2] % 4 != 0 || mm->nb[0] != sizeof(float) || ids->nb[0] != sizeof(int32_t) || src1->nb[0] != sizeof(float) ||
+        n_used > 65535) {
+        return 0;
+    }
+    const int nb = (int) (K / 64);
+    // shared memory for the activations: 2*nb q8_1 blocks
+    const size_t smem = (size_t) nb*2*sizeof(block_q8_1);
+    if (smem > 48*1024) {
+        return 0;
+    }
+
+    const ggml_tensor * scale_w = nullptr;
+    ggml_tensor *       out     = mm;
+    const int n_skip = ink_match_mmid_scale(cgraph, i, &scale_w, &out);
+
+    // q8_1 activations (same quantization as mul_mat_vec_q)
+    const int64_t K_pad   = GGML_PAD(K, MATRIX_ROW_PADDING);
+    const int64_t n_rows1 = src1->ne[1];
+    ggml_cuda_pool_alloc<char> y_q8(ctx.pool(), n_rows1*K_pad/QK8_1*sizeof(block_q8_1));
+    {
+        const int64_t s11 = src1->nb[1] / sizeof(float);
+        const int64_t s12 = src1->nb[2] / sizeof(float);
+        const int64_t s13 = src1->nb[3] / sizeof(float);
+        quantize_row_q8_1_cuda((const float *) src1->data, y_q8.get(), K, s11, s12, s13, K_pad, n_rows1, 1, 1, ctx.stream());
+    }
+
+    const dim3 block(256, 1, 1);
+    const float * esc = scale_w ? (const float *) scale_w->data : nullptr;
+    const int64_t ystride = K_pad/QK8_1;
+    const bool per_slot = n_rows1 == n_used && n_used > 1;
+    const int64_t dst_nb1 = out->nb[1]/sizeof(float);
+    // tunables for experiments: GGML_CUDA_INK_NVFP4_LGU / _LDN (lanes per row for nb >= 32 / nb < 32), _PRE, _VEC
+    static const int  env_lgu = getenv("GGML_CUDA_INK_NVFP4_LGU") ? atoi(getenv("GGML_CUDA_INK_NVFP4_LGU")) : 8;
+    static const int  env_ldn = getenv("GGML_CUDA_INK_NVFP4_LDN") ? atoi(getenv("GGML_CUDA_INK_NVFP4_LDN")) : 8;
+    static const bool env_pre = getenv("GGML_CUDA_INK_NVFP4_PRE") ? atoi(getenv("GGML_CUDA_INK_NVFP4_PRE")) != 0 : false;
+    static const bool env_vec = getenv("GGML_CUDA_INK_NVFP4_VEC") ? atoi(getenv("GGML_CUDA_INK_NVFP4_VEC")) != 0 : false;
+    const int lanes = nb >= 32 ? env_lgu : env_ldn;
+#define INK_LAUNCH_NVFP4_PV(L_, IT_, P_, V_)                                                                                    \
+        ink_mmid_nvfp4<L_, IT_, P_, V_><<<grid, block, smem, ctx.stream()>>>((const char *) src0->data, src0->nb[1],          \
+            src0->nb[2], nb, (const block_q8_1 *) y_q8.get(), ystride, per_slot, (const int32_t *) ids->data, esc,              \
+            (float *) out->data, dst_nb1, (int) N)
+#define INK_LAUNCH_NVFP4(L_, IT_) do {                                                                                          \
+        const dim3 grid((N + 256/(L_) - 1)/(256/(L_)), n_used, 1);                                                              \
+        if (env_pre) { if (env_vec) { INK_LAUNCH_NVFP4_PV(L_, IT_, true, true); } else { INK_LAUNCH_NVFP4_PV(L_, IT_, true, false); } } \
+        else         { if (env_vec) { INK_LAUNCH_NVFP4_PV(L_, IT_, false, true); } else { INK_LAUNCH_NVFP4_PV(L_, IT_, false, false); } } \
+    } while (0)
+    if (lanes == 2 && nb <= 2*18) {
+        INK_LAUNCH_NVFP4(2, 18);
+    } else if (lanes == 4 && nb <= 4*9) {
+        INK_LAUNCH_NVFP4(4, 9);
+    } else if (lanes == 8 && nb <= 8*5) {
+        INK_LAUNCH_NVFP4(8, 5);
+    } else if (lanes == 16 && nb <= 16*3) {
+        INK_LAUNCH_NVFP4(16, 3);
+    } else if (lanes == 32 && nb <= 32*2) {
+        INK_LAUNCH_NVFP4(32, 2);
+    } else {
+        GGML_ABORT("ink nvfp4: unsupported lanes/nb");
+    }
+#undef INK_LAUNCH_NVFP4
+#undef INK_LAUNCH_NVFP4_PV
+    CUDA_CHECK(cudaGetLastError());
+    return n_skip > 0 ? n_skip : -1;
+}
