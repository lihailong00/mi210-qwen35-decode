+#!/bin/bash
+# decode-path logits check (run inside the container). usage: kld.sh <bindir> <tag> [chunks]
+# writes /lab/results/inkkld-<tag>.bin (llama-perplexity --kl-divergence-base with -ub 1 = single-token decode graphs)
+# and prints its md5; if /lab/results/inkkld-base.bin exists and tag != base, also prints KLD vs base.
+B=$1; TAG=$2; CH=${3:-3}
+M=/data/model/Inkling-2-Mini-GGUF/Inkling-2-Mini-UD-Q8_K_XL.gguf
+export LD_LIBRARY_PATH=$B:/opt/rocm/lib
+O=/lab/results/inkkld-$TAG.bin
+$B/llama-perplexity -m $M -f /lab/eval/ppl.txt -c 512 --chunks $CH -b 512 -ub 1 -ngl 999 -fa on --kl-divergence-base $O > /lab/results/inkkld-$TAG.log 2>&1
+echo "$TAG md5 $(md5sum < $O | cut -c1-12) $(grep -o "Final estimate: PPL = [0-9.]*" /lab/results/inkkld-$TAG.log)"
+if [ "$TAG" != base ] && [ -f /lab/results/inkkld-base.bin ] && ! cmp -s $O /lab/results/inkkld-base.bin; then
+  $B/llama-perplexity -m $M -f /lab/eval/ppl.txt -c 512 --chunks $CH -b 512 -ub 1 -ngl 999 -fa on --kl-divergence-base /lab/results/inkkld-base.bin --kl-divergence > /lab/results/inkkld-$TAG-cmp.log 2>&1
+  grep -E "Mean    KLD|Maximum KLD|Same top p|Mean PPL\(Q\)" /lab/results/inkkld-$TAG-cmp.log | sed "s/^/  /"
+fi
