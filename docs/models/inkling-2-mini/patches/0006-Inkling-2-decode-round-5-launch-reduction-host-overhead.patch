+    const ggml_tensor * sig = cgraph->nodes[k + 1];
+    ggml_tensor *       mul = cgraph->nodes[k + 2];
+    if (sig->op != GGML_OP_UNARY || ggml_get_unary_op(sig) != GGML_UNARY_OP_SIGMOID || sig->src[0] != mm || mul->op != GGML_OP_MUL ||
