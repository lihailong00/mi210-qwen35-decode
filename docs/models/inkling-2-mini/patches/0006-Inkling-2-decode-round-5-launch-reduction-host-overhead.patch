+    __shared__ float chunk[32];
+
+    const float4 xs = ((const float4 *) x)[tid];
+    float t[1];
+    {
+#pragma clang fp contract(off)
+        const float qx = xs.x * xs.x;
+        const float qy = xs.y * xs.y;
+        const float qz = xs.z * xs.z;
+        const float qw = xs.w * xs.w;
+        float tmp = qx + qy;
+        tmp = tmp + qz;
+        tmp = tmp + qw;
+        t[0] = tmp;
+    }
+    ink_reduce_xor<1, 32>(t);
+    if ((lane & 31) == 0) {
+        chunk[tid >> 5] = t[0];
+    }
+    __syncthreads();
+    const int gl = lane & 31;
+    float v[1] = { chunk[gl < 18 ? gl : 17] };
+    v[0] = gl < 18 ? v[0] : 0.0f;
+    ink_reduce_xor<1, 32>(v);
+    const float scale = rsqrtf(v[0] / n + eps);
+    ((float4 *) dst)[tid] = make_float4(scale*xs.x, scale*xs.y, scale*xs.z, scale*xs.w);
+    if (cpy) {
+        ((float4 *) cpy)[tid] = xs;
+    }
+}
+
+struct ink_ctl_down_args {
+    const char  * w[INK_CTL_MAXC];
+    const float * x[INK_CTL_MAXC];
+    float       * dst[INK_CTL_MAXC];
+    int64_t       nb1[INK_CTL_MAXC];
+};
+
+// ink_gemv_bf16<256> (inkling-gemv.cu) with one segment of 64 rows x 4608 columns per chain: one row per 256-thread
+// block, 16-byte weight loads, per-thread fused multiply-add chains, 64-lane xor reduction, (p0 + p1) + (p2 + p3)
+template <int NC>
+static __global__ void __launch_bounds__(256) ink_ctl_down(const ink_ctl_down_args a) {
+    constexpr int K8 = 2*INK_CTL_N/8;
+    const int tid = threadIdx.x;
+    const int r   = blockIdx.x;
+    const int ch  = blockIdx.y;
+    const char *  w   = a.w[0];
+    const float * x   = a.x[0];
+    float *       dst = a.dst[0];
+    int64_t       nb1 = a.nb1[0];
+#pragma unroll
+    for (int c = 1; c < NC; ++c) {
+        if (ch == c) {
+            w   = a.w[c];
+            x   = a.x[c];
+            dst = a.dst[c];
+            nb1 = a.nb1[c];
+        }
+    }
+    const uint4  * wr = (const uint4 *) (w + (int64_t) r*nb1);
+    const float4 * x4 = (const float4 *) x;
+    float sum = 0.0f;
+    for (int c = tid; c < K8; c += 256) {
+        const uint4  wv = wr[c];
+        const float4 xa = x4[2*c + 0];
+        const float4 xb = x4[2*c + 1];
+        sum = fmaf(__uint_as_float(wv.x << 16),         xa.x, sum);
+        sum = fmaf(__uint_as_float(wv.x & 0xFFFF0000u), xa.y, sum);
+        sum = fmaf(__uint_as_float(wv.y << 16),         xa.z, sum);
+        sum = fmaf(__uint_as_float(wv.y & 0xFFFF0000u), xa.w, sum);
+        sum = fmaf(__uint_as_float(wv.z << 16),         xb.x, sum);
+        sum = fmaf(__uint_as_float(wv.z & 0xFFFF0000u), xb.y, sum);
+        sum = fmaf(__uint_as_float(wv.w << 16),         xb.z, sum);
+        sum = fmaf(__uint_as_float(wv.w & 0xFFFF0000u), xb.w, sum);
+    }
+#pragma unroll
+    for (int off = 32; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off, 64);
+    }
+    __shared__ float part[4];
+    if (tid % 64 == 0) {
+        part[tid / 64] = sum;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        dst[r] = (part[0] + part[1]) + (part[2] + part[3]);
+    }
+}
+
+struct ink_ctl_gate_args {
+    const nv_bfloat16 * wf[INK_CTL_MAXC];
+    const nv_bfloat16 * wg[INK_CTL_MAXC];
+    const float       * h[INK_CTL_MAXC];
+    const float       * cur[INK_CTL_MAXC];
+    const float       * msg[INK_CTL_MAXC];
+    float             * dst[INK_CTL_MAXC];
+    float               s_scale[INK_CTL_MAXC];
+    float               s_bias[INK_CTL_MAXC];
+};
+
+// as ink_dot64_bf16 of inkling-fuse.cu
+static __device__ __forceinline__ float ops_dot64_bf16(const nv_bfloat16 * w_row, const float * h, const int lane) {
+    float sum = 0.0f;
+    if (lane < 32) {
+        const int    tmpx = ((const int *) w_row)[lane];
+        const float2 tmpy = ((const float2 *) h)[lane];
+        const float tmpx0 = ggml_cuda_cast<float>(reinterpret_cast<const nv_bfloat16 *>(&tmpx)[0]);
+        const float tmpx1 = ggml_cuda_cast<float>(reinterpret_cast<const nv_bfloat16 *>(&tmpx)[1]);
+        ggml_cuda_mad(sum, tmpx0, tmpy.x);
+        ggml_cuda_mad(sum, tmpx1, tmpy.y);
+    }
+    return warp_reduce_sum<64>(sum);
+}
+
+// ink_ctrl_gate of inkling-fuse.cu (4 rows per 256-thread block, 2304 rows) for NC chains: blockIdx.y selects the chain
+template <int NC>
+static __global__ void __launch_bounds__(256) ink_ctl_gate(const ink_ctl_gate_args a) {
+    const int lane = threadIdx.x % 64;
+    const int row  = blockIdx.x*4 + threadIdx.x/64;
+    const int ch   = blockIdx.y;
+    const nv_bfloat16 * wf  = a.wf[0];
+    const nv_bfloat16 * wg  = a.wg[0];
+    const float *       h   = a.h[0];
+    const float *       cur = a.cur[0];
+    const float *       msg = a.msg[0];
+    float *             dst = a.dst[0];
+    float               s_scale = a.s_scale[0];
+    float               s_bias  = a.s_bias[0];
+#pragma unroll
+    for (int c = 1; c < NC; ++c) {
+        if (ch == c) {
+            wf      = a.wf[c];
+            wg      = a.wg[c];
+            h       = a.h[c];
+            cur     = a.cur[c];
+            msg     = a.msg[c];
+            dst     = a.dst[c];
+            s_scale = a.s_scale[c];
+            s_bias  = a.s_bias[c];
+        }
+    }
+    const float sf = ops_dot64_bf16(wf + (int64_t) row*64, h, lane);
+    const float sg = ops_dot64_bf16(wg + (int64_t) row*64, h, lane);
+    if (lane != 0) {
+        return;
+    }
+    // see ink_ctrl_gate: the SCALE node is contracted in scale_f32, the MUL / MUL / ADD nodes round each operation
+    const float f  = tanhf(sf);
+    const float fs = s_scale * f + s_bias;
+    const float g  = tanhf(sg);
+    float m1, m2, r;
+    {
+#pragma clang fp contract(off)
+        m1 = fs * cur[row];
+        m2 = g * msg[row];
+        r  = m1 + m2;
+    }
+    dst[row] = r;
+}
+
+static __global__ void ink_row_copy(const float * src, float * dst, const int n) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    if (i < n) {
+        dst[i] = src[i];
+    }
+}
+
+// the tensor that owns the memory of t
+static const ggml_tensor * ops_data_base(const ggml_tensor * t) {
+    while (t && (t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE)) {
+        const ggml_tensor * up = t->view_src ? t->view_src : t->src[0];
+        if (!up) {
+            break;
+        }
+        t = up;
+    }
+    return t;
+}
+
+// does t hold its values when node i is dispatched? (leafs always; nodes that were computed before i and materialized)
+static bool ops_available_before(const ggml_cgraph * cgraph, const ggml_tensor * t, int i) {
+    const ggml_tensor * b = ops_data_base(t);
+    if (!b || !b->data || !t->data) {
+        return false;
+    }
+    if (b->op == GGML_OP_NONE) {
+        return true;
+    }
+    const int p = ops_pos_of(cgraph, b);
+    return p >= 0 && p < i && !ops_unmat.count(b) && !ops_elided.count(b);
+}
+
+// every node in [i0, i1] except `out` is used only by nodes inside [i0, i1] and is not an output (ink_internal_only)
+static bool ops_internal_only(const ggml_cgraph * cgraph, int i0, int i1, const ggml_tensor * out) {
+    for (int k = i0; k <= i1; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (n == out) {
+            continue;
+        }
+        if (n->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+        int uses = 0;
+        for (int m = k + 1; m <= i1; ++m) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (cgraph->nodes[m]->src[s] == n) {
+                    uses++;
+                }
+            }
+        }
+        if (uses != ggml_node_get_use_count(cgraph, k)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// every use of node p is by a node of `set`, or by a view / reshape all of whose uses are (recursively) in `set`
+static bool ops_all_users_in(const ggml_cgraph * cgraph, int p, const ops_set & set, int lim) {
+    const ggml_tensor * t = cgraph->nodes[p];
+    if (t->flags & GGML_TENSOR_FLAG_OUTPUT) {
+        return false;
+    }
+    int uses = 0;
+    for (int m = p + 1; m < lim; ++m) {
+        const ggml_tensor * nd = cgraph->nodes[m];
+        int cnt = 0;
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            cnt += nd->src[s] == t;
+        }
+        if (cnt == 0) {
+            continue;
+        }
+        uses += cnt;
+        if (set.count(nd)) {
+            continue;
+        }
+        if ((nd->op == GGML_OP_RESHAPE || nd->op == GGML_OP_VIEW) && ops_all_users_in(cgraph, m, set, lim)) {
+            continue;
+        }
+        return false;
+    }
+    return uses == ggml_node_get_use_count(cgraph, p);
+}
+
+struct ops_ctl_chain {
+    int i_cat, i_nrm, i_down;
+    int g[8];              // forget MUL_MAT, TANH, SCALE, MUL, gain MUL_MAT, TANH, MUL, ADD
+    int i_drms, i_dmul;    // RMS_NORM, MUL(weight) that consume the result
+    const ggml_tensor * cur;
+    const ggml_tensor * msg;
+};
+
+static bool ops_ctlgrp_on() {
+    // the stages reproduced here are those of the default kernels: any switch that changes one of them turns the groups off
+    static const bool on = ops_env_on("GGML_CUDA_INK_CTLGRP") && ops_env_on("GGML_CUDA_INK_BF16") &&
+                           ops_env_on("GGML_CUDA_INK_CTRL_GATE") && ops_env_on("GGML_CUDA_INK_NORM_MUL") &&
+                           ops_env_on("GGML_CUDA_INK_ELIDED") && ops_env_on("GGML_CUDA_INK_MIXOUT") && ops_env_on("GGML_CUDA_INK_MIX") &&
+                           !ops_env_on("GGML_CUDA_INK_MIXOUT_NORM", false) && getenv("GGML_CUDA_INK_BF16_L") == nullptr &&
+                           (getenv("GGML_CUDA_INK_BF16_SMALL_L") == nullptr || atoi(getenv("GGML_CUDA_INK_BF16_SMALL_L")) == 256);
+    return on;
+}
+
+// structural match of one control chain starting at its CONCAT (node i); pure function of the graph
+static bool ops_ctl_match(const ggml_cgraph * cgraph, int i, ops_ctl_chain & c) {
+    const int64_t n = INK_CTL_N;
+    if (cgraph->nodes[i]->op != GGML_OP_CONCAT) {
+        return false;
+    }
+    const int j = ops_ctrl_norm_match_raw(cgraph, i);
+    if (j < 0) {
+        return false;
+    }
+    const ggml_tensor * cat = cgraph->nodes[i];
+    const ggml_tensor * nrm = cgraph->nodes[j];
+    const int kd = ops_next(cgraph, j);
+    if (kd < 0) {
+        return false;
+    }
+    // down GEMV: the conditions under which ink_try_gemv_bf16 runs it as ink_gemv_bf16<256> with a single segment
+    const ggml_tensor * down = cgraph->nodes[kd];
+    const ggml_tensor * wd   = down->src[0];
+    const ggml_tensor * x    = down->src[1];
+    if (down->op != GGML_OP_MUL_MAT || !wd || !x || x->op != GGML_OP_RESHAPE || x->src[0] != nrm || x->data != nrm->data ||
+        wd->type != GGML_TYPE_BF16 || x->type != GGML_TYPE_F32 || down->type != GGML_TYPE_F32 || wd->ne[0] != 2*n ||
+        wd->ne[1] != 64 || wd->ne[2] != 1 || wd->ne[3] != 1 || ggml_nelements(x) != 2*n || !ggml_is_contiguous(x) ||
+        wd->nb[0] != 2 || wd->nb[1] % 16 != 0 || !wd->data || ((uintptr_t) wd->data % 16) || ((uintptr_t) x->data % 16) ||
+        ggml_nelements(down) != 64 || !ggml_is_contiguous(down) || !down->data || ops_overlap(down, x) || ops_overlap(down, wd) ||
+        (down->flags & GGML_TENSOR_FLAG_OUTPUT) || (nrm->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        ggml_node_get_use_count(cgraph, j) != 1 || ggml_node_get_use_count(cgraph, kd) != 2) {
+        return false;
+    }
+    {
+        // the reshaped norm feeds the down GEMV only
+        int px = -1;
+        for (int m = j + 1; m < kd; ++m) {
+            if (cgraph->nodes[m] == x) {
+                px = m;
+            }
+        }
+        if (px < 0 || ggml_node_get_use_count(cgraph, px) != 1 || (x->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return false;
+        }
+    }
+    // gate: the conditions of ink_try_ctrl_gate (inkling-fuse.cu)
+    const ggml_op seq[] = { GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_SCALE, GGML_OP_MUL, GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_ADD };
+    int k = kd;
+    for (int q = 0; q < 8; ++q) {
+        k = ops_next(cgraph, k);
+        if (k < 0 || cgraph->nodes[k]->op != seq[q]) {
+            return false;
+        }
+        c.g[q] = k;
+    }
+    const ggml_tensor * g[8];
+    for (int q = 0; q < 8; ++q) {
+        g[q] = cgraph->nodes[c.g[q]];
+    }
+    const ggml_tensor * wf  = g[0]->src[0];
+    const ggml_tensor * h   = g[0]->src[1];
+    const ggml_tensor * wg  = g[4]->src[0];
+    const ggml_tensor * cur = g[3]->src[1];
+    const ggml_tensor * msg = g[6]->src[1];
+    const ggml_tensor * out = g[7];
+    if (h != down || !wf || !wg || !cur || !msg || ggml_get_unary_op(g[1]) != GGML_UNARY_OP_TANH ||
+        ggml_get_unary_op(g[5]) != GGML_UNARY_OP_TANH || g[1]->src[0] != g[0] || g[2]->src[0] != g[1] || g[3]->src[0] != g[2] ||
+        g[4]->src[1] != h || g[5]->src[0] != g[4] || g[6]->src[0] != g[5] || g[7]->src[0] != g[3] || g[7]->src[1] != g[6]) {
+        return false;
+    }
+    if (wf->type != GGML_TYPE_BF16 || wg->type != GGML_TYPE_BF16 || wf->ne[0] != 64 || wg->ne[0] != 64 || wf->ne[1] != n ||
+        wg->ne[1] != n || !ggml_is_contiguous(wf) || !ggml_is_contiguous(wg) || !wf->data || !wg->data ||
+        h->type != GGML_TYPE_F32 || ggml_nelements(h) != 64 || !ggml_is_contiguous(h) || cur->type != GGML_TYPE_F32 ||
+        msg->type != GGML_TYPE_F32 || ggml_nelements(cur) != n || ggml_nelements(msg) != n || !ggml_is_contiguous(cur) ||
+        !ggml_is_contiguous(msg) || out->type != GGML_TYPE_F32 || ggml_nelements(out) != n || !ggml_is_contiguous(out) ||
+        ((uintptr_t) h->data % 8) || ggml_nelements(g[0]) != n) {
+        return false;
+    }
+    if (!ops_internal_only(cgraph, c.g[0], c.g[7], out)) {
+        return false;
+    }
+    if (ops_overlap(out, h) || (ops_overlap(out, cur) && out->data != cur->data) || (ops_overlap(out, msg) && out->data != msg->data)) {
+        return false;
+    }
+    // the gate operands are the two rows of the CONCAT
+    const ggml_tensor * ca = ops_strip_reshape(cat->src[0]);
+    const ggml_tensor * cb = ops_strip_reshape(cat->src[1]);
+    if (ops_strip_reshape(cur) != ca || ops_strip_reshape(msg) != cb || cur->data != ca->data || msg->data != cb->data ||
+        cat->src[0]->data != ca->data || cat->src[1]->data != cb->data) {
+        return false;
+    }
+    // the result feeds RMS_NORM -> MUL(weight) only
+    if (ggml_node_get_use_count(cgraph, c.g[7]) != 1 || (out->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    const int kr = ops_next(cgraph, c.g[7]);
+    if (kr < 0 || cgraph->nodes[kr]->op != GGML_OP_RMS_NORM || cgraph->nodes[kr]->src[0] != out) {
+        return false;
+    }
+    const int km = ops_norm_mul_match(cgraph, kr);
+    if (km < 0) {
+        return false;
+    }
+    c.i_cat  = i;
+    c.i_nrm  = j;
+    c.i_down = kd;
+    c.i_drms = kr;
+    c.i_dmul = km;
+    c.cur    = ca;
+    c.msg    = cb;
+    return true;
+}
+
+// where a chain input (cur or msg) can be read at the group's launch position
+struct ops_ctl_src {
+    const float *       ptr;      // final pointer (set at commit for rows of an early mix)
+    const ggml_tensor * early_mo; // final MUL_MAT of a mix that has to be launched early, or nullptr
+    int                 early_i;  // its first node
+    int                 row;
+    int                 cont_pos; // index of the CONT (a later node) that would copy the row, or -1
+};
+
+// the rows of the final MUL_MAT `mo` (node pm) of a mix are read through VIEW -> CONT copies only
+static bool ops_mix_rows_cont_only(const ggml_cgraph * cgraph, const ggml_tensor * mo, int pm) {
+    const int64_t n = INK_CTL_N;
+    {
+        const int lim = std::min(cgraph->n_nodes, pm + 2000);
+        int uses = 0;
+        for (int m = pm + 1; m < lim; ++m) {
+            const ggml_tensor * u = cgraph->nodes[m];
+            bool is_user = false;
+            for (int q = 0; q < GGML_MAX_SRC; ++q) {
+                if (u->src[q] == mo) {
+                    is_user = true;
+                    uses++;
+                }
+            }
+            if (!is_user) {
+                continue;
+            }
+            if (u->op != GGML_OP_VIEW || u->view_src != mo || u->src[0] != mo || u->type != GGML_TYPE_F32 || ggml_nelements(u) != n ||
+                u->ne[0] != n || !ggml_is_contiguous(u) || u->view_offs % (n*sizeof(float)) != 0 || (u->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                return false;
+            }
+            int vuses = 0;
+            for (int m2 = m + 1; m2 < lim; ++m2) {
+                const ggml_tensor * cu = cgraph->nodes[m2];
+                for (int q = 0; q < GGML_MAX_SRC; ++q) {
+                    if (cu->src[q] == u) {
+                        vuses++;
+                        if (cu->op != GGML_OP_CONT || q != 0 || cu->type != GGML_TYPE_F32 || ggml_nelements(cu) != n ||
+                            !ggml_is_contiguous(cu) || !cu->data) {
+                            return false;
+                        }
+                    }
+                }
+            }
+            if (vuses != ggml_node_get_use_count(cgraph, m)) {
+                return false;
+            }
+        }
+        if (uses != ggml_node_get_use_count(cgraph, pm)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// CONT copies of rows of an early mix that were not materialized because a control group reads them from scratch
+static std::unordered_map<const ggml_tensor *, const float *> ops_cont_alias;
+
+static bool ops_ctl_resolve(const ggml_cgraph * cgraph, const ggml_tensor * t, int i_grp, ops_ctl_src & s) {
+    const int64_t n = INK_CTL_N;
+    s = { nullptr, nullptr, -1, 0, -1 };
+    if (t->type != GGML_TYPE_F32 || ggml_nelements(t) != n || !t->data) {
+        return false;
+    }
+    if (t->op == GGML_OP_NONE) {
+        s.ptr = (const float *) t->data;
+        return true;
+    }
+    const int p = ops_pos_of(cgraph, t);
+    if (p < 0) {
+        return false;
+    }
+    {
+        auto al = ops_cont_alias.find(t);
+        if (al != ops_cont_alias.end()) {
+            s.ptr = al->second;
+            return true;
+        }
+    }
+    if (p < i_grp || ops_direct_conts.count(t)) {
+        // computed already (a CONT written by its mix kernel counts)
+        if (ops_unmat.count(t) || ops_elided.count(t)) {
+            return false;
+        }
+        if (p < i_grp && !ops_available_before(cgraph, t, i_grp)) {
+            return false;
+        }
+        s.ptr = (const float *) t->data;
+        return true;
+    }
+    // a later node: only the CONT copy of a mixed row
+    const ggml_tensor * v = t->src[0];
+    if (t->op != GGML_OP_CONT || !v || v->op != GGML_OP_VIEW || !v->view_src || v->src[0] != v->view_src ||
+        v->type != GGML_TYPE_F32 || ggml_nelements(v) != n || v->ne[0] != n || !ggml_is_contiguous(v) ||
+        v->view_offs % (n*sizeof(float)) != 0 || (t->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    const ggml_tensor * mo = v->view_src;
+    const int64_t       j  = (int64_t) (v->view_offs/(n*sizeof(float)));
+    if (mo->op != GGML_OP_MUL_MAT || mo->type != GGML_TYPE_F32 || mo->ne[0] != n || j >= mo->ne[1] || !ggml_is_contiguous(mo) ||
+        ggml_nelements(mo) != n*mo->ne[1] || !mo->data || ((uintptr_t) mo->data % 16)) {
+        return false;
+    }
+    const int pm = ops_pos_of(cgraph, mo);
+    if (pm < 0) {
+        return false;
+    }
+    s.row      = (int) j;
+    s.cont_pos = p;
+    {
+        // a mix that was launched early already (its node may still be ahead)
+        auto it = ops_mix_scratch.find(mo);
+        if (it != ops_mix_scratch.end()) {
+            s.ptr = it->second + j*n;
+            return true;
+        }
+    }
+    if (pm < i_grp) {
+        if (ops_unmat.count(mo) || ops_elided.count(mo)) {
+            return false; // its mix wrote only the CONT copies
+        }
+        s.ptr = (const float *) mo->data + j*n;
+        return true;
+    }
+    // the mix comes later: it must be one that the mix fusion takes, with every input available now, and its
+    // rows must be read through CONT copies only
+    auto sp = ops_mix_spans.find(mo);
+    if (sp == ops_mix_spans.end() || sp->second.first <= i_grp || sp->second.second != pm) {
+        return false;
+    }
+    const int i2 = sp->second.first;
+    {
+        std::vector<const ggml_tensor *> tmp;
+        const ops_mix_early chk = { i_grp, nullptr };
+        if (ops_mixout_impl(nullptr, const_cast<ggml_cgraph *>(cgraph), i2, &tmp, &chk) != pm - i2) {
+            return false;
+        }
+    }
+    if (!ops_mix_rows_cont_only(cgraph, mo, pm)) {
+        return false;
+    }
+    s.early_mo = mo;
+    s.early_i  = i2;
+    return true;
+}
+
+// RMS_NORM node of a grouped chain -> the gate result in scratch
+struct ops_ctl_dnorm_pend {
+    const float * x;
+    int           grp; // node index of the group
+};
+static std::unordered_map<const ggml_tensor *, ops_ctl_dnorm_pend> ops_ctl_dpend;
+
+// the chains that would be grouped at the CONCAT at node i (pure): their number (0 or >= 2)
+static int ops_ctlgrp_plan(const ggml_cgraph * cgraph, int i, ops_ctl_chain * ch, ops_ctl_src (* src)[2]) {
+    if (!ops_ctlgrp_on() || ops_verify()) {
+        return 0;
+    }
+    ops_ctl_chain cand[INK_CTL_MAXC];
+    if (!ops_ctl_match(cgraph, i, cand[0])) {
+        return 0;
+    }
+    ops_elided_prepare(cgraph);
+    int ncand = 1;
+    {
+        const int lim = std::min(cgraph->n_nodes, i + 240);
+        for (int k = cand[0].i_dmul + 1; k < lim && ncand < INK_CTL_MAXC; ++k) {
+            if (cgraph->nodes[k]->op == GGML_OP_CONCAT && ops_ctl_match(cgraph, k, cand[ncand])) {
+                k = cand[ncand].i_dmul;
+                ncand++;
+            }
+        }
+    }
+    if (ncand < 2) {
+        return 0;
+    }
+    int nc = 0;
+    for (int c = 0; c < ncand; ++c) {
+        ops_ctl_src s0, s1;
+        const bool ok = ops_ctl_resolve(cgraph, cand[c].cur, i, s0) && ops_ctl_resolve(cgraph, cand[c].msg, i, s1);
+        if (!ok) {
+            if (ops_debug()) {
+                fprintf(stderr, "ink ops ctlgrp: chain at node %d (group at %d) not resolvable\n", cand[c].i_cat, i);
+            }
+            if (c == 0) {
+                return 0;
+            }
+            continue;
+        }
+        ch[nc]     = cand[c];
+        src[nc][0] = s0;
+        src[nc][1] = s1;
+        nc++;
+    }
+    return nc < 2 ? 0 : nc;
+}
+
+// A lean <2, 2> mix (nodes i..ko, arguments la) is about to be launched. When the control group that follows it needs
+// one more mix of that form that comes later in the graph, both are launched here as one kernel; the later mix writes
+// its rows to scratch (as in ops_try_ctlgrp, which then finds them there).
+static bool ops_mix_pair_launch(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i, int ko, const ink_mixl_args & la, int nd) {
+    static const bool on = ops_env_on("GGML_CUDA_INK_MIX_PAIR");
+    if (!on || !ops_ctlgrp_on() || ops_verify() || nd < 1 || nd > 2) {
+        return false;
+    }
+    int kc = -1;
+    {
+        const int lim = std::min(cgraph->n_nodes, ko + 40);
+        for (int m = ko + 1; m < lim && kc < 0; ++m) {
+            if (cgraph->nodes[m]->op == GGML_OP_CONCAT) {
+                kc = m;
+            }
+        }
+    }
+    if (kc < 0) {
+        return false;
+    }
+    ops_ctl_chain ch[INK_CTL_MAXC];
+    ops_ctl_src   src[INK_CTL_MAXC][2];
+    const int nc = ops_ctlgrp_plan(cgraph, kc, ch, src);
+    const ggml_tensor * mo2 = nullptr;
+    int                 i2  = -1;
+    for (int c = 0; c < nc; ++c) {
+        for (int r = 0; r < 2; ++r) {
+            if (!src[c][r].early_mo) {
+                continue;
+            }
+            if (mo2 && mo2 != src[c][r].early_mo) {
+                return false;
+            }
+            mo2 = src[c][r].early_mo;
+            i2  = src[c][r].early_i;
+        }
+    }
+    if (!mo2 || mo2->ne[1] != 2 || i2 <= ko) {
+        return false;
+    }
+    {
+        // its inputs must exist here already (the plan checked them at the group's node)
+        std::vector<const ggml_tensor *> tmp;
+        const ops_mix_early chk = { i, nullptr, nullptr };
+        if (ops_mixout_impl(nullptr, cgraph, i2, &tmp, &chk) <= 0) {
+            return false;
+        }
+    }
+    float * scratch = (float *) ops_q8_buffer((size_t) 2*INK_CTL_N*sizeof(float));
+    ink_mixl_args la2 = {};
+    const ops_mix_early e = { i, scratch, &la2 };
+    if (ops_mixout_impl(&ctx, cgraph, i2, nullptr, &e) <= 0) {
+        return false;
+    }
+    if (nd == 1) {
+        ink_mixl_pair<1><<<2, 1024, 0, ctx.stream()>>>(la, la2);
+    } else {
+        ink_mixl_pair<2><<<2, 1024, 0, ctx.stream()>>>(la, la2);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    ops_hits[OPS_MIX_PAIR]++;
+    return true;
+}
+
+// A lean mix with one query (nodes i..ko, arguments la: the attention-input mix of a layer) is about to be launched.
+// In a looped pass it is followed by the kv-message mix M1, the K control chain and later the attention-message mix M2;
+// M1 and M2 only read the previous pass. When both can be launched here (inputs available, rows read through CONT
+// copies only, a control group follows that needs M2), the three mixes run as the blocks of one kernel; M1 and M2
+// write scratch rows that the control group and ops_try_cont pick up.
+#define OPS_TRI_REJECT(code) do { if (ops_debug()) { fprintf(stderr, "ink ops mix tri: reject %d at node %d S %d nd %d\n", code, i, S, nd); } return false; } while (0)
+
+static bool ops_mix_tri_launch(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i, int ko, const ink_mixl_args & la, int S, int nd) {
+    static const bool on = ops_env_on("GGML_CUDA_INK_MIX_TRI") && ops_env_on("GGML_CUDA_INK_MIX_PAIR") && ops_env_on("GGML_CUDA_INK_CONT_FOLD");
+    if (!on || !ops_ctlgrp_on() || ops_verify() || nd < 1 || nd > 4 || S < 2 || S > 5) {
+        return false;
+    }
+    // M1: the next CONCAT
+    int m1 = -1;
+    {
+        const int lim = std::min(cgraph->n_nodes, ko + 16);
+        for (int m = ko + 1; m < lim && m1 < 0; ++m) {
+            if (cgraph->nodes[m]->op == GGML_OP_CONCAT) {
+                m1 = m;
+            }
+        }
+    }
+    if (m1 < 0) {
+        OPS_TRI_REJECT(1);
+    }
+    int ko1 = -1;
+    {
+        std::vector<const ggml_tensor *> tmp;
+        const ops_mix_early chk = { i, nullptr, nullptr };
+        const int r1 = ops_mixout_impl(nullptr, cgraph, m1, &tmp, &chk);
+        if (r1 <= 0 || ops_mix_dry_S != 2 || ops_mix_dry_nq != 2) {
+            OPS_TRI_REJECT(2);
+        }
+        ko1 = m1 + r1;
+    }
+    const ggml_tensor * mo1 = cgraph->nodes[ko1];
+    if (!ops_mix_rows_cont_only(cgraph, mo1, ko1)) {
+        OPS_TRI_REJECT(3);
+    }
+    // the control group after M1 and the mix M2 it needs
+    int kc = -1;
+    {
+        const int lim = std::min(cgraph->n_nodes, ko1 + 40);
+        for (int m = ko1 + 1; m < lim && kc < 0; ++m) {
+            if (cgraph->nodes[m]->op == GGML_OP_CONCAT) {
+                kc = m;
+            }
+        }
+    }
+    if (kc < 0) {
+        OPS_TRI_REJECT(4);
+    }
+    ops_ctl_chain ch[INK_CTL_MAXC];
+    ops_ctl_src   src[INK_CTL_MAXC][2];
+    const int nc = ops_ctlgrp_plan(cgraph, kc, ch, src);
+    const ggml_tensor * mo2 = nullptr;
+    int                 i2  = -1;
+    for (int c = 0; c < nc; ++c) {
+        for (int r = 0; r < 2; ++r) {
+            if (!src[c][r].early_mo) {
+                continue;
+            }
+            if (mo2 && mo2 != src[c][r].early_mo) {
+                OPS_TRI_REJECT(5);
+            }
+            mo2 = src[c][r].early_mo;
+            i2  = src[c][r].early_i;
+        }
+    }
+    if (!mo2 || mo2 == mo1 || mo2->ne[1] != 2 || i2 <= ko1) {
+        OPS_TRI_REJECT(6);
+    }
+    {
+        std::vector<const ggml_tensor *> tmp;
+        const ops_mix_early chk = { i, nullptr, nullptr };
+        if (ops_mixout_impl(nullptr, cgraph, i2, &tmp, &chk) <= 0 || ops_mix_dry_S != 2 || ops_mix_dry_nq != 2) {
+            OPS_TRI_REJECT(7);
+        }
+    }
+    // every CONT copy of an M1 row that comes before the group's node must be one that the group will read from
+    // scratch (ops_try_cont skips it then); otherwise it would cost a copy launch
+    {
+        ops_set chain_nodes;
+        for (int c = 0; c < nc; ++c) {
+            const int idx[11] = { ch[c].i_cat, ch[c].i_nrm, ch[c].i_down, ch[c].g[0], ch[c].g[1], ch[c].g[2], ch[c].g[3], ch[c].g[4],
+                                  ch[c].g[5], ch[c].g[6], ch[c].g[7] };
+            for (int m : idx) {
+                chain_nodes.insert(cgraph->nodes[m]);
+            }
+        }
+        const int lim = std::min(cgraph->n_nodes, kc + 400);
+        for (int m = ko1 + 1; m < lim; ++m) {
+            const ggml_tensor * nd2 = cgraph->nodes[m];
+            if (nd2->op == GGML_OP_CONT && nd2->src[0] && nd2->src[0]->view_src == mo1 && !ops_all_users_in(cgraph, m, chain_nodes, lim)) {
+                OPS_TRI_REJECT(8);
+            }
+        }
+    }
+    float * scratch1 = (float *) ops_q8_buffer((size_t) 2*INK_CTL_N*sizeof(float));
+    float * scratch2 = (float *) ops_q8_buffer((size_t) 2*INK_CTL_N*sizeof(float));
+    ink_mixl_args la1 = {};
+    ink_mixl_args la2 = {};
+    const ops_mix_early e1 = { i, scratch1, &la1 };
+    if (ops_mixout_impl(&ctx, cgraph, m1, nullptr, &e1) <= 0) {
+        return false;
+    }
+    const ops_mix_early e2 = { i, scratch2, &la2 };
+    if (ops_mixout_impl(&ctx, cgraph, i2, nullptr, &e2) <= 0) {
+        // M1 is committed to scratch already: run the two that are ready as a pair-less fallback
+        GGML_ABORT("ink ops: second message mix of a mix triple did not match");
+    }
+    cudaStream_t stream = ctx.stream();
+    switch (S*10 + nd) {
+        case 21: ink_mixl_tri<2, 1><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 22: ink_mixl_tri<2, 2><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 23: ink_mixl_tri<2, 3><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 24: ink_mixl_tri<2, 4><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 31: ink_mixl_tri<3, 1><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 32: ink_mixl_tri<3, 2><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 33: ink_mixl_tri<3, 3><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 34: ink_mixl_tri<3, 4><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 41: ink_mixl_tri<4, 1><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 42: ink_mixl_tri<4, 2><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 43: ink_mixl_tri<4, 3><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 44: ink_mixl_tri<4, 4><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 51: ink_mixl_tri<5, 1><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 52: ink_mixl_tri<5, 2><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 53: ink_mixl_tri<5, 3><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        case 54: ink_mixl_tri<5, 4><<<3, 1024, 0, stream>>>(la, la1, la2); break;
+        default: GGML_ABORT("ink ops: mix triple shape");
+    }
+    CUDA_CHECK(cudaGetLastError());
+    ops_hits[OPS_MIX_TRI]++;
+    return true;
+}
+
+static int ops_try_ctlgrp(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    const int64_t n = INK_CTL_N;
+    ops_ctl_chain ch[INK_CTL_MAXC];
+    ops_ctl_src   src[INK_CTL_MAXC][2];
+    const int nc = ops_ctlgrp_plan(cgraph, i, ch, src);
+    if (nc < 2) {
+        return 0;
+    }
+
+    // ---- commit ----
+    // mixes that have to run first
+    {
+        std::vector<std::pair<const ggml_tensor *, float *>> done;
+        for (int c = 0; c < nc; ++c) {
+            for (int r = 0; r < 2; ++r) {
+                ops_ctl_src & s = src[c][r];
+                if (!s.early_mo) {
+                    continue;
+                }
+                float * scratch = nullptr;
+                for (const auto & d : done) {
+                    if (d.first == s.early_mo) {
+                        scratch = d.second;
+                    }
+                }
+                if (!scratch) {
+                    scratch = (float *) ops_q8_buffer((size_t) s.early_mo->ne[1]*n*sizeof(float));
+                    const ops_mix_early e = { i, scratch };
+                    if (ops_mixout_impl(&ctx, cgraph, s.early_i, nullptr, &e) <= 0) {
+                        GGML_ABORT("ink ops: early mix of a control group did not launch");
+                    }
+                    done.push_back({ s.early_mo, scratch });
+                }
+                s.ptr = scratch + (int64_t) s.row*n;
+            }
+        }
+    }
+    float * hbuf = (float *) ops_q8_buffer((size_t) nc*2*n*sizeof(float)); // normalized (cur, msg) per chain
+    float * dbuf = (float *) ops_q8_buffer((size_t) nc*64*sizeof(float));  // down GEMV results
+    float * obuf = (float *) ops_q8_buffer((size_t) nc*n*sizeof(float));   // gate results
+
+    ink_ctl_norm_args na = {};
+    ink_ctl_down_args da = {};
+    ink_ctl_gate_args ga = {};
+    for (int c = 0; c < nc; ++c) {
+        const ops_ctl_chain & q = ch[c];
+        const ggml_tensor * nrm  = cgraph->nodes[q.i_nrm];
+        const ggml_tensor * down = cgraph->nodes[q.i_down];
+        for (int r = 0; r < 2; ++r) {
+            na.src[2*c + r] = src[c][r].ptr;
+            na.dst[2*c + r] = hbuf + (int64_t) (2*c + r)*n;
+            na.cpy[2*c + r] = nullptr;
+            na.eps[2*c + r] = ops_param_f32(nrm, 0);
+        }
+        da.w[c]   = (const char *) down->src[0]->data;
+        da.x[c]   = hbuf + (int64_t) 2*c*n;
+        da.dst[c] = dbuf + c*64;
+        da.nb1[c] = down->src[0]->nb[1];
+        ga.wf[c]      = (const nv_bfloat16 *) cgraph->nodes[q.g[0]]->src[0]->data;
+        ga.wg[c]      = (const nv_bfloat16 *) cgraph->nodes[q.g[4]]->src[0]->data;
+        ga.h[c]       = dbuf + c*64;
+        ga.cur[c]     = src[c][0].ptr;
+        ga.msg[c]     = src[c][1].ptr;
+        ga.dst[c]     = obuf + (int64_t) c*n;
+        ga.s_scale[c] = ops_param_f32(cgraph->nodes[q.g[2]], 0);
+        ga.s_bias[c]  = ops_param_f32(cgraph->nodes[q.g[2]], 1);
+    }
+    cudaStream_t stream = ctx.stream();
+    if (nc == 2) {
+        ink_ctl_norm<4><<<4, 576, 0, stream>>>(na);
+        ink_ctl_down<2><<<dim3(64, 2, 1), 256, 0, stream>>>(da);
+        ink_ctl_gate<2><<<dim3(n/4, 2, 1), 256, 0, stream>>>(ga);
+    } else {
+        ink_ctl_norm<6><<<6, 576, 0, stream>>>(na);
+        ink_ctl_down<3><<<dim3(64, 3, 1), 256, 0, stream>>>(da);
+        ink_ctl_gate<3><<<dim3(n/4, 3, 1), 256, 0, stream>>>(ga);
+    }
+    CUDA_CHECK(cudaGetLastError());
+
+    // bookkeeping: the chain nodes are not materialized, the norm + weight of each chain runs at its RMS_NORM
+    ops_set chain_nodes;
+    for (int c = 0; c < nc; ++c) {
+        const ops_ctl_chain & q = ch[c];
+        const int idx[11] = { q.i_cat, q.i_nrm, q.i_down, q.g[0], q.g[1], q.g[2], q.g[3], q.g[4], q.g[5], q.g[6], q.g[7] };
+        for (int m : idx) {
+            const ggml_tensor * nd = cgraph->nodes[m];
+            chain_nodes.insert(nd);
+            ops_unmat.insert(nd);
+            if (m != i) {
+                ggml_cuda_inkling_defer_skip(nd);
+            }
+        }
+        ops_ctl_dpend[cgraph->nodes[q.i_drms]] = { obuf + (int64_t) c*n, i };
+        ops_hits[OPS_CTLGRP_CHAIN]++;
+    }
+    // CONT copies of rows that only the grouped chains read
+    {
+        const int lim = std::min(cgraph->n_nodes, i + 400);
+        ops_set seen;
+        for (int c = 0; c < nc; ++c) {
+            for (int r = 0; r < 2; ++r) {
+                const int p = src[c][r].cont_pos;
+                if (p < 0) {
+                    continue;
+                }
+                const ggml_tensor * ct = cgraph->nodes[p];
+                if (seen.count(ct) || !ops_all_users_in(cgraph, p, chain_nodes, lim)) {
+                    continue;
+                }
+                seen.insert(ct);
+                ops_unmat.insert(ct);
+                ggml_cuda_inkling_defer_skip(ct);
+                ops_hits[OPS_CONT_SKIP]++;
+            }
+        }
+    }
+    ops_hits[OPS_CTLGRP]++;
+    return -1;
+}
+
+// The norm + weight of a grouped chain, at its RMS_NORM node. The norms of the later chains of the same group are
+// launched with it (one block per chain) when their result buffers are free from here to their own nodes.
+static int ops_try_ctl_dnorm(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool multi_on = ops_env_on("GGML_CUDA_INK_CTLGRP_DNORM");
+    auto it = ops_ctl_dpend.find(cgraph->nodes[i]);
+    if (it == ops_ctl_dpend.end()) {
+        return 0;
+    }
+    const ops_ctl_dnorm_pend me = it->second;
+    ops_ctl_dpend.erase(it);
+    const int k = ops_norm_mul_match(cgraph, i);
+    if (k < 0) {
+        GGML_ABORT("ink ops: norm of a grouped control chain does not match");
+    }
+    const ggml_tensor * mul0 = cgraph->nodes[k];
+    if (multi_on && !ops_ctl_dpend.empty() && ops_q8_consumer_rows(cgraph, k, mul0, 64) != 1) {
+        struct row {
+            const ggml_tensor * rms;
+            int                 i_rms, k;
+            const float *       x;
+        };
+        std::vector<row> cand;
+        for (const auto & kv : ops_ctl_dpend) {
+            if (kv.second.grp != me.grp) {
+                continue;
+            }
+            const int p = ops_pos_of(cgraph, kv.first);
+            if (p <= i) {
+                continue;
+            }
+            const int kk = ops_norm_mul_match(cgraph, p);
+            if (kk >= 0) {
+                cand.push_back({ kv.first, p, kk, kv.second.x });
+            }
+        }
+        std::sort(cand.begin(), cand.end(), [](const row & a, const row & b) { return a.i_rms < b.i_rms; });
+        std::vector<row> acc;
+        for (const row & r : cand) {
+            const ggml_tensor * mulr = cgraph->nodes[r.k];
+            const ggml_tensor * wt   = mulr->src[1];
+            bool ok = acc.size() < 2 && ops_q8_consumer_rows(cgraph, r.k, mulr, 64) != 1 && ops_available_before(cgraph, wt, i) &&
+                      !ops_overlap(mulr, mul0) && !ops_overlap(mulr, mul0->src[1]) && !ops_overlap(mul0, wt) && !ops_overlap(mulr, wt);
+            for (const row & o : acc) {
+                ok = ok && !ops_overlap(mulr, cgraph->nodes[o.k]) && !ops_overlap(mulr, cgraph->nodes[o.k]->src[1]) &&
+                     !ops_overlap(cgraph->nodes[o.k], wt);
+            }
+            if (ok) {
+                const ops_set fused = { r.rms, mulr };
+                ok = ops_write_window_free(cgraph, i, r.k, mulr, fused);
+            }
+            if (ok) {
+                acc.push_back(r);
+            }
+        }
+        if (!acc.empty()) {
+            ink_dnorm_args a = {};
+            a.x[0]   = me.x;
+            a.w[0]   = (const float *) mul0->src[1]->data;
+            a.dst[0] = (float *) mul0->data;
+            a.eps[0] = ops_param_f32(cgraph->nodes[i], 0);
+            for (size_t r = 0; r < acc.size(); ++r) {
+                const ggml_tensor * mulr = cgraph->nodes[acc[r].k];
+                a.x[r + 1]   = acc[r].x;
+                a.w[r + 1]   = (const float *) mulr->src[1]->data;
+                a.dst[r + 1] = (float *) mulr->data;
+                a.eps[r + 1] = ops_param_f32(acc[r].rms, 0);
+            }
+            if (acc.size() == 1) {
+                ink_dnorm<2><<<2, 576, 0, ctx.stream()>>>(a);
+            } else {
+                ink_dnorm<3><<<3, 576, 0, ctx.stream()>>>(a);
+            }
+            CUDA_CHECK(cudaGetLastError());
+            for (const row & r : acc) {
+                ggml_cuda_inkling_defer_skip(r.rms);
+                ggml_cuda_inkling_defer_skip(cgraph->nodes[r.k]);
+                ops_ctl_dpend.erase(r.rms);
+                ops_hits[OPS_NORMMUL]++;
+                ops_hits[OPS_CTL_DNORM]++;
+            }
+            ops_hits[OPS_NORMMUL]++;
+            return k - i;
+        }
+    }
+    return ops_norm_mul_launch(ctx, cgraph, i, k, me.x);
+}
+
+// ---------------------------------------------------------------------------------------------
+// CONT copies of mixed rows that feed control(): CONT(row) [CONT(row)] CONCAT(cur, msg) RMS_NORM. The norm kernel
+// reads the rows at their sources and writes the copies as well (no copyBuffer launch).
+// A CONT whose source row lives in scratch (early mix) and that is not folded is copied here.
+// ---------------------------------------------------------------------------------------------
+
+static bool ops_row_cont(const ggml_tensor * c) {
+    const ggml_tensor * v = c->src[0];
+    return c->op == GGML_OP_CONT && v && c->type == GGML_TYPE_F32 && v->type == GGML_TYPE_F32 && ggml_nelements(c) == INK_CTL_N &&
+           ggml_nelements(v) == INK_CTL_N && ggml_is_contiguous(c) && ggml_is_contiguous(v) && c->data && v->data &&
+           !(c->flags & GGML_TENSOR_FLAG_OUTPUT);
+}
+
+// where the source row of a row CONT lives; *scratch: it is a row of an early mix
+static const float * ops_row_cont_src(const ggml_tensor * c, bool * scratch) {
+    const ggml_tensor * v = c->src[0];
+    const ggml_tensor * b = ops_data_base(v);
+    *scratch = false;
+    if (b && b != v && b->data) {
+        auto it = ops_mix_scratch.find(b);
+        if (it != ops_mix_scratch.end()) {
+            *scratch = true;
+            return (const float *) ((const char *) it->second + ((const char *) v->data - (const char *) b->data));
+        }
+    }
+    return (const float *) v->data;
+}
+
+static bool ops_ranges_overlap(const void * a, size_t na, const void * b, size_t nb) {
+    const char * a0 = (const char *) a;
+    const char * b0 = (const char *) b;
+    return a0 < b0 + nb && b0 < a0 + na;
+}
+
+static int ops_try_cont_fold(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    const size_t nbytes = INK_CTL_N*sizeof(float);
+    const ggml_tensor * c1 = cgraph->nodes[i];
+    const ggml_tensor * c2 = nullptr;
+    int k  = ops_next(cgraph, i);
+    int k2 = -1;
+    if (k >= 0 && cgraph->nodes[k]->op == GGML_OP_CONT) {
+        c2 = cgraph->nodes[k];
+        k2 = k;
+        if (!ops_row_cont(c2)) {
+            return 0;
+        }
+        k = ops_next(cgraph, k);
+    }
+    if (k < 0 || cgraph->nodes[k]->op != GGML_OP_CONCAT) {
+        return 0;
+    }
+    const int j = ops_ctrl_norm_match(cgraph, k);
+    if (j < 0) {
+        return 0;
+    }
+    const ggml_tensor * cat = cgraph->nodes[k];
+    const ggml_tensor * nrm = cgraph->nodes[j];
+    if (ops_ctrl_rows.count(nrm)) {
+        return 0;
+    }
+    {
+        // a control group that starts at this CONCAT takes precedence (the CONT is then copied the regular way)
+        ops_ctl_chain gch[INK_CTL_MAXC];
+        ops_ctl_src   gsrc[INK_CTL_MAXC][2];
+        if (ops_ctlgrp_plan(cgraph, k, gch, gsrc) >= 2) {
+            return 0;
+        }
+    }
+    const ggml_tensor * rows[2] = { ops_strip_reshape(cat->src[0]), ops_strip_reshape(cat->src[1]) };
+    if (rows[0] == rows[1] || (rows[0] != c1 && rows[1] != c1) || (c2 && rows[0] != c2 && rows[1] != c2)) {
+        return 0;
+    }
+    ops_set fused = { c1, cat, nrm };
+    if (c2) {
+        fused.insert(c2);
+    }
+    ink_ctl_norm_args a = {};
+    for (int r = 0; r < 2; ++r) {
+        const ggml_tensor * t = rows[r];
+        a.dst[r] = (float *) nrm->data + (int64_t) r*INK_CTL_N;
+        a.eps[r] = ops_param_f32(nrm, 0);
+        if (t == c1 || t == c2) {
+            bool scratch = false;
+            a.src[r] = ops_row_cont_src(t, &scratch);
+            a.cpy[r] = (float *) t->data;
+            // the second CONT is read and written before its node
+            if (t == c2 && ((!scratch && !ops_available_before(cgraph, t->src[0], i)) || !ops_write_window_free(cgraph, i, k2, t, fused))) {
+                return 0;
+            }
+        } else {
+            if (!ops_available_before(cgraph, t, i)) {
+                return 0;
+            }
+            a.src[r] = (const float *) t->data;
+        }
+        if (((uintptr_t) a.src[r] % 16) || ((uintptr_t) a.cpy[r] % 16)) {
+            return 0;
+        }
+    }
+    // the norm is written before its node
+    if (!ops_write_window_free(cgraph, i, j, nrm, fused)) {
+        return 0;
+    }
+    // the two row blocks run concurrently: no output may overlap anything else
+    for (int r = 0; r < 2; ++r) {
+        if (ops_ranges_overlap(nrm->data, 2*nbytes, a.src[r], nbytes) ||
+            (a.cpy[r] && (ops_ranges_overlap(nrm->data, 2*nbytes, a.cpy[r], nbytes) || ops_ranges_overlap(a.cpy[r], nbytes, a.src[0], nbytes) ||
+                          ops_ranges_overlap(a.cpy[r], nbytes, a.src[1], nbytes)))) {
+            return 0;
+        }
+    }
+    if (a.cpy[0] && a.cpy[1] && ops_ranges_overlap(a.cpy[0], nbytes, a.cpy[1], nbytes)) {
+        return 0;
+    }
+    ink_ctl_norm<2><<<2, 576, 0, ctx.stream()>>>(a);
+    CUDA_CHECK(cudaGetLastError());
+    if (c2) {
+        ggml_cuda_inkling_defer_skip(c2);
+        ops_hits[OPS_CONT_FOLD]++;
+    }
+    ggml_cuda_inkling_defer_skip(cat);
+    ggml_cuda_inkling_defer_skip(nrm);
+    ops_hits[OPS_CONT_FOLD]++;
+    ops_hits[OPS_CTRLNORM2]++;
+    return -1;
+}
+
+static int ops_try_cont(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool fold_on = ops_env_on("GGML_CUDA_INK_CONT_FOLD");
+    const ggml_tensor * c = cgraph->nodes[i];
+    if (!ops_row_cont(c)) {
+        return 0;
+    }
+    bool scratch = false;
+    const float * src = ops_row_cont_src(c, &scratch);
+    if (!fold_on && !scratch) {
+        return 0;
+    }
+    if (ops_verify()) {
+        return 0; // no early mixes in verify mode
+    }
+    if (fold_on) {
+        const int n = ops_try_cont_fold(ctx, cgraph, i);
+        if (n != 0) {
+            return n;
+        }
+    }
+    if (!scratch) {
+        return 0;
+    }
+    {
+        // a control group starts at the CONCAT that follows and reads this row: it takes it from scratch
+        int k = ops_next(cgraph, i);
+        if (k >= 0 && cgraph->nodes[k]->op == GGML_OP_CONT) {
+            k = ops_next(cgraph, k);
+        }
+        if (k >= 0 && cgraph->nodes[k]->op == GGML_OP_CONCAT) {
+            ops_ctl_chain ch[INK_CTL_MAXC];
+            ops_ctl_src   gsrc[INK_CTL_MAXC][2];
+            const int nc = ops_ctlgrp_plan(cgraph, k, ch, gsrc);
+            if (nc >= 2) {
+                ops_set chain_nodes;
+                for (int q = 0; q < nc; ++q) {
+                    const int idx[11] = { ch[q].i_cat, ch[q].i_nrm, ch[q].i_down, ch[q].g[0], ch[q].g[1], ch[q].g[2], ch[q].g[3], ch[q].g[4],
+                                          ch[q].g[5], ch[q].g[6], ch[q].g[7] };
+                    for (int m : idx) {
+                        chain_nodes.insert(cgraph->nodes[m]);
+                    }
+                }
+                if (ops_all_users_in(cgraph, i, chain_nodes, std::min(cgraph->n_nodes, k + 400))) {
+                    ops_cont_alias[c] = src;
+                    ops_unmat.insert(c);
+                    ops_hits[OPS_CONT_SKIP]++;
+                    return -1;
+                }
+            }
+        }
+    }
+    ink_row_copy<<<(INK_CTL_N + 255)/256, 256, 0, ctx.stream()>>>(src, (float *) c->data, INK_CTL_N);
+    CUDA_CHECK(cudaGetLastError());
+    ops_hits[OPS_CONT_COPY]++;
+    return -1;
+}
+
+// a control CONCAT that no group took: rows that were left in scratch for a group have to be copied now
+static void ops_cont_alias_materialize(ggml_backend_cuda_context & ctx, const ggml_tensor * cat) {
+    for (int q = 0; q < GGML_MAX_SRC; ++q) {
+        const ggml_tensor * t = cat->src[q] ? ops_strip_reshape(cat->src[q]) : nullptr;
+        if (!t) {
+            continue;
+        }
+        auto al = ops_cont_alias.find(t);
+        if (al == ops_cont_alias.end()) {
+            continue;
+        }
+        ink_row_copy<<<(INK_CTL_N + 255)/256, 256, 0, ctx.stream()>>>(al->second, (float *) t->data, INK_CTL_N);
+        CUDA_CHECK(cudaGetLastError());
+        ops_unmat.erase(t);
+        ops_cont_alias.erase(al);
+        ops_hits[OPS_CONT_ALIAS_COPY]++;
+    }
+}
