+bool ggml_cuda_ink_bf16_gate_for(const ggml_tensor * other_base, const float ** gate, ggml_tensor ** mul, const ggml_tensor ** gate_mm,
+                                 const ggml_tensor ** other) {
+    for (auto & kv : ink_bf16_early_map) {
+        ink_bf16_early & e = kv.second;
+        if (e.kind != INK_EARLY_GATE || e.claimed || e.nvar != 1) {
+            continue;
+        }
+        const ggml_tensor * o = e.other;
+        while (o && o != other_base && (o->op == GGML_OP_RESHAPE || o->op == GGML_OP_VIEW) && o->view_offs == 0 && o->src[0]) {
+            o = o->src[0];
+        }
+        if (o != other_base || e.other->data != other_base->data) {
+            continue;
+        }
+        *gate    = e.data[0];
+        *mul     = e.mul;
+        *gate_mm = kv.first;
+        *other   = e.other;
+        return true;
+    }
+    return false;
+}
