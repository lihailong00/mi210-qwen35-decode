+    return p;
+}
+
+void ggml_cuda_ink_moe_red_cancel() {
+    imoe_red_pending.active = false;
+}
+
+static void imoe_red_flush(ggml_backend_cuda_context & ctx) {
+    imoe_launch_reduce8(ctx.stream(), imoe_red_pending.ex, imoe_red_pending.rw, (float *) imoe_red_pending.x->data, imoe_red_pending.n);
+    CUDA_CHECK(cudaGetLastError());
+    imoe_red_pending.active = false;
+    imoe_hit(IMOE_RED_FLUSH);
+}
+
+bool ggml_cuda_ink_moe_red_pending(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i, bool may_wait) {
+    if (!imoe_red_pending.active) {
+        return false;
+    }
+    if (may_wait && cgraph->nodes[i] == imoe_red_pending.cat) {
+        return true;
+    }
+    imoe_red_flush(ctx);
+    return false;
+}
+
+void ggml_cuda_ink_moe_red_settle(ggml_backend_cuda_context & ctx, int n_ops) {
+    if (!imoe_red_pending.active) {
+        return; // claimed by the convolution fusion
+    }
+    if (n_ops != 0) {
+        // a fusion of inkling-ops.cu took the CONCAT without claiming the sum: its kernel may already have read x
+        GGML_ABORT("inkling: pending MoE reduction was not claimed by the convolution fusion (inkling-ops.cu hunk missing?)");
+    }
+    imoe_red_flush(ctx);
+}
+
+const float * ggml_cuda_ink_moe_red_claim(const ggml_tensor * x, const float ** rw) {
+    if (!imoe_red_pending.active || imoe_red_pending.x != x) {
+        return nullptr;
+    }
+    imoe_red_pending.active = false;
+    imoe_hit(IMOE_RED_CONV);
+    *rw = imoe_red_pending.rw;
+    return imoe_red_pending.ex;
+}
+
+void ggml_cuda_ink_moe_begin() {
+    if (imoe_red_pending.active) {
+        GGML_LOG_ERROR("%s: a deferred Inkling MoE reduction was never consumed in the previous graph evaluation\n", __func__);
+        imoe_red_pending.active = false;
+    }
+    imoe_rw_copies.clear();
 }
