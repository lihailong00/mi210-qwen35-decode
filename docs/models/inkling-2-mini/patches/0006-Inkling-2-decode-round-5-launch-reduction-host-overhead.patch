+// ---- staged upload of small graph inputs: GGML_CUDA_INK_STAGED_INPUTS=0 restores the blocking copies ----
+// The scheduler uploads every user input of a split with a blocking copy on the per-thread stream (cudaMemcpyAsync +
+// cudaStreamSynchronize, ~11 us each on ROCm; a decoded token has 12 of them). Here the bytes are copied to a pinned
+// staging buffer before returning, so the caller may overwrite its data at once, and the device copy is queued on the
+// compute stream of the backend: it runs before the graph that reads the input and after everything queued earlier.
+// A staging slot is reused only after the stream was synchronized.
+struct ggml_cuda_input_staging {
+    ggml_backend_cuda_context * ctx  = nullptr;
+    char *                      host = nullptr;
+    size_t                      used = 0;
+};
+static const size_t ggml_cuda_input_staging_size     = 512 * 1024;
+static const size_t ggml_cuda_input_staging_max_copy = 64 * 1024;
+static std::mutex ggml_cuda_input_staging_mutex;
+static std::vector<ggml_cuda_input_staging> ggml_cuda_input_stagings;
+
+struct ggml_cuda_input_staging_stats {
+    uint64_t n = 0, bytes = 0, n_wrap = 0;
+    ~ggml_cuda_input_staging_stats() {
+        const char * v = getenv("GGML_CUDA_FUSION_STATS");
+        if (v != nullptr && atoi(v) != 0) {
+            fprintf(stderr, "ggml_cuda host stats: staged input copies %llu (%llu bytes, %llu staging wraps)\n",
+                    (unsigned long long) n, (unsigned long long) bytes, (unsigned long long) n_wrap);
+        }
+    }
+};
+static ggml_cuda_input_staging_stats ggml_cuda_input_staging_stat;
+
+static bool ggml_cuda_input_staging_enabled() {
+    static const bool enabled = [] {
+        const char * v = getenv("GGML_CUDA_INK_STAGED_INPUTS");
+        return v == nullptr || atoi(v) != 0;
+    }();
+    return enabled;
+}
+
+// called with the stream of cuda_ctx idle
+static void ggml_cuda_input_staging_reset(ggml_backend_cuda_context * cuda_ctx) {
+    std::lock_guard<std::mutex> lock(ggml_cuda_input_staging_mutex);
+    for (ggml_cuda_input_staging & st : ggml_cuda_input_stagings) {
+        if (st.ctx == cuda_ctx) {
+            st.used = 0;
+        }
+    }
+}
+
+static void ggml_cuda_input_staging_free(ggml_backend_cuda_context * cuda_ctx) {
+    std::lock_guard<std::mutex> lock(ggml_cuda_input_staging_mutex);
+    for (size_t i = 0; i < ggml_cuda_input_stagings.size(); i++) {
+        if (ggml_cuda_input_stagings[i].ctx == cuda_ctx) {
+            ggml_cuda_set_device(cuda_ctx->device);
+            CUDA_CHECK(cudaStreamSynchronize(cuda_ctx->stream()));
+            CUDA_CHECK(cudaFreeHost(ggml_cuda_input_stagings[i].host));
+            ggml_cuda_input_stagings.erase(ggml_cuda_input_stagings.begin() + i);
+            return;
+        }
+    }
+}
+
+// Copies `size` bytes to the start of `tensor`. Returns false, having done nothing, if the caller has to use the blocking path.
+static bool ggml_backend_cuda_set_tensor_staged(ggml_backend_t backend, ggml_tensor * tensor, const void * data, size_t size) {
+    if (!ggml_cuda_input_staging_enabled() || size == 0 || size > ggml_cuda_input_staging_max_copy || !ggml_backend_is_cuda(backend)) {
+        return false;
+    }
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (buf == nullptr || buf->buft != ggml_backend_cuda_buffer_type(cuda_ctx->device) || tensor->data == nullptr) {
+        return false;
+    }
+
+    ggml_cuda_set_device(cuda_ctx->device);
+
+    char * dst_host = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_input_staging_mutex);
+        ggml_cuda_input_staging * st = nullptr;
+        for (ggml_cuda_input_staging & cand : ggml_cuda_input_stagings) {
+            if (cand.ctx == cuda_ctx) {
+                st = &cand;
+            }
+        }
+        if (st == nullptr) {
+            void * host = nullptr;
+            if (cudaMallocHost(&host, ggml_cuda_input_staging_size) != cudaSuccess) {
+                (void) cudaGetLastError();
+                return false;
+            }
+            ggml_cuda_input_stagings.push_back({ cuda_ctx, (char *) host, 0 });
+            st = &ggml_cuda_input_stagings.back();
+        }
+        const size_t padded = GGML_PAD(size, 64);
+        if (st->used + padded > ggml_cuda_input_staging_size) {
+            // the queued copies still read the staging buffer
+            CUDA_CHECK(cudaStreamSynchronize(cuda_ctx->stream()));
+            st->used = 0;
+            ggml_cuda_input_staging_stat.n_wrap++;
+        }
+        dst_host = st->host + st->used;
+        st->used += padded;
+    }
+
+    ggml_cuda_hostprof_scope hp(ggml_cuda_hostprof_state::SET_ASYNC, size);
+    memcpy(dst_host, data, size);
+    CUDA_CHECK(cudaMemcpyAsync(tensor->data, dst_host, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
+    ggml_cuda_input_staging_stat.n++;
+    ggml_cuda_input_staging_stat.bytes += size;
+    return true;
+}
