+// ---- helper threads for the per-candidate loops of the samplers ----
+// With a 200k vocabulary and no truncating sampler in front (top_k 0, top_p 1) the softmax of llama_sampler_dist costs
+// about 1 ms per token on one core (expf and a division per candidate). The loops over independent candidates run on a
+// small pool; everything whose result depends on the order of the operations (the running sum, the draw) stays serial,
+// so the sampled token and the probabilities are bit-identical to the serial code. The greedy sampler and the
+// temperature 0 case (argmax over all candidates) use the pool as well.
+// LLAMA_SAMPLER_THREADS=N sets the number of threads (default: half of the hardware threads, at most 8), 1 = serial code.
+namespace {
+class llama_sampler_pool {
+  public:
+    static llama_sampler_pool & get() {
+        static llama_sampler_pool pool;
+        return pool;
+    }
+
+    int n_threads() const { return n_threads_; }
+
+    // one user at a time, a second sampler thread runs the serial code
+    bool try_lock() { return user_mutex_.try_lock(); }
+    void unlock()   { user_mutex_.unlock(); }
+
+    // scratch buffers of the current user
+    std::vector<float>  max_blocks;
+    std::vector<size_t> idx_blocks;
+    std::vector<double> sum_blocks;
+    std::vector<double> p_dbl;
+    std::vector<std::atomic<uint8_t>> exp_done;
+
+    // calls fn(i0, i1) for consecutive blocks covering [0, n), from several threads; returns when all blocks are done
+    void run(size_t n, size_t block, const std::function<void(size_t, size_t)> & fn) {
+        begin(n, block, fn);
+        work();
+        finish();
+    }
+
+    // the same on the helper threads only: the caller goes on between begin() and finish(), fn must stay alive
+    void begin(size_t n, size_t block, const std::function<void(size_t, size_t)> & fn) {
+        if (workers_.empty()) {
+            start();
+        }
+        job_       = &fn;
+        job_n_     = n;
+        job_block_ = block;
+        next_.store(0, std::memory_order_relaxed);
+        done_.store(0, std::memory_order_relaxed);
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            gen_.fetch_add(1, std::memory_order_release);
+        }
+        if (n_sleeping_.load(std::memory_order_acquire) > 0) {
+            cv_.notify_all();
+        }
+    }
+
+    void finish() {
+        while (done_.load(std::memory_order_acquire) != (int) workers_.size()) {
+            // the workers are finishing their last block
+        }
+        job_ = nullptr;
+    }
+
+  private:
+    llama_sampler_pool() {
+        int n = (int) std::thread::hardware_concurrency() / 2;
+        n = std::max(1, std::min(8, n));
+        const char * e = getenv("LLAMA_SAMPLER_THREADS");
+        if (e != nullptr) {
+            n = std::max(1, std::min(64, atoi(e)));
+        }
+        n_threads_ = n;
+    }
+
+    ~llama_sampler_pool() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            stop_ = true;
+            gen_.fetch_add(1, std::memory_order_release);
+        }
+        cv_.notify_all();
+        for (auto & t : workers_) {
+            t.join();
+        }
+    }
+
+    void start() {
+        for (int i = 1; i < n_threads_; i++) {
+            workers_.emplace_back([this] { loop(); });
+        }
+    }
+
+    void work() {
+        const size_t n = job_n_, block = job_block_;
+        while (true) {
+            const size_t i0 = next_.fetch_add(block, std::memory_order_relaxed);
+            if (i0 >= n) {
+                break;
+            }
+            (*job_)(i0, std::min(n, i0 + block));
+        }
+    }
+
+    void loop() {
+        uint64_t seen = 0;
+        while (true) {
+            // a second job usually follows within ~100 us: poll for a while before sleeping
+            bool found = false;
+            const auto t_end = std::chrono::steady_clock::now() + std::chrono::microseconds(300);
+            while (!found) {
+                for (int i = 0; i < 256 && !found; i++) {
+                    found = gen_.load(std::memory_order_acquire) != seen;
+                }
+                if (std::chrono::steady_clock::now() > t_end) {
+                    break;
+                }
+            }
+            if (!found) {
+                std::unique_lock<std::mutex> lock(mutex_);
+                n_sleeping_.fetch_add(1, std::memory_order_release);
+                cv_.wait(lock, [&] { return gen_.load(std::memory_order_acquire) != seen; });
+                n_sleeping_.fetch_sub(1, std::memory_order_release);
+            }
+            seen = gen_.load(std::memory_order_acquire);
+            if (stop_) {
+                return;
+            }
+            work();
+            done_.fetch_add(1, std::memory_order_release);
+        }
+    }
+
+    int                      n_threads_ = 1;
+    std::mutex               user_mutex_;
+    std::vector<std::thread> workers_;
+    std::mutex               mutex_;
+    std::condition_variable  cv_;
+    std::atomic<uint64_t>    gen_{0};
+    std::atomic<int>         n_sleeping_{0};
+    std::atomic<int>         done_{0};
+    std::atomic<size_t>      next_{0};
+    bool                     stop_ = false;
+
+    const std::function<void(size_t, size_t)> * job_ = nullptr;
+    size_t job_n_ = 0, job_block_ = 1;
+};
