+static __global__ void ink_gate_mul(const float * __restrict__ gate, const float * other, float * dst, const int n) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const float g = gate[i];
+    const float o = other[i];
