+// index of the first candidate with the largest logit, as found by the serial scan
+//   sel = 0; for (i = 1; i < size; ++i) if (data[i].logit > data[sel].logit) sel = i;
+// (a NaN never wins a comparison: a NaN first logit keeps index 0, any other NaN is skipped)
+static size_t llama_sampler_argmax_first(const llama_token_data_array * cur_p) {
+    const llama_token_data * data = cur_p->data;
+    const size_t             n    = cur_p->size;
+
+    if (n >= 32768 && llama_sampler_pool::get().n_threads() > 1 && llama_sampler_pool::get().try_lock()) {
+        llama_sampler_pool & pool = llama_sampler_pool::get();
+        const size_t block = 4096;
+        const size_t n_blocks = (n + block - 1) / block;
+        pool.max_blocks.resize(n_blocks);
+        pool.idx_blocks.resize(n_blocks);
+        float *  bm = pool.max_blocks.data();
+        size_t * bi = pool.idx_blocks.data();
+        pool.run(n, block, [data, bm, bi, block](size_t i0, size_t i1) {
+            float  m  = -INFINITY;
+            size_t mi = i0;
+            for (size_t i = i0; i < i1; ++i) {
+                if (data[i].logit > m) {
+                    m  = data[i].logit;
+                    mi = i;
+                }
+            }
+            bm[i0 / block] = m;
+            bi[i0 / block] = mi;
+        });
+        size_t sel   = 0;
+        float  max_l = data[0].logit;
+        for (size_t b = 0; b < n_blocks; ++b) {
+            if (bm[b] > max_l) {
+                max_l = bm[b];
+                sel   = bi[b];
+            }
+        }
+        pool.unlock();
+        return sel;
+    }
+
+    size_t sel = 0;
+    for (size_t i = 1; i < n; ++i) {
+        if (data[i].logit > data[sel].logit) {
+            sel = i;
+        }
+    }
+    return sel;
+}
