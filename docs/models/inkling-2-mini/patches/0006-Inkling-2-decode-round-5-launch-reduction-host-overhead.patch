+// one row with L lanes: the arithmetic of ink_gemv_bf16<L>
+template <int L>
+static __device__ __forceinline__ void ink_bf16_row(const char * __restrict__ w, const int64_t nb1, float * __restrict__ dst,
+                                                    const float * __restrict__ x, const int K8, const int r, const int sub, const int tid) {
+    constexpr int LL = L >= 64 ? 64 : L;
