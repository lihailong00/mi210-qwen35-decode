+// ticket counter of ink_router3_kernel: one per stream, zero-initialized, never reset. Launches on a stream are
+// serialized (also inside a captured graph) and each adds a multiple of the ticket count, so all call sites of a
+// stream can share it; different streams (contexts) never share one.
+static int * imoe_router3_counter(cudaStream_t stream) {
+    static std::vector<std::pair<cudaStream_t, int *>> counters;
+    for (const auto & c : counters) {
+        if (c.first == stream) {
+            return c.second;
+        }
+    }
+    int * c = nullptr;
+    CUDA_CHECK(cudaMalloc(&c, 16*sizeof(int)));
+    CUDA_CHECK(cudaMemset(c, 0, 16*sizeof(int)));
+    counters.push_back({ stream, c });
+    return c;
+}
