+// ---------------------------------------------------------------------------------------------
+// Router, third form (GGML_CUDA_INK_ROUTER=3): the GEMV of mul_mat_vec_f<float, float, 1, 128> for K = 2304 with the
+// 9 weight loads (and the 9 activation loads) of a lane issued up front instead of 9 serial rounds, then the same
+// rounded products (v_pk_mul_f32 in the stock kernel) added in the same order, the same two 64-lane xor trees and
+// (p0 + 0) + (p1 + 0). RPB rows per block (128 threads per row).
+// XL: the activation vector is staged in LDS once per block instead of being read from global memory by every row.
+// TAIL: the block that takes the last ticket also does the top-k tail (as ink_router_kernel; the ticket counter is
+// never reset: the number of blocks is a power of two and the last ticket is the one that is -1 modulo it).
+// ---------------------------------------------------------------------------------------------
+
+#define IMOE_ROUTER_K 2304
+
+template <int RPB, bool XL, bool TAIL>
+static __global__ void __launch_bounds__(128*RPB) ink_router3_kernel(
+        const float * __restrict__ w, const uint32_t w_stride, const float * __restrict__ x, const float * __restrict__ bias,
+        float * logits, int32_t * ids, float * weights, float * weights2, int * counter,
+        const float s1, const float b1, const float s2, const float b2) {
+    constexpr int NIT = IMOE_ROUTER_K / 256;
+    static_assert(IMOE_ROUTER_K % 256 == 0 && IMOE_N_EXPERT % RPB == 0 && (RPB & (RPB - 1)) == 0, "ink router3: unsupported shape");
+    const uint32_t tid = threadIdx.x;
+    const uint32_t g   = tid >> 7;
+    const uint32_t lt  = tid & 127;
+    const uint32_t row = blockIdx.x*RPB + g;
+
+    __shared__ float part[RPB][2];
+    __shared__ int   is_last;
+    __shared__ uint4 sh_key[IMOE_N_EXPERT/2];
+    __shared__ float sh_top[IMOE_N_USED];
+    __shared__ int   sh_ids[IMOE_N_USED];
+    __shared__ float sh_x[XL ? IMOE_ROUTER_K : 4];
+
+    const float2 * w2 = (const float2 *) (w + (size_t) (row*w_stride)) + lt;
+    float2 wv[NIT];
+#pragma unroll
+    for (int it = 0; it < NIT; ++it) {
+        wv[it] = w2[128*it];
+    }
+    float2 xv[NIT];
+    if constexpr (XL) {
+#pragma unroll
+        for (int k = 0; k < (IMOE_ROUTER_K/4 + 128*RPB - 1)/(128*RPB); ++k) {
+            const uint32_t j = tid + k*128*RPB;
+            if (j < IMOE_ROUTER_K/4) {
+                ((float4 *) sh_x)[j] = ((const float4 *) x)[j];
+            }
+        }
+        __syncthreads();
+#pragma unroll
+        for (int it = 0; it < NIT; ++it) {
+            xv[it] = ((const float2 *) sh_x)[lt + 128*it];
+        }
+    } else {
+#pragma unroll
+        for (int it = 0; it < NIT; ++it) {
+            xv[it] = ((const float2 *) x)[lt + 128*it];
+        }
+    }
+    float sumf = 0.0f;
+    {
+#pragma clang fp contract(off)
+#pragma unroll
+        for (int it = 0; it < NIT; ++it) {
+            const float px = wv[it].x * xv[it].x;
+            const float py = wv[it].y * xv[it].y;
+            sumf = sumf + px;
+            sumf = py + sumf;
+        }
+    }
+    sumf = warp_reduce_sum<64>(sumf);
+    if ((lt & 63) == 0) {
+        part[g][lt >> 6] = sumf;
+    }
+    __syncthreads();
+    if (tid < RPB) {
+        logits[blockIdx.x*RPB + tid] = (part[tid][0] + 0.0f) + (part[tid][1] + 0.0f);
+    }
+    if constexpr (TAIL) {
+        if (tid < 64) {
+            __builtin_amdgcn_fence(__ATOMIC_RELEASE, "agent");
+        }
+        if (tid == 0) {
+            constexpr int n_tickets = IMOE_N_EXPERT / RPB;
+            const int ticket = atomicAdd(counter, 1);
+            is_last = (ticket & (n_tickets - 1)) == n_tickets - 1;
+        }
+        __syncthreads();
+        if (!is_last) {
+            return;
+        }
+        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent");
+        const float l = logits[tid / RPB];
+        ink_router_tail2<RPB>(l, bias, ids, weights, weights2, s1, b1, s2, b2, tid, sh_key, sh_top, sh_ids);
+    }
+}
