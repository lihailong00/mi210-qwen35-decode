+// ---------------------------------------------------------------------------------------------
+// Router-weighted sum over the expert slots: MUL(experts [n, 8], weights [1, 8]) -> 8 VIEWs -> 7 ADDs, one token.
+// Replaces moe_weighted_reduction_f32 (stock fusion of the same nodes) with the same arithmetic as that kernel
+// compiles to on gfx90a when no expert scale is passed: r = x[0] * w[0] (rounded product), then
+// r = fma(w[e], x[e], r) for e = 1..7. The stock kernel has a runtime trip count and does 8 serial rounds of
+// (load value, load weight) per lane; here a lane owns 4 columns and issues its 8 16-byte loads up front.
+// GGML_CUDA_INK_MOE_RED=0: stock kernel.
+// ---------------------------------------------------------------------------------------------
+
+static __global__ void __launch_bounds__(64) ink_moe_reduce8(const float * __restrict__ ex, const float * __restrict__ rw,
+                                                             float * __restrict__ dst, const uint32_t n4) {
+    const uint32_t t = blockIdx.x*64 + threadIdx.x;
+    const float4 wa = ((const float4 *) rw)[0];
+    const float4 wb = ((const float4 *) rw)[1];
+    if (t >= n4) {
+        return;
+    }
+    float4 v[IMOE_N_USED];
+#pragma unroll
+    for (int e = 0; e < IMOE_N_USED; ++e) {
+        v[e] = ((const float4 *) ex)[e*n4 + t];
+    }
+    float4 r;
+    {
+#pragma clang fp contract(off)
+        r.x = v[0].x * wa.x;
+        r.y = v[0].y * wa.x;
+        r.z = v[0].z * wa.x;
+        r.w = v[0].w * wa.x;
+    }
+#define IMOE_RED_STEP(E_, W_)             \
+    r.x = fmaf(W_, v[E_].x, r.x);         \
+    r.y = fmaf(W_, v[E_].y, r.y);         \
+    r.z = fmaf(W_, v[E_].z, r.z);         \
+    r.w = fmaf(W_, v[E_].w, r.w);
+    IMOE_RED_STEP(1, wa.y)
+    IMOE_RED_STEP(2, wa.z)
+    IMOE_RED_STEP(3, wa.w)
+    IMOE_RED_STEP(4, wb.x)
+    IMOE_RED_STEP(5, wb.y)
+    IMOE_RED_STEP(6, wb.z)
+    IMOE_RED_STEP(7, wb.w)
+#undef IMOE_RED_STEP
+    ((float4 *) dst)[t] = r;
+}
+
+static void imoe_launch_reduce8(cudaStream_t stream, const float * ex, const float * rw, float * dst, int64_t n_embd) {
+    const uint32_t n4 = (uint32_t) (n_embd/4);
+    ink_moe_reduce8<<<(n4 + 63)/64, 64, 0, stream>>>(ex, rw, dst, n4);
+}
+
+struct imoe_red_match {
+    const ggml_tensor * experts; // [n_embd, 8] f32 contiguous
+    const ggml_tensor * weights; // [1, 8] f32 contiguous
+    ggml_tensor *       out;     // last ADD
+    int                 last;
+};
+
+// i: index of MUL(experts, weights). Same node pattern as ggml_cuda_match_moe_weighted_reduction (short form).
+static bool imoe_match_reduce(const ggml_cgraph * cgraph, int i, imoe_red_match & m) {
+    const ggml_tensor * weighted = cgraph->nodes[i];
+    if (weighted->op != GGML_OP_MUL || weighted->type != GGML_TYPE_F32 || !ggml_is_contiguous(weighted)) {
+        return false;
+    }
+    const ggml_tensor * ex = weighted->src[0];
+    const ggml_tensor * rw = weighted->src[1];
+    const int64_t n_embd = weighted->ne[0];
+    if (!ex || !rw || weighted->ne[1] != IMOE_N_USED || weighted->ne[2] != 1 || weighted->ne[3] != 1 ||
+        ex->type != GGML_TYPE_F32 || !ggml_is_contiguous(ex) || !ggml_are_same_shape(ex, weighted) ||
+        rw->type != GGML_TYPE_F32 || !ggml_is_contiguous(rw) || rw->ne[0] != 1 || rw->ne[1] != IMOE_N_USED || rw->ne[2] != 1 ||
+        rw->ne[3] != 1 || n_embd % 4 != 0 || n_embd < 4 || n_embd > (1 << 24) || i + 2*IMOE_N_USED - 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * views[IMOE_N_USED] = {};
+    const ggml_tensor * prev = nullptr;
+    int n_views = 0;
+    int n_adds  = 0;
+    for (int k = i + 1; k < i + 2*IMOE_N_USED; ++k) {
+        const ggml_tensor * c = cgraph->nodes[k];
+        if (c->op == GGML_OP_VIEW) {
+            if (n_views >= IMOE_N_USED || c->src[0] != weighted || c->view_src != weighted || c->type != GGML_TYPE_F32 ||
+                c->ne[0] != n_embd || c->ne[1] != 1 || c->ne[2] != 1 || c->ne[3] != 1 || c->nb[0] != weighted->nb[0] ||
+                c->view_offs != (size_t) n_views*weighted->nb[1] || (c->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                return false;
+            }
+            views[n_views++] = c;
+            continue;
+        }
+        if (c->op != GGML_OP_ADD || n_views < 2 || n_adds + 1 >= n_views || c->type != GGML_TYPE_F32) {
+            return false;
+        }
+        if (c->src[0] != (n_adds == 0 ? views[0] : prev) || c->src[1] != views[n_adds + 1]) {
+            return false;
+        }
+        prev = c;
+        n_adds++;
+    }
+    if (n_views != IMOE_N_USED || n_adds != IMOE_N_USED - 1) {
+        return false;
+    }
+    ggml_tensor * out = cgraph->nodes[i + 2*IMOE_N_USED - 1];
+    if (out != prev || !ggml_is_contiguous(out) || out->ne[0] != n_embd || ggml_nelements(out) != n_embd) {
+        return false;
+    }
+    if (!ex->data || !rw->data || !out->data || ((uintptr_t) ex->data % 16) != 0 || ((uintptr_t) rw->data % 16) != 0 ||
+        ((uintptr_t) out->data % 16) != 0) {
+        return false;
+    }
+    m.experts = ex;
+    m.weights = rw;
+    m.out     = out;
+    m.last    = i + 2*IMOE_N_USED - 1;
+    // the MUL, the views and all ADDs but the last are used only inside; nothing in between is a graph output
+    if (!imoe_internal_only(cgraph, i, m.last, out, out)) {
+        return false;
+    }
+    if (imoe_overlap(out, ex) || imoe_overlap(out, rw)) {
+        return false;
+    }
+    return true;
+}
