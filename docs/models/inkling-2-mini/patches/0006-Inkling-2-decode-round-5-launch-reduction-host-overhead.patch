+// ink_router_tail with the last step (sum, 8 divisions, scale, stores) done by 8 lanes, one weight each, instead of
+// serially by one lane: the same operations on the same values.
+template <int TPE>
+static __device__ __forceinline__ void ink_router_tail2(const float logit, const float * __restrict__ bias, int32_t * ids,
+                                                        float * weights, float * weights2, const float s1, const float b1, const float s2,
+                                                        const float b2, const int tid, uint4 * sh_key, float * sh_top,
+                                                        int * sh_ids) {
+    const int e = tid / TPE;
+    const int c = tid % TPE;
+    float wt = 1.f / (1.f + expf(-logit));
+    if (__isnanf(wt)) {
+        wt = -FLT_MAX;
+    }
+    float sel = wt + bias[e];
+    if (__isnanf(sel)) {
+        sel = -FLT_MAX;
+    }
+    sel += 0.0f; // -0 -> +0: float equality must be key equality
+    const uint32_t  bits = __float_as_uint(sel);
+    const uint32_t  mono = (bits & 0x80000000u) ? ~bits : (bits | 0x80000000u);
+    const uint64_t  key  = ((uint64_t) mono << 32) | (uint32_t) (IMOE_N_EXPERT - 1 - e);
+    if (c == 0) {
+        ((uint64_t *) sh_key)[e] = key;
+    }
+    __syncthreads();
+    constexpr int per = IMOE_N_EXPERT / TPE; // keys compared by one thread
+    const uint4 * kp = sh_key + c*(per/2);
+    int rank = 0;
+#pragma unroll
+    for (int j2 = 0; j2 < per/2; ++j2) {
+        const uint4 o = kp[j2];
+        const uint64_t k0 = ((uint64_t) o.y << 32) | o.x;
+        const uint64_t k1 = ((uint64_t) o.w << 32) | o.z;
+        rank += (int) (k0 > key) + (int) (k1 > key);
+    }
+#pragma unroll
+    for (int off = TPE/2; off > 0; off >>= 1) {
+        rank += __shfl_xor(rank, off, 64);
+    }
+    if (c == 0 && rank < IMOE_N_USED) {
+        sh_ids[rank] = e;
+        sh_top[rank] = wt;
+    }
+    __syncthreads();
+    if (tid < IMOE_N_USED) {
+        const float4 va = ((const float4 *) sh_top)[0];
+        const float4 vb = ((const float4 *) sh_top)[1];
+        const float s = ((va.x + vb.x) + (va.z + vb.z)) + ((va.y + vb.y) + (va.w + vb.w));
+        const float cl = s1 * s + b1;
+        float mine = va.x;
+        mine = tid == 1 ? va.y : mine;
+        mine = tid == 2 ? va.z : mine;
+        mine = tid == 3 ? va.w : mine;
+        mine = tid == 4 ? vb.x : mine;
+        mine = tid == 5 ? vb.y : mine;
+        mine = tid == 6 ? vb.z : mine;
+        mine = tid == 7 ? vb.w : mine;
+        const float d = mine / cl;
+        const float wgt = s2 * d + b2;
+        weights[tid] = wgt;
+        if (weights2) {
+            weights2[tid] = wgt; // persistent copy for a kernel that runs after the graph buffer may have been reused
+        }
+        ids[tid]     = sh_ids[tid];
+    }
+}
