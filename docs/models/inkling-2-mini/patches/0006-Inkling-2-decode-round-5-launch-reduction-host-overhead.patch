+// ---- host-side profile of the decode loop: GGML_CUDA_INK_HOSTPROF=1 prints a per-graph-call breakdown at exit ----
+// A "cycle" runs from the start of one graph_compute to the start of the next one. Cycles are grouped by
+// (mode, node count); mode 0 = direct evaluation, 1 = capture + launch, 2 = replay of a captured graph.
+struct ggml_cuda_hostprof_state {
+    enum cat { GC_PRE, GC_RUN, SYNC_FIRST, SYNC_REST, SET, SET_ASYNC, GET, GET_ASYNC, N_CAT };
+    struct acc {
+        int      mode = 0, n_nodes = 0;
+        uint64_t n = 0, wall = 0, gap = 0, cpu = 0; // cpu: CPU time of all threads of the process
+        uint64_t t[N_CAT] = {}, c[N_CAT] = {}, b[N_CAT] = {};
+    };
+    bool             enabled    = false;
+    int              level      = 0;      // 2: wait for the graph before a large readback, to time the readback alone
+    bool             open       = false;  // a cycle is running
+    bool             synced     = false;  // the cycle has seen its first synchronize
+    uint64_t         t_start    = 0;      // start of the running cycle
+    uint64_t         t_sync_end = 0;      // end of its last synchronize
+    uint64_t         cpu_start  = 0;
+    acc              cur;
+    std::vector<acc> table;
+    std::map<std::pair<int, size_t>, uint64_t> sizes; // (cat, bytes) -> calls, replay cycles only
+
+    static uint64_t now() {
+        return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    static uint64_t cpu_now() {
+        return (uint64_t) ((double) std::clock() * (1e9 / CLOCKS_PER_SEC));
+    }
+    ggml_cuda_hostprof_state() {
+        const char * e = getenv("GGML_CUDA_INK_HOSTPROF");
+        level   = e != nullptr ? atoi(e) : 0;
+        enabled = level != 0;
+    }
+    void close_cycle(uint64_t t) {
+        if (!open) {
+            return;
+        }
+        cur.wall = t - t_start;
+        cur.gap  = synced ? t - t_sync_end : 0;
+        cur.cpu  = cpu_now() - cpu_start;
+        acc * dst = nullptr;
+        for (acc & a : table) {
+            if (a.mode == cur.mode && a.n_nodes == cur.n_nodes) {
+                dst = &a;
+            }
+        }
+        if (dst == nullptr) {
+            table.emplace_back();
+            dst = &table.back();
+            dst->mode = cur.mode;
+            dst->n_nodes = cur.n_nodes;
+        }
+        dst->n++;
+        dst->wall += cur.wall;
+        dst->gap  += cur.gap;
+        dst->cpu  += cur.cpu;
+        for (int i = 0; i < N_CAT; i++) {
+            dst->t[i] += cur.t[i];
+            dst->c[i] += cur.c[i];
+            dst->b[i] += cur.b[i];
+        }
+        open = false;
+    }
+    void begin_cycle(uint64_t t, int n_nodes) {
+        close_cycle(t);
+        cur = acc();
+        cur.n_nodes = n_nodes;
+        open = true;
+        synced = false;
+        t_start = t;
+        cpu_start = cpu_now();
+    }
+    void add(int c, uint64_t dt, size_t bytes) {
+        if (!open) {
+            return;
+        }
+        cur.t[c] += dt;
+        cur.c[c] += 1;
+        cur.b[c] += bytes;
+        if (c >= SET) {
+            sizes[std::make_pair(c, bytes)]++;
+        }
+    }
+    ~ggml_cuda_hostprof_state() {
+        if (!enabled) {
+            return;
+        }
+        // the last cycle has no end: dropped
+        static const char * names[N_CAT] = { "gc_pre", "gc_run", "sync1", "sync+", "set", "set_async", "get", "get_async" };
+        static const char * modes[3]     = { "direct", "capture", "replay" };
+        fprintf(stderr, "\n[ink hostprof] per graph_compute cycle (us); gap = end of last synchronize -> next graph_compute\n");
+        for (const acc & a : table) {
+            const double n = (double) a.n;
+            fprintf(stderr, "[ink hostprof] %-7s nodes %6d cycles %6llu wall %9.1f gap %8.1f cpu %8.1f |", modes[a.mode], a.n_nodes,
+                    (unsigned long long) a.n, a.wall / n / 1e3, a.gap / n / 1e3, a.cpu / n / 1e3);
+            for (int i = 0; i < N_CAT; i++) {
+                if (a.c[i] == 0) {
+                    continue;
+                }
+                fprintf(stderr, " %s %.1f (x%.2f, %.0f B)", names[i], a.t[i] / n / 1e3, a.c[i] / n, a.b[i] / n);
+            }
+            fprintf(stderr, "\n");
+        }
+        fprintf(stderr, "[ink hostprof] copy sizes, all cycles (calls):");
+        for (const auto & kv : sizes) {
+            fprintf(stderr, " %s[%zu B]=%llu", names[kv.first.first], kv.first.second, (unsigned long long) kv.second);
+        }
+        fprintf(stderr, "\n");
+    }
+};
+static ggml_cuda_hostprof_state & ggml_cuda_hostprof() {
+    static ggml_cuda_hostprof_state st;
+    return st;
+}
+struct ggml_cuda_hostprof_scope {
+    int      c;
+    size_t   bytes;
+    uint64_t t0 = 0;
+    bool     on;
+    ggml_cuda_hostprof_scope(int c, size_t bytes = 0) : c(c), bytes(bytes), on(ggml_cuda_hostprof().enabled) {
+        if (on) {
+            t0 = ggml_cuda_hostprof_state::now();
+        }
+    }
+    ~ggml_cuda_hostprof_scope() {
+        if (on) {
+            ggml_cuda_hostprof().add(c, ggml_cuda_hostprof_state::now() - t0, bytes);
+        }
+    }
+};
