+// ---------------------------------------------------------------------------------------------
+// Router-weighted sum left to the convolution kernel (GGML_CUDA_INK_RED_CONV=0: off). The sum x = ffn_moe_out has two
+// consumers, both inside the convolve() fusion of inkling-ops.cu (CONCAT of the conv window, ADD(x, conv)); that kernel
+// is elementwise over the 2304 channels, so it can add the 8 expert values itself (same arithmetic as ink_moe_reduce8)
+// and the reduction launch disappears.
+//   1. the down GEMV (NVFP4 v4 in inkling-gemv.cu, BF16 here) calls ggml_cuda_ink_moe_red_defer(): when the nodes that
+//      follow are the reduction and its consumers are the convolution pattern, the GEMV writes its (scaled) output to a
+//      persistent buffer instead of the graph buffer, the reduction nodes are consumed and nothing is launched for them.
+//      The router weights were copied to a persistent buffer by the router kernel (the graph buffers of both may be
+//      reused before the convolution kernel runs, which can be deferred to the SSM_CONV node).
+//   2. the next dispatched node is the conv CONCAT: inkling-ops.cu claims the pending sum at the point where its fusion
+//      is certain (ggml_cuda_ink_moe_red_claim) and its kernel reads the persistent buffers.
+//   3. anything else (another node dispatched first, ops off or rejecting): the sum is materialized into x's buffer
+//      with ink_moe_reduce8 before that node runs (ggml_cuda_ink_moe_red_pending / _settle in the dispatcher).
+// ---------------------------------------------------------------------------------------------
+
+struct imoe_red_pending_state {
+    bool                active;
+    const ggml_tensor * x;   // last ADD of the reduction, not materialized
+    const ggml_tensor * cat; // CONCAT at which the convolution fusion starts
+    const float *       ex;  // persistent [8][n]
+    const float *       rw;  // persistent [8]
+    int64_t             n;
+};
+
+static imoe_red_pending_state                             imoe_red_pending = {};
+static std::unordered_map<const ggml_tensor *, float *>  imoe_rw_copies; // router weight tensor -> persistent copy (this evaluation)
+
+static bool imoe_red_conv_on() {
+    static const bool on = imoe_env_int("GGML_CUDA_INK_MOE_RED", 1) != 0 && imoe_env_int("GGML_CUDA_INK_RED_CONV", 1) != 0 &&
+                           getenv("GGML_CUDA_INK_VERIFY") == nullptr;
+    return on;
+}
+
+// persistent device buffer per (context, kind, node index): captured graphs keep the pointers, so nothing is ever freed
+static float * imoe_scratch(ggml_backend_cuda_context & ctx, int kind, int node_idx, size_t bytes) {
+    static std::map<std::pair<const void *, int64_t>, std::pair<float *, size_t>> buffers;
+    const std::pair<const void *, int64_t> key = { (const void *) &ctx, ((int64_t) kind << 32) | (uint32_t) node_idx };
+    auto it = buffers.find(key);
+    if (it != buffers.end() && it->second.second >= bytes) {
+        return it->second.first;
+    }
+    if (it == buffers.end() && buffers.size() >= 8192) {
+        return nullptr;
+    }
+    float * p = nullptr;
+    CUDA_CHECK(cudaMalloc(&p, bytes));
+    CUDA_CHECK(cudaMemset(p, 0, bytes));
+    buffers[key] = { p, bytes };
+    return p;
+}
+
+// router dispatch: where the tail kernel should store a second copy of the 8 weights (nullptr: no copy)
+static float * imoe_rw_copy_for(ggml_backend_cuda_context & ctx, const ggml_tensor * weights, int node_idx) {
+    if (!imoe_red_conv_on()) {
+        return nullptr;
+    }
+    float * p = imoe_scratch(ctx, 1, node_idx, 64);
+    if (p) {
+        imoe_rw_copies[weights] = p;
+    }
+    return p;
+}
+
+static void imoe_rw_copy_drop(const ggml_tensor * weights) {
+    imoe_rw_copies.erase(weights);
+}
+
+static bool imoe_is_noop(const ggml_tensor * t) {
+    return t->op == GGML_OP_NONE || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE ||
+           t->op == GGML_OP_TRANSPOSE || ggml_is_empty(t);
+}
+
+float * ggml_cuda_ink_moe_red_defer(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i_ex, int * last) {
+    if (!imoe_red_conv_on() || imoe_red_pending.active || i_ex + 1 >= cgraph->n_nodes) {
+        return nullptr;
+    }
+    const ggml_tensor * exn = cgraph->nodes[i_ex];
+    imoe_red_match m;
+    if (!imoe_match_reduce(cgraph, i_ex + 1, m) || m.experts != exn || ggml_node_get_use_count(cgraph, i_ex) != 1 ||
+        (exn->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return nullptr;
+    }
+    const auto rw_it = imoe_rw_copies.find(m.weights);
+    if (rw_it == imoe_rw_copies.end()) {
+        return nullptr; // the router kernel of this evaluation did not copy these weights
+    }
+    const ggml_tensor * x = m.out;
+    const int64_t n = x->ne[0];
+    if (ggml_node_get_use_count(cgraph, m.last) != 2 || (x->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return nullptr;
+    }
+    // consumer 1: [RESHAPE(x)] -> TRANSPOSE -> CONCAT(history, .) = the next dispatched node
+    int ic = -1;
+    for (int k = m.last + 1; k < cgraph->n_nodes; ++k) {
+        if (!imoe_is_noop(cgraph->nodes[k])) {
+            ic = k;
+            break;
+        }
+    }
+    if (ic < 0) {
