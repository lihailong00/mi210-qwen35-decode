+        const uint4  wv = wr[c];
+        const float4 xa = x4[2*c + 0];
+        const float4 xb = x4[2*c + 1];
+        sum = fmaf(__uint_as_float(wv.x << 16),         xa.x, sum);
+        sum = fmaf(__uint_as_float(wv.x & 0xFFFF0000u), xa.y, sum);
+        sum = fmaf(__uint_as_float(wv.y << 16),         xa.z, sum);
+        sum = fmaf(__uint_as_float(wv.y & 0xFFFF0000u), xa.w, sum);
+        sum = fmaf(__uint_as_float(wv.z << 16),         xb.x, sum);
+        sum = fmaf(__uint_as_float(wv.z & 0xFFFF0000u), xb.y, sum);
+        sum = fmaf(__uint_as_float(wv.w << 16),         xb.z, sum);
+        sum = fmaf(__uint_as_float(wv.w & 0xFFFF0000u), xb.w, sum);
