+        mul->type != GGML_TYPE_F32 || !other || other->type != GGML_TYPE_F32 || !other->data || !mul->data ||
+        ggml_nelements(sig) != n || ggml_nelements(mul) != n || ggml_nelements(other) != n || !ggml_is_contiguous(mul) ||
+        !ggml_is_contiguous(other) || !ggml_is_contiguous(sig) || n >= (1 << 30)) {
