+// ---- host-side profile of llama_decode: LLAMA_INK_HOSTPROF=1 prints a per-decode breakdown at exit ----
+// A cycle runs from the entry of one decode() to the entry of the next one. "out" is the time between the return of
+// decode() and the next entry (sampling, detokenization, server work ...) without the synchronize calls made there.
+namespace {
+struct llama_ink_hostprof {
+    enum cat { D_PRE, D_PARAMS, D_BUILD, D_ALLOC, D_INPUTS, D_COMPUTE, D_EXTRACT, D_POST, SYNC, OUT, N_CAT };
+    struct acc {
+        uint64_t n = 0;
+        uint64_t t[N_CAT] = {};
+        uint64_t n_sync = 0;
+    };
+    bool     enabled = false;
+    bool     open    = false; // a cycle is running
+    bool     inside  = false; // inside decode()
+    bool     single  = false;
+    bool     reused  = false;
+    uint64_t t_last  = 0;
+    acc      cur;
+    acc      table[4];        // [single token][graph reused]
+
+    static uint64_t now() {
+        return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    llama_ink_hostprof() {
+        const char * e = getenv("LLAMA_INK_HOSTPROF");
+        enabled = e != nullptr && atoi(e) != 0;
+    }
+    void mark(int c) {
+        const uint64_t t = now();
+        cur.t[c] += t - t_last;
+        t_last = t;
+    }
+    void enter() {
+        if (open) {
+            mark(OUT);
+            acc & dst = table[(single ? 2 : 0) + (reused ? 1 : 0)];
+            dst.n++;
+            dst.n_sync += cur.n_sync;
+            for (int i = 0; i < N_CAT; i++) {
+                dst.t[i] += cur.t[i];
+            }
+        }
+        cur    = acc();
+        open   = true;
+        inside = true;
+        t_last = now();
+    }
+    void leave() {
+        mark(D_POST);
+        inside = false;
+    }
+    ~llama_ink_hostprof() {
+        if (!enabled) {
+            return;
+        }
+        static const char * names[N_CAT] = { "pre", "params", "build", "alloc", "inputs", "compute", "extract", "post", "sync", "out" };
+        fprintf(stderr, "\n[llama hostprof] per decode() cycle (us), the last cycle of the process is dropped\n");
+        for (int b = 0; b < 4; b++) {
+            const acc & a = table[b];
+            if (a.n == 0) {
+                continue;
+            }
+            uint64_t tot = 0;
+            for (int i = 0; i < N_CAT; i++) {
+                tot += a.t[i];
+            }
+            fprintf(stderr, "[llama hostprof] %s %s cycles %6llu total %9.1f |", (b & 2) ? "1-token" : "n-token", (b & 1) ? "reuse  " : "rebuild",
+                    (unsigned long long) a.n, tot / (double) a.n / 1e3);
+            for (int i = 0; i < N_CAT; i++) {
+                fprintf(stderr, " %s %.1f", names[i], a.t[i] / (double) a.n / 1e3);
+            }
+            fprintf(stderr, " (sync calls %.2f)\n", a.n_sync / (double) a.n);
+        }
+    }
+};
+llama_ink_hostprof & ink_hostprof() {
+    static llama_ink_hostprof st;
+    return st;
+}
+struct llama_ink_hostprof_decode {
