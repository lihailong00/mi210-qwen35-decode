+int ggml_cuda_ink_try_moe_reduce(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const int mode = imoe_env_int("GGML_CUDA_INK_MOE_RED", 1);
+    if (mode == 0 || cgraph->nodes[i]->op != GGML_OP_MUL) {
+        return 0;
+    }
+    imoe_red_match m;
+    if (!imoe_match_reduce(cgraph, i, m)) {
+        return 0;
+    }
+    const int64_t n_embd = m.out->ne[0];
+    int reps = 0;
+    static bool benched = false;
+    if (!benched && imoe_bench_ready(ctx, reps)) {
+        benched = true;
+        for (int pass = 0; pass < 2; ++pass) {
+            const double t_new = imoe_bench(ctx, reps, [&] {
+                imoe_launch_reduce8(ctx.stream(), (const float *) m.experts->data, (const float *) m.weights->data,
+                                    (float *) m.out->data, n_embd);
+            });
+            const double t_old = imoe_bench(ctx, reps, [&] {
+                ggml_cuda_op_moe_weighted_reduction(ctx, m.experts, nullptr, m.weights, m.out);
+            });
+            fprintf(stderr, "MOEBENCH reduce: ink_moe_reduce8 %.2f us/launch, moe_weighted_reduction_f32 %.2f us/launch\n", t_new, t_old);
+        }
+    }
+    imoe_launch_reduce8(ctx.stream(), (const float *) m.experts->data, (const float *) m.weights->data, (float *) m.out->data, n_embd);
+    CUDA_CHECK(cudaGetLastError());
+    imoe_hit(IMOE_REDUCE);
+    return m.last - i;
+}
